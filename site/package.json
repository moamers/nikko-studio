{
  "name": "nikko-studio-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "start": "astro dev",
    "build": "npm run enquiry:options && astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "enquiry:options": "node src/lib/enquiry/options.build.mjs",
    "enquiry:options:check": "node src/lib/enquiry/options.build.mjs --check",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "serve-handler": "^6.1.7",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
