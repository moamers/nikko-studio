---
/**
 * Services section — "Put us to work".
 *
 * Spec section 7 (design-handoff/homepage/README.md § 7; dc.html lines
 * 492-537, card copy in `renderVals()` ~919-1030). Two cards, Show&Tell (01,
 * coral) and Dream&Do (02, cobalt), each a three-column grid: figure, copy,
 * investment.
 *
 * DEVIATION (logged in docs/06-responsive-and-mobile-risks.md, R8): the
 * source separates the investment column with an absolutely-positioned
 * `border-left`, which survives unchanged into the stacked mobile layout as
 * a stray vertical line down the left edge of a full-width block. Here the
 * divider is a logical border driven by a container query on the card
 * itself — `border-inline-start` (a left rule, inset top/bottom, exactly
 * matching the source) once the card is wide enough for its grid to lay
 * columns side by side, `border-block-start` (a top rule) once it isn't.
 * 680px is not a guess: `grid-template-columns:
 * repeat(auto-fit,minmax(min(100%,340px),1fr))` collapses from two columns
 * to one at exactly `2 × 340px` of available width, so the query threshold
 * reproduces the grid's own arithmetic rather than approximating it.
 *
 * Build rules:
 *   - Copy comes from `src/lib/content`, never a string literal here. [P7]
 *   - Colours/timings come from `--nk-*` tokens, never a hex literal. [P11]
 *   - Both cards' full body copy ships in the HTML — it is the page's
 *     clearest statement of what is sold and at what price. [P6]
 *   - Resting state is the FINAL state — nothing is stranded invisible. [P1, P3]
 *   - Card hover has a keyboard-reachable `:focus-within` equivalent. [P10]
 *   - Must hold at 390px with no horizontal overflow. [P2]
 */
import { getServices } from '../lib/content';
import Figure from '../components/Figure.astro';
import Pill from '../components/Pill.astro';

const services = await getServices();

const accentVar = (colour: 'coral' | 'cobalt') =>
  colour === 'coral' ? 'var(--nk-coral)' : 'var(--nk-cobalt)';
---

<section id="services" class="nk-services">
  <div class="nk-services__header">
    <h2 class="nk-services__heading nk-reveal">{services.heading}</h2>
    <span class="nk-services__kicker">{services.kicker}</span>
  </div>

  <div class="nk-services__cards">
    {
      services.items.map((item) => (
        <article
          class="nk-service-card nk-reveal"
          style={`--nk-service-accent: ${accentVar(item.colour)}`}
        >
          <div class="nk-service-card__header">
            <span class="nk-service-card__numeral">{item.n}</span>
            <h3 class="nk-service-card__title">{item.title}</h3>
            <span class="nk-service-card__stamp">{item.stamp}</span>
          </div>

          <div class="nk-service-card__figure">
            <Figure
              image={item.figure.image}
              alt={item.figure.alt}
              caption={item.figure.caption}
              variant="service"
              ratio="4 / 3"
              sizes="(min-width: 1024px) 400px, (min-width: 640px) 45vw, 100vw"
            />
          </div>

          <div class="nk-service-card__copy">
            <p class="nk-service-card__lead">{item.lead}</p>
            <p class="nk-service-card__body">{item.body}</p>
            <p class="nk-service-card__body">{item.body2}</p>
            <p class="nk-service-card__kicker">{item.kicker}</p>
          </div>

          <div class="nk-service-card__investment">
            <span class="nk-service-card__divider" aria-hidden="true" />
            <div>
              <p class="nk-service-card__eyebrow">{services.investmentLabel}</p>
              <p class="nk-service-card__price">{item.price}</p>
              <p class="nk-service-card__price-note">{item.priceNote}</p>
            </div>
            <div class="nk-service-card__cta-row">
              <Pill href={item.cta.href} size="md" tone="ink">
                {item.cta.label}
              </Pill>
              <span class="nk-service-card__serial">{item.serial}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  @layer layout {
    .nk-services {
      max-width: var(--nk-content-max);
      margin: 0 auto;
      padding: var(--nk-section-pad);
    }

    .nk-services__header {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: clamp(30px, 4vw, 54px);
    }

    .nk-services__heading {
      margin: 0;
      font-family: var(--nk-font-display);
      font-size: var(--nk-size-h2-services);
      line-height: var(--nk-leading-h1);
      letter-spacing: var(--nk-tracking-display-tight);
      text-transform: uppercase;
    }

    .nk-services__kicker {
      font-family: var(--nk-font-mono);
      font-size: var(--nk-size-mono);
      letter-spacing: var(--nk-tracking-mono-wide);
      text-transform: uppercase;
      color: var(--nk-ink-muted);
    }

    .nk-services__cards {
      display: flex;
      flex-direction: column;
      gap: var(--nk-gap-cards);
    }

    /* ── Card ──────────────────────────────────────────────────────────── */
    .nk-service-card {
      container-type: inline-size;
      container-name: nk-service-card;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
      overflow: hidden;
      border: var(--nk-rule-hair);
      border-radius: var(--nk-radius-lid-card);
      background: var(--nk-ground);
      transition:
        background-color var(--nk-dur-ground) var(--nk-ease-accent),
        transform var(--nk-dur-card) var(--nk-ease-card),
        box-shadow var(--nk-dur-card) ease;
    }

    @media (hover: hover) {
      .nk-service-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--nk-shadow-card-hover);
      }
    }

    /* Keyboard-reachable equivalent of the hover lift: the CTA pill inside
       is the focusable element, so its focus lifts the whole card. [P10] */
    .nk-service-card:focus-within {
      transform: translateY(-4px);
      box-shadow: var(--nk-shadow-card-hover);
    }

    /* ── Header row ───────────────────────────────────────────────────── */
    .nk-service-card__header {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 12px 22px;
      grid-column: 1 / -1;
      padding: clamp(22px, 2.6vw, 34px) clamp(20px, 2.4vw, 32px);
      border-bottom: var(--nk-rule-hair-soft);
    }

    .nk-service-card__numeral {
      font-family: var(--nk-font-display);
      font-size: clamp(34px, 4vw, 58px);
      line-height: var(--nk-leading-display);
      letter-spacing: var(--nk-tracking-display-tight);
      color: var(--nk-service-accent);
    }

    .nk-service-card__title {
      flex: 1 1 320px;
      margin: 0;
      font-family: var(--nk-font-display);
      font-size: clamp(22px, 2.5vw, 38px);
      line-height: var(--nk-leading-flat);
      letter-spacing: var(--nk-tracking-display);
      text-transform: uppercase;
      text-wrap: pretty;
    }

    .nk-service-card__stamp {
      padding: 8px 16px;
      border-radius: var(--nk-radius-oval);
      background: var(--nk-service-accent);
      color: var(--nk-paper);
      font-family: var(--nk-font-mono);
      font-size: var(--nk-size-mono-sm);
      letter-spacing: var(--nk-tracking-mono);
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* ── Column A: figure ─────────────────────────────────────────────── */
    .nk-service-card__figure {
      padding: clamp(24px, 2.6vw, 34px) clamp(20px, 2.4vw, 32px);
    }

    /* ── Column B: copy ───────────────────────────────────────────────── */
    .nk-service-card__copy {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: clamp(24px, 2.6vw, 34px) clamp(20px, 2.4vw, 32px);
    }

    .nk-service-card__lead {
      margin: 0;
      max-width: var(--nk-measure-prose);
      font-size: var(--nk-size-body);
      line-height: var(--nk-leading-body);
      text-wrap: pretty;
    }

    .nk-service-card__body {
      margin: 0;
      max-width: var(--nk-measure-prose);
      font-size: var(--nk-size-body);
      line-height: var(--nk-leading-body);
      color: var(--nk-ink-muted);
      text-wrap: pretty;
    }

    .nk-service-card__kicker {
      margin: 0;
      font-family: var(--nk-font-editorial);
      font-style: italic;
      font-size: 22px;
      line-height: 1.3;
      color: var(--nk-coral);
    }

    /* ── Column C: investment ─────────────────────────────────────────── */
    .nk-service-card__investment {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 24px;
      padding: clamp(24px, 2.6vw, 34px) clamp(20px, 2.4vw, 32px);
    }

    /* Mobile-first / stacked default: a top rule, full measure. Flips to a
       side rule once the card's own grid is wide enough to lay columns
       side by side — see the file-level deviation note above. */
    .nk-service-card__divider {
      display: block;
      border-block-start: var(--nk-rule-dashed);
      margin-inline: 0;
      pointer-events: none;
    }

    @container nk-service-card (min-width: 680px) {
      .nk-service-card__divider {
        position: absolute;
        inset-block: 18px;
        inset-inline-start: 0;
        border-block-start: none;
        border-inline-start: var(--nk-rule-dashed);
        margin-inline: 0;
      }
    }

    .nk-service-card__eyebrow {
      margin: 0 0 8px;
      font-family: var(--nk-font-mono);
      font-size: var(--nk-size-mono-sm);
      letter-spacing: var(--nk-tracking-mono-wide);
      text-transform: uppercase;
      color: var(--nk-ink-muted);
    }

    .nk-service-card__price {
      margin: 0 0 8px;
      font-family: var(--nk-font-display);
      font-size: var(--nk-size-price);
      letter-spacing: var(--nk-tracking-display);
    }

    .nk-service-card__price-note {
      margin: 0;
      max-width: 34ch;
      font-size: 14.5px;
      line-height: 1.5;
      color: var(--nk-ink-muted);
    }

    .nk-service-card__cta-row {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .nk-service-card__serial {
      font-family: var(--nk-font-mono);
      font-size: var(--nk-size-mono-xs);
      letter-spacing: var(--nk-tracking-mono);
      text-transform: uppercase;
      color: var(--nk-ink-muted);
    }
  }
</style>
