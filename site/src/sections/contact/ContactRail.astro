---
/**
 * The section rail — desktop (≥1080px) only: a sticky left-hand list of
 * 01–05. Below 1080px `ContactRailBar.astro` takes over with the same list
 * as a horizontal chip bar; the two live in separate files because they sit
 * in different places in the DOM (this one inside the two-column shell, the
 * bar full-bleed above it), so the five-line SECTIONS list is the one thing
 * intentionally duplicated between them rather than reached for a shared
 * `.ts` module outside this directory's ownership.
 *
 * The design's "gathered fragments" — one stamped chip per answered value,
 * appearing live as the form fills in — hang off the bottom of the rail.
 * The markup for them is deliberately empty and `hidden` in the document:
 * `contact-form.ts` fills and reveals it from live form state, so with
 * JavaScript off the rail degrades to exactly what it was before, a
 * five-line navigation aid with nothing blank or broken showing. [P3]
 *
 * The summary is `aria-hidden` on purpose. Every value in it is a mirror of
 * a form control the visitor has just filled in and can still reach, so
 * announcing it a second time — on every keystroke of a business name —
 * would be noise, not information. [P10]
 */
const SECTIONS = [
  { n: '01', href: '#about', title: 'About you' },
  { n: '02', href: '#project', title: 'The project' },
  { n: '03', href: '#work', title: 'The work' },
  { n: '04', href: '#reason', title: 'The reason' },
  { n: '05', href: '#finish', title: 'The finish line' },
] as const;
---

<aside class="nk-c-rail" aria-label="Enquiry sections">
  <p class="nk-c-rail-eyebrow">The brief</p>
  <nav class="nk-c-rail-list">
    {
      SECTIONS.map((s) => (
        <a class="nk-c-rail-link" href={s.href}>
          <span class="nk-c-rail-num" aria-hidden="true">
            {s.n}
          </span>
          <span class="nk-c-rail-title">{s.title}</span>
        </a>
      ))
    }
  </nav>

  <div class="nk-c-rail-frags" data-rail-frags aria-hidden="true" hidden>
    <p class="nk-c-rail-frags-head">
      Gathered <span class="nk-c-rail-frags-count" data-rail-frag-count>00</span>
    </p>
    <div class="nk-c-rail-frag-list" data-rail-frag-list></div>
  </div>
</aside>
