---
/**
 * §1 — the sticky header.
 *
 * Three things live here: the CSS logo lockup, the primary navigation, and
 * the right-hand controls (mode dial, CTA, and — below 1024px — the button
 * that opens the mobile menu). Every rule is in `src/styles/header.css`;
 * every string is in `src/content/settings/site.yaml`. [P7, P11]
 *
 * `data-nk-chrome` opts the bar into the opening sequence's chrome gate.
 * Note the polarity: it is VISIBLE by default and the sequence hides it while
 * it owns the screen. A JS failure leaves the header exactly where it is. [P1]
 *
 * THREE THINGS ARE DELIBERATELY OUTSIDE `<header>`:
 *
 *   - the skip link, because the header is chrome-gated and a keyboard reader
 *     wants the skip *during* the opening sequence, not after it;
 *   - the <dialog>, because `[data-nk-chrome]` animates `transform`, and a
 *     transformed ancestor becomes the containing block for anything fixed
 *     inside it — which would pin the full-screen panel to the header;
 *   - nothing else. The bar itself is one element, and it is sticky, so no
 *     ancestor may ever gain `overflow: hidden`. [R10]
 *
 * The header's natural flow position lands at the end of the 320vh runway, so
 * the handoff from the sequence is gapless with no scroll maths.
 *
 * PROPS VS SETTINGS. `nav`, `cta` and `logo` arrive as props because the page
 * already reads them; the header's own microcopy and the dial's labels are
 * read here so that adding a control never means editing `index.astro`. Both
 * paths end at the same `getSiteSettings()`. [P7]
 */
import Logo from './Logo.astro';
import ModeDial from './ModeDial.astro';
import MobileMenu from './MobileMenu.astro';
import Pill from './Pill.astro';
import { getSiteSettings, type NavItem } from '../lib/content';
import { resolveNavHref } from '../lib/links';
import '../styles/header.css';

interface Props {
  nav: NavItem[];
  cta: { label: string; href: string };
  logo: { wordmark: string; homeLabel: string; homeHref: string };
}

const { nav, cta, logo } = Astro.props;
const { header, modeDial } = await getSiteSettings();

const MENU_ID = 'nk-menu';

// `nav`, `cta.href` and `logo.homeHref` arrive from settings as bare anchors
// (`#work`, `#services`, `#founder`, `#top`) — correct only on the page that
// owns those ids, the homepage. Resolved once here, then handed to both this
// header's own <nav> and to <MobileMenu>, so the two never disagree. [P7]
const path = Astro.url.pathname;
const resolvedNav = nav.map((item) => ({ ...item, href: resolveNavHref(item.href, path) }));
const resolvedCta = { ...cta, href: resolveNavHref(cta.href, path) };
const resolvedHomeHref = resolveNavHref(logo.homeHref, path);
---

<a class="nk-skip" href="#main">{header.skipLink}</a>

<header class="nk-header" data-nk-chrome="true">
  <div class="nk-header__row">
    <Logo wordmark={logo.wordmark} href={resolvedHomeHref} label={logo.homeLabel} />

    <nav class="nk-header__nav" aria-label={header.navLabel}>
      {resolvedNav.map((item) => <a class="nk-header__link" href={item.href}>{item.label}</a>)}
    </nav>

    <div class="nk-header__tools">
      <div class="nk-header__dial"><ModeDial copy={modeDial} /></div>

      <Pill class="nk-header__cta" href={resolvedCta.href} size="sm">{cta.label}</Pill>

      {/*
        Hidden until the inline script in `MobileMenu.astro` has both set
        `data-nk-js` and wired the dialog — one script, so the button can
        never appear without something behind it. [P1]
      */}
      <div class="nk-header__menu">
        <Pill
          size="sm"
          lift={false}
          data-nk-menu-open
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls={MENU_ID}
        >
          {header.menuOpen}
        </Pill>
      </div>
    </div>
  </div>
</header>

<MobileMenu id={MENU_ID} nav={resolvedNav} cta={resolvedCta} copy={header} modeDial={modeDial} />

<script>
  /* The dial is the only control on the page that needs `mode.ts`, so the
     header mounts it rather than waiting for a page-level entry point. The
     call is idempotent, so `initSite()` mounting it as well is harmless. The
     dial stays `display: none` until this module has written `data-mode` on
     <html>, which means it is never on screen without its behaviour. [P1] */
  import { initMode } from '../scripts/mode';

  initMode();

  /* Publish the header's real height as `--nk-header-h`, so anything that
     sticks directly beneath it sits flush instead of guessing. The CSS
     fallback is a sum of the padding and the tap target, which overshoots
     the rendered height — the gap that leaves is small, but page content
     scrolls through it. Observed rather than measured once, because the
     header re-wraps at narrow widths and changes height when it does. */
  const header = document.querySelector('.nk-header');
  if (header instanceof HTMLElement && 'ResizeObserver' in window) {
    const publish = (): void => {
      document.documentElement.style.setProperty(
        '--nk-header-h',
        `${Math.round(header.getBoundingClientRect().height)}px`,
      );
    };
    publish();
    new ResizeObserver(publish).observe(header);
  }
</script>
