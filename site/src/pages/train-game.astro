          ctx.fillRect(c.x - c.dir * 11 - 1, cy - 5, 2, 3);
          ctx.fillRect(c.x - c.dir * 11 - 1, cy + 1, 2, 3);
        }
      });
      // the traffic lights, one on each side of the street
      drawSignal(stopEastX() + 2, sy + 26, state);
      drawSignal(stopWestX() - 2, sy - 56, state);
    }

    function drawScenery() {
      const land = getComputedStyle(document.documentElement).getPropertyValue('--land').trim() || '#6fbf73';
      const bed = getComputedStyle(document.documentElement).getPropertyValue('--bed').trim() || '#b8a88a';
      ctx.fillStyle = onMono() ? (getComputedStyle(document.documentElement).getPropertyValue('--water').trim() || '#4aa3d8') : land;
      ctx.fillRect(0, 0, W, H);

      drawCity();
      const dim = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--city-dim')) || 0;
      if (dim > 0) {
        ctx.fillStyle = 'rgba(6, 12, 26, ' + dim + ')';
        ctx.fillRect(0, 0, W, H);
      }

      drawBridgeWater();

      const ground = onGround();
      if (ground) {
        drawRoadGap(110, 170, 1);
        drawRoadGap(230, 290, 2);
      }
      if (onMono()) {
        // a concrete guideway on pillars, with its shadow on the sea
        laneX.forEach((x) => {
          ctx.fillStyle = 'rgba(0, 40, 80, 0.25)';
          ctx.fillRect(x - 17, 0, 40, H);
          ctx.fillStyle = '#dfe3e8';
          ctx.fillRect(x - 20, 0, 40, H);
          ctx.fillStyle = '#b3bac2';
          ctx.fillRect(x - 20, 0, 3, H);
          ctx.fillRect(x + 17, 0, 3, H);
          ctx.fillStyle = '#8f96a0';
          ctx.fillRect(x - 3, 0, 6, H);
          ctx.fillStyle = '#c4cad1';
          const jb = scrollTotal % 90;
          for (let y = -90 + jb; y < H + 90; y += 90) ctx.fillRect(x - 20, y, 40, 3);
        });
        drawStationGround();
        return;
      }
      laneX.forEach((x) => {
        // gravel bed (the tram's bed is paved into the road)
        ctx.fillStyle = ground ? '#8e949b' : bed;
        ctx.fillRect(x - 30, 0, 60, H);
        if (ground) {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
          ctx.fillRect(x - 30, 0, 2, H);
          ctx.fillRect(x + 28, 0, 2, H);
        }
        // sleepers
        ctx.fillStyle = '#7a5a3a';
        const sb = scrollTotal % 22;
        if (!ground) for (let y = -22 + sb; y < H + 22; y += 22) ctx.fillRect(x - 24, y, 48, 7);
        // rails
        ctx.fillStyle = '#8d969e';
        ctx.fillRect(x - 15, 0, 3, H);
        ctx.fillRect(x + 12, 0, 3, H);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.fillRect(x - 15, 0, 1, H);
        ctx.fillRect(x + 12, 0, 1, H);
      });

      drawBridgeDecks();
      if (ground) drawGroundStreets();
      drawStationGround();
      drawMallBuildings();
    }

    // A shopping mall beside the station: a big roof with a glass dome and its sign.
    function drawMallBuildings() {
      const st = stationInfo();
      if (!isMallName(st.name) || st.top > H || st.top + stationLength < 0) return;
      [[2, 46], [352, 46]].forEach(([x, w], side) => {
        const y = st.top - 10;
        const h = stationLength + 20;
        ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
        ctx.fillRect(x + 4, y + 4, w, h);
        ctx.fillStyle = '#d9a5e8';
        ctx.fillRect(x, y, w, h);
        ctx.strokeStyle = '#7d4a92';
        ctx.lineWidth = 2;
        ctx.strokeRect(x + 1, y + 1, w - 2, h - 2);
        // a glass dome and a car park
        ctx.fillStyle = 'rgba(190, 230, 255, 0.85)';
        ctx.beginPath();
        ctx.ellipse(x + w / 2, y + 48, 17, 32, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#9b9ea6';
        ctx.fillRect(x + 4, y + h - 62, w - 8, 52);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
        for (let i = 0; i < 3; i++) ctx.fillRect(x + 8 + i * 12, y + h - 58, 2, 44);
        // the sign
        ctx.save();
        ctx.translate(x + w / 2, y + h / 2 + 8);
        ctx.rotate(side === 0 ? -Math.PI / 2 : Math.PI / 2);
        ctx.fillStyle = '#7d4a92';
        ctx.font = 'bold 20px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('MALL \u{1F6CD}\uFE0F', 0, 0);
        ctx.restore();
      });
    }

    // Every so often the line passes something special: a station, then a
    // tunnel, then a bridge over a river. One per slot, so they never overlap.
    const slotLength = 1500;
    const metroLines = {
      red: {
        name: 'Red Line',
        nameAr: 'الخط الأحمر',
        colour: '#e21836',
        dark: '#8f0f22',
        end: { name: 'Centrepoint', ar: 'سنتر بوينت' },
        names: ['Burj Khalifa', 'Dubai Mall', 'Dubai Marina', 'Mall of the Emirates', 'Ibn Battuta Mall', 'Business Bay', 'Union', 'Emirates Towers', 'Financial Centre', 'BurJuman', 'Expo 2020', 'Al Rigga'],
        ar: ['برج خليفة', 'دبي مول', 'دبي مارينا', 'مول الإمارات', 'ابن بطوطة مول', 'الخليج التجاري', 'الاتحاد', 'أبراج الإمارات', 'المركز المالي', 'برجمان', 'إكسبو 2020', 'الرقة'],
      },
      green: {
        name: 'Green Line',
        nameAr: 'الخط الأخضر',
        colour: '#00a04a',
        dark: '#006b31',
        end: { name: 'Etisalat', ar: 'اتصالات' },
        names: ['Al Qusais', 'Al Nahda', 'City Centre Deira', 'Stadium', 'Abu Hail', 'Al Ghurair Centre', 'Salah Al Din', 'Union', 'Baniyas Square', 'Al Ras', 'BurJuman', 'Oud Metha', 'Al Jadaf', 'Creek'],
        ar: ['القصيص', 'النهدة', 'سيتي سنتر ديرة', 'الاستاد', 'أبو هيل', 'الغرير سنتر', 'صلاح الدين', 'الاتحاد', 'ساحة بني ياس', 'الراس', 'برجمان', 'عود ميثاء', 'الجداف', 'كريك'],
      },
      tram: {
        name: 'Dubai Tram',
        nameAr: 'ترام دبي',
        colour: '#f28c28',
        dark: '#a85a0e',
        end: { name: 'Palm Jumeirah', ar: 'نخلة جميرا' },
        names: ['Dubai Marina', 'Marina Towers', 'Marina Walk', 'JBR 1', 'The Walk', 'JBR 2', 'Marina Mall', 'The Beach Mall', 'Mina Seyahi', 'Media City', 'Internet City', 'Knowledge Village', 'Al Sufouh', 'Sobha Realty', 'Marina Yacht Club', 'Dubai Harbour'],
        ar: ['دبي مارينا', 'أبراج المارينا', 'مارينا ووك', 'جي بي آر 1', 'ذا ووك', 'جي بي آر 2', 'مارينا مول', 'ذا بيتش مول', 'ميناء السيهة', 'مدينة دبي للإعلام', 'مدينة دبي للإنترنت', 'القرية المعرفية', 'السفوح', 'صبّا العقارية', 'نادي مارينا لليخوت', 'ميناء دبي'],
      },
      monorail: {
        name: 'Palm Monorail',
        nameAr: 'مونوريل النخلة',
        colour: '#8e44ad',
        dark: '#5b2c6f',
        end: { name: 'Atlantis The Palm', ar: 'أتلانتس النخلة' },
        names: ['Palm Jumeirah', 'Palm Jumeirah Station'],
        ar: ['نخلة جميرا', 'محطة نخلة جميرا'],
      },
      blue: {
        name: 'Blue Line',
        nameAr: 'الخط الأزرق',
        colour: '#0a6ed1',
        dark: '#064a8f',
        end: { name: 'Academic City', ar: 'المدينة الأكاديمية' },
        names: ['Mirdif', 'Dubai Festival City Mall', 'Al Warqa', 'Dubai Hills Mall', 'International City', 'Silicon Oasis', 'Ras Al Khor', 'Creek', 'Dubai Creek Harbour', 'Business Bay', 'Al Safa', 'Al Quoz'],
        ar: ['مردف', 'دبي فستيفال سيتي مول', 'الورقاء', 'دبي هيلز مول', 'المدينة العالمية', 'واحة السيليكون', 'رأس الخور', 'كريك', 'ميناء خور دبي', 'الخليج التجاري', 'الصفا', 'القوز'],
      },
    };
    const lineOf = () => metroLines[currentLine];
    // the shopping malls: they get a big mall building beside the station
    const isMallName = (name) => /Mall|City Centre|Ghurair|Centrepoint/.test(name);
    const lineWith = (name) => Object.keys(metroLines).find((key) => key !== currentLine && metroLines[key].names.includes(name)) || null;
    // which station of the current line is station number k
    const lineIndexAt = (k) => {
      const len = lineOf().names.length;
      return (((k - lineBaseK + lineStart) % len) + len) % len;
    };
    const stationName = (k) => (k === terminusK ? lineOf().end.name : lineOf().names[lineIndexAt(k)]);
    const stationNameAr = (k) => (k === terminusK ? lineOf().end.ar : lineOf().ar[lineIndexAt(k)]);
    const targetLineAt = (k) => lineWith(stationName(k));
    // the Dubai Tram's last stop, Palm Jumeirah, is where the monorail carries on to Atlantis
const isInterchange = (k) => (k !== terminusK || currentLine === 'tram') && targetLineAt(k) !== null;
    const eventKinds = ['station', 'tunnel', 'bridge'];
    const eventLengths = { station: 300, tunnel: 440, bridge: 200 };
    // Station number k is passed when the train has travelled this far. The
    // stations come round every three slots (station, tunnel, bridge).
    const stationSpan = slotLength * 3;
    // The train stops with its middle carriage opposite the middle of the platforms.
    function stationPassAt(k) {
      return k * stationSpan + engineY + 200;
    }
    function nextStationK() {
      const first = stationPassAt(0);
      const ahead = Math.max(0, Math.ceil((scrollTotal - first - 1e-6) / stationSpan));
      return Math.max(ahead, lastStoppedK + 1);
    }

    function eventInfo() {
      const n = Math.floor(scrollTotal / slotLength);
      const kind = eventKinds[n % 3];
      const len = eventLengths[kind];
      const top = (scrollTotal % slotLength) - len; // top edge on screen
      return { n, kind, len, top, name: stationName(Math.floor(n / 3)), nameAr: stationNameAr(Math.floor(n / 3)) };
    }
    // the moment the engine reaches the thing (sign, tunnel mouth or river)
    function eventReach(ev) {
      return ev.kind === 'station' ? ev.top + 20 : ev.top + ev.len;
    }
    const stationInfo = () => {
      const ev = eventInfo();
      return { n: ev.n, top: ev.kind === 'station' ? ev.top : 9999, name: ev.name, nameAr: ev.nameAr };
    };
    const stationLength = eventLengths.station;

    function drawStationGround() {
      const st = stationInfo();
      if (st.top > H || st.top + stationLength < 0) return;
      [140, 260].forEach((cx) => {
        // platform
        ctx.fillStyle = '#c9ccd1';
        ctx.fillRect(cx - 27, st.top, 54, stationLength);
        ctx.fillStyle = '#ffd23f';
        ctx.fillRect(cx - 27, st.top, 3, stationLength);
        ctx.fillRect(cx + 24, st.top, 3, stationLength);
        // platform screen doors along both edges (the street-level tram has none)
        ctx.fillStyle = 'rgba(120, 190, 230, 0.9)';
        if (!onGround()) for (let y = st.top + 8; y < st.top + stationLength - 14; y += 22) {
          ctx.fillRect(cx - 27, y, 3, 16);
          ctx.fillRect(cx + 24, y, 3, 16);
        }
        // waiting passengers
        const colours = passengerColours;
        const emptied = st.n === boardedSlot && cx === boardedPlatformX; // they have all gone on board
        for (let i = 0; i < (emptied ? 0 : 5); i++) {
          const px = cx - 16 + ((i * 11) % 32);
          const py = st.top + 40 + i * 48 + (cx === 260 ? 18 : 0);
          ctx.beginPath();
          ctx.arc(px, py, 5, 0, Math.PI * 2);
          ctx.fillStyle = colours[(i + (cx === 260 ? 2 : 0)) % 4];
          ctx.fill();
          ctx.beginPath();
          ctx.arc(px, py - 7, 3.5, 0, Math.PI * 2);
          ctx.fillStyle = '#f2c9a0';
          ctx.fill();
        }
        if (onGround() || onMono()) {
          // a simple shelter in the line's colour
          const tx = cx - 20;
          const ty = st.top + 70;
          const th = stationLength - 140;
          ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
          ctx.fillRect(tx + 4, ty + 4, 40, th);
          ctx.fillStyle = lineOf().colour;
          roundedRect(tx, ty, 40, th, 6);
          ctx.fill();
          ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
          ctx.fillRect(tx + 6, ty + 6, 28, 4);
          ctx.fillRect(tx + 6, ty + th - 10, 28, 4);
          ctx.fillStyle = 'rgba(140, 200, 235, 0.45)';
          ctx.fillRect(tx + 14, ty + 16, 12, th - 32);
          return;
        }
        // the silver "shell" roof that Dubai Metro stations are famous for
        const rx = cx - 25;
        const ry = st.top + 28;
        const rw = 50;
        const rh = stationLength - 56;
        const shell = ctx.createLinearGradient(rx, 0, rx + rw, 0);
        shell.addColorStop(0, 'rgba(150, 160, 172, 0.82)');
        shell.addColorStop(0.35, 'rgba(245, 248, 252, 0.85)');
        shell.addColorStop(0.65, 'rgba(230, 236, 244, 0.8)');
        shell.addColorStop(1, 'rgba(140, 150, 165, 0.82)');
        roundedRect(rx, ry, rw, rh, 24);
        ctx.fillStyle = shell;
        ctx.fill();
        ctx.strokeStyle = 'rgba(80, 90, 105, 0.8)';
        ctx.lineWidth = 2;
        ctx.stroke();
        // glass strip down the middle and ribs across
        roundedRect(cx - 9, ry + 14, 18, rh - 28, 9);
        ctx.fillStyle = 'rgba(140, 200, 235, 0.45)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(90, 100, 115, 0.4)';
        ctx.lineWidth = 1;
        for (let y = ry + 30; y < ry + rh - 24; y += 20) {
          ctx.beginPath();
          ctx.moveTo(rx + 6, y);
          ctx.quadraticCurveTo(cx, y - 5, rx + rw - 6, y);
          ctx.stroke();
        }
      });
    }

    function drawStationSign() {
      const st = stationInfo();
      const y = st.top + 20;
      if (y < -40 || y > H + 20) return;
      ctx.fillStyle = '#4a4f55';
      ctx.fillRect(0, y, W, 6);
      ctx.fillRect(6, y, 6, 20);
      ctx.fillRect(W - 12, y, 6, 20);
      roundedRect(W / 2 - 105, y - 6, 210, 48, 8);
      ctx.fillStyle = lineOf().colour;
      ctx.fill();
      ctx.strokeStyle = 'white';
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      const label = (isMallName(st.name) ? '\u{1F6CD}\uFE0F ' : '\u{1F687} ') + st.name;
      let size = 18;
      ctx.font = 'bold ' + size + 'px sans-serif';
      while (size > 10 && ctx.measureText(label).width > 190) {
        size--;
        ctx.font = 'bold ' + size + 'px sans-serif';
      }
      ctx.fillText(label, W / 2, y + 10 + size / 2);
      let sizeAr = 15;
      ctx.font = 'bold ' + sizeAr + 'px sans-serif';
      while (sizeAr > 9 && ctx.measureText(st.nameAr).width > 190) {
        sizeAr--;
        ctx.font = 'bold ' + sizeAr + 'px sans-serif';
      }
      ctx.fillText(st.nameAr, W / 2, y + 36);
    }

    function drawBridgeWater() {
      const ev = eventInfo();
      if (onGround() || onMono() || ev.kind !== 'bridge' || ev.top > H || ev.top + ev.len < 0) return;
      const water = getComputedStyle(document.documentElement).getPropertyValue('--water').trim() || '#4aa3d8';
      ctx.fillStyle = '#7a5b3a';
      ctx.fillRect(0, ev.top - 6, W, ev.len + 12); // muddy banks
      ctx.fillStyle = water;
      ctx.fillRect(0, ev.top, W, ev.len);
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 9; i++) {
        const wy = ev.top + 14 + ((i * 47) % (ev.len - 28));
        const wx = (i * 83 + scrollTotal * 0.6) % (W + 40) - 20;
        ctx.beginPath();
        ctx.moveTo(wx, wy);
        ctx.quadraticCurveTo(wx + 10, wy - 5, wx + 20, wy);
        ctx.quadraticCurveTo(wx + 30, wy + 5, wx + 40, wy);
        ctx.stroke();
      }
    }

    function drawBridgeDecks() {
      const ev = eventInfo();
      if (onGround() || ev.kind !== 'bridge' || ev.top > H || ev.top + ev.len < 0) return;
      laneX.forEach((x) => {
        ctx.fillStyle = '#9a7b4f';
        ctx.fillRect(x - 34, ev.top - 8, 68, ev.len + 16);
        ctx.fillStyle = '#7a5a3a';
        const sb = scrollTotal % 22;
        ctx.save();
        ctx.beginPath();
        ctx.rect(x - 34, ev.top - 8, 68, ev.len + 16);
        ctx.clip();
        for (let y = -22 + sb; y < H + 22; y += 22) ctx.fillRect(x - 24, y, 48, 7);
        ctx.fillStyle = '#8d969e';
        ctx.fillRect(x - 15, 0, 3, H);
        ctx.fillRect(x + 12, 0, 3, H);
        ctx.restore();
        // railings
        ctx.fillStyle = '#5b4026';
        ctx.fillRect(x - 34, ev.top - 8, 3, ev.len + 16);
        ctx.fillRect(x + 31, ev.top - 8, 3, ev.len + 16);
        for (let y = ev.top; y <= ev.top + ev.len; y += 25) {
          ctx.fillRect(x - 36, y - 2, 7, 5);
          ctx.fillRect(x + 29, y - 2, 7, 5);
        }
      });
    }

    // A tunnel through a hill. The hill covers everything beside the tracks;
    // inside it is dark, with just a headlight glow around the engine.
    // A wall of red bricks, in rows that are shifted like a real brick wall.
    function drawBricks(x, y, w, h, colour) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(x, y, w, h);
      ctx.clip();
      ctx.fillStyle = colour;
      ctx.fillRect(x, y, w, h);
      const rowH = 12;
      const brickW = 26;
      ctx.strokeStyle = 'rgba(235, 215, 195, 0.55)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      for (let r = 0; r * rowH <= h; r++) {
        const ry = y + r * rowH;
        ctx.moveTo(x, ry);
        ctx.lineTo(x + w, ry);
        const shift = r % 2 ? brickW / 2 : 0;
        for (let bx = x - shift; bx < x + w; bx += brickW) {
          ctx.moveTo(bx, ry);
          ctx.lineTo(bx, ry + rowH);
        }
      }
      ctx.stroke();
      // a few darker and lighter bricks so it does not look flat
      for (let r = 0; r * rowH <= h; r++) {
        const shift = r % 2 ? brickW / 2 : 0;
        for (let c = 0; c < Math.ceil(w / brickW) + 1; c++) {
          const n = (r * 7 + c * 13) % 9;
          if (n > 2) continue;
          ctx.fillStyle = n === 0 ? 'rgba(0, 0, 0, 0.14)' : n === 1 ? 'rgba(255, 255, 255, 0.10)' : 'rgba(60, 20, 10, 0.12)';
          ctx.fillRect(x - shift + c * brickW + 1, y + r * rowH + 1, brickW - 2, rowH - 2);
        }
      }
      ctx.restore();
    }

    function drawTunnel() {
      const ev = eventInfo();
      if (onGround() || onMono() || ev.kind !== 'tunnel' || ev.top > H || ev.top + ev.len < 0) return;
      const y0 = ev.top;
      const bands = [[0, 50], [110, 170], [230, 290], [350, W]];
      bands.forEach(([x0, x1]) => drawBricks(x0, y0, x1 - x0, ev.len, '#a8543b'));
      // darkness over the three tracks, lit by the headlight
      ctx.save();
      ctx.beginPath();
      laneX.forEach((x) => ctx.rect(x - 30, y0, 60, ev.len));
      ctx.clip();
      const ex = cars[0].x;
      const grad = ctx.createRadialGradient(ex, engineY - 60, 30, ex, engineY - 60, 250);
      grad.addColorStop(0, 'rgba(0, 0, 10, 0.25)');
      grad.addColorStop(1, 'rgba(0, 0, 10, 0.78)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, y0, W, ev.len);
      ctx.restore();
      // stone mouths at both ends (the tracks pass through the gaps)
      [y0, y0 + ev.len - 22].forEach((y) => {
        bands.forEach(([x0, x1]) => {
          drawBricks(x0, y, x1 - x0, 22, '#8c4330');
          ctx.fillStyle = '#b9b2a6';
          ctx.fillRect(x0, y + 17, x1 - x0, 5);
          ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';
          ctx.fillRect(x0, y + 21, x1 - x0, 1);
        });
      });
    }

    function drawAnimal(o) {
      if (o.scared) {
        ctx.fillStyle = '#e63946';
        ctx.font = 'bold 20px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('!', o.x, o.y - o.hh - 12);
      }
      const d = o.dir;
      const swing = Math.sin(o.phase) * 3;
      ctx.save();
      ctx.translate(o.x, o.y);
      // legs peeking out at the sides
      ctx.fillStyle = '#3a2a20';
      for (let i = 0; i < 2; i++) {
        const lx = (i === 0 ? -0.5 : 0.45) * o.hw;
        ctx.fillRect(lx - 2 + swing * (i ? -1 : 1), -o.hh - 3, 4, 5);
        ctx.fillRect(lx - 2 - swing * (i ? -1 : 1), o.hh - 2, 4, 5);
      }
      if (o.animal === 'cow') {
        ctx.fillStyle = '#ffffff';
        roundedRect(-o.hw, -o.hh, o.hw * 2, o.hh * 2, 8);
        ctx.fill();
        ctx.strokeStyle = '#555a60';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.fillStyle = '#2a2a2e';
        ctx.beginPath();
        ctx.ellipse(-d * 7, -3, 6, 4, 0.4, 0, Math.PI * 2);
        ctx.ellipse(d * 2, 4, 5, 3.5, -0.3, 0, Math.PI * 2);
        ctx.fill();
        // tail
        ctx.strokeStyle = '#2a2a2e';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-d * o.hw, 0);
        ctx.lineTo(-d * (o.hw + 7), swing);
        ctx.stroke();
        // head
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(d * (o.hw + 3), 0, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#f4a6b0';
        ctx.beginPath();
        ctx.arc(d * (o.hw + 8), 0, 4.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#d9c9a0';
        ctx.fillRect(d * (o.hw + 1) - 1.5, -10, 3, 4);
        ctx.fillRect(d * (o.hw + 1) - 1.5, 6, 3, 4);
      } else {
        ctx.fillStyle = '#f3efe2';
        [[-9, -3], [0, -5], [9, -3], [-8, 4], [1, 5], [9, 4]].forEach(([bx, by]) => {
          ctx.beginPath();
          ctx.arc(bx * (o.hw / 12), by, 8, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.25)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(0, 0, o.hw - 3, 0, Math.PI * 2);
        ctx.stroke();
        ctx.fillStyle = '#3b3b40';
        ctx.beginPath();
        ctx.arc(d * (o.hw + 3), 0, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillRect(d * (o.hw + 1) - 1.5, -9, 3, 4);
        ctx.fillRect(d * (o.hw + 1) - 1.5, 5, 3, 4);
      }
      ctx.restore();
    }

    function drawRock(o) {
      const r = 18;
      ctx.beginPath();
      for (let i = 0; i < 8; i++) {
        const a = (i / 8) * Math.PI * 2;
        const rr = r * (0.82 + 0.28 * Math.abs(Math.sin(o.seed + i * 2.3)));
        const px = o.x + Math.cos(a) * rr;
        const py = o.y + Math.sin(a) * rr;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = '#6b6f76';
      ctx.fill();
      ctx.strokeStyle = '#3d4045';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(o.x - 6, o.y - 6, 6, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
      ctx.fill();
    }

    function drawBarrier(o) {
      const x0 = o.x - 28;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(x0, o.y - 8, 56, 16);
      ctx.fillStyle = '#ff8c1a';
      for (let i = 0; i < 4; i++) ctx.fillRect(x0 + i * 14 + 3, o.y - 8, 7, 16);
      ctx.strokeStyle = '#7a4a10';
      ctx.lineWidth = 2;
      ctx.strokeRect(x0, o.y - 8, 56, 16);
      ctx.fillStyle = '#4a4f55';
      ctx.fillRect(x0 - 4, o.y - 12, 6, 24);
      ctx.fillRect(x0 + 54, o.y - 12, 6, 24);
    }

    function roundedRect(x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    // A bullet train, drawn from above, nose pointing up: white and sleek,
    // with a long pointed nose and a coloured stripe.
    const whiteBody = ['#dfe6ec', '#ffffff', '#cfd8e0'];
    const blueBody = ['#1a56b0', '#3d8bf0', '#164a96'];
    const tramBody = ['#d97a12', '#ffa83d', '#c26a0c'];
    const monoBody = ['#8e44ad', '#b576d3', '#6c3483'];
    function drawEngine(stripe, outline, headlight, body) {
      body = body || whiteBody;
      ctx.beginPath();
      ctx.moveTo(-16, 25);
      ctx.lineTo(-16, -4);
      ctx.bezierCurveTo(-16, -17, -8, -25, 0, -29);
      ctx.bezierCurveTo(8, -25, 16, -17, 16, -4);
      ctx.lineTo(16, 25);
      ctx.closePath();
      const g = ctx.createLinearGradient(-16, 0, 16, 0);
      g.addColorStop(0, body[0]);
      g.addColorStop(0.5, body[1]);
      g.addColorStop(1, body[2]);
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = outline;
      ctx.lineWidth = 2;
      ctx.stroke();
      // stripe down each side
      ctx.fillStyle = stripe;
      ctx.fillRect(-15, -2, 4, 26);
      ctx.fillRect(11, -2, 4, 26);
      // windscreen
      ctx.beginPath();
      ctx.moveTo(-9, -8);
      ctx.bezierCurveTo(-9, -15, -4, -20, 0, -22);
      ctx.bezierCurveTo(4, -20, 9, -15, 9, -8);
      ctx.closePath();
      ctx.fillStyle = '#26323d';
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
      ctx.fillRect(-6, -13, 5, 2);
      // roof stripe and vents
      ctx.fillStyle = stripe;
      ctx.fillRect(-2, -3, 4, 28);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
      ctx.fillRect(-9, 8, 18, 3);
      ctx.fillRect(-9, 15, 18, 3);
      if (headlight) {
        ctx.beginPath();
        ctx.arc(0, -27, 3, 0, Math.PI * 2);
        ctx.fillStyle = '#fff3a0';
        ctx.fill();
      }
    }

    function drawCarriage(stripe, outline, body) {
      body = body || whiteBody;
      roundedRect(-16, -22, 32, 44, 7);
      const g = ctx.createLinearGradient(-16, 0, 16, 0);
      g.addColorStop(0, body[0]);
      g.addColorStop(0.5, body[1]);
      g.addColorStop(1, body[2]);
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = outline;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = stripe;
      ctx.fillRect(-15, -20, 4, 40);
      ctx.fillRect(11, -20, 4, 40);
      ctx.fillRect(-2, -20, 4, 40);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
      ctx.fillRect(-9, -12, 18, 3);
      ctx.fillRect(-9, 9, 18, 3);
    }

    function drawOncoming(o) {
      if (o.scared) {
        ctx.fillStyle = '#e63946';
        ctx.font = 'bold 22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('!', o.x, o.y - o.hh - 18);
      }
      // an oncoming train: engine facing down, with a carriage behind it
      ctx.save();
      ctx.translate(o.x, o.y + 22);
      ctx.rotate(Math.PI);
      drawEngine('#e63946', '#3b4752', true);
      ctx.restore();
      ctx.save();
      ctx.translate(o.x, o.y - 30);
      drawCarriage('#e63946', '#3b4752');
      ctx.restore();
      ctx.beginPath();
      ctx.arc(o.x, o.y + 50, 14, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 243, 160, 0.35)';
      ctx.fill();
    }

    function drawShieldPickup(c) {
      const pulse = 1 + 0.08 * Math.sin(frame * 0.12);
      const g = ctx.createRadialGradient(c.x - 4, c.y - 4, 2, c.x, c.y, c.r * pulse);
      g.addColorStop(0, 'rgba(210, 240, 255, 0.95)');
      g.addColorStop(1, 'rgba(60, 150, 255, 0.85)');
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r * pulse, 0, Math.PI * 2);
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
      // little shield badge
      ctx.beginPath();
      ctx.moveTo(c.x - 7, c.y - 7);
      ctx.lineTo(c.x + 7, c.y - 7);
      ctx.lineTo(c.x + 7, c.y + 1);
      ctx.quadraticCurveTo(c.x + 7, c.y + 8, c.x, c.y + 11);
      ctx.quadraticCurveTo(c.x - 7, c.y + 8, c.x - 7, c.y + 1);
      ctx.closePath();
      ctx.fillStyle = '#1d4e89';
      ctx.fill();
    }

    function drawShieldBubble() {
      if (shieldTime <= 0 || crashing) return;
      if (shieldTime < 120 && Math.floor(shieldTime / 6) % 2 === 0) return; // flicker when running out
      const cx = (cars[0].x + cars[cars.length - 1].x) / 2;
      const top = engineY - 30;
      const bottom = carY(cars.length - 1) + 28;
      const cy = (top + bottom) / 2;
      const rx = 34 + Math.abs(cars[0].x - cars[cars.length - 1].x) / 2;
      const ry = (bottom - top) / 2 + 4;
      const pulse = 1 + 0.03 * Math.sin(frame * 0.2);
      const g = ctx.createRadialGradient(cx, cy, ry * 0.3, cx, cy, ry * pulse);
      g.addColorStop(0, 'rgba(120, 200, 255, 0.05)');
      g.addColorStop(1, 'rgba(120, 200, 255, 0.4)');
      ctx.save();
      ctx.translate(cx, cy);
      ctx.scale(rx / ry, 1);
      ctx.beginPath();
      ctx.arc(0, 0, ry * pulse, 0, Math.PI * 2);
      ctx.restore();
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = 'rgba(190, 230, 255, 0.95)';
      ctx.lineWidth = 3;
      ctx.stroke();
    }

    function drawBoostEffects() {
      if (boostTime <= 0) return;
      // speed lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 14; i++) {
        const x = (i * 97) % W;
        const y = ((i * 131 + frame * 28) % (H + 80)) - 40;
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x, y + 36);
        ctx.stroke();
      }
      // flame out of the back
      const fx = cars[cars.length - 1].x;
      const fy = carY(cars.length - 1) + 24;
      const len = 26 + Math.random() * 14;
      ctx.fillStyle = 'rgba(255, 140, 30, 0.9)';
      ctx.beginPath();
      ctx.moveTo(fx - 9, fy);
      ctx.lineTo(fx + 9, fy);
      ctx.lineTo(fx, fy + len);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 235, 120, 0.95)';
      ctx.beginPath();
      ctx.moveTo(fx - 4, fy);
      ctx.lineTo(fx + 4, fy);
      ctx.lineTo(fx, fy + len * 0.55);
      ctx.closePath();
      ctx.fill();
    }

    // The "next station" information panel, like the screens inside the metro.
    function drawStationPanel() {
      if (!started || gameOver) return;
      const doorsOpen = dwell > 0;
      const k = doorsOpen ? doorK : nextStationK();
      const line = lineOf();
      const name = stationName(k);
      const dist = doorsOpen ? 0 : Math.max(0, stationPassAt(k) - scrollTotal);
      const arriving = !doorsOpen && dist < 1100;
      const x = 40;
      const y = H - 52;
      const w = W - 80;
      const h = 42;
      const flash = arriving && Math.floor(frame / 24) % 2 === 0;
      roundedRect(x, y, w, h, 10);
      ctx.fillStyle = doorsOpen ? 'rgba(20, 120, 70, 0.93)' : arriving ? (flash ? line.colour : line.dark) : 'rgba(16, 24, 38, 0.82)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      // red route line along the bottom: how far to the next station
      const total = stationSpan;
      const frac = doorsOpen ? Math.min(1, dwell / dwellTotal) : 1 - Math.min(1, dist / total);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
      ctx.fillRect(x + 10, y + h - 7, w - 20, 3);
      ctx.fillStyle = line.colour;
      ctx.fillRect(x + 10, y + h - 7, (w - 20) * frac, 3);
      ctx.beginPath();
      ctx.arc(x + 10 + (w - 20) * frac, y + h - 5.5, 4, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      const nameAr = stationNameAr(k);
      // small words on top: English on the left, Arabic on the right
      ctx.textAlign = 'left';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
      ctx.font = 'bold 9px sans-serif';
      ctx.fillText(doorsOpen ? 'DOORS OPEN \u2022 ' + doorSide.toUpperCase() + ' SIDE ' + (doorSide === 'left' ? '\u25C0' : '\u25B6') + ' \u2022 ' + Math.ceil(dwell / 60) + 's' : line.name.toUpperCase() + ' \u2022 ' + (arriving ? 'ARRIVING' : k === terminusK ? 'FINAL STOP' : 'NEXT') + ' \u2022 ' + Math.round(dist / 5) + ' m', x + 12, y + 13);
      ctx.textAlign = 'right';
      ctx.font = '11px sans-serif';
      ctx.fillText(doorsOpen ? (doorSide === 'right' ? 'الأبواب على الجانب الأيمن' : 'الأبواب على الجانب الأيسر') : arriving ? 'نصل الآن' : 'المحطة القادمة', x + w - 12, y + 13);
      // the station's name in English and in Arabic
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'left';
      let size = 17;
      ctx.font = 'bold ' + size + 'px sans-serif';
      while (size > 10 && ctx.measureText(name).width > w * 0.5) {
        size--;
        ctx.font = 'bold ' + size + 'px sans-serif';
      }
      ctx.fillText(name, x + 12, y + 30);
      ctx.textAlign = 'right';
      size = 17;
      ctx.font = 'bold ' + size + 'px sans-serif';
      while (size > 10 && ctx.measureText(nameAr).width > w * 0.42) {
        size--;
        ctx.font = 'bold ' + size + 'px sans-serif';
      }
      ctx.fillText(nameAr, x + w - 12, y + 30);
    }

    // The line map: every station of the line you are on, the ones you have
    // stopped at ticked, a little train showing where you are, and the
    // interchanges where you can change to the other line.
    function drawMapOverlay() {
      if (!mapOpen) return;
      const line = lineOf();
      const names = line.names.concat([line.end.name]); // the last station comes at the end
      const ars = line.ar.concat([line.end.ar]);
      const total = names.length;
      const endIdx = total - 1;
      const x0 = 30;
      const y0 = 24;
      const w = W - 60;
      const h = H - 36;
      roundedRect(x0, y0, w, h, 16);
      ctx.fillStyle = 'rgba(12, 18, 30, 0.95)';
      ctx.fill();
      ctx.strokeStyle = line.colour;
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 19px sans-serif';
      ctx.fillText(line.name.toUpperCase() + ' MAP', W / 2, y0 + 30);
      ctx.font = '14px sans-serif';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
      ctx.fillText(line.nameAr, W / 2, y0 + 50);

      const lineX = x0 + 44;
      const top = y0 + 86;
      const gap = (h - 178) / (total - 1);
      const yOf = (i) => top + i * gap;
      const nextIdx = nextStationK() === terminusK ? endIdx : lineIndexAt(nextStationK());
      // the track between the stations
      for (let i = 0; i < total - 1; i++) {
        ctx.beginPath();
        ctx.moveTo(lineX, yOf(i));
        ctx.lineTo(lineX, yOf(i + 1));
        ctx.lineWidth = 6;
        ctx.strokeStyle = ridden.includes(i) && ridden.includes(i + 1) ? line.colour : 'rgba(255, 255, 255, 0.25)';
        ctx.stroke();
      }
      // the stations
      for (let i = 0; i < total; i++) {
        const y = yOf(i);
        const passed = i === endIdx ? won : ridden.includes(i);
        const isNext = i === nextIdx;
        const otherKey = i < endIdx ? lineWith(names[i]) : null;
        const other = otherKey ? metroLines[otherKey] : null;
        const change = other !== null;
        ctx.beginPath();
        ctx.arc(lineX, y, isNext ? 11 : 9, 0, Math.PI * 2);
        ctx.fillStyle = passed ? line.colour : isNext ? '#ffffff' : 'rgba(12, 18, 30, 1)';
        ctx.fill();
        ctx.lineWidth = isNext ? 4 : 3;
        ctx.strokeStyle = passed ? '#ffffff' : isNext ? line.colour : change ? other.colour : 'rgba(255, 255, 255, 0.45)';
        ctx.stroke();
        if (passed) {
          ctx.beginPath();
          ctx.moveTo(lineX - 4, y);
          ctx.lineTo(lineX - 1, y + 3.5);
          ctx.lineTo(lineX + 5, y - 3.5);
          ctx.lineWidth = 2.2;
          ctx.strokeStyle = '#ffffff';
          ctx.stroke();
        }
        ctx.textAlign = 'left';
        ctx.fillStyle = passed ? '#ffffff' : isNext ? '#ffe066' : 'rgba(255, 255, 255, 0.6)';
        ctx.font = (isNext || passed ? 'bold ' : '') + '15px sans-serif';
        ctx.fillText(names[i], lineX + 24, y + (change ? 1 : 5));
        ctx.textAlign = 'right';
        ctx.font = '13px sans-serif';
        ctx.fillText(ars[i], x0 + w - 18, y + 5);
        if (change) {
          ctx.textAlign = 'left';
          ctx.fillStyle = other.colour;
          ctx.font = 'bold 10px sans-serif';
          ctx.fillText('\u21C4 Change for ' + other.name, lineX + 24, y + 14);
        }
        if (isNext) {
          ctx.textAlign = 'left';
          ctx.fillStyle = '#ffe066';
          ctx.font = 'bold 9px sans-serif';
          ctx.fillText(i === endIdx ? 'FINAL STOP' : 'NEXT STOP', lineX + 24, y - 10);
        } else if (i === endIdx) {
          ctx.textAlign = 'left';
          ctx.fillStyle = '#ffe066';
          ctx.font = 'bold 10px sans-serif';
          ctx.fillText('\u{1F3C1} End of the line \u2022 reach level ' + finalLevel, lineX + 24, y + 14);
        }
      }
      // where the train is right now
      const toStop = stationPassAt(nextStationK()) - scrollTotal;
      const frac = Math.min(1, Math.max(0, toStop / stationSpan));
      const P = nextStationK() === terminusK ? endIdx - frac : lineIndexAt(lastStoppedK) + 1 - frac;
      const pos = Math.min(total - 0.5, Math.max(-0.4, P));
      const ty = top + pos * gap;
      roundedRect(lineX - 17, ty - 9, 34, 18, 9);
      ctx.fillStyle = '#1f6fd6';
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = '#ffffff';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('\u{1F684}', lineX, ty + 4.5);
      // summary
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText('Stations: ' + (lastStoppedK + 1) + '  \u2022  Delivered: ' + delivered + '  \u2022  On board: ' + onboard.length, W / 2, y0 + h - 34);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
      ctx.font = '12px sans-serif';
      ctx.fillText('Tap anywhere to carry on', W / 2, y0 + h - 14);
    }

    function drawSpeedometer() {
      const cx = W - 50;
      const cy = 52;
      const r = 40;
      const a0 = Math.PI * 0.75;
      const a1 = Math.PI * 2.25;
      const frac = Math.min(1, shownMph / mphMax);
      ctx.beginPath();
      ctx.arc(cx, cy, r + 4, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
      ctx.fill();
      // dial track
      ctx.lineCap = 'round';
      ctx.lineWidth = 6;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
      ctx.beginPath();
      ctx.arc(cx, cy, r - 5, a0, a1);
      ctx.stroke();
      // coloured part: green when slow, red when really fast
      if (frac > 0.005) {
        ctx.strokeStyle = 'hsl(' + Math.round(130 - frac * 130) + ', 85%, 55%)';
        ctx.beginPath();
        ctx.arc(cx, cy, r - 5, a0, a0 + (a1 - a0) * frac);
        ctx.stroke();
      }
      ctx.lineCap = 'butt';
      // tick marks every 100 mph
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
      ctx.lineWidth = 2;
      for (let m = 0; m <= mphMax; m += 100) {
        const a = a0 + (a1 - a0) * (m / mphMax);
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(a) * (r - 14), cy + Math.sin(a) * (r - 14));
        ctx.lineTo(cx + Math.cos(a) * (r - 9), cy + Math.sin(a) * (r - 9));
        ctx.stroke();
      }
      // needle
      const na = a0 + (a1 - a0) * frac;
      ctx.strokeStyle = '#ff5a4a';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(na) * (r - 12), cy + Math.sin(na) * (r - 12));
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(cx, cy, 4, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      // numbers
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText(String(Math.round(shownMph)), cx, cy + 22);
      ctx.font = '10px sans-serif';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
      ctx.fillText('mph', cx, cy + 33);
      // kilometres per hour too, in a little label under the dial
      const kmh = Math.round(shownMph * 1.60934) + ' km/h';
      ctx.font = 'bold 12px sans-serif';
      const kw = ctx.measureText(kmh).width + 16;
      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
      roundedRect(cx - kw / 2, cy + r + 8, kw, 19, 9.5);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.fillText(kmh, cx, cy + r + 22);
    }

    function drawStorm() {
      if (rainAmt > 0.01) {
        // gloomy sky
        ctx.fillStyle = 'rgba(14, 24, 48, ' + 0.3 * rainAmt + ')';
        ctx.fillRect(0, 0, W, H);
        // rain
        ctx.strokeStyle = 'rgba(205, 225, 255, 0.55)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        const n = Math.floor(drops.length * rainAmt);
        for (let i = 0; i < n; i++) {
          const d = drops[i];
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(d.x + d.len * 0.28, d.y - d.len);
        }
        ctx.stroke();
      }
      if (flash > 0.02) {
        if (bolt && flash > 0.3) {
          ctx.lineJoin = 'round';
          ctx.strokeStyle = 'rgba(200, 220, 255, ' + flash * 0.5 + ')';
          ctx.lineWidth = 9;
          ctx.beginPath();
          bolt.forEach(([bx, by], i) => (i ? ctx.lineTo(bx, by) : ctx.moveTo(bx, by)));
          ctx.stroke();
          ctx.strokeStyle = 'rgba(255, 255, 255, ' + Math.min(1, flash * 1.2) + ')';
          ctx.lineWidth = 3;
          ctx.stroke();
        }
        ctx.fillStyle = 'rgba(235, 240, 255, ' + 0.5 * flash + ')';
        ctx.fillRect(0, 0, W, H);
      }
    }

    function drawPerson(x, y, colour, hop) {
      const lift = Math.abs(Math.sin(hop)) * 3;
      ctx.beginPath();
      ctx.arc(x, y - lift, 5, 0, Math.PI * 2);
      ctx.fillStyle = colour;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(x, y - 7 - lift, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#f2c9a0';
      ctx.fill();
    }

    function drawBoarding() {
      boarding.forEach((p) => drawPerson(p.x, p.y, p.colour, p.delay > 0 ? 0 : p.hop));
      alighting.forEach((p) => {
        if (p.delay > 0) return; // still inside the train
        ctx.globalAlpha = Math.max(0, 1 - p.fade / 22);
        drawPerson(p.x, p.y, p.colour, p.hop);
        ctx.globalAlpha = 1;
      });
    }

    function drawFloaters() {
      floaters.forEach((f) => {
        const a = 1 - f.age / (f.text && f.text.length > 4 ? 90 : 45);
        ctx.fillStyle = f.text && f.text.length > 4 ? 'rgba(255, 110, 90, ' + a + ')' : 'rgba(255, 240, 120, ' + a + ')';
        ctx.font = 'bold ' + (f.text && f.text.length > 4 ? 18 : 16) + 'px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(f.text || '+1', f.x, f.y - f.age * (f.text && f.text.length > 4 ? 0.3 : 0.6));
      });
    }

    function drawPassengerPill() {
      if (!started || gameOver) return;
      const label = '\u{1F465} ' + onboard.length + (dwell > 0 ? '   \u2B07' + offHere + ' \u2B06' + onHere : '');
      ctx.font = 'bold 14px sans-serif';
      const w = ctx.measureText(label).width + 20;
      ctx.fillStyle = 'rgba(10, 18, 28, 0.6)';
      roundedRect(10, 38, w, 24, 12);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'left';
      ctx.fillText(label, 20, 55);
    }

    function drawChances() {
      if (!started || gameOver) return;
      const label = '\u2764\uFE0F'.repeat(chances) + '\u{1F90D}'.repeat(maxChances - chances);
      ctx.font = '14px sans-serif';
      const w = ctx.measureText(label).width + 20;
      ctx.fillStyle = 'rgba(10, 18, 28, 0.6)';
      roundedRect(10, 68, w, 24, 12);
      ctx.fill();
      ctx.textAlign = 'left';
      ctx.fillStyle = '#ffffff';
      ctx.fillText(label, 20, 85);
    }

    function drawHurtGlow() {
      if (hurtTime <= 0 || crashing) return;
      const cx = (cars[0].x + cars[cars.length - 1].x) / 2;
      const top = engineY - 30;
      const bottom = carY(cars.length - 1) + 28;
      const cy = (top + bottom) / 2;
      const rx = 30 + Math.abs(cars[0].x - cars[cars.length - 1].x) / 2;
      const a = 0.35 + 0.35 * Math.abs(Math.sin(frame * 0.25));
      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, (bottom - top) / 2 + 4, 0, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255, 120, 80, ' + a + ')';
      ctx.lineWidth = 4;
      ctx.stroke();
    }

    function drawShieldHud() {
      if (shieldTime <= 0 || !started || gameOver) return;
      const w = 90;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
      roundedRect(10, 10, w + 36, 22, 11);
      ctx.fill();
      ctx.fillStyle = '#55b6ff';
      roundedRect(32, 16, Math.max(2, w * (shieldTime / shieldDuration)), 10, 5);
      ctx.fill();
      ctx.font = '14px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillStyle = 'white';
      ctx.fillText('🛡️', 14, 27);
    }

    function drawCoin(c) {
      if (c.kind === 'shield') return drawShieldPickup(c);
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd400';
      ctx.fill();
      ctx.strokeStyle = '#b8860b';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r - 4, 0, Math.PI * 2);
      ctx.strokeStyle = '#fff3b0';
      ctx.stroke();
    }

    function drawTrain() {
      const t = crashing || (gameOver && crashT > 0) ? crashT : 0;
      // carriages first, so the engine sits on top
      for (let i = cars.length - 1; i >= 0; i--) {
        const c = cars[i];
        const x = c.x + crashDir * t * i * 20;
        const y = carY(i);
        const angle = crashDir * t * (0.3 + 0.3 * i);
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(angle);
        const onTram = currentLine === 'tram';
        const onMonoLine = currentLine === 'monorail';
        const bodyCols = onMonoLine ? monoBody : onTram ? tramBody : blueBody;
        const darkCol = onMonoLine ? '#4a235a' : onTram ? '#7a4208' : '#0d2f66';
        if (i === 0) drawEngine('#ffffff', darkCol, true, bodyCols);
        else drawCarriage('#ffffff', darkCol, bodyCols);
        if (dwell > 0 && !crashing) {
          // open doors: bright green door panels on the platform side
          const sx = doorSide === 'left' ? -1 : 1;
          ctx.fillStyle = '#3ddc84';
          ctx.strokeStyle = '#146b3a';
          ctx.lineWidth = 1;
          [-9, 5].forEach((dy) => {
            ctx.fillRect(sx * 16 - 2, dy, 4, 10);
            ctx.strokeRect(sx * 16 - 2, dy, 4, 10);
          });
        }
        ctx.restore();
      }
    }

    function drawEffects() {
      puffs.forEach((p) => {
        const a = p.age / 40;
        ctx.beginPath();
        ctx.arc(p.x, p.y + p.age * 2.4, 5 + a * 12, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(245, 245, 245, ' + 0.55 * (1 - a) + ')';
        ctx.fill();
      });
      rings.forEach((r) => {
        const a = r.age / 40;
        ctx.beginPath();
        ctx.arc(r.x, r.y, 6 + a * 34, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 255, 255, ' + 0.8 * (1 - a) + ')';
        ctx.lineWidth = 3;
        ctx.stroke();
      });
    }

    // Night: everything goes dark except a glow from the headlight, with
    // little lights on the engine and carriages.
    function drawNight() {
      const ex = cars[0].x;
      const grad = ctx.createRadialGradient(ex, engineY - 90, 40, ex, engineY - 90, 330);
      grad.addColorStop(0, 'rgba(8, 12, 45, 0.15)');
      grad.addColorStop(1, 'rgba(8, 12, 45, 0.7)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, W, H);
      // headlight beam
      const beam = ctx.createLinearGradient(0, engineY - 20, 0, engineY - 190);
      beam.addColorStop(0, 'rgba(255, 244, 180, 0.35)');
      beam.addColorStop(1, 'rgba(255, 244, 180, 0)');
      ctx.fillStyle = beam;
      ctx.beginPath();
      ctx.moveTo(ex - 8, engineY - 22);
      ctx.lineTo(ex + 8, engineY - 22);
      ctx.lineTo(ex + 34, engineY - 190);
      ctx.lineTo(ex - 34, engineY - 190);
      ctx.closePath();
      ctx.fill();
      // little yellow window lights on the carriages
      ctx.fillStyle = 'rgba(255, 230, 120, 0.9)';
      for (let i = 1; i < cars.length; i++) {
        const cx = cars[i].x;
        const cy = carY(i);
        ctx.fillRect(cx - 7, cy - 10, 5, 5);
        ctx.fillRect(cx + 2, cy - 10, 5, 5);
        ctx.fillRect(cx - 7, cy + 3, 5, 5);
        ctx.fillRect(cx + 2, cy + 3, 5, 5);
      }
    }

    // A shiny gold trophy cup with the level number on it.
    function drawTrophy(cx, cy, size, label, shine) {
      const g = ctx.createLinearGradient(cx - size * 0.5, 0, cx + size * 0.5, 0);
      g.addColorStop(0, '#c99a1e');
      g.addColorStop(0.45, '#ffe066');
      g.addColorStop(1, '#b8860b');
      ctx.save();
      ctx.strokeStyle = '#d9a920';
      ctx.lineWidth = size * 0.09;
      [-1, 1].forEach((side) => {
        ctx.beginPath();
        ctx.arc(cx + side * size * 0.52, cy - size * 0.22, size * 0.2, side > 0 ? -Math.PI / 2 : Math.PI / 2, side > 0 ? Math.PI / 2 : Math.PI * 1.5, false);
        ctx.stroke();
      });
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.moveTo(cx - size * 0.5, cy - size * 0.5);
      ctx.lineTo(cx + size * 0.5, cy - size * 0.5);
      ctx.bezierCurveTo(cx + size * 0.5, cy + size * 0.05, cx + size * 0.25, cy + size * 0.3, cx, cy + size * 0.3);
      ctx.bezierCurveTo(cx - size * 0.25, cy + size * 0.3, cx - size * 0.5, cy + size * 0.05, cx - size * 0.5, cy - size * 0.5);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#8a6508';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillRect(cx - size * 0.09, cy + size * 0.28, size * 0.18, size * 0.28);
      ctx.fillStyle = '#b8860b';
      ctx.fillRect(cx - size * 0.4, cy + size * 0.54, size * 0.8, size * 0.14);
      ctx.fillStyle = '#6b4a06';
      ctx.fillRect(cx - size * 0.3, cy + size * 0.68, size * 0.6, size * 0.1);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.fillRect(cx - size * 0.38, cy - size * 0.42, size * 0.1, size * 0.4);
      if (label !== undefined) {
        ctx.fillStyle = '#6b4a06';
        ctx.textAlign = 'center';
        ctx.font = 'bold ' + Math.round(size * 0.42) + 'px sans-serif';
        ctx.fillText(String(label), cx, cy - size * 0.1);
      }
      if (shine) {
        // twinkling stars around it
        ctx.fillStyle = '#fff6b0';
        for (let i = 0; i < 5; i++) {
          const a = frame * 0.05 + i * 1.26;
          const sx = cx + Math.cos(a) * size * 0.85;
          const sy = cy - size * 0.1 + Math.sin(a * 1.3) * size * 0.7;
          const r = 2 + 2 * Math.abs(Math.sin(frame * 0.12 + i));
          ctx.beginPath();
          ctx.moveTo(sx, sy - r * 2);
          ctx.lineTo(sx + r * 0.6, sy - r * 0.6);
          ctx.lineTo(sx + r * 2, sy);
          ctx.lineTo(sx + r * 0.6, sy + r * 0.6);
          ctx.lineTo(sx, sy + r * 2);
          ctx.lineTo(sx - r * 0.6, sy + r * 0.6);
          ctx.lineTo(sx - r * 2, sy);
          ctx.lineTo(sx - r * 0.6, sy - r * 0.6);
          ctx.closePath();
          ctx.fill();
        }
      }
      ctx.restore();
    }

    // A medal on a ribbon: red or green for the lines, gold with a star for Metro Master.
    function drawMedal(cx, cy, r, kind, earned, shine) {
      const colour = kind === 'green' ? '#00a04a' : kind === 'blue' ? '#0a6ed1' : kind === 'tram' ? '#f28c28' : kind === 'monorail' ? '#8e44ad' : kind === 'master' ? '#2a2a3a' : '#e21836';
      const ribbon = kind === 'green' ? '#007a38' : kind === 'blue' ? '#064a8f' : kind === 'tram' ? '#a85a0e' : kind === 'monorail' ? '#5b2c6f' : kind === 'master' ? '#c99a1e' : '#a8112a';
      ctx.save();
      if (!earned) ctx.globalAlpha = 0.3;
      // ribbon
      ctx.fillStyle = ribbon;
      [-1, 1].forEach((side) => {
        ctx.beginPath();
        ctx.moveTo(cx + side * r * 0.95, cy - r * 1.9);
        ctx.lineTo(cx + side * r * 0.35, cy - r * 1.9);
        ctx.lineTo(cx - side * r * 0.2, cy - r * 0.3);
        ctx.lineTo(cx + side * r * 0.4, cy - r * 0.3);
        ctx.closePath();
        ctx.fill();
      });
      // the medal itself
      const rim = ctx.createLinearGradient(cx - r, cy - r, cx + r, cy + r);
      rim.addColorStop(0, '#ffe066');
      rim.addColorStop(0.5, '#e0a81a');
      rim.addColorStop(1, '#fff0a0');
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = rim;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(cx, cy, r * 0.74, 0, Math.PI * 2);
      ctx.fillStyle = colour;
      ctx.fill();
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.textAlign = 'center';
      if (kind === 'master') {
        ctx.fillStyle = '#ffe066';
        ctx.font = 'bold ' + Math.round(r * 1.1) + 'px sans-serif';
        ctx.fillText('\u2605', cx, cy + r * 0.38);
      } else {
        ctx.font = Math.round(r * 0.95) + 'px sans-serif';
        ctx.fillText('\u{1F684}', cx, cy + r * 0.33);
      }
      ctx.restore();
      if (shine && earned) {
        ctx.fillStyle = '#fff6b0';
        for (let i = 0; i < 4; i++) {
          const a = frame * 0.05 + i * 1.6;
          const sx = cx + Math.cos(a) * r * 1.5;
          const sy = cy - r * 0.2 + Math.sin(a * 1.3) * r * 1.2;
          const q = 2 + 2 * Math.abs(Math.sin(frame * 0.12 + i));
          ctx.beginPath();
          ctx.moveTo(sx, sy - q * 2);
          ctx.lineTo(sx + q * 0.6, sy - q * 0.6);
          ctx.lineTo(sx + q * 2, sy);
          ctx.lineTo(sx + q * 0.6, sy + q * 0.6);
          ctx.lineTo(sx, sy + q * 2);
          ctx.lineTo(sx - q * 0.6, sy + q * 0.6);
          ctx.lineTo(sx - q * 2, sy);
          ctx.lineTo(sx - q * 0.6, sy - q * 0.6);
          ctx.closePath();
          ctx.fill();
        }
      }
    }

    function drawOverlay(title, subtitle) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      ctx.font = 'bold 30px sans-serif';
      ctx.fillText(title, W / 2, H / 2 - 16);
      ctx.font = '18px sans-serif';
      ctx.fillText(subtitle, W / 2, H / 2 + 20);
    }

    function draw() {
      if (walkMode) {
        drawWalk();
        return;
      }
      ctx.clearRect(0, 0, W, H);
      drawScenery();

      coins.forEach(drawCoin);
      obstacles.forEach((o) => {
        if (o.kind === 'rock') drawRock(o);
        else if (o.kind === 'barrier') drawBarrier(o);
        else if (o.kind === 'train') drawOncoming(o);
      });
      drawBoarding();
      drawTrain();
      drawHurtGlow();
      drawFloaters();
      drawShieldBubble();
      drawBoostEffects();
      drawTunnel();
      obstacles.forEach((o) => {
        if (o.kind === 'animal') drawAnimal(o);
      });
      drawStationSign();
      drawEffects();

      if (night) drawNight();
      drawStorm();
      drawShieldHud();
      drawPassengerPill();
      drawChances();
      drawSpeedometer();
      drawStationPanel();
      if (started && !gameOver && dwell > 0 && !changedHere && isInterchange(lastStoppedK)) {
        // a hint that you can change line here
        const o = metroLines[targetLineAt(lastStoppedK)];
        const text = '\u{1F501} Change here for the ' + o.name + '!';
        ctx.font = 'bold 15px sans-serif';
        const tw = ctx.measureText(text).width + 24;
        roundedRect(W / 2 - tw / 2, 120, tw, 30, 15);
        ctx.fillStyle = o.colour;
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.fillText(text, W / 2, 140);
      }

      if (levelFlash > 0 && started && !gameOver) {
        const alpha = Math.min(1, levelFlash / 20);
        ctx.fillStyle = 'rgba(255, 235, 90, ' + alpha + ')';
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Level ' + level + '!' + (level === stormLevel ? ' \u26C8\uFE0F Storm!' : ''), W / 2, 70);
      }

      if (calmFlash > 0 && started && !gameOver) {
        const alpha = Math.min(1, calmFlash / 25);
        ctx.fillStyle = 'rgba(190, 255, 200, ' + alpha + ')';
        ctx.font = 'bold 22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F308} Clear track ahead!', W / 2, 185);
      }
      if (quietT > 0 && started && !gameOver) {
        ctx.fillStyle = 'rgba(190, 255, 235, 0.95)';
        ctx.font = 'bold 15px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F54A}\uFE0F Calm minute \u2022 ' + Math.ceil(quietT / 60) + 's', W / 2, 205);
      }

      // the last station is coming
      if (finalFlash > 0 && started && !gameOver) {
        const alpha = Math.min(1, finalFlash / 25);
        ctx.fillStyle = 'rgba(255, 255, 255, ' + alpha + ')';
        ctx.font = 'bold 22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F3C1} Last stop: ' + lineOf().end.name, W / 2, 150);
      }

      // banner when you beat your record level in the middle of a journey
      if (recordFlash > 0 && started && !gameOver) {
        const alpha = Math.min(1, recordFlash / 25);
        ctx.fillStyle = 'rgba(255, 224, 102, ' + alpha + ')';
        ctx.font = 'bold 26px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F3C6} New record!', W / 2, 108);
      }

      if (!started) {
        drawOverlay('Tap to start', 'Tap left, middle or right to switch tracks!');
        if (bestLevel > 0) {
          drawTrophy(W / 2, 170, 44, bestLevel, false);
          ctx.fillStyle = '#ffe066';
          ctx.font = 'bold 15px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Your best level', W / 2, 242);
        }
        // the medals you have won so far (faded when not yet won)
        const have = [medals.red > 0, medals.green > 0, medals.blue > 0, medals.tram > 0, medals.monorail > 0, medals.red > 0 && medals.green > 0 && medals.blue > 0 && medals.tram > 0];
        ['red', 'green', 'blue', 'tram', 'monorail', 'master'].forEach((kind, i) => {
          const mx = W / 2 - 125 + i * 50;
          drawMedal(mx, 66, 15, kind, have[i], false);
          ctx.fillStyle = have[i] ? '#ffe066' : 'rgba(255, 255, 255, 0.45)';
          ctx.font = '10px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(kind === 'master' ? 'Master' : kind === 'red' ? 'Red' : kind === 'green' ? 'Green' : kind === 'blue' ? 'Blue' : kind === 'monorail' ? 'Mono' : 'Tram', mx, 92);
        });
      } else if (gameOver) {
        drawOverlay(won ? 'Journey complete! \u{1F389}' : 'Derailed!', (won ? 'Tap to play again \u2022 Score: ' : 'Tap to try again • Score: ') + score);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.font = '15px sans-serif';
        ctx.fillText('Stations: ' + (lastStoppedK + 1) + '  \u2022  Passengers delivered: ' + delivered, W / 2, H / 2 + 50);
        if (won) {
          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 16px sans-serif';
          ctx.fillText('\u{1F3C1} You reached ' + lineOf().end.name + '!', W / 2, H / 2 + 78);
        }
        const record = recordThisRun && level >= 2;
        if (won) {
          // the trophy on the left, the medal for this line on the right
          drawTrophy(W / 2 - 62, 165, 42, bestLevel, record);
          drawMedal(W / 2 + 62, 178, 30, currentLine, true, newMedals.length > 0);
          if (newMedals.includes('master')) drawMedal(W / 2 + 120, 190, 20, 'master', true, true);
          ctx.fillStyle = '#ffe066';
          ctx.font = 'bold 15px sans-serif';
          ctx.textAlign = 'center';
          const nm = newMedals.length ? '\u{1F396}\uFE0F New medal: ' + (newMedals.includes('master') ? lineOf().name + ' + Metro Master!' : lineOf().name + '!') : '\u{1F396}\uFE0F ' + lineOf().name + ' medal \u00D7' + medals[currentLine];
          ctx.fillText(nm, W / 2, H / 2 + 106);
        } else {
          drawTrophy(W / 2, 165, 46, bestLevel, record);
        }
        ctx.fillStyle = record ? '#fff6b0' : '#ffe066';
        ctx.font = 'bold 16px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(won ? (record ? '\u{1F3C6} New record! Level ' + level : 'Level ' + level + ' \u2022 best ' + bestLevel) : record ? '\u{1F3C6} New record! Level ' + level : 'Best level: ' + bestLevel + ' (you reached ' + level + ')', W / 2, 245);
      }

      drawMapOverlay();
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function boot(data) {
      if (data) {
        const n = Math.max(data.bestNormal || 0, data.best || 0);
        if (n > bestNormal) bestNormal = n;
        if ((data.bestEasy || 0) > bestEasy) bestEasy = data.bestEasy;
        if ((data.bestLevelNormal || 0) > bestLevelNormal) bestLevelNormal = data.bestLevelNormal;
        if ((data.bestLevelEasy || 0) > bestLevelEasy) bestLevelEasy = data.bestLevelEasy;
        if ((data.medals && data.medals.red || 0) > medals.red) medals.red = data.medals.red;
        if ((data.medals && data.medals.green || 0) > medals.green) medals.green = data.medals.green;
        if ((data.medals && data.medals.blue || 0) > medals.blue) medals.blue = data.medals.blue;
        if ((data.medals && data.medals.tram || 0) > medals.tram) medals.tram = data.medals.tram;
        if ((data.medals && data.medals.monorail || 0) > medals.monorail) medals.monorail = data.medals.monorail;
        saveMedals();
        updateMedalsEl();
        applyMode();
      }
      draw();
      loop();
    }

    if (window.claude && window.claude.hot && window.claude.hot.snapshot) {
      window.claude.hot.snapshot(() => ({ bestNormal, bestEasy, bestLevelNormal, bestLevelEasy, medals }));
    }

    if (window.claude && window.claude.hot && window.claude.hot.ready) {
      window.claude.hot.ready(boot);
    } else {
      boot(window.claude && window.claude.hot ? window.claude.hot.data : null);
    }
  })();
</script>
  </body>
</html>
