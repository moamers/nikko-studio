<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Train Dodge</title>
  </head>
  <body>
<style is:global>
  :root {
    --bg: #f6fdff;
    --card: #ffffff;
    --ink: #1a2a33;
    --ink-soft: #4a6572;
    --land: #a9b0b7;
    --city-dim: 0;
    --bed: #b8a88a;
    --water: #4aa3d8;
    --accent: #e4572e;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0f1b22;
      --card: #16262f;
      --ink: #eaf4f8;
      --ink-soft: #9fb6c0;
      --land: #3b434b;
      --city-dim: 0.38;
      --bed: #7d7360;
      --water: #2a6a99;
      --accent: #ff8a6a;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0f1b22;
    --card: #16262f;
    --ink: #eaf4f8;
    --ink-soft: #9fb6c0;
    --land: #3b434b;
    --city-dim: 0.38;
    --bed: #7d7360;
    --water: #2a6a99;
    --accent: #ff8a6a;
    color-scheme: dark;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .wrap {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 24px;
  }

  h1 {
    font-size: clamp(22px, 6vw, 30px);
    margin: 0;
    text-align: center;
  }

  .sub {
    color: var(--ink-soft);
    margin: 0;
    text-align: center;
    font-size: 14px;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    max-height: 70vh;
    background: var(--card);
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background: var(--land);
    touch-action: none;
  }

  .score {
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .level {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .controls button {
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    background: var(--card);
    border: 2px solid var(--ink-soft);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
  }

  .controls button:disabled {
    opacity: 0.55;
    cursor: default;
  }

  /* the change-line button grows big and bright whenever you can change line */
  #lineBtn:not(:disabled) {
    border-color: #00a04a;
    color: #00a04a;
    font-weight: 700;
  }

  #lineBtn.big:not(:disabled) {
    order: -1;
    flex: 1 1 100%;
    font-size: 24px;
    font-weight: 800;
    padding: 18px 20px;
    border-color: #00793a;
    background: #00a04a;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 160, 74, 0.45);
    animation: lineBtnPulse 1.1s ease-in-out infinite;
  }

  @keyframes lineBtnPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
  }

  @media (prefers-reduced-motion: reduce) {
    #lineBtn.big:not(:disabled) { animation: none; }
  }

  #quietBtn:not(:disabled) {
    border-color: #2a9d8f;
    color: #2a9d8f;
  }

  #quietBtn[aria-pressed="true"] {
    background: #2a9d8f;
    border-color: #2a9d8f;
    color: #ffffff;
  }

  #boostBtn:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .controls button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .controls button:active {
    transform: scale(0.96);
  }

  .best {
    font-size: 13px;
    color: var(--ink-soft);
  }
</style>

<div class="wrap">
  <h1>&#128644; Train Dodge</h1>
  <p class="sub">Tap the left, middle or right side to switch tracks. You have two chances ❤️❤️ before the train derails. Dodge the rocks, barriers, oncoming trains and wandering cows, grab the gold and shields, and press Boost to zoom! Stop at the stations: passengers get off at their stop and new ones hop on. At Union, BurJuman, Business Bay or Creek get off the train and walk through the city to the tunnels at the end: there is one to every line (Red, Green, Blue, Tram and Monorail), so you pick where to go. At any station you can press "Get off & walk" if you like. At Dubai Marina the walk goes down the road to the Dubai Tram, and at the end of the tram, Palm Jumeirah, hop on the Palm Monorail to Atlantis. Reach level 20 to finish the journey. From level 9 to level 20 there are no obstacles at all!</p>
  <p class="score" id="score">Score: 0</p>
  <p class="level" id="level">Level 1</p>
  <p class="best" id="best">Best: 0</p>
  <p class="best" id="trophy">&#127942; Best level: 0</p>
  <p class="best" id="medals">&#127894;&#65039; Medals: none yet</p>
  <div class="stage">
    <canvas id="game" width="400" height="600" aria-label="Train dodge game"></canvas>
  </div>
  <div class="controls">
    <button type="button" id="easyBtn">&#128034; Easy</button>
    <button type="button" id="normalBtn">&#127918; Normal</button>
    <button type="button" id="whistleBtn">&#128226; Horn</button>
    <button type="button" id="boostBtn">&#128640; Boost</button>
    <button type="button" id="lineBtn" disabled>&#128257; Change line</button>
    <button type="button" id="quietBtn" disabled>&#128330;&#65039; Calm minute</button>
    <button type="button" id="mapBtn">&#128506;&#65039; Map</button>
    <button type="button" id="nightBtn">&#127769; Night</button>
    <button type="button" id="soundBtn">&#128266; Sound on</button>
  </div>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const levelEl = document.getElementById('level');
    const bestEl = document.getElementById('best');
    const trophyEl = document.getElementById('trophy');
    const medalsEl = document.getElementById('medals');

    const W = canvas.width;
    const H = canvas.height;
    const pointsPerLevel = 5;

    const laneX = [80, 200, 320];

    // The train's spot on screen never changes by itself: only its sideways
    // position follows the track you pick. The wreck animation is drawn as an
    // offset on top, so a restart always puts everything back.
    const engineY = H - 190;
    const carSpacing = 52;
    const cars = [
      { x: laneX[1], hw: 15, hh: 25, kind: 'engine' },
      { x: laneX[1], hw: 14, hh: 22, kind: 'car' },
      { x: laneX[1], hw: 14, hh: 22, kind: 'car' },
    ];
    const carY = (i) => engineY + i * carSpacing;

    let lane = 1;
    let obstacles = [];
    let coins = [];
    let puffs = []; // chimney smoke
    let rings = []; // dust rings when something happens
    let score = 0;
    let level = 1;
    let levelFlash = 0;
    let best = 0; // best score for the mode you are playing
    let bestNormal = 0;
    let bestEasy = 0;
    // the trophy: the highest level you have ever reached (one per mode)
    let bestLevel = 0;
    let bestLevelNormal = 0;
    let bestLevelEasy = 0;
    // Medals: one for finishing each line (reaching its last station), and a
    // gold Metro Master medal once you have finished both.
    let medals = { red: 0, green: 0, blue: 0, tram: 0, monorail: 0 }; // how many times you have finished each line
    let newMedals = []; // the medals won on this journey
    let levelAtStart = 0; // the record when this journey began
    let recordThisRun = false;
    let recordFlash = 0;
    let easy = false; // easy mode: a calmer, slower game
    let started = false;
    let gameOver = false;
    let coinSpawnIn = 90;
    let boostTime = 0; // frames of boost left
    let boostCool = 0; // frames until the boost is ready again
    const boostDuration = 120; // 2 seconds
    let boostCooldown = 420; // 7 seconds (shorter in easy mode)
    const boostSpeed = 1.6;
    let shieldTime = 0; // frames of shield left
    let shieldSpawnIn = 1100;
    let shieldDuration = 720; // about 12 seconds (longer in easy mode)
    let lastSpawnY = 0;
    let scrollTotal = 0;
    let smokeIn = 0;
    let frame = 0;
    let shownMph = 0; // the speedometer needle eases toward the real speed
    const mphPerUnit = 20; // game speed -> miles per hour
    const mphMax = 400;

    // Storm: from level 5 it rains, and now and then lightning strikes.
    const stormLevel = 5;
    let rainAmt = 0; // 0 = dry, 1 = full storm (fades in and out)
    let lightningIn = 200;
    let flash = 0;
    let flashAgain = 0; // frames until the second flicker of a strike
    let bolt = null;
    let rainSoundIn = 0;
    const drops = [];
    for (let i = 0; i < 110; i++) {
      drops.push({ x: Math.random() * (W + 40), y: Math.random() * H, len: 10 + Math.random() * 14, v: 15 + Math.random() * 9 });
    }
    let lastTime = null;

    // Wreck animation: the carriages swing out sideways and the train tips,
    // staying fully on screen.
    let crashing = false;
    let crashTimer = 0;
    const crashDuration = 60;
    let crashDir = 1;
    let crashT = 0;

    try {
      bestNormal = Number(localStorage.getItem('trainDodgeBest') || 0);
      bestEasy = Number(localStorage.getItem('trainDodgeBestEasy') || 0);
      bestLevelNormal = Number(localStorage.getItem('trainBestLevel') || 0);
      bestLevelEasy = Number(localStorage.getItem('trainBestLevelEasy') || 0);
      const savedMedals = JSON.parse(localStorage.getItem('trainMedals') || '{}');
      medals.red = Number(savedMedals.red) || 0;
      medals.green = Number(savedMedals.green) || 0;
      medals.blue = Number(savedMedals.blue) || 0;
      medals.tram = Number(savedMedals.tram) || 0;
      medals.monorail = Number(savedMedals.monorail) || 0;
      easy = localStorage.getItem('trainEasy') === '1';
    } catch (e) {}
    best = easy ? bestEasy : bestNormal;
    bestEl.textContent = 'Best: ' + best;

    // ---------- sound (made with Web Audio, no files needed) ----------
    let audio = null;
    let noiseBuf = null;
    let soundOn = true;
    let chuffIn = 0;
    let chuffFlip = false;
    let whistledSlot = -1;
    let doorSide = 'right'; // which side the doors open on
    let doorK = 0; // which station the open doors belong to
    // passengers: the ones waiting on the platform hop on while the train stands
    let passengers = 0; // how many you have carried so far
    let boarding = []; // passengers walking to the train right now
    let onboard = []; // the passengers on the train, each with the station they are going to
    let alighting = []; // passengers getting off right now
    let delivered = 0; // passengers who reached their stop
    let offHere = 0; // how many are getting off at this station
    let onHere = 0; // how many are getting on at this station
    let floaters = []; // little "+1" signs
    let boardedSlot = -1; // which station's platform has been emptied...
    let boardedPlatformX = -1; // ...and which of its two platforms
    const passengerColours = ['#2b7bd6', '#e8a33d', '#8e44ad', '#2a9d8f'];
    // Metro lines: you can change between the Red and Green lines at an interchange station.
    // The journey ends at the last station of the line when you reach level 20.
    const finalLevel = 20;
    let terminusK = -1; // the station number of the last station, once it is scheduled
    let won = false;
    let finalFlash = 0;
    let currentLine = 'red';
    let lineBaseK = 0; // from this station number on, the current line's list starts at lineStart
    let lineStart = 0;
    let ridden = []; // the stations (positions on the current line) you have stopped at
    let changedHere = false; // you have already changed line at this stop
    // Two chances: the first two bumps do not derail the train, the third does.
    const maxChances = 2;
    let chances = maxChances;
    let hurtTime = 0; // after a bump the train cannot be hit again for a moment
    let mapOpen = false; // the metro line map; the game waits while it is open
    let lastStoppedK = -1; // the last station the train has stopped at
    let dwell = 0; // frames left standing at a station (doors open)
    let departT = 0; // frames of pulling away after a station
    let doorsClosingSaid = false;
    let curSpeed = 0; // how fast the train is really going right now
    const dwellFrames = 300; // at least 5 seconds at each station
    let dwellTotal = dwellFrames; // how long this stop lasts (longer when many passengers swap)
    const brakeDist = 650; // how far before the station the train starts slowing down
    let nextAnnouncedK = -1; // the next station we have already announced
    let arrivingAnnouncedK = -1; // the station we have already said we are arriving at
    const whistleBtn = document.getElementById('whistleBtn');
    const soundBtn = document.getElementById('soundBtn');
    const mapBtn = document.getElementById('mapBtn');
    const lineBtn = document.getElementById('lineBtn');
    const quietBtn = document.getElementById('quietBtn');

    function getAudio() {
      if (audio) return audio;
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        audio = new AC();
        noiseBuf = audio.createBuffer(1, audio.sampleRate * 0.5, audio.sampleRate);
        const d = noiseBuf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      } catch (e) {
        audio = null;
      }
      return audio;
    }

    function unlockAudio() {
      try {
        const a = getAudio();
        if (a && a.state === 'suspended') a.resume();
      } catch (e) {}
    }

    function noiseBurst(freq, dur, vol, type) {
      try {
        const a = getAudio();
        if (!a || !soundOn) return;
        const src = a.createBufferSource();
        src.buffer = noiseBuf;
        const f = a.createBiquadFilter();
        f.type = type || 'bandpass';
        f.frequency.value = freq;
        const g = a.createGain();
        const t = a.currentTime;
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + dur);
        src.connect(f);
        f.connect(g);
        g.connect(a.destination);
        src.start(t);
        src.stop(t + dur + 0.02);
      } catch (e) {}
    }

    function tone(type, f0, f1, dur, vol, delay, lowpass) {
      try {
        const a = getAudio();
        if (!a || !soundOn) return;
        const o = a.createOscillator();
        const g = a.createGain();
        const t = a.currentTime + (delay || 0);
        o.type = type;
        o.frequency.setValueAtTime(f0, t);
        o.frequency.linearRampToValueAtTime(f1, t + dur);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(vol, t + 0.04);
        g.gain.setValueAtTime(vol, t + dur * 0.7);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        if (lowpass) {
          const f = a.createBiquadFilter();
          f.type = 'lowpass';
          f.frequency.value = lowpass;
          o.connect(f);
          f.connect(g);
        } else {
          o.connect(g);
        }
        g.connect(a.destination);
        o.start(t);
        o.stop(t + dur + 0.05);
      } catch (e) {}
    }

    // Bullet-train sounds: a smooth electric hum and rushing wind that rise
    // with speed, quick clack-clacks over the rail joints, and a bright horn.
    let hum = null;
    let humIn = 0;
    function ensureHum() {
      try {
        const a = getAudio();
        if (!a || hum) return;
        const o = a.createOscillator();
        o.type = 'sawtooth';
        const f = a.createBiquadFilter();
        f.type = 'lowpass';
        f.frequency.value = 300;
        const g = a.createGain();
        g.gain.value = 0;
        o.connect(f);
        f.connect(g);
        g.connect(a.destination);
        o.start();
        const n = a.createBufferSource();
        n.buffer = noiseBuf;
        n.loop = true;
        const nf = a.createBiquadFilter();
        nf.type = 'bandpass';
        nf.frequency.value = 800;
        nf.Q.value = 0.6;
        const ng = a.createGain();
        ng.gain.value = 0;
        n.connect(nf);
        nf.connect(ng);
        ng.connect(a.destination);
        n.start();
        hum = { o, f, g, nf, ng };
      } catch (e) {
        hum = null;
      }
    }

    let rainSnd = null;
    function updateRainSound() {
      try {
        if (rainAmt < 0.02 || !soundOn) {
          if (rainSnd) rainSnd.g.gain.setTargetAtTime(0, audio.currentTime, 0.2);
          return;
        }
        const a = getAudio();
        if (!a) return;
        if (!rainSnd) {
          const n = a.createBufferSource();
          n.buffer = noiseBuf;
          n.loop = true;
          const f = a.createBiquadFilter();
          f.type = 'highpass';
          f.frequency.value = 2500;
          const g = a.createGain();
          g.gain.value = 0;
          n.connect(f);
          f.connect(g);
          g.connect(a.destination);
          n.start();
          rainSnd = { g };
        }
        rainSnd.g.gain.setTargetAtTime(0.035 * rainAmt, a.currentTime, 0.2);
      } catch (e) {}
    }

    function strikeLightning() {
      flash = 1;
      flashAgain = 7;
      // a jagged bolt from the sky down to the ground
      const pts = [];
      let x = 40 + Math.random() * (W - 80);
      let y = 0;
      const bottom = 180 + Math.random() * 260;
      while (y < bottom) {
        pts.push([x, y]);
        x += (Math.random() - 0.5) * 50;
        y += 22 + Math.random() * 26;
      }
      bolt = pts;
      // thunder arrives a moment later
      setTimeout(() => {
        noiseBurst(140, 1.3, 0.4, 'lowpass');
        noiseBurst(70, 1.6, 0.35, 'lowpass');
      }, 250 + Math.random() * 600);
    }

    function updateHum(on, speed) {
      try {
        if (!on || !soundOn) {
          if (hum) {
            const t0 = audio.currentTime;
            hum.g.gain.setTargetAtTime(0, t0, 0.08);
            hum.ng.gain.setTargetAtTime(0, t0, 0.08);
          }
          return;
        }
        ensureHum();
        if (!hum) return;
        const t = audio.currentTime;
        hum.o.frequency.setTargetAtTime(60 + speed * 12, t, 0.15);
        hum.f.frequency.setTargetAtTime(240 + speed * 45, t, 0.15);
        hum.g.gain.setTargetAtTime(0.03, t, 0.15);
        hum.nf.frequency.setTargetAtTime(500 + speed * 110, t, 0.15);
        hum.ng.gain.setTargetAtTime(0.012 + speed * 0.004, t, 0.15);
      } catch (e) {}
    }

    function playClack() {
      chuffFlip = !chuffFlip;
      noiseBurst(chuffFlip ? 2600 : 2100, 0.04, 0.1);
      noiseBurst(260, 0.06, 0.09, 'lowpass');
    }

    // Honk at an oncoming train that is heading for you and it politely slides
    // over to another track (never onto yours).
    function moveOncomingTrain(o) {
      if (o.slideTo !== undefined) return;
      const ahead = engineY - (o.y + o.hh);
      if (ahead < -20 || ahead > 380) return;
      const mine = laneX[lane];
      if (Math.abs(o.x - mine) > 50 && Math.abs(o.x - cars[0].x) > 50) return; // not coming for us
      const options = [0, 1, 2].filter((l) => laneX[l] !== mine && Math.abs(laneX[l] - o.x) > 10);
      if (!options.length) return;
      const clear = (l) => !obstacles.some((q) => q !== o && Math.abs(q.x - laneX[l]) < 40 && Math.abs(q.y - o.y) < 140);
      const pick = options.find(clear) || options[0];
      o.slideTo = laneX[pick];
      o.lane = pick;
      o.scared = true;
      rings.push({ x: o.x, y: o.y + o.hh, age: 18 });
    }

    // Honk! Any animal ahead of the train (and close) gets a fright and runs
    // away sideways, fast.
    function scareAnimals() {
      obstacles.forEach((o) => {
        if (o.kind === 'train') {
          moveOncomingTrain(o);
          return;
        }
        if (o.kind !== 'animal' || o.scared) return;
        const ahead = engineY - o.y; // how far in front of the engine
        if (ahead < -40 || ahead > 280) return;
        o.scared = true;
        o.dir = o.x < cars[0].x ? -1 : o.x > cars[0].x ? 1 : Math.random() < 0.5 ? -1 : 1;
        o.vx = o.dir * 6.5;
        rings.push({ x: o.x, y: o.y, age: 18 });
      });
    }

    // A bright two-note electric horn: pwaaa!
    function playWhistle(short) {
      scareAnimals();
      const d = short ? 0.3 : 0.8;
      tone('sawtooth', 520, 500, d, 0.05, 0, 1700);
      tone('sawtooth', 660, 630, d, 0.04, 0, 1700);
      if (!short) {
        tone('sawtooth', 520, 470, 0.35, 0.05, d + 0.15, 1700);
        tone('sawtooth', 660, 600, 0.35, 0.04, d + 0.15, 1700);
      }
    }

    // whoosh when a train rushes past the other way
    function playPassBy() {
      noiseBurst(1800, 0.5, 0.22);
      tone('sawtooth', 700, 260, 0.45, 0.04, 0, 900);
    }

    function playDing() {
      tone('sine', 1100, 1500, 0.18, 0.12);
    }

    function playCrash() {
      noiseBurst(300, 0.6, 0.4, 'lowpass');
      tone('sawtooth', 220, 50, 0.5, 0.12);
    }

    // Metro-style announcements: a two-note chime, then a calm voice.
    let speakTimer = null;
    function stopSpeech() {
      try {
        clearTimeout(speakTimer);
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
      } catch (e) {}
    }

    // The voices come from the device, and can arrive a moment after the page loads.
    let voicesCache = [];
    function loadVoices() {
      try {
        if ('speechSynthesis' in window && window.speechSynthesis.getVoices) voicesCache = window.speechSynthesis.getVoices() || [];
      } catch (e) {}
    }
    loadVoices();
    try {
      if ('speechSynthesis' in window) window.speechSynthesis.onvoiceschanged = loadVoices;
    } catch (e) {}

    // A calm, formal woman's voice if the device has one.
    function pickVoice(lang) {
      const mine = voicesCache.filter((v) => new RegExp('^' + lang, 'i').test(v.lang));
      if (lang === 'en') {
        const gb = mine.filter((v) => /^en[-_]GB/i.test(v.lang));
        const woman = /female|serena|kate|fiona|hazel|sonia|libby|tessa|moira|karen|samantha|susan/i;
        return gb.find((v) => woman.test(v.name)) || mine.find((v) => woman.test(v.name)) || gb[0] || mine[0] || null;
      }
      return mine.find((v) => /female|laila|leila|zeina|salma|hoda|noura|amira|mariam|maryam|google/i.test(v.name)) || mine[0] || null;
    }

    // parts: [{ text, lang: 'ar' | 'en' }], spoken one after the other, slowly
    function speakParts(parts, queue) {
      try {
        if (!soundOn || !('speechSynthesis' in window)) return;
        const synth = window.speechSynthesis;
        loadVoices();
        if (!queue) synth.cancel(); // a new message replaces the old one, unless it should wait its turn
        parts.forEach((p) => {
          const voice = pickVoice(p.lang);
          if (p.lang === 'ar' && !voice) return; // no Arabic voice on this device: the panel still shows it
          const u = new SpeechSynthesisUtterance(p.text);
          if (voice) {
            u.voice = voice;
            u.lang = voice.lang;
          } else {
            u.lang = 'en-GB';
          }
          u.rate = p.lang === 'ar' ? 0.75 : 0.7; // unhurried, like the real announcements
          u.pitch = 1;
          u.volume = 0.9;
          synth.speak(u);
        });
      } catch (e) {}
    }

    // A two-note chime, then the same message in Arabic and in English.
    function announce(arabic, english, queue) {
      const parts = [{ text: arabic, lang: 'ar' }, { text: english, lang: 'en' }];
      if (queue) {
        // doors message: no chime, it just follows what is already being said
        setTimeout(() => speakParts(parts, true), 300);
        return;
      }
      tone('sine', 784, 784, 0.35, 0.09);
      tone('sine', 659, 659, 0.45, 0.09, 0.3);
      clearTimeout(speakTimer);
      speakTimer = setTimeout(() => speakParts(parts), 900);
    }

    function setSound(on) {
      soundOn = on;
      if (!on) stopSpeech();
      soundBtn.innerHTML = on ? '&#128266; Sound on' : '&#128263; Sound off';
    }

    whistleBtn.addEventListener('click', () => {
      unlockAudio();
      playWhistle();
    });
    soundBtn.addEventListener('click', () => {
      unlockAudio();
      setSound(!soundOn);
    });

    // ---------- night mode ----------
    let night = false;
    const nightBtn = document.getElementById('nightBtn');
    try {
      night = localStorage.getItem('trainNight') === '1';
    } catch (e) {}
    function setNight(on) {
      night = on;
      nightBtn.innerHTML = on ? '&#9728;&#65039; Day' : '&#127769; Night';
      try {
        localStorage.setItem('trainNight', on ? '1' : '0');
      } catch (e) {}
    }
    setNight(night);
    nightBtn.addEventListener('click', () => setNight(!night));

    // ---------- boost ----------
    const boostBtn = document.getElementById('boostBtn');
    let boostLabel = '';
    function updateBoostBtn(force) {
      const running = started && !gameOver && !crashing;
      let label = '\u{1F680} Boost';
      if (boostTime > 0) label = '\u{1F525} Zoom!';
      else if (boostCool > 0) label = '\u{1F680} ' + Math.ceil(boostCool / 60) + 's';
      const off = !running || boostTime > 0 || boostCool > 0;
      if (force || label !== boostLabel || boostBtn.disabled !== off) {
        boostLabel = label;
        boostBtn.textContent = label;
        boostBtn.disabled = off;
      }
    }

    function useBoost() {
      unlockAudio();
      if (!started || gameOver || crashing || walkMode || boostTime > 0 || boostCool > 0) return;
      boostTime = boostDuration;
      boostCool = boostCooldown;
      noiseBurst(1200, 0.6, 0.25);
      tone('sawtooth', 120, 420, 0.6, 0.07);
      playWhistle(true);
      updateBoostBtn();
    }
    boostBtn.addEventListener('click', useBoost);
    updateBoostBtn(true);

    // ---------- easy mode / normal mode ----------
    const easyBtn = document.getElementById('easyBtn');
    const normalBtn = document.getElementById('normalBtn');
    function applyMode() {
      easyBtn.setAttribute('aria-pressed', easy ? 'true' : 'false');
      normalBtn.setAttribute('aria-pressed', easy ? 'false' : 'true');
      shieldDuration = easy ? 1080 : 720;
      boostCooldown = easy ? 300 : 420;
      best = easy ? bestEasy : bestNormal;
      bestEl.textContent = 'Best: ' + best;
      bestLevel = easy ? bestLevelEasy : bestLevelNormal;
      trophyEl.textContent = '\u{1F3C6} Best level: ' + bestLevel;
    }
    function setMode(wantEasy) {
      if (easy === wantEasy) return;
      easy = wantEasy;
      try {
        localStorage.setItem('trainEasy', easy ? '1' : '0');
      } catch (e) {}
      applyMode();
      if (started) {
        // switching in the middle of a game: go back to the start screen
        resetGame();
        started = false;
        obstacles = [];
        coins = [];
        updateBoostBtn(true);
      }
    }
    easyBtn.addEventListener('click', () => setMode(true));
    normalBtn.addEventListener('click', () => setMode(false));
    applyMode();

    // ---------- the metro line map ----------
    // Levels 9 to 20 are a calm run to the end of the line: no obstacles at all.
    const calmLevel = 9;
    // The Calm minute button: no obstacles at all for one minute. It has to
    // recharge for a minute before you can use it again.
    const quietLength = 3600;
    const quietRecharge = 3600;
    let quietT = 0; // frames of calm left
    let quietCool = 0; // frames until the button works again
    function quietLabel() {
      const secs = (f) => Math.ceil(f / 60);
      const mmss = (f) => Math.floor(secs(f) / 60) + ':' + String(secs(f) % 60).padStart(2, '0');
      if (quietT > 0) return '\u{1F54A}\uFE0F Calm ' + mmss(quietT);
      if (quietCool > 0) return '\u{1F54A}\uFE0F Recharging ' + mmss(quietCool);
      return '\u{1F54A}\uFE0F Calm minute';
    }
    function updateQuietBtn() {
      const usable = started && !gameOver && !walkMode && quietT <= 0 && quietCool <= 0 && level < calmLevel;
      const label = quietLabel();
      if (quietBtn.textContent !== label) quietBtn.textContent = label;
      if (quietBtn.disabled === usable) quietBtn.disabled = !usable;
      quietBtn.setAttribute('aria-pressed', String(quietT > 0));
    }
    function startQuiet() {
      unlockAudio();
      if (!started || gameOver || walkMode || quietT > 0 || quietCool > 0 || level >= calmLevel) return;
      quietT = quietLength;
      calmFlash = 170;
      // everything on the track pops away
      obstacles.forEach((o) => {
        if (!o.dead) {
          o.dead = true;
          rings.push({ x: o.x, y: o.y, age: 18 });
        }
      });
      [523, 659, 784].forEach((f, i) => tone('triangle', f, f, 0.2, 0.08, i * 0.1));
      updateQuietBtn();
    }
    quietBtn.addEventListener('click', startQuiet);
    let calmTick = 0;
    let calmFlash = 0;
    let calmStarted = false;

    function checkLevelUp() {
      const newLevel = levelFor(score);
      if (newLevel <= level) return;
      level = newLevel;
      levelEl.textContent = 'Level ' + level;
      levelFlash = 90;
      playWhistle(true);
      // beating your old record level wins the trophy
      if (level > levelAtStart && level >= 2) {
        if (!recordThisRun && levelAtStart >= 2) {
          recordFlash = 150;
          [523, 659, 784, 1047, 1319].forEach((f, i) => tone('triangle', f, f, 0.25, 0.09, i * 0.09));
        }
        recordThisRun = true;
      }
      noteLevelRecord();
      if (level >= calmLevel && calmFlash <= 0 && !calmStarted) {
        // the track clears: everything still on it pops away
        calmStarted = true;
        calmFlash = 170;
        obstacles.forEach((o) => {
          if (!o.dead) {
            o.dead = true;
            rings.push({ x: o.x, y: o.y, age: 18 });
          }
        });
      }
      if (level >= finalLevel && terminusK < 0) scheduleTerminus();
    }

    // Level 10: the next (or the one after, if the next is too close) station
    // becomes the last one of the line.
    function scheduleTerminus() {
      const k = nextStationK();
      const dist = stationPassAt(k) - scrollTotal;
      terminusK = dist > 2000 ? k : k + 1;
      // the monorail always runs its whole way, to Atlantis
      if (currentLine === 'monorail') terminusK = Math.max(terminusK, lineBaseK + metroLines.monorail.names.length);
      finalFlash = 200;
      if (terminusK === k) {
        nextAnnouncedK = -1; // announce it again, now as the final station
        arrivingAnnouncedK = -1;
      }
      [523, 659, 784].forEach((f, i) => tone('triangle', f, f, 0.2, 0.08, i * 0.1));
    }

    function saveMedals() {
      try {
        localStorage.setItem('trainMedals', JSON.stringify(medals));
      } catch (e) {}
    }

    function updateMedalsEl() {
      const m = (icon, name, n) => icon + ' ' + name + (n > 0 ? ' \u2713' + (n > 1 ? ' \u00D7' + n : '') : ' \u2014');
      const master = medals.red > 0 && medals.green > 0 && medals.blue > 0 && medals.tram > 0 ? 1 : 0;
      medalsEl.textContent = '\u{1F396}\uFE0F ' + m('\u{1F534}', 'Red', medals.red) + '   ' + m('\u{1F7E2}', 'Green', medals.green) + '   ' + m('\u{1F535}', 'Blue', medals.blue) + '   ' + m('\u{1F7E0}', 'Tram', medals.tram) + '   ' + m('\u{1F7E3}', 'Monorail', medals.monorail) + '   ' + m('\u2B50', 'Metro Master', master);
    }
    updateMedalsEl();

    function finishJourney() {
      won = true;
      // a medal for the line you finished (the first time), and Metro Master for both
      const key = currentLine;
      const firstTime = medals[key] === 0;
      medals[key]++;
      newMedals = [];
      if (firstTime) newMedals.push(key);
      if (firstTime && medals.red > 0 && medals.green > 0 && medals.blue > 0 && medals.tram > 0) newMedals.push('master');
      saveMedals();
      updateMedalsEl();
      [523, 659, 784, 1047, 1319, 1568].forEach((f, i) => tone('triangle', f, f, 0.3, 0.1, i * 0.12));
      announce('شكراً لسفركم معنا', 'Thank you for travelling with us.', true);
      endGame();
    }

    function updateLineBtn() {
      // at any station you can get off and walk (except at the very end of a line)
      const inter = isInterchange(lastStoppedK);
      const here = started && !gameOver && dwell > 0 && !changedHere && !walkMode && lastStoppedK >= 0 && (lastStoppedK !== terminusK || inter);
      const tl = here && inter ? targetLineAt(lastStoppedK) : null;
      const label = here ? (inter ? (tl === 'monorail' || currentLine === 'monorail' ? '\u{1F501} To ' + metroLines[tl].name : '\u{1F6B6} Walk to the lines') : '\u{1F6B6} Get off & walk') : '\u{1F501} Change line';
      if (lineBtn.textContent !== label) lineBtn.textContent = label;
      if (lineBtn.disabled === here) lineBtn.disabled = !here;
      lineBtn.classList.toggle('big', here && inter);
    }

    // Step off at an interchange and on to the other line: the stations after
    // this one are the other line's.
    function changeLine() {
      unlockAudio();
      if (!started || gameOver || dwell <= 0 || changedHere || lastStoppedK < 0) return;
      if (!isInterchange(lastStoppedK)) {
        // any ordinary station: get off if you like and pick any line in the tunnels
        if (lastStoppedK === terminusK) return;
        changedHere = true;
        startWalk(null);
        return;
      }
      const target = targetLineAt(lastStoppedK);
      if (target !== 'monorail' && currentLine !== 'monorail') {
        // the other line is down the road in the city: get off and walk there
        changedHere = true;
        startWalk(target);
        return;
      }
      performLineChange(target, 5);
    }

    function performLineChange(target, bonus) {
      const name = stationName(lastStoppedK);
      let j = metroLines[target].names.indexOf(name);
      if (j < 0) j = 0; // you walked to a tunnel for a line that does not stop here: join it at its first station
      currentLine = target;
      lineBaseK = lastStoppedK;
      lineStart = j;
      ridden = [j];
      // a new line gets its own last station (the monorail goes all the way to Atlantis)
      if (target === 'monorail') terminusK = lineBaseK + metroLines.monorail.names.length;
      changedHere = true;
      score += bonus; // a little bonus for changing line
      scoreEl.textContent = 'Score: ' + score;
      floaters.push({ x: cars[0].x, y: engineY - 30, age: 0, text: '+' + bonus });
      nextAnnouncedK = -1; // say the next station again, on the new line
      arrivingAnnouncedK = lastStoppedK;
      tone('sine', 660, 990, 0.2, 0.09);
      tone('sine', 990, 1320, 0.25, 0.09, 0.15);
      const o = metroLines[target];
      announce('التحويل إلى ' + o.nameAr, 'Changing to the ' + o.name + '.', true);
      updateLineBtn();
    }
    lineBtn.addEventListener('click', changeLine);

    // ---------- changing between the metro and the tram: a walk along the road ----------
    // The tram stop is down the road from the metro station. You walk there,
    // crossing roads where the cars drive and a railway crossing where a tram
    // comes through, and the line changes when you arrive.
    let walkMode = false;
    let walkTarget = null; // the line we are walking to
    let walkPointer = null; // where a finger or the mouse is pressing (canvas coordinates)
    const walkKeys = { left: false, right: false, up: false, down: false };
    const walkLen = 1700;
    const walker = { x: 200, y: walkLen - 60, hurt: 0, fallT: 0, safeY: 0, stepT: 0, moving: false };
    let walkCars = [];
    let walkTime = 0;
    let walkMsg = '';
    let walkMsgT = 0;
    let walkIntro = 0;
    let walkTramX = -400;
    let walkGate = 0; // 0 = the gates are up, 1 = down
    let walkTramWarn = false;
    const walkRoads = [
      { y: 1420, h: 120, signal: true, speed: 2.4, gap: 190, phase: 0, next: [0, 0] },
      { y: 1080, h: 120, signal: false, speed: 3.0, gap: 330, phase: 0, next: [0, 0] },
      { y: 520, h: 120, signal: true, speed: 2.8, gap: 170, phase: 300, next: [0, 0] },
    ];
    const zebra = { x0: 140, x1: 260 };
    const tramCross = { y0: 820, y1: 900 };
    const walkCarColours = ['#e63946', '#1f6fd6', '#f4a261', '#2a9d8f', '#8e44ad', '#e9c46a', '#dfe6ec'];
    const walkCamY = () => Math.max(0, Math.min(walkLen - H, walker.y - 400));
    const canvasPos = (clientX, clientY) => {
      const rect = canvas.getBoundingClientRect();
      return { x: ((clientX - rect.left) / rect.width) * W, y: ((clientY - rect.top) / rect.height) * H };
    };

    // the traffic lights: cars stop while the light is yellow or red, and people can cross while it is red
    function carsMustStop(road) {
      if (!road.signal) return false;
      const t = (walkTime + road.phase) % 900;
      return t >= 420 && t < 800;
    }
    function pedGreen(road) {
      if (!road.signal) return false;
      const t = (walkTime + road.phase) % 900;
      return t >= 500 && t < 780;
    }

    function addWalkCar(roadIdx, lane, x) {
      const road = walkRoads[roadIdx];
      const dir = lane === 0 ? -1 : 1;
      if (walkCars.some((c) => c.road === roadIdx && c.lane === lane && Math.abs(c.x - x) < 70)) return;
      walkCars.push({
        road: roadIdx,
        lane,
        x,
        y: road.y + (lane === 0 ? 38 : 90),
        dir,
        w: 40,
        h: 22,
        speed: road.speed * (easy ? 0.75 : 1) * (0.85 + Math.random() * 0.3), // calmer traffic in Easy mode
        moving: true,
        colour: walkCarColours[Math.floor(Math.random() * walkCarColours.length)],
      });
    }

    function startWalk(target) {
      walkMode = true;
      walkTarget = target;
      walker.x = 200;
      walker.y = walkLen - 60;
      walker.hurt = 0;
      walker.fallT = 0;
      walkPointer = null;
      walkTime = 0;
      walkMsg = '';
      walkMsgT = 0;
      walkIntro = 300;
      walkTramX = -400;
      walkGate = 0;
      walkCars = [];
      walkRoads.forEach((road, ri) => {
        for (let lane = 0; lane < 2; lane++) {
          let x = Math.random() * road.gap;
          while (x < W + 40) {
            addWalkCar(ri, lane, x);
            x += road.gap * (0.7 + Math.random() * 0.8);
          }
          road.next[lane] = (road.gap / road.speed) * (0.6 + Math.random() * 0.8);
        }
      });
      updateHum(false, 0);
      if (target) {
        const t = metroLines[target];
        announce('يرجى السير إلى ' + t.nameAr, 'Please walk to the ' + t.name + '.');
      } else {
        announce('يرجى اختيار الخط الذي تريده', 'Please choose the line you want.');
      }
      updateLineBtn();
    }

    // At the end of the walk there is a tunnel to every line. The one you came
    // to change to is in the middle, so walking straight on picks it.
    const walkLineKeys = ['red', 'green', 'blue', 'tram', 'monorail'];
    function walkTunnels() {
      if (!walkTarget) return walkLineKeys.map((key, i) => ({ key, cx: 56 + i * 72 }));
      const others = walkLineKeys.filter((k) => k !== walkTarget);
      const order = [others[0], others[1], walkTarget, others[2], others[3]];
      return order.map((key, i) => ({ key, cx: 56 + i * 72 }));
    }
    const tunnelMouthY = 215; // you are in the tunnel once you reach this high

    function finishWalk(skipped, chosen) {
      walkMode = false;
      walkPointer = null;
      walkKeys.left = walkKeys.right = walkKeys.up = walkKeys.down = false;
      const target = chosen || walkTarget || currentLine;
      walkTarget = null;
      if (target === currentLine) {
        // back on the same line: nothing changes
        updateLineBtn();
        return;
      }
      performLineChange(target, skipped ? 5 : 10);
    }

    function walkHit(why) {
      walker.hurt = 130;
      walker.fallT = 90; // knocked over, then gets back up
      score = Math.max(0, score - 3);
      scoreEl.textContent = 'Score: ' + score;
      walkMsg = why;
      walkMsgT = 160;
      walkPointer = null;
      // back to the pavement just before whatever you walked into
      const zones = walkRoads.map((r) => [r.y - 4, r.y + r.h + 4]).concat([[tramCross.y0, tramCross.y1]]);
      let safe = walkLen - 60;
      zones.forEach(([a, b]) => {
        if (walker.y >= a - 2 && walker.y <= b + 2) safe = b + 24;
      });
      walker.safeY = safe; // you are helped back to the pavement when you get up
      noiseBurst(500, 0.3, 0.3);
      tone('square', 380, 330, 0.3, 0.06);
    }

    function updateWalk(step) {
      walkTime += step;
      walkIntro = Math.max(0, walkIntro - step);
      walkMsgT = Math.max(0, walkMsgT - step);
      walker.hurt = Math.max(0, walker.hurt - step);
      if (walker.fallT > 0) {
        walker.fallT -= step;
        if (walker.fallT <= 0) {
          walker.fallT = 0;
          walker.y = walker.safeY;
        }
      }

      // walking: press and hold to walk towards your finger, or use the arrow keys
      let dx = 0;
      let dy = 0;
      if (walkPointer) {
        const tx = walkPointer.x;
        const ty = walkPointer.y + walkCamY();
        const d = Math.hypot(tx - walker.x, ty - walker.y);
        if (d > 5) {
          dx = (tx - walker.x) / d;
          dy = (ty - walker.y) / d;
        }
      }
      if (walkKeys.left) dx -= 1;
      if (walkKeys.right) dx += 1;
      if (walkKeys.up) dy -= 1;
      if (walkKeys.down) dy += 1;
      if (walker.fallT > 0) {
        dx = 0;
        dy = 0;
      }
      const len = Math.hypot(dx, dy);
      walker.moving = len > 0.01;
      if (walker.moving) {
        dx /= Math.max(1, len);
        dy /= Math.max(1, len);
        let nx = walker.x + dx * 2.3 * step;
        let ny = walker.y + dy * 2.3 * step;
        // the railway gates are shut while a tram is coming: you cannot walk in
        if (walkGate > 0.5) {
          if (walker.y > tramCross.y1 + 6 && ny <= tramCross.y1 + 6) ny = tramCross.y1 + 6;
          if (walker.y < tramCross.y0 - 6 && ny >= tramCross.y0 - 6) ny = tramCross.y0 - 6;
        }
        walker.x = Math.max(28, Math.min(W - 28, nx));
        walker.y = Math.max(40, Math.min(walkLen - 16, ny));
        walker.stepT += step;
        if (walker.stepT > 15) {
          walker.stepT = 0;
          noiseBurst(1600, 0.03, 0.04);
        }
      }

      // the tram timetable: warning lights and bell, gates down, tram passes, gates up
      const t = (walkTime + 200) % 600;
      walkTramWarn = t >= 140 && t < 440;
      if (t >= 140 && t < 300) walkGate = Math.min(1, (t - 140) / 50);
      else if (t >= 300 && t < 420) walkGate = 1;
      else if (t >= 420 && t < 470) walkGate = Math.max(0, 1 - (t - 420) / 45);
      else walkGate = 0;
      const tramOn = t >= 300 && t < 420;
      walkTramX = tramOn ? -260 + ((t - 300) / 120) * 740 : -400;
      if (walkTramWarn && (t - 140) % 22 < step) tone('sine', 1650, 1650, 0.12, 0.05);
      if (tramOn && walker.hurt <= 0 && Math.abs(walker.x - walkTramX) < 125 && walker.y > tramCross.y0 + 14 && walker.y < tramCross.y1 - 14) {
        walkHit('A tram! Wait for the gates to open');
      }

      // the cars
      walkRoads.forEach((road, ri) => {
        for (let lane = 0; lane < 2; lane++) {
          road.next[lane] -= step;
          if (road.next[lane] <= 0) {
            addWalkCar(ri, lane, lane === 0 ? W + 30 : -30);
            road.next[lane] = (road.gap / road.speed) * (0.7 + Math.random() * 0.9);
          }
        }
      });
      walkCars.forEach((c) => {
        const road = walkRoads[c.road];
        let move = c.speed * c.dir * step;
        // wait at a red light
        if (carsMustStop(road)) {
          if (c.dir > 0 && c.x + c.w / 2 <= zebra.x0 - 14 && c.x + c.w / 2 + move > zebra.x0 - 14) move = zebra.x0 - 14 - (c.x + c.w / 2);
          if (c.dir < 0 && c.x - c.w / 2 >= zebra.x1 + 14 && c.x - c.w / 2 + move < zebra.x1 + 14) move = zebra.x1 + 14 - (c.x - c.w / 2);
        }
        // keep a gap to the car in front
        walkCars.forEach((o) => {
          if (o === c || o.road !== c.road || o.lane !== c.lane) return;
          const ahead = (o.x - c.x) * c.dir;
          if (ahead > 0 && ahead - Math.abs(move) < c.w + 12) move = c.dir * Math.max(0, ahead - (c.w + 12));
        });
        // slow down for a person on the crossing
        if (walker.y > road.y - 22 && walker.y < road.y + road.h + 22 && walker.x > zebra.x0 - 12 && walker.x < zebra.x1 + 12) {
          const ahead = (walker.x - c.x) * c.dir;
          if (ahead > 0 && ahead < 130) move *= Math.max(0, (ahead - 34) / 96);
        }
        c.x += move;
        c.moving = Math.abs(move) > 0.25 * step;
        // bumped into the walker?
        if (c.moving && walker.hurt <= 0 && Math.abs(walker.x - c.x) < c.w / 2 + 5 && Math.abs(walker.y - c.y) < c.h / 2 + 6) {
          walkHit('Ouch! Watch out for the cars');
        }
      });
      walkCars = walkCars.filter((c) => c.x > -80 && c.x < W + 80);

      // arrived at the stop
      if (walker.fallT <= 0 && walker.y < tunnelMouthY) {
        const tun = walkTunnels().find((t) => Math.abs(walker.x - t.cx) < 32);
        if (tun) finishWalk(false, tun.key);
      }
    }

    function drawWalk() {
      const camY = walkCamY();
      const cs = getComputedStyle(document.documentElement);
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = cs.getPropertyValue('--land').trim() || '#a9b0b7';
      ctx.fillRect(0, 0, W, H);
      ctx.save();
      ctx.translate(0, -camY);
      // buildings along both sides
      const first = Math.floor(camY / 96) - 1;
      for (let i = first; i < first + H / 96 + 3; i++) {
        const hv = cityHash(i, 40);
        drawRoof(2, i * 96 + 6, 36, 76 - (hv % 18), hv >>> 2);
        const hw = cityHash(i, 41);
        drawRoof(W - 38, i * 96 + 6, 36, 76 - (hw % 18), hw >>> 2);
      }
      // pavement decorations: palms, benches and arrows
      for (let y = 140; y < walkLen - 40; y += 64) {
        const inRoad = walkRoads.some((r) => y > r.y - 30 && y < r.y + r.h + 30) || (y > tramCross.y0 - 40 && y < tramCross.y1 + 40);
        if (inRoad || y < 270) continue;
        const hv = cityHash(Math.floor(y / 64), 55);
        drawPalm(hv % 2 ? 64 : 336, y);
        if (hv % 5 === 0) {
          ctx.fillStyle = '#8d6e50';
          ctx.fillRect(hv % 2 ? 84 : 296, y - 5, 20, 8);
        }
      }
      ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';
      ctx.font = 'bold 20px sans-serif';
      ctx.textAlign = 'center';
      for (let y = 300; y < walkLen - 100; y += 150) {
        if (walkRoads.some((r) => y > r.y - 40 && y < r.y + r.h + 40) || (y > tramCross.y0 - 50 && y < tramCross.y1 + 50)) continue;
        ctx.fillText('▲', 200, y);
      }
      // roads, zebra crossings, traffic lights
      walkRoads.forEach((road) => {
        ctx.fillStyle = '#585e66';
        ctx.fillRect(0, road.y, W, road.h);
        ctx.fillStyle = '#c9ccd1';
        ctx.fillRect(0, road.y - 3, W, 3);
        ctx.fillRect(0, road.y + road.h, W, 3);
        ctx.fillStyle = 'rgba(255, 220, 90, 0.85)';
        for (let x = 0; x < W; x += 28) ctx.fillRect(x, road.y + road.h / 2 - 1, 14, 2);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.92)';
        for (let x = zebra.x0; x < zebra.x1; x += 16) ctx.fillRect(x, road.y + 5, 9, road.h - 10);
        if (road.signal) {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
          ctx.fillRect(zebra.x0 - 16, road.y + road.h / 2, 3, road.h / 2); // stop line, one way
          ctx.fillRect(zebra.x1 + 13, road.y, 3, road.h / 2); // stop line, the other way
          const green = pedGreen(road);
          [zebra.x0 - 22, zebra.x1 + 22].forEach((px) => {
            roundedRect(px - 10, road.y - 24, 20, 20, 5);
            ctx.fillStyle = green ? '#27a844' : '#d4352a';
            ctx.fill();
            ctx.fillStyle = '#ffffff';
            ctx.font = '12px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(green ? '\u{1F6B6}' : '✋', px, road.y - 10);
          });
        }
      });
      // the railway crossing
      ctx.fillStyle = '#b8a88a';
      ctx.fillRect(0, tramCross.y0 + 6, W, tramCross.y1 - tramCross.y0 - 12);
      ctx.fillStyle = '#7a5a3a';
      for (let x = 0; x < W; x += 14) ctx.fillRect(x, tramCross.y0 + 14, 8, tramCross.y1 - tramCross.y0 - 28);
      ctx.fillStyle = '#8d969e';
      ctx.fillRect(0, 843, W, 4);
      ctx.fillRect(0, 873, W, 4);
      const flash = walkTramWarn && Math.floor(walkTime / 12) % 2 === 0;
      [[44, tramCross.y0 - 16], [W - 44, tramCross.y1 + 16]].forEach(([px, py]) => {
        ctx.fillStyle = '#3a3f46';
        ctx.fillRect(px - 2, py - 8, 4, 22);
        ctx.beginPath();
        ctx.arc(px - 7, py - 10, 5, 0, Math.PI * 2);
        ctx.arc(px + 7, py - 10, 5, 0, Math.PI * 2);
        ctx.fillStyle = '#5a1d1d';
        ctx.fill();
        if (walkTramWarn) {
          ctx.beginPath();
          ctx.arc(flash ? px - 7 : px + 7, py - 10, 5, 0, Math.PI * 2);
          ctx.fillStyle = '#ff3b30';
          ctx.fill();
        }
      });
      // the gates
      [tramCross.y0 - 6, tramCross.y1 + 6].forEach((gy) => {
        const lenArm = 26 + walkGate * (W - 100);
        ctx.fillStyle = '#4a4f55';
        ctx.fillRect(22, gy - 8, 10, 16);
        for (let i = 0; i < lenArm / 18; i++) {
          ctx.fillStyle = i % 2 ? '#ffffff' : '#e63946';
          ctx.fillRect(32 + i * 18, gy - 3, Math.min(18, lenArm - i * 18), 6);
        }
      });
      // the tram that comes through
      if (walkTramX > -300) {
        const tx = walkTramX - 120;
        roundedRect(tx, 843, 240, 34, 10);
        ctx.fillStyle = '#ffa83d';
        ctx.fill();
        ctx.strokeStyle = '#7a4208';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(tx + 8, 858, 224, 4);
        ctx.fillStyle = '#2f4358';
        for (let i = 0; i < 6; i++) ctx.fillRect(tx + 16 + i * 36, 848, 26, 7);
        ctx.fillStyle = '#fff3a0';
        ctx.fillRect(tx + 236, 852, 4, 16);
      }
      // the cars
      walkCars.forEach((c) => {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
        ctx.fillRect(c.x - c.w / 2 + 2, c.y - c.h / 2 + 3, c.w, c.h);
        roundedRect(c.x - c.w / 2, c.y - c.h / 2, c.w, c.h, 5);
        ctx.fillStyle = c.colour;
        ctx.fill();
        ctx.fillStyle = 'rgba(30, 40, 55, 0.75)';
        ctx.fillRect(c.x + c.dir * 7 - 5, c.y - c.h / 2 + 3, 10, c.h - 6);
        if (!c.moving) {
          ctx.fillStyle = '#ff3b30';
          ctx.fillRect(c.x - c.dir * (c.w / 2) - 1, c.y - 8, 2, 4);
          ctx.fillRect(c.x - c.dir * (c.w / 2) - 1, c.y + 4, 2, 4);
        }
      });
      // where you came from (at the bottom) and where you are going (at the top)
      const from = lineOf();
      const to = walkTarget ? metroLines[walkTarget] : lineOf();
      const drawStop = (y, line, isTram, big) => {
        ctx.fillStyle = '#d7dbe0';
        ctx.fillRect(80, y, 240, 150);
        ctx.fillStyle = line.colour;
        ctx.fillRect(80, y, 240, 6);
        roundedRect(110, y + 20, 180, 30, 8);
        ctx.fillStyle = line.colour;
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 15px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText((isTram ? '\u{1F68B} ' : '\u{1F687} ') + line.name, 200, y + 40);
        if (isTram && big) {
          // the tram waiting at the stop
          roundedRect(176, y + 56, 48, 94, 10);
          ctx.fillStyle = '#ffa83d';
          ctx.fill();
          ctx.strokeStyle = '#7a4208';
          ctx.lineWidth = 2;
          ctx.stroke();
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(198, y + 62, 4, 82);
          ctx.fillStyle = '#2f4358';
          for (let i = 0; i < 4; i++) ctx.fillRect(182, y + 66 + i * 20, 10, 14);
          ctx.fillStyle = '#3ddc84';
          ctx.fillRect(173, y + 80, 4, 14);
          ctx.fillRect(223, y + 80, 4, 14);
        }
      };
      drawStop(walkLen - 130, from, from === metroLines.tram, false);
      // the plaza at the end of the walk, with a tunnel to every line
      ctx.fillStyle = '#d7dbe0';
      ctx.fillRect(0, 50, W, 190);
      ctx.fillStyle = '#b8bec6';
      ctx.fillRect(0, 232, W, 8);
      walkTunnels().forEach((t) => {
        const line = metroLines[t.key];
        const suggested = t.key === walkTarget;
        const x = t.cx - 31;
        // the arch: dark inside, in the line's colour round the edge
        roundedRect(x, 96, 62, 120, 30);
        ctx.fillStyle = line.colour;
        ctx.fill();
        roundedRect(x + 6, 102, 50, 114, 25);
        const dark = ctx.createLinearGradient(0, 102, 0, 216);
        dark.addColorStop(0, '#0b0f14');
        dark.addColorStop(1, '#2a323c');
        ctx.fillStyle = dark;
        ctx.fill();
        // stairs going down
        ctx.fillStyle = 'rgba(255, 255, 255, 0.16)';
        for (let i = 0; i < 5; i++) ctx.fillRect(x + 12, 196 - i * 14, 38, 3);
        // the sign above
        roundedRect(x - 2, 62, 66, 28, 8);
        ctx.fillStyle = line.colour;
        ctx.fill();
        ctx.strokeStyle = suggested ? '#fff3a0' : '#ffffff';
        ctx.lineWidth = suggested ? 3 : 2;
        ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        const here = t.key === currentLine;
        const short = t.key === 'monorail' ? 'Monorail' : t.key === 'tram' ? 'Tram' : line.name.replace(' Line', '');
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText((t.key === 'tram' ? '🚋 ' : t.key === 'monorail' ? '🚝 ' : '🚇 ') + short, t.cx + 1, 80);
        if (here && !walkTarget) {
          ctx.fillStyle = 'rgba(10, 18, 28, 0.7)';
          ctx.font = 'bold 10px sans-serif';
          ctx.fillText('your line', t.cx, 232);
        }
        if (suggested) {
          const bob = Math.sin(walkTime / 8) * 4;
          ctx.fillStyle = '#fff3a0';
          ctx.beginPath();
          ctx.moveTo(t.cx - 8, 98 + bob);
          ctx.lineTo(t.cx + 8, 98 + bob);
          ctx.lineTo(t.cx, 108 + bob);
          ctx.fill();
        }
      });
      // you
      if (walker.fallT > 0) {
        // knocked over: lying on the ground with stars, then getting back up
        const lie = Math.min(1, walker.fallT / 30);
        ctx.save();
        ctx.translate(walker.x, walker.y);
        ctx.scale(1.5, 1.5);
        ctx.rotate((Math.PI / 2) * lie);
        drawPerson(0, 0, '#d71920', 0);
        ctx.restore();
        if (lie >= 1) {
          ctx.fillStyle = '#ffd400';
          ctx.font = 'bold 16px sans-serif';
          ctx.textAlign = 'center';
          for (let i = 0; i < 3; i++) {
            const a = walkTime / 6 + i * 2.1;
            ctx.fillText('\u2605', walker.x + Math.cos(a) * 16, walker.y - 22 + Math.sin(a) * 5);
          }
        }
      } else if (walker.hurt <= 0 || Math.floor(walker.hurt / 6) % 2 === 0) {
        ctx.save();
        ctx.translate(walker.x, walker.y);
        ctx.scale(1.5, 1.5);
        drawPerson(0, 0, '#d71920', walker.moving ? walkTime * 0.45 : 0);
        ctx.restore();
      }
      ctx.restore();

      // the words on top
      ctx.textAlign = 'center';
      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
      roundedRect(W / 2 - 150, 10, 300, 30, 15);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText(walkTarget ? '\u{1F6B6} Pick a tunnel: ' + to.name + ' or any line' : '\u{1F6B6} Pick a tunnel to the line you want', W / 2, 30);
      // a bar showing how far you have to go
      const frac = Math.max(0, Math.min(1, 1 - (walker.y - tunnelMouthY) / (walkLen - 60 - tunnelMouthY)));
      ctx.fillStyle = 'rgba(10, 18, 28, 0.55)';
      roundedRect(10, 60, 14, 220, 7);
      ctx.fill();
      ctx.fillStyle = to.colour;
      roundedRect(12, 62 + 216 * (1 - frac), 10, 216 * frac, 5);
      ctx.fill();
      // skip
      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
      roundedRect(W - 86, H - 36, 76, 26, 13);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 13px sans-serif';
      ctx.fillText('Skip ▶', W - 48, H - 18);
      if (walkIntro > 0) {
        const a = Math.min(1, walkIntro / 40);
        ctx.fillStyle = 'rgba(10, 18, 28, ' + 0.7 * a + ')';
        roundedRect(30, 90, W - 60, 72, 14);
        ctx.fill();
        ctx.fillStyle = 'rgba(255, 255, 255, ' + a + ')';
        ctx.font = 'bold 15px sans-serif';
        ctx.fillText('Press and hold to walk (or use the arrow keys)', W / 2, 118);
        ctx.font = '13px sans-serif';
        ctx.fillText('Cross when the cars stop • wait for the tram gates!', W / 2, 142);
      }
      if (walkMsgT > 0) {
        const a = Math.min(1, walkMsgT / 30);
        ctx.fillStyle = 'rgba(214, 40, 40, ' + 0.9 * a + ')';
        roundedRect(W / 2 - 140, H - 70, 280, 34, 17);
        ctx.fill();
        ctx.fillStyle = 'rgba(255, 255, 255, ' + a + ')';
        ctx.font = 'bold 14px sans-serif';
        ctx.fillText(walkMsg, W / 2, H - 48);
      }
    }

    function setMap(on) {
      if (on && walkMode) return;
      mapOpen = on;
      mapBtn.innerHTML = on ? '&#10006;&#65039; Close map' : '&#128506;&#65039; Map';
      if (on) {
        stopSpeech();
        updateHum(false, 0);
      }
    }
    mapBtn.addEventListener('click', () => {
      unlockAudio();
      setMap(!mapOpen);
    });

    // The trophy goes to the highest level you reach.
    function noteLevelRecord() {
      if (level <= bestLevel) return;
      bestLevel = level;
      if (easy) bestLevelEasy = level;
      else bestLevelNormal = level;
      trophyEl.textContent = '\u{1F3C6} Best level: ' + bestLevel;
      try {
        localStorage.setItem(easy ? 'trainBestLevelEasy' : 'trainBestLevel', String(bestLevel));
      } catch (e) {}
    }

    function levelFor(s) {
      return Math.floor(s / pointsPerLevel) + 1;
    }

    // Starts gentle at level 1 and steps up each level.
    function worldSpeed() {
      return Math.min(11.5, 3.3 + (Math.min(level, calmLevel) - 1) * 0.9) * (easy ? 0.7 : 1) * (currentLine === 'tram' ? 0.75 : 1); // trams are a little slower
    }

    function spawnGap() {
      return Math.max(145, 280 - (level - 1) * 13) * (easy ? 1.3 : 1);
    }

    // A cow or a sheep wanders across the tracks from one side.
    function spawnAnimal() {
      const dir = Math.random() < 0.5 ? 1 : -1;
      const cow = Math.random() < 0.5;
      const vx = dir * Math.min(4.2, 2.5 + level * 0.12) * (easy ? 0.7 : 1);
      obstacles.push({
        kind: 'animal',
        animal: cow ? 'cow' : 'sheep',
        lane: dir > 0 ? 0 : 2,
        x: dir > 0 ? -30 : W + 30,
        y: -40,
        vx,
        dir,
        phase: 0,
        hw: cow ? 21 : 17,
        hh: cow ? 12 : 11,
        speedMul: 1,
        passed: false,
      });
      lastSpawnY = -40;
      if (cow) tone('sawtooth', 140, 95, 0.55, 0.07, 0.3);
      else tone('square', 330, 270, 0.4, 0.04, 0.3);
    }

    function spawnRow() {
      if (level >= 2 && Math.random() < (easy ? 0.07 : 0.14)) {
        spawnAnimal();
        return;
      }
      const lanes = [0, 1, 2].sort(() => Math.random() - 0.5);
      const blocked = !easy && level >= 4 && Math.random() < 0.3 ? 2 : 1; // never all three
      for (let i = 0; i < blocked; i++) {
        const l = lanes[i];
        const roll = Math.random();
        const x = laneX[l];
        if (level >= 2 && blocked === 1 && roll < 0.3) {
          obstacles.push({ kind: 'train', lane: l, x, y: -90, hw: 15, hh: 48, speedMul: easy ? 1.15 : 1.35, passed: false });
        } else if (roll < 0.65) {
          obstacles.push({ kind: 'rock', lane: l, x, y: -40, hw: 17, hh: 15, seed: Math.random() * 10, speedMul: 1, passed: false });
        } else {
          obstacles.push({ kind: 'barrier', lane: l, x, y: -40, hw: 28, hh: 8, speedMul: 1, passed: false });
        }
      }
      lastSpawnY = -40;
    }

    function spawnCoin() {
      const l = Math.floor(Math.random() * 3);
      if (obstacles.some((o) => o.lane === l && o.y < 120)) return false;
      coins.push({ x: laneX[l], y: -30, r: 12 });
      return true;
    }

    // A glowing shield bubble to collect. It protects the whole train from
    // one bump (or runs out after about 12 seconds).
    function spawnShield() {
      if (shieldTime > 0 || coins.some((c) => c.kind === 'shield')) return true;
      const l = Math.floor(Math.random() * 3);
      if (obstacles.some((o) => o.lane === l && o.y < 120)) return false;
      coins.push({ x: laneX[l], y: -30, r: 15, kind: 'shield' });
      return true;
    }

    function resetGame() {
      lane = 1;
      cars.forEach((c) => (c.x = laneX[1]));
      obstacles = [];
      coins = [];
      puffs = [];
      rings = [];
      score = 0;
      level = 1;
      levelFlash = 0;
      coinSpawnIn = 90;
      shieldTime = 0;
      shieldSpawnIn = 1100;
      boostTime = 0;
      boostCool = 0;
      updateBoostBtn(true);
      crashing = false;
      crashTimer = 0;
      crashT = 0;
      gameOver = false;
      started = true;
      scoreEl.textContent = 'Score: 0';
      levelEl.textContent = 'Level 1';
      const ev0 = eventInfo();
      whistledSlot = eventReach(ev0) >= engineY ? ev0.n : -1;
      nextAnnouncedK = -1;
      arrivingAnnouncedK = -1;
      levelAtStart = bestLevel;
      recordThisRun = false;
      recordFlash = 0;
      newMedals = [];
      chances = maxChances;
      hurtTime = 0;
      calmStarted = false;
      calmTick = 0;
      calmFlash = 0;
      quietT = 0;
      quietCool = 0;
      terminusK = -1;
      won = false;
      finalFlash = 0;
      currentLine = 'red';
      lineBaseK = 0;
      lineStart = 0;
      ridden = [];
      changedHere = false;
      passengers = 0;
      onboard = [];
      alighting = [];
      delivered = 0;
      offHere = 0;
      onHere = 0;
      boarding = [];
      floaters = [];
      boardedSlot = -1;
      boardedPlatformX = -1;
      lastStoppedK = -1;
      lastStoppedK = nextStationK() - 1; // do not stop at a station we are already past
      dwell = 0;
      departT = 0;
      doorsClosingSaid = false;
      stopSpeech();
      spawnRow();
    }

    function startOrRestart() {
      if (!started || gameOver) resetGame();
    }

    function startCrash() {
      if (crashing || gameOver) return;
      crashing = true;
      boostTime = 0;
      stopSpeech();
      crashTimer = crashDuration;
      crashDir = cars[0].x < W / 2 ? 1 : cars[0].x > W / 2 ? -1 : Math.random() < 0.5 ? 1 : -1;
      rings.push({ x: cars[0].x, y: engineY - 20, age: 0 });
      playCrash();
    }

    function endGame() {
      if (gameOver) return;
      gameOver = true;
      noteLevelRecord();
      if (score > best) {
        best = score;
        if (easy) bestEasy = best;
        else bestNormal = best;
        bestEl.textContent = 'Best: ' + best;
        try {
          localStorage.setItem(easy ? 'trainDodgeBestEasy' : 'trainDodgeBest', String(best));
        } catch (e) {}
      }
    }

    function easeInOut(t) {
      return t * t * (3 - 2 * t);
    }

    function laneFromClientX(clientX) {
      const rect = canvas.getBoundingClientRect();
      const x = ((clientX - rect.left) / rect.width) * W;
      return Math.max(0, Math.min(2, Math.floor(x / (W / 3))));
    }

    // while walking to the tram: press and hold to walk towards your finger
    const walkPress = (clientX, clientY) => {
      const p = canvasPos(clientX, clientY);
      if (p.x > W - 90 && p.y > H - 40 && p.y < H - 6) return finishWalk(true); // Skip
      walkPointer = p;
    };
    window.addEventListener('mouseup', () => (walkPointer = null));
    window.addEventListener('touchend', () => (walkPointer = null));
    window.addEventListener('touchcancel', () => (walkPointer = null));
    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') walkKeys.left = false;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') walkKeys.right = false;
      if (e.code === 'ArrowUp' || e.code === 'KeyW') walkKeys.up = false;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') walkKeys.down = false;
    });

    canvas.addEventListener('mousedown', (e) => {
      unlockAudio();
      if (walkMode) return walkPress(e.clientX, e.clientY);
      if (mapOpen) return setMap(false);
      startOrRestart();
      lane = laneFromClientX(e.clientX);
    });
    canvas.addEventListener('mousemove', (e) => {
      if (walkMode) {
        if (walkPointer) walkPointer = canvasPos(e.clientX, e.clientY);
        return;
      }
      lane = laneFromClientX(e.clientX);
    });
    canvas.addEventListener(
      'touchstart',
      (e) => {
        unlockAudio();
        if (walkMode) return walkPress(e.touches[0].clientX, e.touches[0].clientY);
        if (mapOpen) return setMap(false);
        startOrRestart();
        lane = laneFromClientX(e.touches[0].clientX);
      },
      { passive: true }
    );
    canvas.addEventListener(
      'touchmove',
      (e) => {
        if (walkMode) {
          if (walkPointer) walkPointer = canvasPos(e.touches[0].clientX, e.touches[0].clientY);
          return;
        }
        lane = laneFromClientX(e.touches[0].clientX);
      },
      { passive: true }
    );

    window.addEventListener('keydown', (e) => {
      if (walkMode) {
        // walking to the tram: the arrow keys steer
        if (e.code === 'ArrowLeft' || e.code === 'KeyA') walkKeys.left = true;
        if (e.code === 'ArrowRight' || e.code === 'KeyD') walkKeys.right = true;
        if (e.code === 'ArrowUp' || e.code === 'KeyW') walkKeys.up = true;
        if (e.code === 'ArrowDown' || e.code === 'KeyS') walkKeys.down = true;
        if (e.code.startsWith('Arrow') || e.code === 'Space') e.preventDefault();
        return;
      }
      if (e.repeat) return;
      unlockAudio();
      if (e.code === 'KeyM') setMap(!mapOpen);
      if (e.code === 'KeyL') changeLine();
      if (e.code === 'Escape' && mapOpen) setMap(false);
      if (e.code === 'ArrowUp' || e.code === 'KeyW') playWhistle();
      if (e.code === 'ArrowDown' || e.code === 'KeyB') useBoost();
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') lane = Math.max(0, lane - 1);
      if (e.code === 'ArrowRight' || e.code === 'KeyD') lane = Math.min(2, lane + 1);
      if (e.code === 'Space') {
        e.preventDefault();
        startOrRestart();
      }
    });

    function update() {
      const now = performance.now();
      let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
      lastTime = now;
      step = Math.min(Math.max(step, 0.2), 3); // same speed on 60Hz and 120Hz screens
      if (mapOpen) return; // everything waits while you look at the map
      if (walkMode) {
        frame += step; // the train waits at the station while you walk
        updateWalk(step);
        return;
      }
      frame += step;

      // weather
      const wantRain = started && !gameOver && level >= stormLevel ? 1 : 0;
      rainAmt += (wantRain - rainAmt) * (1 - Math.pow(1 - 0.02, step));
      if (rainAmt < 0.005 && !wantRain) rainAmt = 0;
      drops.forEach((d) => {
        d.y += d.v * step;
        d.x -= d.v * 0.28 * step;
        if (d.y > H + 20 || d.x < -20) {
          d.y = -20 - Math.random() * 40;
          d.x = Math.random() * (W + 60);
        }
      });
      flash = Math.max(0, flash - 0.07 * step);
      if (flashAgain > 0) {
        flashAgain -= step;
        if (flashAgain <= 0) flash = 0.75;
      }
      if (rainAmt > 0.8 && !easy) {
        lightningIn -= step;
        if (lightningIn <= 0) {
          strikeLightning();
          lightningIn = 220 + Math.random() * 420;
        }
      }
      rainSoundIn -= step;
      if (rainSoundIn <= 0) {
        updateRainSound();
        rainSoundIn = 10;
      }

      updateStreets(step);

      // speedometer: ease toward the speed we are really doing
      const liveSpeed = started && !gameOver && !crashing ? curSpeed : 0;
      shownMph += (liveSpeed * mphPerUnit - shownMph) * (1 - Math.pow(1 - 0.08, step));

      rings.forEach((r) => (r.age += step));
      rings = rings.filter((r) => r.age < 40);
      puffs.forEach((p) => (p.age += step));
      puffs = puffs.filter((p) => p.age < 40);

      if (crashing) {
        crashTimer -= step;
        crashT = easeInOut(Math.min(1, Math.max(0, 1 - crashTimer / crashDuration)));
        if (crashTimer <= 0) {
          crashing = false;
          endGame();
        }
        updateHum(false, 0);
        return;
      }

      const running = started && !gameOver;
      alighting.forEach((p) => {
        if (p.done) return;
        if (p.delay > 0) {
          p.delay -= step;
          return;
        }
        const dx = p.tx - p.x;
        const dy = p.ty - p.y;
        const d = Math.hypot(dx, dy);
        p.hop += step * 0.5;
        if (d < 3) {
          p.fade += step;
          if (p.fade > 22) {
            // home safe: two points for getting them to their stop
            p.done = true;
            delivered++;
            score += 2;
            scoreEl.textContent = 'Score: ' + score;
            rings.push({ x: p.x, y: p.y, age: 26 });
            floaters.push({ x: p.x, y: p.y - 10, age: 0, text: '+2' });
            tone('sine', 880, 1320, 0.14, 0.08);
          }
        } else {
          p.x += (dx / d) * Math.min(d, 1.7 * step);
          p.y += (dy / d) * Math.min(d, 1.7 * step);
        }
      });
      alighting = alighting.filter((p) => !p.done);
      boarding.forEach((p) => {
        if (p.done) return;
        if (p.delay > 0) {
          p.delay -= step;
          return;
        }
        const dx = p.tx - p.x;
        const dy = p.ty - p.y;
        const d = Math.hypot(dx, dy);
        p.hop += step * 0.5;
        if (d < 3) {
          // hopped on!
          p.done = true;
          passengers++;
          onboard.push({ dest: lastStoppedK + 1 + Math.floor(Math.random() * 3), colour: p.colour });
          score++;
          scoreEl.textContent = 'Score: ' + score;
          rings.push({ x: p.tx, y: p.ty, age: 26 });
          floaters.push({ x: p.tx, y: p.ty - 10, age: 0 });
          tone('sine', 700, 1000, 0.1, 0.08);
        } else {
          p.x += (dx / d) * Math.min(d, 1.9 * step);
          p.y += (dy / d) * Math.min(d, 1.9 * step);
        }
      });
      boarding = boarding.filter((p) => !p.done);
      floaters.forEach((f) => (f.age += step));
      floaters = floaters.filter((f) => f.age < (f.text && f.text.length > 4 ? 90 : 45));
      hurtTime = Math.max(0, hurtTime - step);

      const kStop = nextStationK();
      const toStop = stationPassAt(kStop) - scrollTotal; // distance to where we stop
      let factor = 1;
      if (running) {
        if (dwell > 0) {
          factor = 0; // standing at the station with the doors open
          dwell -= step;
          if (!doorsClosingSaid && dwell < 110 && lastStoppedK !== terminusK) {
            doorsClosingSaid = true;
            announce('الأبواب تُغلق الآن', 'The doors are closing.', true);
            [0, 1, 2].forEach((i) => tone('square', 1000, 1000, 0.1, 0.05, 0.3 + i * 0.2));
          }
          if (dwell <= 0 && (boarding.length > 0 || alighting.length > 0)) dwell = 20; // never leave while someone is still walking to the train
          if (dwell <= 0 && lastStoppedK === terminusK) {
            dwell = 0;
            doorsClosingSaid = true;
            if (!won) finishJourney(); // the end of the line: the journey is complete
          } else if (dwell <= 0) {
            dwell = 0;
            departT = 100; // pull away smoothly
          }
        } else {
          if (toStop < brakeDist) factor = Math.min(1, Math.max(0.1, Math.sqrt(Math.max(0, toStop) / brakeDist)));
          if (departT > 0) {
            departT = Math.max(0, departT - step);
            factor = Math.min(factor, 0.15 + 0.85 * (1 - departT / 100));
          }
        }
      }
      let dist = (running ? worldSpeed() * (boostTime > 0 ? boostSpeed : 1) * factor : 2) * step;
      let arrived = false;
      if (running && dwell <= 0 && dist >= toStop - 1e-4) {
        dist = Math.max(0, toStop); // stop exactly at the platform
        arrived = true;
      }
      curSpeed = running ? dist / step : 0;
      scrollTotal += dist;
      if (arrived) {
        lastStoppedK = kStop;
        dwell = dwellFrames;
        doorsClosingSaid = false;
        doorK = kStop;
        doorSide = lane === 0 ? 'right' : lane === 2 ? 'left' : kStop % 2 === 0 ? 'right' : 'left';
        // the platform on the door side: its passengers hop on
        const platX = doorSide === 'right' ? (lane === 0 ? 140 : 260) : lane === 2 ? 260 : 140;
        const evNow = eventInfo();
        boardedSlot = evNow.n;
        boardedPlatformX = platX;
        boarding = [];
        const sx = doorSide === 'right' ? 1 : -1;
        // passengers whose stop this is get off first and walk onto the platform
        const atEnd = kStop === terminusK;
        const getOff = atEnd ? onboard.slice() : onboard.filter((p) => p.dest <= kStop);
        onboard = atEnd ? [] : onboard.filter((p) => p.dest > kStop);
        alighting = getOff.map((p, i) => {
          const y = carY(i % 3) + (i % 2 ? 6 : -6);
          return {
            x: cars[0].x + sx * 20,
            y,
            colour: p.colour,
            delay: 30 + i * 24,
            tx: platX + (i % 2 ? 8 : -8),
            ty: y + (i % 2 ? 14 : -14),
            hop: Math.random() * 6,
            fade: 0,
            done: false,
          };
        });
        offHere = getOff.length;
        onHere = atEnd ? 0 : 5;
        const waitExtra = getOff.length * 24 + 20; // the waiting passengers board after the others are off
        for (let i = 0; i < (atEnd ? 0 : 5); i++) {
          const px = platX - 16 + ((i * 11) % 32);
          const py = evNow.top + 40 + i * 48 + (platX === 260 ? 18 : 0);
          boarding.push({
            x: px,
            y: py,
            colour: passengerColours[(i + (platX === 260 ? 2 : 0)) % 4],
            delay: 40 + waitExtra + i * 26, // they queue up and board one after another
            tx: cars[0].x + sx * 20,
            ty: Math.max(carY(0) - 8, Math.min(carY(2) + 8, py)),
            hop: Math.random() * 6,
            done: false,
          });
        }
        // stand long enough for everyone to get off and the new passengers to get on
        dwell = Math.max(dwellFrames, 190 + offHere * 24 + onHere * 26);
        if (kStop === terminusK && currentLine === 'tram') dwell = Math.max(dwell, 480); // time to hop on the monorail
        dwellTotal = dwell;
        noiseBurst(3500, 0.7, 0.09, 'highpass'); // the brakes hiss
        tone('sine', 880, 880, 0.25, 0.08, 0.5);
        announce(
          doorSide === 'right' ? 'ستُفتح الأبواب على الجانب الأيمن' : 'ستُفتح الأبواب على الجانب الأيسر',
          'Doors will open on the ' + doorSide + ' side.',
          true
        );
        changedHere = false;
        if (!atEnd) ridden.push(lineIndexAt(kStop));
        if (isInterchange(kStop)) {
          const o = metroLines[targetLineAt(kStop)];
          announce('للتحويل إلى ' + o.nameAr, 'Change here for the ' + o.name + '.', true);
        }
      }
      updateLineBtn();

      // The engine glides to the chosen track; each carriage trails the one
      // in front a little, so the train swings round corners like a snake.
      cars[0].x += (laneX[lane] - cars[0].x) * (1 - Math.pow(1 - 0.2, step));
      for (let i = 1; i < cars.length; i++) {
        cars[i].x += (cars[i - 1].x - cars[i].x) * (1 - Math.pow(1 - 0.16, step));
      }

      smokeIn -= step;
      if (smokeIn <= 0) {
        if (boostTime > 0) puffs.push({ x: cars[0].x + (Math.random() - 0.5) * 6, y: engineY + 10, age: 0 });
        smokeIn = 7;
      }

      if (!running) {
        humIn -= step;
        if (humIn <= 0) {
          updateHum(false, 0);
          humIn = 10;
        }
        return;
      }

      humIn -= step;
      if (humIn <= 0) {
        updateHum(true, dist / step);
        humIn = 8;
      }
      chuffIn -= step;
      if (chuffIn <= 0) {
        if (dist / step > 0.6) playClack();
        chuffIn = Math.max(6, 24 - (dist / step) * 1.5);
      }
      const ev = eventInfo();
      if (ev.n !== whistledSlot && eventReach(ev) >= engineY) {
        whistledSlot = ev.n;
        playWhistle();
      }
      {
        const k = nextStationK();
        const name = stationName(k);
        const nameAr = stationNameAr(k);
        const dist = stationPassAt(k) - scrollTotal;
        const last = k === terminusK;
        const sayNext = () =>
          last
            ? announce('المحطة القادمة هي المحطة الأخيرة، ' + nameAr, 'The next station is ' + name + ', the final station.')
            : announce('المحطة القادمة، ' + nameAr, 'The next station is ' + name + '.');
        const sayArriving = () =>
          last && currentLine !== 'tram'
            ? announce('نصل الآن إلى محطة ' + nameAr + '. هذه المحطة الأخيرة', 'Arriving at ' + name + '. This train terminates here.')
            : announce('نصل الآن إلى محطة ' + nameAr, 'Arriving at ' + name + '.');

        // say which station is next once we have pulled away from the last one
        const clearOfLast = dwell <= 0 && (k === 0 || scrollTotal > stationPassAt(k - 1) + 150);
        if (clearOfLast) {
          if (k !== nextAnnouncedK) {
            nextAnnouncedK = k;
            if (dist < 1100) {
              arrivingAnnouncedK = k; // already close: go straight to "arriving"
              sayArriving();
            } else {
              sayNext();
            }
          } else if (arrivingAnnouncedK !== k && dist < 1100) {
            arrivingAnnouncedK = k;
            sayArriving();
          }
        }
      }

      obstacles.forEach((o) => {
        o.y += dist * o.speedMul;
        if (o.slideTo !== undefined) {
          const d = o.slideTo - o.x;
          o.x += Math.max(-4.5 * step, Math.min(4.5 * step, d));
          if (Math.abs(o.slideTo - o.x) < 0.5) {
            o.x = o.slideTo;
            o.slideTo = undefined;
            o.scared = false;
          }
        }
        if (o.kind === 'train' && !o.whooshed && o.y > engineY - 70) {
          o.whooshed = true;
          if (Math.abs(o.x - cars[0].x) < 140) playPassBy();
        }
        if (o.kind === 'animal') {
          if (dwell <= 0) o.x += o.vx * step;
          o.phase += step * (o.scared ? 0.9 : 0.35);
          o.lane = o.x < 140 ? 0 : o.x < 260 ? 1 : 2;
        }
        let hit = false;
        if (!o.ignore && !o.dead && hurtTime <= 0) {
          for (let i = 0; i < cars.length; i++) {
            const c = cars[i];
            if (Math.abs(c.x - o.x) < c.hw + o.hw - (easy ? 7 : 4) && Math.abs(carY(i) - o.y) < c.hh + o.hh - (easy ? 7 : 4)) {
              hit = true;
              break;
            }
          }
        }
        if (hit) {
          if (shieldTime > 0) {
            // the shield soaks up the bump
            shieldTime = 0;
            rings.push({ x: o.x, y: o.y, age: 0 });
            rings.push({ x: o.x, y: o.y, age: 12 });
            noiseBurst(700, 0.25, 0.3);
            tone('sine', 900, 300, 0.3, 0.12);
            if (o.kind === 'animal') {
              o.ignore = true; // the animal gets a fright and runs off
              o.vx = o.dir * 5;
            } else {
              o.dead = true;
            }
          } else if (chances > 0) {
            // a bump, but you still have a chance left: no derailment
            chances--;
            hurtTime = 120; // about two seconds when nothing can hurt you
            rings.push({ x: o.x, y: o.y, age: 0 });
            rings.push({ x: o.x, y: o.y, age: 12 });
            noiseBurst(500, 0.3, 0.3);
            tone('sawtooth', 220, 90, 0.35, 0.1);
            floaters.push({ x: cars[0].x, y: engineY - 30, age: 0, text: chances > 0 ? 'Ouch! 1 chance left' : 'Ouch! Last chance!' });
            if (o.kind === 'animal') {
              o.ignore = true; // the animal runs off
              o.vx = o.dir * 5;
            } else {
              o.dead = true;
            }
          } else {
            startCrash();
          }
        }
        if (!o.passed && o.y - o.hh > carY(cars.length - 1) + 22) {
          o.passed = true;
          score += boostTime > 0 ? 2 : 1; // double points while boosting
          scoreEl.textContent = 'Score: ' + score;
          checkLevelUp();
        }
      });
      lastSpawnY += dist;
      obstacles = obstacles.filter((o) => o.y - o.hh < H + 20 && !o.dead);
      if (lastSpawnY > spawnGap() && dwell <= 0 && toStop > 900 && level < calmLevel && quietT <= 0) spawnRow(); // keep the line clear around a station

      coins.forEach((c) => {
        c.y += dist;
        const dx = cars[0].x - c.x;
        const dy = engineY - c.y;
        if (Math.sqrt(dx * dx + dy * dy) < c.r + 22) {
          c.collected = true;
          rings.push({ x: c.x, y: c.y, age: 22 });
          if (c.kind === 'shield') {
            shieldTime = shieldDuration;
            tone('triangle', 500, 900, 0.25, 0.12);
            tone('triangle', 750, 1300, 0.25, 0.1, 0.12);
          } else {
            score += 3;
            scoreEl.textContent = 'Score: ' + score;
            playDing();
          }
        }
      });
      coins = coins.filter((c) => !c.collected && c.y < H + 40);
      coinSpawnIn -= step;
      if (coinSpawnIn <= 0) {
        coinSpawnIn = spawnCoin() ? 100 + Math.random() * 90 : 10;
      }

      if (boostTime > 0) {
        boostTime = Math.max(0, boostTime - step);
      } else {
        boostCool = Math.max(0, boostCool - step);
      }
      updateBoostBtn();
      shieldTime = Math.max(0, shieldTime - step);
      shieldSpawnIn -= step;
      if (shieldSpawnIn <= 0) {
        shieldSpawnIn = spawnShield() ? (1500 + Math.random() * 900) * (easy ? 0.6 : 1) : 10;
      }

      if (quietT > 0) {
        quietT -= step;
        if (quietT <= 0) {
          quietT = 0;
          quietCool = quietRecharge;
          tone('triangle', 660, 440, 0.25, 0.08);
        }
      } else if (quietCool > 0) {
        quietCool = Math.max(0, quietCool - step);
      }
      if ((level >= calmLevel || quietT > 0) && !won && dwell <= 0) {
        // smooth sailing: a point every second and a half, so the journey still moves on
        calmTick += step;
        if (calmTick >= 90) {
          calmTick = 0;
          score++;
          scoreEl.textContent = 'Score: ' + score;
        }
      }
      checkLevelUp();
      calmFlash = Math.max(0, calmFlash - step);
      levelFlash = Math.max(0, levelFlash - step);
      finalFlash = Math.max(0, finalFlash - step);
      updateLineBtn();
      updateQuietBtn();
      recordFlash = Math.max(0, recordFlash - step);
    }

    // ---------- drawing ----------

    // The city rolling past: rooftops and parks beside the tracks, and a street
    // every now and then that the railway crosses over.
    const roofColours = ['#c1ad95', '#9db4c9', '#cdbfa8', '#a4aeb8', '#d1a58b', '#93ab9f', '#bdbdbd', '#d8c9aa', '#b49bbf'];
    const cityColumns = [[0, 50], [110, 170], [230, 290], [350, 400]];
    const cityHash = (a, b) => (Math.imul(a + 7919, 73856093) ^ Math.imul(b + 104729, 19349663)) >>> 0;

    function drawRoof(x, y, w, h, hv) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
      ctx.fillRect(x + 4, y + 4, w, h); // shadow
      ctx.fillStyle = roofColours[hv % roofColours.length];
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.28)';
      ctx.fillRect(x + 2, y + 2, w - 4, 3); // sunny edge
      const kind = (hv >>> 4) % 6;
      if (kind === 0) {
        // air-con boxes
        ctx.fillStyle = '#7e868e';
        ctx.fillRect(x + 6, y + 8, 12, 9);
        ctx.fillRect(x + w - 18, y + h - 17, 12, 9);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
        ctx.fillRect(x + 8, y + 10, 8, 5);
      } else if (kind === 1 && w >= 50) {
        // helipad
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2, Math.min(w, h) * 0.32, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
        ctx.lineWidth = 2.5;
        ctx.stroke();
        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
        ctx.font = 'bold 14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('H', x + w / 2, y + h / 2 + 5);
      } else if (kind === 2) {
        // skylight
        ctx.fillStyle = 'rgba(190, 230, 255, 0.7)';
        ctx.fillRect(x + w / 2 - 9, y + h / 2 - 7, 18, 14);
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';
        ctx.lineWidth = 1;
        ctx.strokeRect(x + w / 2 - 9, y + h / 2 - 7, 18, 14);
      } else if (kind === 3) {
        // water tank
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2, 9, 0, Math.PI * 2);
        ctx.fillStyle = '#8d6e50';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(x + w / 2 - 2, y + h / 2 - 2, 4, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
        ctx.fill();
      }
    }

    function drawPalm(px, py) {
      ctx.strokeStyle = '#2f8a46';
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      for (let i = 0; i < 7; i++) {
        const a = (i / 7) * Math.PI * 2 + 0.3;
        ctx.beginPath();
        ctx.moveTo(px, py);
        ctx.quadraticCurveTo(px + Math.cos(a) * 7, py + Math.sin(a) * 7 - 1, px + Math.cos(a) * 12, py + Math.sin(a) * 12 + 2);
        ctx.stroke();
      }
      ctx.lineCap = 'butt';
      ctx.beginPath();
      ctx.arc(px, py, 3, 0, Math.PI * 2);
      ctx.fillStyle = '#8d6e50';
      ctx.fill();
    }

    function drawPark(x, y, w, h, hv) {
      ctx.fillStyle = '#6fbf73';
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
      for (let i = 0; i < 2; i++) {
        const tx = x + 14 + ((hv >>> (i * 3)) % Math.max(10, w - 28));
        const ty = y + 14 + ((hv >>> (i * 3 + 1)) % Math.max(10, h - 28));
        drawPalm(tx, ty);
      }
    }

    // The Dubai Tram runs along the ground, in the road, instead of up on a viaduct.
    const onGround = () => currentLine === 'tram';
    const onMono = () => currentLine === 'monorail';

    // The Palm Monorail glides above the sea: a beach with palm trees and hotels
    // beside the track, and waves in between.
    function drawPalmIsland(x0, x1, c) {
      const period = 96;
      const idx = Math.floor(scrollTotal / period);
      const base = scrollTotal % period;
      const w = x1 - x0;
      for (let r = -1; r < H / period + 1; r++) {
        const g = idx - r;
        const hv = cityHash(g, c + 60);
        const y = r * period + base;
        const edge = c === 0 ? x1 : x0; // the shore
        ctx.fillStyle = '#ecd9a6';
        ctx.fillRect(x0, y, w, period + 1);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.7)'; // surf along the shore
        ctx.fillRect(c === 0 ? edge - 5 : edge, y, 5, period + 1);
        if ((hv >>> 3) % 5 === 0) {
          drawRoof(x0 + 4, y + 14, w - 8, 66, hv >>> 2); // a hotel
        } else {
          drawPalm(x0 + 14 + (hv % (w - 28)), y + 20 + ((hv >>> 6) % 20));
          if ((hv >>> 9) % 2) drawPalm(x0 + 12 + ((hv >>> 12) % (w - 24)), y + 62 + ((hv >>> 15) % 20));
        }
      }
    }

    function drawSeaWaves() {
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 26; i++) {
        const wy = ((i * 97 + scrollTotal * 0.9) % (H + 40)) - 20;
        const wx = 55 + ((i * 131) % 290);
        ctx.beginPath();
        ctx.moveTo(wx, wy);
        ctx.quadraticCurveTo(wx + 8, wy - 4, wx + 16, wy);
        ctx.quadraticCurveTo(wx + 24, wy + 4, wx + 32, wy);
        ctx.stroke();
      }
    }
    const carBodies = ['#e8e8ea', '#2f3f58', '#c0392b', '#d9b44a', '#4d7a5a', '#7d7f86'];

    function drawCarV(x, y, colour, up) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
      ctx.fillRect(x - 8, y - 13, 18, 30);
      ctx.fillStyle = colour;
      roundedRect(x - 9, y - 15, 18, 30, 4);
      ctx.fill();
      ctx.fillStyle = 'rgba(30, 40, 55, 0.75)';
      ctx.fillRect(x - 6, y + (up ? -8 : 1), 12, 8);
      ctx.fillStyle = up ? '#fff6c0' : '#ff3b30';
      ctx.fillRect(x - 7, y - 15, 3, 2);
      ctx.fillRect(x + 4, y - 15, 3, 2);
    }

    // a road with cars running between two of the tram tracks
    function drawRoadGap(x0, x1, c) {
      const w = x1 - x0;
      ctx.fillStyle = '#585e66';
      ctx.fillRect(x0, 0, w, H);
      ctx.fillStyle = 'rgba(255, 220, 90, 0.85)';
      const db = scrollTotal % 36;
      for (let y = -36 + db; y < H; y += 36) ctx.fillRect(x0 + w / 2 - 1, y, 2, 18);
      const per = 230;
      const bb = scrollTotal * 0.4;
      const cb = scrollTotal * 1.6;
      for (let i = 0; i < 4; i++) {
        const hv = cityHash(i, c + 40);
        const f = (((i * per + bb + (hv % 90)) % (per * 4)) + per * 4) % (per * 4) - per;
        const o = (((i * per + cb + (hv % 70)) % (per * 4)) + per * 4) % (per * 4) - per;
        drawCarV(x0 + w / 2 - 14, f, carBodies[hv % carBodies.length], true);
        drawCarV(x0 + w / 2 + 14, o, carBodies[(hv >>> 4) % carBodies.length], false);
      }
    }

    function drawCity() {
      const period = 96;
      const idx = Math.floor(scrollTotal / period);
      const base = scrollTotal % period;
      const ground = onGround();
      if (onMono()) {
        drawSeaWaves();
        drawPalmIsland(0, 50, 0);
        drawPalmIsland(350, 400, 3);
        return;
      }
      cityColumns.forEach(([x0, x1], c) => {
        if (ground && (c === 1 || c === 2)) return;
        for (let r = -1; r < H / period + 1; r++) {
          const g = idx - r;
          const hv = cityHash(g, c);
          const gap = 6 + (hv % 9);
          const h = 56 + ((hv >>> 8) % 26);
          const y = r * period + base + (period - h) / 2 - gap / 2;
          const inset = (hv >>> 12) % 4;
          const x = x0 + 2 + inset;
          const w = x1 - x0 - 4 - inset - ((hv >>> 14) % 3);
          if ((hv >>> 3) % 7 === 0) drawPark(x - 1, y, w + 2, h, hv);
          else drawRoof(x, y, w, h, hv >>> 2);
        }
      });
      if (ground) return; // the tram's streets are drawn over its tracks, after them
      // streets crossing under the railway
      const ev = eventInfo();
      const spacing = 620;
      const sIdx = Math.floor(scrollTotal / spacing);
      const sBase = scrollTotal % spacing;
      for (let k = -1; k < H / spacing + 1; k++) {
        const sy = k * spacing + sBase + 120;
        if (sy > ev.top - 40 && sy < ev.top + ev.len + 40) continue; // not over a station, tunnel or river
        const g = sIdx - k;
        ctx.fillStyle = '#585e66';
        ctx.fillRect(0, sy - 20, W, 40);
        ctx.fillStyle = '#c9ccd1';
        ctx.fillRect(0, sy - 23, W, 3);
        ctx.fillRect(0, sy + 20, W, 3);
        ctx.fillStyle = 'rgba(255, 220, 90, 0.85)';
        for (let dx = -((scrollTotal * 0) % 28); dx < W; dx += 28) ctx.fillRect(dx, sy - 1, 14, 2);
        drawStreetExtras(sy, g);
      }
    }

    // Streets that cross the tram tracks at level crossings.
    function drawGroundStreets() {
      const ev = eventInfo();
      const spacing = 620;
      const sIdx = Math.floor(scrollTotal / spacing);
      const sBase = scrollTotal % spacing;
      for (let k = -1; k < H / spacing + 1; k++) {
        const sy = k * spacing + sBase + 120;
        if (sy > ev.top - 40 && sy < ev.top + ev.len + 40 && ev.kind === 'station') continue;
        const g = sIdx - k;
        ctx.fillStyle = '#585e66';
        ctx.fillRect(0, sy - 20, W, 40);
        ctx.fillStyle = '#c9ccd1';
        ctx.fillRect(0, sy - 23, W, 3);
        ctx.fillRect(0, sy + 20, W, 3);
        ctx.fillStyle = 'rgba(255, 220, 90, 0.85)';
        for (let dx = 0; dx < W; dx += 28) ctx.fillRect(dx, sy - 1, 14, 2);
        // level crossings: yellow and black stripes where the tram goes over the road
        laneX.forEach((x) => {
          ctx.fillStyle = '#3a3f46';
          ctx.fillRect(x - 28, sy - 20, 56, 40);
          ctx.fillStyle = '#f2c230';
          for (let i = 0; i < 8; i++) ctx.fillRect(x - 28 + i * 8, sy - 20, 4, 40);
          ctx.fillStyle = '#8d969e';
          ctx.fillRect(x - 15, sy - 20, 3, 40);
          ctx.fillRect(x + 12, sy - 20, 3, 40);
        });
        drawStreetExtras(sy, g);
      }
    }

    // ---------- traffic lights and the cars that obey them ----------
    const streetSpacing = 620;
    const lightCycle = 600; // frames: green, then yellow, then red
    const stopEastX = () => (onGround() ? 40 : 122); // where eastbound cars wait (in the gap between tracks)
    const stopWestX = () => (onGround() ? 360 : 278); // where westbound cars wait
    let streetCars = {};

    function lightState(g) {
      const p = (frame + g * 173) % lightCycle;
      return p < 260 ? 'green' : p < 320 ? 'yellow' : 'red';
    }

    function newStreetCars(g) {
      const h = (i) => cityHash(g, i + 20);
      const mk = (x, dir, i) => ({
        x,
        dir,
        v: 0.9 + ((h(i) % 8) / 8) * 1.1,
        colour: roofColours[h(i + 5) % roofColours.length],
        stopped: false,
      });
      return [mk(-30 + (h(0) % 90), 1, 0), mk(180 + (h(1) % 110), 1, 1), mk(W - 20 - (h(2) % 120), -1, 2), mk(W + 70, -1, 3)];
    }

    function updateStreets(step) {
      const sIdx = Math.floor(scrollTotal / streetSpacing);
      const keep = {};
      for (let k = -1; k < H / streetSpacing + 1; k++) {
        const g = sIdx - k;
        keep[g] = streetCars[g] || newStreetCars(g);
        const cars = keep[g];
        const state = lightState(g);
        cars.forEach((c, i) => {
          const stopX = c.dir > 0 ? stopEastX() : stopWestX();
          let nx = c.x + c.dir * c.v * step;
          // wait at a red or yellow light (a car already past the line carries on)
          if (state !== 'green') {
            if (c.dir > 0 && c.x <= stopX - 14 && nx > stopX - 14) nx = stopX - 14;
            if (c.dir < 0 && c.x >= stopX + 14 && nx < stopX + 14) nx = stopX + 14;
          }
          // keep a gap to the car in front
          cars.forEach((o, j) => {
            if (j === i || o.dir !== c.dir) return;
            const ahead = (o.x - c.x) * c.dir;
            if (ahead > 0 && ahead < 30 + c.v * step) nx = c.x;
          });
          c.stopped = Math.abs(nx - c.x) < 0.01;
          c.x = nx;
          if (c.dir > 0 && c.x > W + 40) c.x = -40;
          if (c.dir < 0 && c.x < -40) c.x = W + 40;
        });
      }
      streetCars = keep;
    }

    function drawSignal(px, py, state) {
      ctx.fillStyle = '#4a4f55';
      ctx.fillRect(px - 1, py - 8, 3, 8);
      ctx.fillStyle = '#23272d';
      roundedRect(px - 6, py, 12, 30, 4);
      ctx.fill();
      [['red', '#ff3b30'], ['yellow', '#ffcc00'], ['green', '#34d058']].forEach(([name, col], i) => {
        const on = name === state;
        ctx.beginPath();
        ctx.arc(px, py + 7 + i * 8, 3.2, 0, Math.PI * 2);
        ctx.fillStyle = on ? col : 'rgba(255, 255, 255, 0.14)';
        ctx.fill();
        if (on) {
          ctx.beginPath();
          ctx.arc(px, py + 7 + i * 8, 8, 0, Math.PI * 2);
          ctx.fillStyle = col + '44';
          ctx.fill();
        }
      });
    }

    function drawStreetExtras(sy, g) {
      const state = lightState(g);
      // stop lines
      ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
      ctx.fillRect(stopEastX(), sy + 1, 4, 18);
      ctx.fillRect(stopWestX() - 4, sy - 19, 4, 18);
