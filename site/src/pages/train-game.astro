<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Train Dodge</title>
  </head>
  <body>
<style is:global>
  :root {
    --bg: #f6fdff;
    --card: #ffffff;
    --ink: #1a2a33;
    --ink-soft: #4a6572;
    --land: #6fbf73;
    --bed: #b8a88a;
    --water: #4aa3d8;
    --accent: #e4572e;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0f1b22;
      --card: #16262f;
      --ink: #eaf4f8;
      --ink-soft: #9fb6c0;
      --land: #2f6b3a;
      --bed: #7d7360;
      --water: #2a6a99;
      --accent: #ff8a6a;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0f1b22;
    --card: #16262f;
    --ink: #eaf4f8;
    --ink-soft: #9fb6c0;
    --land: #2f6b3a;
    --bed: #7d7360;
    --water: #2a6a99;
    --accent: #ff8a6a;
    color-scheme: dark;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .wrap {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 24px;
  }

  h1 {
    font-size: clamp(22px, 6vw, 30px);
    margin: 0;
    text-align: center;
  }

  .sub {
    color: var(--ink-soft);
    margin: 0;
    text-align: center;
    font-size: 14px;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    max-height: 70vh;
    background: var(--card);
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background: var(--land);
    touch-action: none;
  }

  .score {
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .level {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .controls button {
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    background: var(--card);
    border: 2px solid var(--ink-soft);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
  }

  .controls button:disabled {
    opacity: 0.55;
    cursor: default;
  }

  #boostBtn:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .controls button:active {
    transform: scale(0.96);
  }

  .best {
    font-size: 13px;
    color: var(--ink-soft);
  }
</style>

<div class="wrap">
  <h1>&#128644; Train Dodge</h1>
  <p class="sub">Tap the left, middle or right side to switch tracks. Dodge the rocks, barriers, oncoming trains and wandering cows, grab the gold and shields, and press Boost to zoom!</p>
  <p class="score" id="score">Score: 0</p>
  <p class="level" id="level">Level 1</p>
  <p class="best" id="best">Best: 0</p>
  <div class="stage">
    <canvas id="game" width="400" height="600" aria-label="Train dodge game"></canvas>
  </div>
  <div class="controls">
    <button type="button" id="whistleBtn">&#128226; Horn</button>
    <button type="button" id="boostBtn">&#128640; Boost</button>
    <button type="button" id="nightBtn">&#127769; Night</button>
    <button type="button" id="soundBtn">&#128266; Sound on</button>
  </div>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const levelEl = document.getElementById('level');
    const bestEl = document.getElementById('best');

    const W = canvas.width;
    const H = canvas.height;
    const pointsPerLevel = 5;

    const laneX = [80, 200, 320];

    // The train's spot on screen never changes by itself: only its sideways
    // position follows the track you pick. The wreck animation is drawn as an
    // offset on top, so a restart always puts everything back.
    const engineY = H - 190;
    const carSpacing = 52;
    const cars = [
      { x: laneX[1], hw: 15, hh: 25, kind: 'engine' },
      { x: laneX[1], hw: 14, hh: 22, kind: 'car' },
      { x: laneX[1], hw: 14, hh: 22, kind: 'car' },
    ];
    const carY = (i) => engineY + i * carSpacing;

    let lane = 1;
    let obstacles = [];
    let coins = [];
    let puffs = []; // chimney smoke
    let rings = []; // dust rings when something happens
    let score = 0;
    let level = 1;
    let levelFlash = 0;
    let best = 0;
    let started = false;
    let gameOver = false;
    let coinSpawnIn = 90;
    let boostTime = 0; // frames of boost left
    let boostCool = 0; // frames until the boost is ready again
    const boostDuration = 120; // 2 seconds
    const boostCooldown = 420; // 7 seconds
    const boostSpeed = 1.6;
    let shieldTime = 0; // frames of shield left
    let shieldSpawnIn = 1100;
    const shieldDuration = 720; // about 12 seconds
    let lastSpawnY = 0;
    let scrollTotal = 0;
    let smokeIn = 0;
    let frame = 0;
    let shownMph = 0; // the speedometer needle eases toward the real speed
    const mphPerUnit = 20; // game speed -> miles per hour
    const mphMax = 400;

    // Storm: from level 5 it rains, and now and then lightning strikes.
    const stormLevel = 5;
    let rainAmt = 0; // 0 = dry, 1 = full storm (fades in and out)
    let lightningIn = 200;
    let flash = 0;
    let flashAgain = 0; // frames until the second flicker of a strike
    let bolt = null;
    let rainSoundIn = 0;
    const drops = [];
    for (let i = 0; i < 110; i++) {
      drops.push({ x: Math.random() * (W + 40), y: Math.random() * H, len: 10 + Math.random() * 14, v: 15 + Math.random() * 9 });
    }
    let lastTime = null;

    // Wreck animation: the carriages swing out sideways and the train tips,
    // staying fully on screen.
    let crashing = false;
    let crashTimer = 0;
    const crashDuration = 60;
    let crashDir = 1;
    let crashT = 0;

    try {
      best = Number(localStorage.getItem('trainDodgeBest') || 0);
    } catch (e) {}
    bestEl.textContent = 'Best: ' + best;

    // ---------- sound (made with Web Audio, no files needed) ----------
    let audio = null;
    let noiseBuf = null;
    let soundOn = true;
    let chuffIn = 0;
    let chuffFlip = false;
    let whistledSlot = -1;
    const whistleBtn = document.getElementById('whistleBtn');
    const soundBtn = document.getElementById('soundBtn');

    function getAudio() {
      if (audio) return audio;
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        audio = new AC();
        noiseBuf = audio.createBuffer(1, audio.sampleRate * 0.5, audio.sampleRate);
        const d = noiseBuf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      } catch (e) {
        audio = null;
      }
      return audio;
    }

    function unlockAudio() {
      try {
        const a = getAudio();
        if (a && a.state === 'suspended') a.resume();
      } catch (e) {}
    }

    function noiseBurst(freq, dur, vol, type) {
      try {
        const a = getAudio();
        if (!a || !soundOn) return;
        const src = a.createBufferSource();
        src.buffer = noiseBuf;
        const f = a.createBiquadFilter();
        f.type = type || 'bandpass';
        f.frequency.value = freq;
        const g = a.createGain();
        const t = a.currentTime;
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + dur);
        src.connect(f);
        f.connect(g);
        g.connect(a.destination);
        src.start(t);
        src.stop(t + dur + 0.02);
      } catch (e) {}
    }

    function tone(type, f0, f1, dur, vol, delay, lowpass) {
      try {
        const a = getAudio();
        if (!a || !soundOn) return;
        const o = a.createOscillator();
        const g = a.createGain();
        const t = a.currentTime + (delay || 0);
        o.type = type;
        o.frequency.setValueAtTime(f0, t);
        o.frequency.linearRampToValueAtTime(f1, t + dur);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(vol, t + 0.04);
        g.gain.setValueAtTime(vol, t + dur * 0.7);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        if (lowpass) {
          const f = a.createBiquadFilter();
          f.type = 'lowpass';
          f.frequency.value = lowpass;
          o.connect(f);
          f.connect(g);
        } else {
          o.connect(g);
        }
        g.connect(a.destination);
        o.start(t);
        o.stop(t + dur + 0.05);
      } catch (e) {}
    }

    // Bullet-train sounds: a smooth electric hum and rushing wind that rise
    // with speed, quick clack-clacks over the rail joints, and a bright horn.
    let hum = null;
    let humIn = 0;
    function ensureHum() {
      try {
        const a = getAudio();
        if (!a || hum) return;
        const o = a.createOscillator();
        o.type = 'sawtooth';
        const f = a.createBiquadFilter();
        f.type = 'lowpass';
        f.frequency.value = 300;
        const g = a.createGain();
        g.gain.value = 0;
        o.connect(f);
        f.connect(g);
        g.connect(a.destination);
        o.start();
        const n = a.createBufferSource();
        n.buffer = noiseBuf;
        n.loop = true;
        const nf = a.createBiquadFilter();
        nf.type = 'bandpass';
        nf.frequency.value = 800;
        nf.Q.value = 0.6;
        const ng = a.createGain();
        ng.gain.value = 0;
        n.connect(nf);
        nf.connect(ng);
        ng.connect(a.destination);
        n.start();
        hum = { o, f, g, nf, ng };
      } catch (e) {
        hum = null;
      }
    }

    let rainSnd = null;
    function updateRainSound() {
      try {
        if (rainAmt < 0.02 || !soundOn) {
          if (rainSnd) rainSnd.g.gain.setTargetAtTime(0, audio.currentTime, 0.2);
          return;
        }
        const a = getAudio();
        if (!a) return;
        if (!rainSnd) {
          const n = a.createBufferSource();
          n.buffer = noiseBuf;
          n.loop = true;
          const f = a.createBiquadFilter();
          f.type = 'highpass';
          f.frequency.value = 2500;
          const g = a.createGain();
          g.gain.value = 0;
          n.connect(f);
          f.connect(g);
          g.connect(a.destination);
          n.start();
          rainSnd = { g };
        }
        rainSnd.g.gain.setTargetAtTime(0.035 * rainAmt, a.currentTime, 0.2);
      } catch (e) {}
    }

    function strikeLightning() {
      flash = 1;
      flashAgain = 7;
      // a jagged bolt from the sky down to the ground
      const pts = [];
      let x = 40 + Math.random() * (W - 80);
      let y = 0;
      const bottom = 180 + Math.random() * 260;
      while (y < bottom) {
        pts.push([x, y]);
        x += (Math.random() - 0.5) * 50;
        y += 22 + Math.random() * 26;
      }
      bolt = pts;
      // thunder arrives a moment later
      setTimeout(() => {
        noiseBurst(140, 1.3, 0.4, 'lowpass');
        noiseBurst(70, 1.6, 0.35, 'lowpass');
      }, 250 + Math.random() * 600);
    }

    function updateHum(on, speed) {
      try {
        if (!on || !soundOn) {
          if (hum) {
            const t0 = audio.currentTime;
            hum.g.gain.setTargetAtTime(0, t0, 0.08);
            hum.ng.gain.setTargetAtTime(0, t0, 0.08);
          }
          return;
        }
        ensureHum();
        if (!hum) return;
        const t = audio.currentTime;
        hum.o.frequency.setTargetAtTime(60 + speed * 12, t, 0.15);
        hum.f.frequency.setTargetAtTime(240 + speed * 45, t, 0.15);
        hum.g.gain.setTargetAtTime(0.03, t, 0.15);
        hum.nf.frequency.setTargetAtTime(500 + speed * 110, t, 0.15);
        hum.ng.gain.setTargetAtTime(0.012 + speed * 0.004, t, 0.15);
      } catch (e) {}
    }

    function playClack() {
      chuffFlip = !chuffFlip;
      noiseBurst(chuffFlip ? 2600 : 2100, 0.04, 0.1);
      noiseBurst(260, 0.06, 0.09, 'lowpass');
    }

    // Honk at an oncoming train that is heading for you and it politely slides
    // over to another track (never onto yours).
    function moveOncomingTrain(o) {
      if (o.slideTo !== undefined) return;
      const ahead = engineY - (o.y + o.hh);
      if (ahead < -20 || ahead > 380) return;
      const mine = laneX[lane];
      if (Math.abs(o.x - mine) > 50 && Math.abs(o.x - cars[0].x) > 50) return; // not coming for us
      const options = [0, 1, 2].filter((l) => laneX[l] !== mine && Math.abs(laneX[l] - o.x) > 10);
      if (!options.length) return;
      const clear = (l) => !obstacles.some((q) => q !== o && Math.abs(q.x - laneX[l]) < 40 && Math.abs(q.y - o.y) < 140);
      const pick = options.find(clear) || options[0];
      o.slideTo = laneX[pick];
      o.lane = pick;
      o.scared = true;
      rings.push({ x: o.x, y: o.y + o.hh, age: 18 });
    }

    // Honk! Any animal ahead of the train (and close) gets a fright and runs
    // away sideways, fast.
    function scareAnimals() {
      obstacles.forEach((o) => {
        if (o.kind === 'train') {
          moveOncomingTrain(o);
          return;
        }
        if (o.kind !== 'animal' || o.scared) return;
        const ahead = engineY - o.y; // how far in front of the engine
        if (ahead < -40 || ahead > 280) return;
        o.scared = true;
        o.dir = o.x < cars[0].x ? -1 : o.x > cars[0].x ? 1 : Math.random() < 0.5 ? -1 : 1;
        o.vx = o.dir * 6.5;
        rings.push({ x: o.x, y: o.y, age: 18 });
      });
    }

    // A bright two-note electric horn: pwaaa!
    function playWhistle(short) {
      scareAnimals();
      const d = short ? 0.3 : 0.8;
      tone('sawtooth', 520, 500, d, 0.05, 0, 1700);
      tone('sawtooth', 660, 630, d, 0.04, 0, 1700);
      if (!short) {
        tone('sawtooth', 520, 470, 0.35, 0.05, d + 0.15, 1700);
        tone('sawtooth', 660, 600, 0.35, 0.04, d + 0.15, 1700);
      }
    }

    // whoosh when a train rushes past the other way
    function playPassBy() {
      noiseBurst(1800, 0.5, 0.22);
      tone('sawtooth', 700, 260, 0.45, 0.04, 0, 900);
    }

    function playDing() {
      tone('sine', 1100, 1500, 0.18, 0.12);
    }

    function playCrash() {
      noiseBurst(300, 0.6, 0.4, 'lowpass');
      tone('sawtooth', 220, 50, 0.5, 0.12);
    }

    function setSound(on) {
      soundOn = on;
      soundBtn.innerHTML = on ? '&#128266; Sound on' : '&#128263; Sound off';
    }

    whistleBtn.addEventListener('click', () => {
      unlockAudio();
      playWhistle();
    });
    soundBtn.addEventListener('click', () => {
      unlockAudio();
      setSound(!soundOn);
    });

    // ---------- night mode ----------
    let night = false;
    const nightBtn = document.getElementById('nightBtn');
    try {
      night = localStorage.getItem('trainNight') === '1';
    } catch (e) {}
    function setNight(on) {
      night = on;
      nightBtn.innerHTML = on ? '&#9728;&#65039; Day' : '&#127769; Night';
      try {
        localStorage.setItem('trainNight', on ? '1' : '0');
      } catch (e) {}
    }
    setNight(night);
    nightBtn.addEventListener('click', () => setNight(!night));

    // ---------- boost ----------
    const boostBtn = document.getElementById('boostBtn');
    let boostLabel = '';
    function updateBoostBtn(force) {
      const running = started && !gameOver && !crashing;
      let label = '\u{1F680} Boost';
      if (boostTime > 0) label = '\u{1F525} Zoom!';
      else if (boostCool > 0) label = '\u{1F680} ' + Math.ceil(boostCool / 60) + 's';
      const off = !running || boostTime > 0 || boostCool > 0;
      if (force || label !== boostLabel || boostBtn.disabled !== off) {
        boostLabel = label;
        boostBtn.textContent = label;
        boostBtn.disabled = off;
      }
    }

    function useBoost() {
      unlockAudio();
      if (!started || gameOver || crashing || boostTime > 0 || boostCool > 0) return;
      boostTime = boostDuration;
      boostCool = boostCooldown;
      noiseBurst(1200, 0.6, 0.25);
      tone('sawtooth', 120, 420, 0.6, 0.07);
      playWhistle(true);
      updateBoostBtn();
    }
    boostBtn.addEventListener('click', useBoost);
    updateBoostBtn(true);

    function levelFor(s) {
      return Math.floor(s / pointsPerLevel) + 1;
    }

    // Starts gentle at level 1 and steps up each level.
    function worldSpeed() {
      return Math.min(11.5, 3.3 + (level - 1) * 0.9);
    }

    function spawnGap() {
      return Math.max(145, 280 - (level - 1) * 13);
    }

    // A cow or a sheep wanders across the tracks from one side.
    function spawnAnimal() {
      const dir = Math.random() < 0.5 ? 1 : -1;
      const cow = Math.random() < 0.5;
      const vx = dir * Math.min(4.2, 2.5 + level * 0.12);
      obstacles.push({
        kind: 'animal',
        animal: cow ? 'cow' : 'sheep',
        lane: dir > 0 ? 0 : 2,
        x: dir > 0 ? -30 : W + 30,
        y: -40,
        vx,
        dir,
        phase: 0,
        hw: cow ? 21 : 17,
        hh: cow ? 12 : 11,
        speedMul: 1,
        passed: false,
      });
      lastSpawnY = -40;
      if (cow) tone('sawtooth', 140, 95, 0.55, 0.07, 0.3);
      else tone('square', 330, 270, 0.4, 0.04, 0.3);
    }

    function spawnRow() {
      if (level >= 2 && Math.random() < 0.14) {
        spawnAnimal();
        return;
      }
      const lanes = [0, 1, 2].sort(() => Math.random() - 0.5);
      const blocked = level >= 4 && Math.random() < 0.3 ? 2 : 1; // never all three
      for (let i = 0; i < blocked; i++) {
        const l = lanes[i];
        const roll = Math.random();
        const x = laneX[l];
        if (level >= 2 && blocked === 1 && roll < 0.3) {
          obstacles.push({ kind: 'train', lane: l, x, y: -90, hw: 15, hh: 48, speedMul: 1.35, passed: false });
        } else if (roll < 0.65) {
          obstacles.push({ kind: 'rock', lane: l, x, y: -40, hw: 17, hh: 15, seed: Math.random() * 10, speedMul: 1, passed: false });
        } else {
          obstacles.push({ kind: 'barrier', lane: l, x, y: -40, hw: 28, hh: 8, speedMul: 1, passed: false });
        }
      }
      lastSpawnY = -40;
    }

    function spawnCoin() {
      const l = Math.floor(Math.random() * 3);
      if (obstacles.some((o) => o.lane === l && o.y < 120)) return false;
      coins.push({ x: laneX[l], y: -30, r: 12 });
      return true;
    }

    // A glowing shield bubble to collect. It protects the whole train from
    // one bump (or runs out after about 12 seconds).
    function spawnShield() {
      if (shieldTime > 0 || coins.some((c) => c.kind === 'shield')) return true;
      const l = Math.floor(Math.random() * 3);
      if (obstacles.some((o) => o.lane === l && o.y < 120)) return false;
      coins.push({ x: laneX[l], y: -30, r: 15, kind: 'shield' });
      return true;
    }

    function resetGame() {
      lane = 1;
      cars.forEach((c) => (c.x = laneX[1]));
      obstacles = [];
      coins = [];
      puffs = [];
      rings = [];
      score = 0;
      level = 1;
      levelFlash = 0;
      coinSpawnIn = 90;
      shieldTime = 0;
      shieldSpawnIn = 1100;
      boostTime = 0;
      boostCool = 0;
      updateBoostBtn(true);
      crashing = false;
      crashTimer = 0;
      crashT = 0;
      gameOver = false;
      started = true;
      scoreEl.textContent = 'Score: 0';
      levelEl.textContent = 'Level 1';
      const ev0 = eventInfo();
      whistledSlot = eventReach(ev0) >= engineY ? ev0.n : -1;
      spawnRow();
    }

    function startOrRestart() {
      if (!started || gameOver) resetGame();
    }

    function startCrash() {
      if (crashing || gameOver) return;
      crashing = true;
      boostTime = 0;
      crashTimer = crashDuration;
      crashDir = cars[0].x < W / 2 ? 1 : cars[0].x > W / 2 ? -1 : Math.random() < 0.5 ? 1 : -1;
      rings.push({ x: cars[0].x, y: engineY - 20, age: 0 });
      playCrash();
    }

    function endGame() {
      if (gameOver) return;
      gameOver = true;
      if (score > best) {
        best = score;
        bestEl.textContent = 'Best: ' + best;
        try {
          localStorage.setItem('trainDodgeBest', String(best));
        } catch (e) {}
      }
    }

    function easeInOut(t) {
      return t * t * (3 - 2 * t);
    }

    function laneFromClientX(clientX) {
      const rect = canvas.getBoundingClientRect();
      const x = ((clientX - rect.left) / rect.width) * W;
      return Math.max(0, Math.min(2, Math.floor(x / (W / 3))));
    }

    canvas.addEventListener('mousedown', (e) => {
      unlockAudio();
      startOrRestart();
      lane = laneFromClientX(e.clientX);
    });
    canvas.addEventListener('mousemove', (e) => {
      lane = laneFromClientX(e.clientX);
    });
    canvas.addEventListener(
      'touchstart',
      (e) => {
        unlockAudio();
        startOrRestart();
        lane = laneFromClientX(e.touches[0].clientX);
      },
      { passive: true }
    );
    canvas.addEventListener(
      'touchmove',
      (e) => {
        lane = laneFromClientX(e.touches[0].clientX);
      },
      { passive: true }
    );

    window.addEventListener('keydown', (e) => {
      if (e.repeat) return;
      unlockAudio();
      if (e.code === 'ArrowUp' || e.code === 'KeyW') playWhistle();
      if (e.code === 'ArrowDown' || e.code === 'KeyB') useBoost();
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') lane = Math.max(0, lane - 1);
      if (e.code === 'ArrowRight' || e.code === 'KeyD') lane = Math.min(2, lane + 1);
      if (e.code === 'Space') {
        e.preventDefault();
        startOrRestart();
      }
    });

    function update() {
      const now = performance.now();
      let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
      lastTime = now;
      step = Math.min(Math.max(step, 0.2), 3); // same speed on 60Hz and 120Hz screens
      frame += step;

      // weather
      const wantRain = started && !gameOver && level >= stormLevel ? 1 : 0;
      rainAmt += (wantRain - rainAmt) * (1 - Math.pow(1 - 0.02, step));
      if (rainAmt < 0.005 && !wantRain) rainAmt = 0;
      drops.forEach((d) => {
        d.y += d.v * step;
        d.x -= d.v * 0.28 * step;
        if (d.y > H + 20 || d.x < -20) {
          d.y = -20 - Math.random() * 40;
          d.x = Math.random() * (W + 60);
        }
      });
      flash = Math.max(0, flash - 0.07 * step);
      if (flashAgain > 0) {
        flashAgain -= step;
        if (flashAgain <= 0) flash = 0.75;
      }
      if (rainAmt > 0.8) {
        lightningIn -= step;
        if (lightningIn <= 0) {
          strikeLightning();
          lightningIn = 220 + Math.random() * 420;
        }
      }
      rainSoundIn -= step;
      if (rainSoundIn <= 0) {
        updateRainSound();
        rainSoundIn = 10;
      }

      // speedometer: ease toward the speed we are really doing
      const liveSpeed = started && !gameOver && !crashing ? worldSpeed() * (boostTime > 0 ? boostSpeed : 1) : 0;
      shownMph += (liveSpeed * mphPerUnit - shownMph) * (1 - Math.pow(1 - 0.08, step));

      rings.forEach((r) => (r.age += step));
      rings = rings.filter((r) => r.age < 40);
      puffs.forEach((p) => (p.age += step));
      puffs = puffs.filter((p) => p.age < 40);

      if (crashing) {
        crashTimer -= step;
        crashT = easeInOut(Math.min(1, Math.max(0, 1 - crashTimer / crashDuration)));
        if (crashTimer <= 0) {
          crashing = false;
          endGame();
        }
        updateHum(false, 0);
        return;
      }

      const running = started && !gameOver;
      const dist = (running ? worldSpeed() * (boostTime > 0 ? boostSpeed : 1) : 2) * step;
      scrollTotal += dist;

      // The engine glides to the chosen track; each carriage trails the one
      // in front a little, so the train swings round corners like a snake.
      cars[0].x += (laneX[lane] - cars[0].x) * (1 - Math.pow(1 - 0.2, step));
      for (let i = 1; i < cars.length; i++) {
        cars[i].x += (cars[i - 1].x - cars[i].x) * (1 - Math.pow(1 - 0.16, step));
      }

      smokeIn -= step;
      if (smokeIn <= 0) {
        if (boostTime > 0) puffs.push({ x: cars[0].x + (Math.random() - 0.5) * 6, y: engineY + 10, age: 0 });
        smokeIn = 7;
      }

      if (!running) {
        humIn -= step;
        if (humIn <= 0) {
          updateHum(false, 0);
          humIn = 10;
        }
        return;
      }

      humIn -= step;
      if (humIn <= 0) {
        updateHum(true, dist / step);
        humIn = 8;
      }
      chuffIn -= step;
      if (chuffIn <= 0) {
        playClack();
        chuffIn = Math.max(6, 24 - (dist / step) * 1.5);
      }
      const ev = eventInfo();
      if (ev.n !== whistledSlot && eventReach(ev) >= engineY) {
        whistledSlot = ev.n;
        playWhistle();
      }

      obstacles.forEach((o) => {
        o.y += dist * o.speedMul;
        if (o.slideTo !== undefined) {
          const d = o.slideTo - o.x;
          o.x += Math.max(-4.5 * step, Math.min(4.5 * step, d));
          if (Math.abs(o.slideTo - o.x) < 0.5) {
            o.x = o.slideTo;
            o.slideTo = undefined;
            o.scared = false;
          }
        }
        if (o.kind === 'train' && !o.whooshed && o.y > engineY - 70) {
          o.whooshed = true;
          if (Math.abs(o.x - cars[0].x) < 140) playPassBy();
        }
        if (o.kind === 'animal') {
          o.x += o.vx * step;
          o.phase += step * (o.scared ? 0.9 : 0.35);
          o.lane = o.x < 140 ? 0 : o.x < 260 ? 1 : 2;
        }
        let hit = false;
        if (!o.ignore && !o.dead) {
          for (let i = 0; i < cars.length; i++) {
            const c = cars[i];
            if (Math.abs(c.x - o.x) < c.hw + o.hw - 4 && Math.abs(carY(i) - o.y) < c.hh + o.hh - 4) {
              hit = true;
              break;
            }
          }
        }
        if (hit) {
          if (shieldTime > 0) {
            // the shield soaks up the bump
            shieldTime = 0;
            rings.push({ x: o.x, y: o.y, age: 0 });
            rings.push({ x: o.x, y: o.y, age: 12 });
            noiseBurst(700, 0.25, 0.3);
            tone('sine', 900, 300, 0.3, 0.12);
            if (o.kind === 'animal') {
              o.ignore = true; // the animal gets a fright and runs off
              o.vx = o.dir * 5;
            } else {
              o.dead = true;
            }
          } else {
            startCrash();
          }
        }
        if (!o.passed && o.y - o.hh > carY(cars.length - 1) + 22) {
          o.passed = true;
          score += boostTime > 0 ? 2 : 1; // double points while boosting
          scoreEl.textContent = 'Score: ' + score;
          const newLevel = levelFor(score);
          if (newLevel > level) {
            level = newLevel;
            levelEl.textContent = 'Level ' + level;
            levelFlash = 90;
            playWhistle(true);
          }
        }
      });
      lastSpawnY += dist;
      obstacles = obstacles.filter((o) => o.y - o.hh < H + 20 && !o.dead);
      if (lastSpawnY > spawnGap()) spawnRow();

      coins.forEach((c) => {
        c.y += dist;
        const dx = cars[0].x - c.x;
        const dy = engineY - c.y;
        if (Math.sqrt(dx * dx + dy * dy) < c.r + 22) {
          c.collected = true;
          rings.push({ x: c.x, y: c.y, age: 22 });
          if (c.kind === 'shield') {
            shieldTime = shieldDuration;
            tone('triangle', 500, 900, 0.25, 0.12);
            tone('triangle', 750, 1300, 0.25, 0.1, 0.12);
          } else {
            score += 3;
            scoreEl.textContent = 'Score: ' + score;
            playDing();
          }
        }
      });
      coins = coins.filter((c) => !c.collected && c.y < H + 40);
      coinSpawnIn -= step;
      if (coinSpawnIn <= 0) {
        coinSpawnIn = spawnCoin() ? 100 + Math.random() * 90 : 10;
      }

      if (boostTime > 0) {
        boostTime = Math.max(0, boostTime - step);
      } else {
        boostCool = Math.max(0, boostCool - step);
      }
      updateBoostBtn();
      shieldTime = Math.max(0, shieldTime - step);
      shieldSpawnIn -= step;
      if (shieldSpawnIn <= 0) {
        shieldSpawnIn = spawnShield() ? 1500 + Math.random() * 900 : 10;
      }

      levelFlash = Math.max(0, levelFlash - step);
    }

    // ---------- drawing ----------

    function drawScenery() {
      const land = getComputedStyle(document.documentElement).getPropertyValue('--land').trim() || '#6fbf73';
      const bed = getComputedStyle(document.documentElement).getPropertyValue('--bed').trim() || '#b8a88a';
      ctx.fillStyle = land;
      ctx.fillRect(0, 0, W, H);

      // trees and bushes drifting past
      const idx = Math.floor(scrollTotal / 90);
      const base = scrollTotal % 90;
      const treeXs = [22, 140, 260, 378];
      for (let r = -1; r < H / 90 + 1; r++) {
        const y = r * 90 + base;
        const g = idx - r;
        const x = treeXs[((g * 7) % 4 + 4) % 4];
        const size = 11 + (((g * 13) % 5) + 5) % 5 * 2;
        ctx.beginPath();
        ctx.arc(x, y, size, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(30, 90, 45, 0.85)';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(x - size * 0.25, y - size * 0.25, size * 0.45, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.14)';
        ctx.fill();
      }

      drawBridgeWater();

      laneX.forEach((x) => {
        // gravel bed
        ctx.fillStyle = bed;
        ctx.fillRect(x - 30, 0, 60, H);
        // sleepers
        ctx.fillStyle = '#7a5a3a';
        const sb = scrollTotal % 22;
        for (let y = -22 + sb; y < H + 22; y += 22) ctx.fillRect(x - 24, y, 48, 7);
        // rails
        ctx.fillStyle = '#8d969e';
        ctx.fillRect(x - 15, 0, 3, H);
        ctx.fillRect(x + 12, 0, 3, H);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.fillRect(x - 15, 0, 1, H);
        ctx.fillRect(x + 12, 0, 1, H);
      });

      drawBridgeDecks();
      drawStationGround();
    }

    // Every so often the line passes something special: a station, then a
    // tunnel, then a bridge over a river. One per slot, so they never overlap.
    const slotLength = 1500;
    const stationNames = ['Nikko Central', 'Sunny Junction', 'Gold Hill', 'Pine Valley', 'Rocky Bridge', 'Seaside'];
    const eventKinds = ['station', 'tunnel', 'bridge'];
    const eventLengths = { station: 300, tunnel: 440, bridge: 200 };
    function eventInfo() {
      const n = Math.floor(scrollTotal / slotLength);
      const kind = eventKinds[n % 3];
      const len = eventLengths[kind];
      const top = (scrollTotal % slotLength) - len; // top edge on screen
      return { n, kind, len, top, name: stationNames[Math.floor(n / 3) % stationNames.length] };
    }
    // the moment the engine reaches the thing (sign, tunnel mouth or river)
    function eventReach(ev) {
      return ev.kind === 'station' ? ev.top + 20 : ev.top + ev.len;
    }
    const stationInfo = () => {
      const ev = eventInfo();
      return { top: ev.kind === 'station' ? ev.top : 9999, name: ev.name };
    };
    const stationLength = eventLengths.station;

    function drawStationGround() {
      const st = stationInfo();
      if (st.top > H || st.top + stationLength < 0) return;
      [140, 260].forEach((cx) => {
        // platform
        ctx.fillStyle = '#c9ccd1';
        ctx.fillRect(cx - 27, st.top, 54, stationLength);
        ctx.fillStyle = '#ffd23f';
        ctx.fillRect(cx - 27, st.top, 3, stationLength);
        ctx.fillRect(cx + 24, st.top, 3, stationLength);
        // little roof over the platform
        ctx.fillStyle = 'rgba(190, 60, 60, 0.95)';
        roundedRect(cx - 24, st.top + 60, 48, stationLength - 120, 6);
        ctx.fill();
        ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
        ctx.fillRect(cx - 24, st.top + 60, 48, 6);
        // waiting passengers
        const colours = ['#2b7bd6', '#e8a33d', '#8e44ad', '#2a9d8f'];
        for (let i = 0; i < 5; i++) {
          const px = cx - 16 + ((i * 11) % 32);
          const py = st.top + 40 + i * 48 + (cx === 260 ? 18 : 0);
          ctx.beginPath();
          ctx.arc(px, py, 5, 0, Math.PI * 2);
          ctx.fillStyle = colours[(i + (cx === 260 ? 2 : 0)) % 4];
          ctx.fill();
          ctx.beginPath();
          ctx.arc(px, py - 7, 3.5, 0, Math.PI * 2);
          ctx.fillStyle = '#f2c9a0';
          ctx.fill();
        }
      });
    }

    function drawStationSign() {
      const st = stationInfo();
      const y = st.top + 20;
      if (y < -40 || y > H + 20) return;
      ctx.fillStyle = '#4a4f55';
      ctx.fillRect(0, y, W, 6);
      ctx.fillRect(6, y, 6, 20);
      ctx.fillRect(W - 12, y, 6, 20);
      roundedRect(W / 2 - 100, y - 6, 200, 34, 8);
      ctx.fillStyle = '#1d4e89';
      ctx.fill();
      ctx.strokeStyle = 'white';
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      ctx.font = 'bold 18px sans-serif';
      ctx.fillText('🚉 ' + st.name, W / 2, y + 17);
    }

    function drawBridgeWater() {
      const ev = eventInfo();
      if (ev.kind !== 'bridge' || ev.top > H || ev.top + ev.len < 0) return;
      const water = getComputedStyle(document.documentElement).getPropertyValue('--water').trim() || '#4aa3d8';
      ctx.fillStyle = '#7a5b3a';
      ctx.fillRect(0, ev.top - 6, W, ev.len + 12); // muddy banks
      ctx.fillStyle = water;
      ctx.fillRect(0, ev.top, W, ev.len);
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 9; i++) {
        const wy = ev.top + 14 + ((i * 47) % (ev.len - 28));
        const wx = (i * 83 + scrollTotal * 0.6) % (W + 40) - 20;
        ctx.beginPath();
        ctx.moveTo(wx, wy);
        ctx.quadraticCurveTo(wx + 10, wy - 5, wx + 20, wy);
        ctx.quadraticCurveTo(wx + 30, wy + 5, wx + 40, wy);
        ctx.stroke();
      }
    }

    function drawBridgeDecks() {
      const ev = eventInfo();
      if (ev.kind !== 'bridge' || ev.top > H || ev.top + ev.len < 0) return;
      laneX.forEach((x) => {
        ctx.fillStyle = '#9a7b4f';
        ctx.fillRect(x - 34, ev.top - 8, 68, ev.len + 16);
        ctx.fillStyle = '#7a5a3a';
        const sb = scrollTotal % 22;
        ctx.save();
        ctx.beginPath();
        ctx.rect(x - 34, ev.top - 8, 68, ev.len + 16);
        ctx.clip();
        for (let y = -22 + sb; y < H + 22; y += 22) ctx.fillRect(x - 24, y, 48, 7);
        ctx.fillStyle = '#8d969e';
        ctx.fillRect(x - 15, 0, 3, H);
        ctx.fillRect(x + 12, 0, 3, H);
        ctx.restore();
        // railings
        ctx.fillStyle = '#5b4026';
        ctx.fillRect(x - 34, ev.top - 8, 3, ev.len + 16);
        ctx.fillRect(x + 31, ev.top - 8, 3, ev.len + 16);
        for (let y = ev.top; y <= ev.top + ev.len; y += 25) {
          ctx.fillRect(x - 36, y - 2, 7, 5);
          ctx.fillRect(x + 29, y - 2, 7, 5);
        }
      });
    }

    // A tunnel through a hill. The hill covers everything beside the tracks;
    // inside it is dark, with just a headlight glow around the engine.
    function drawTunnel() {
      const ev = eventInfo();
      if (ev.kind !== 'tunnel' || ev.top > H || ev.top + ev.len < 0) return;
      const y0 = ev.top;
      const bands = [[0, 50], [110, 170], [230, 290], [350, W]];
      bands.forEach(([x0, x1]) => {
        ctx.fillStyle = '#566b4a';
        ctx.fillRect(x0, y0, x1 - x0, ev.len);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.10)';
        for (let i = 0; i < 6; i++) {
          ctx.beginPath();
          ctx.arc(x0 + ((i * 29) % Math.max(8, x1 - x0 - 8)) + 8, y0 + 40 + i * 62, 9, 0, Math.PI * 2);
          ctx.fill();
        }
      });
      // darkness over the three tracks, lit by the headlight
      ctx.save();
      ctx.beginPath();
      laneX.forEach((x) => ctx.rect(x - 30, y0, 60, ev.len));
      ctx.clip();
      const ex = cars[0].x;
      const grad = ctx.createRadialGradient(ex, engineY - 60, 30, ex, engineY - 60, 250);
      grad.addColorStop(0, 'rgba(0, 0, 10, 0.25)');
      grad.addColorStop(1, 'rgba(0, 0, 10, 0.78)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, y0, W, ev.len);
      ctx.restore();
      // stone mouths at both ends (the tracks pass through the gaps)
      [y0, y0 + ev.len - 22].forEach((y) => {
        bands.forEach(([x0, x1]) => {
          ctx.fillStyle = '#8a8d93';
          ctx.fillRect(x0, y, x1 - x0, 22);
          ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';
          ctx.fillRect(x0, y + 20, x1 - x0, 2);
        });
      });
    }

    function drawAnimal(o) {
      if (o.scared) {
        ctx.fillStyle = '#e63946';
        ctx.font = 'bold 20px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('!', o.x, o.y - o.hh - 12);
      }
      const d = o.dir;
      const swing = Math.sin(o.phase) * 3;
      ctx.save();
      ctx.translate(o.x, o.y);
      // legs peeking out at the sides
      ctx.fillStyle = '#3a2a20';
      for (let i = 0; i < 2; i++) {
        const lx = (i === 0 ? -0.5 : 0.45) * o.hw;
        ctx.fillRect(lx - 2 + swing * (i ? -1 : 1), -o.hh - 3, 4, 5);
        ctx.fillRect(lx - 2 - swing * (i ? -1 : 1), o.hh - 2, 4, 5);
      }
      if (o.animal === 'cow') {
        ctx.fillStyle = '#ffffff';
        roundedRect(-o.hw, -o.hh, o.hw * 2, o.hh * 2, 8);
        ctx.fill();
        ctx.strokeStyle = '#555a60';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.fillStyle = '#2a2a2e';
        ctx.beginPath();
        ctx.ellipse(-d * 7, -3, 6, 4, 0.4, 0, Math.PI * 2);
        ctx.ellipse(d * 2, 4, 5, 3.5, -0.3, 0, Math.PI * 2);
        ctx.fill();
        // tail
        ctx.strokeStyle = '#2a2a2e';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-d * o.hw, 0);
        ctx.lineTo(-d * (o.hw + 7), swing);
        ctx.stroke();
        // head
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(d * (o.hw + 3), 0, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#f4a6b0';
        ctx.beginPath();
        ctx.arc(d * (o.hw + 8), 0, 4.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#d9c9a0';
        ctx.fillRect(d * (o.hw + 1) - 1.5, -10, 3, 4);
        ctx.fillRect(d * (o.hw + 1) - 1.5, 6, 3, 4);
      } else {
        ctx.fillStyle = '#f3efe2';
        [[-9, -3], [0, -5], [9, -3], [-8, 4], [1, 5], [9, 4]].forEach(([bx, by]) => {
          ctx.beginPath();
          ctx.arc(bx * (o.hw / 12), by, 8, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.25)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(0, 0, o.hw - 3, 0, Math.PI * 2);
        ctx.stroke();
        ctx.fillStyle = '#3b3b40';
        ctx.beginPath();
        ctx.arc(d * (o.hw + 3), 0, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillRect(d * (o.hw + 1) - 1.5, -9, 3, 4);
        ctx.fillRect(d * (o.hw + 1) - 1.5, 5, 3, 4);
      }
      ctx.restore();
    }

    function drawRock(o) {
      const r = 18;
      ctx.beginPath();
      for (let i = 0; i < 8; i++) {
        const a = (i / 8) * Math.PI * 2;
        const rr = r * (0.82 + 0.28 * Math.abs(Math.sin(o.seed + i * 2.3)));
        const px = o.x + Math.cos(a) * rr;
        const py = o.y + Math.sin(a) * rr;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = '#6b6f76';
      ctx.fill();
      ctx.strokeStyle = '#3d4045';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(o.x - 6, o.y - 6, 6, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
      ctx.fill();
    }

    function drawBarrier(o) {
      const x0 = o.x - 28;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(x0, o.y - 8, 56, 16);
      ctx.fillStyle = '#ff8c1a';
      for (let i = 0; i < 4; i++) ctx.fillRect(x0 + i * 14 + 3, o.y - 8, 7, 16);
      ctx.strokeStyle = '#7a4a10';
      ctx.lineWidth = 2;
      ctx.strokeRect(x0, o.y - 8, 56, 16);
      ctx.fillStyle = '#4a4f55';
      ctx.fillRect(x0 - 4, o.y - 12, 6, 24);
      ctx.fillRect(x0 + 54, o.y - 12, 6, 24);
    }

    function roundedRect(x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    // A bullet train, drawn from above, nose pointing up: white and sleek,
    // with a long pointed nose and a coloured stripe.
    const whiteBody = ['#dfe6ec', '#ffffff', '#cfd8e0'];
    const redBody = ['#b41e1e', '#f04646', '#a01818'];
    function drawEngine(stripe, outline, headlight, body) {
      body = body || whiteBody;
      ctx.beginPath();
      ctx.moveTo(-16, 25);
      ctx.lineTo(-16, -4);
      ctx.bezierCurveTo(-16, -17, -8, -25, 0, -29);
      ctx.bezierCurveTo(8, -25, 16, -17, 16, -4);
      ctx.lineTo(16, 25);
      ctx.closePath();
      const g = ctx.createLinearGradient(-16, 0, 16, 0);
      g.addColorStop(0, body[0]);
      g.addColorStop(0.5, body[1]);
      g.addColorStop(1, body[2]);
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = outline;
      ctx.lineWidth = 2;
      ctx.stroke();
      // stripe down each side
      ctx.fillStyle = stripe;
      ctx.fillRect(-15, -2, 4, 26);
      ctx.fillRect(11, -2, 4, 26);
      // windscreen
      ctx.beginPath();
      ctx.moveTo(-9, -8);
      ctx.bezierCurveTo(-9, -15, -4, -20, 0, -22);
      ctx.bezierCurveTo(4, -20, 9, -15, 9, -8);
      ctx.closePath();
      ctx.fillStyle = '#26323d';
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
      ctx.fillRect(-6, -13, 5, 2);
      // roof stripe and vents
      ctx.fillStyle = stripe;
      ctx.fillRect(-2, -3, 4, 28);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
      ctx.fillRect(-9, 8, 18, 3);
      ctx.fillRect(-9, 15, 18, 3);
      if (headlight) {
        ctx.beginPath();
        ctx.arc(0, -27, 3, 0, Math.PI * 2);
        ctx.fillStyle = '#fff3a0';
        ctx.fill();
      }
    }

    function drawCarriage(stripe, outline, body) {
      body = body || whiteBody;
      roundedRect(-16, -22, 32, 44, 7);
      const g = ctx.createLinearGradient(-16, 0, 16, 0);
      g.addColorStop(0, body[0]);
      g.addColorStop(0.5, body[1]);
      g.addColorStop(1, body[2]);
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = outline;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = stripe;
      ctx.fillRect(-15, -20, 4, 40);
      ctx.fillRect(11, -20, 4, 40);
      ctx.fillRect(-2, -20, 4, 40);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
      ctx.fillRect(-9, -12, 18, 3);
      ctx.fillRect(-9, 9, 18, 3);
    }

    function drawOncoming(o) {
      if (o.scared) {
        ctx.fillStyle = '#e63946';
        ctx.font = 'bold 22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('!', o.x, o.y - o.hh - 18);
      }
      // an oncoming train: engine facing down, with a carriage behind it
      ctx.save();
      ctx.translate(o.x, o.y + 22);
      ctx.rotate(Math.PI);
      drawEngine('#1f6fd6', '#3b4752', true);
      ctx.restore();
      ctx.save();
      ctx.translate(o.x, o.y - 30);
      drawCarriage('#1f6fd6', '#3b4752');
      ctx.restore();
      ctx.beginPath();
      ctx.arc(o.x, o.y + 50, 14, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 243, 160, 0.35)';
      ctx.fill();
    }

    function drawShieldPickup(c) {
      const pulse = 1 + 0.08 * Math.sin(frame * 0.12);
      const g = ctx.createRadialGradient(c.x - 4, c.y - 4, 2, c.x, c.y, c.r * pulse);
      g.addColorStop(0, 'rgba(210, 240, 255, 0.95)');
      g.addColorStop(1, 'rgba(60, 150, 255, 0.85)');
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r * pulse, 0, Math.PI * 2);
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
      // little shield badge
      ctx.beginPath();
      ctx.moveTo(c.x - 7, c.y - 7);
      ctx.lineTo(c.x + 7, c.y - 7);
      ctx.lineTo(c.x + 7, c.y + 1);
      ctx.quadraticCurveTo(c.x + 7, c.y + 8, c.x, c.y + 11);
      ctx.quadraticCurveTo(c.x - 7, c.y + 8, c.x - 7, c.y + 1);
      ctx.closePath();
      ctx.fillStyle = '#1d4e89';
      ctx.fill();
    }

    function drawShieldBubble() {
      if (shieldTime <= 0 || crashing) return;
      if (shieldTime < 120 && Math.floor(shieldTime / 6) % 2 === 0) return; // flicker when running out
      const cx = (cars[0].x + cars[cars.length - 1].x) / 2;
      const top = engineY - 30;
      const bottom = carY(cars.length - 1) + 28;
      const cy = (top + bottom) / 2;
      const rx = 34 + Math.abs(cars[0].x - cars[cars.length - 1].x) / 2;
      const ry = (bottom - top) / 2 + 4;
      const pulse = 1 + 0.03 * Math.sin(frame * 0.2);
      const g = ctx.createRadialGradient(cx, cy, ry * 0.3, cx, cy, ry * pulse);
      g.addColorStop(0, 'rgba(120, 200, 255, 0.05)');
      g.addColorStop(1, 'rgba(120, 200, 255, 0.4)');
      ctx.save();
      ctx.translate(cx, cy);
      ctx.scale(rx / ry, 1);
      ctx.beginPath();
      ctx.arc(0, 0, ry * pulse, 0, Math.PI * 2);
      ctx.restore();
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = 'rgba(190, 230, 255, 0.95)';
      ctx.lineWidth = 3;
      ctx.stroke();
    }

    function drawBoostEffects() {
      if (boostTime <= 0) return;
      // speed lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 14; i++) {
        const x = (i * 97) % W;
        const y = ((i * 131 + frame * 28) % (H + 80)) - 40;
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x, y + 36);
        ctx.stroke();
      }
      // flame out of the back
      const fx = cars[cars.length - 1].x;
      const fy = carY(cars.length - 1) + 24;
      const len = 26 + Math.random() * 14;
      ctx.fillStyle = 'rgba(255, 140, 30, 0.9)';
      ctx.beginPath();
      ctx.moveTo(fx - 9, fy);
      ctx.lineTo(fx + 9, fy);
      ctx.lineTo(fx, fy + len);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 235, 120, 0.95)';
      ctx.beginPath();
      ctx.moveTo(fx - 4, fy);
      ctx.lineTo(fx + 4, fy);
      ctx.lineTo(fx, fy + len * 0.55);
      ctx.closePath();
      ctx.fill();
    }

    function drawSpeedometer() {
      const cx = W - 50;
      const cy = 52;
      const r = 40;
      const a0 = Math.PI * 0.75;
      const a1 = Math.PI * 2.25;
      const frac = Math.min(1, shownMph / mphMax);
      ctx.beginPath();
      ctx.arc(cx, cy, r + 4, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
      ctx.fill();
      // dial track
      ctx.lineCap = 'round';
      ctx.lineWidth = 6;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
      ctx.beginPath();
      ctx.arc(cx, cy, r - 5, a0, a1);
      ctx.stroke();
      // coloured part: green when slow, red when really fast
      if (frac > 0.005) {
        ctx.strokeStyle = 'hsl(' + Math.round(130 - frac * 130) + ', 85%, 55%)';
        ctx.beginPath();
        ctx.arc(cx, cy, r - 5, a0, a0 + (a1 - a0) * frac);
        ctx.stroke();
      }
      ctx.lineCap = 'butt';
      // tick marks every 100 mph
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
      ctx.lineWidth = 2;
      for (let m = 0; m <= mphMax; m += 100) {
        const a = a0 + (a1 - a0) * (m / mphMax);
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(a) * (r - 14), cy + Math.sin(a) * (r - 14));
        ctx.lineTo(cx + Math.cos(a) * (r - 9), cy + Math.sin(a) * (r - 9));
        ctx.stroke();
      }
      // needle
      const na = a0 + (a1 - a0) * frac;
      ctx.strokeStyle = '#ff5a4a';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(na) * (r - 12), cy + Math.sin(na) * (r - 12));
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(cx, cy, 4, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      // numbers
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText(String(Math.round(shownMph)), cx, cy + 22);
      ctx.font = '10px sans-serif';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
      ctx.fillText('mph', cx, cy + 33);
    }

    function drawStorm() {
      if (rainAmt > 0.01) {
        // gloomy sky
        ctx.fillStyle = 'rgba(14, 24, 48, ' + 0.3 * rainAmt + ')';
        ctx.fillRect(0, 0, W, H);
        // rain
        ctx.strokeStyle = 'rgba(205, 225, 255, 0.55)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        const n = Math.floor(drops.length * rainAmt);
        for (let i = 0; i < n; i++) {
          const d = drops[i];
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(d.x + d.len * 0.28, d.y - d.len);
        }
        ctx.stroke();
      }
      if (flash > 0.02) {
        if (bolt && flash > 0.3) {
          ctx.lineJoin = 'round';
          ctx.strokeStyle = 'rgba(200, 220, 255, ' + flash * 0.5 + ')';
          ctx.lineWidth = 9;
          ctx.beginPath();
          bolt.forEach(([bx, by], i) => (i ? ctx.lineTo(bx, by) : ctx.moveTo(bx, by)));
          ctx.stroke();
          ctx.strokeStyle = 'rgba(255, 255, 255, ' + Math.min(1, flash * 1.2) + ')';
          ctx.lineWidth = 3;
          ctx.stroke();
        }
        ctx.fillStyle = 'rgba(235, 240, 255, ' + 0.5 * flash + ')';
        ctx.fillRect(0, 0, W, H);
      }
    }

    function drawShieldHud() {
      if (shieldTime <= 0 || !started || gameOver) return;
      const w = 90;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
      roundedRect(10, 10, w + 36, 22, 11);
      ctx.fill();
      ctx.fillStyle = '#55b6ff';
      roundedRect(32, 16, Math.max(2, w * (shieldTime / shieldDuration)), 10, 5);
      ctx.fill();
      ctx.font = '14px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillStyle = 'white';
      ctx.fillText('🛡️', 14, 27);
    }

    function drawCoin(c) {
      if (c.kind === 'shield') return drawShieldPickup(c);
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd400';
      ctx.fill();
      ctx.strokeStyle = '#b8860b';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r - 4, 0, Math.PI * 2);
      ctx.strokeStyle = '#fff3b0';
      ctx.stroke();
    }

    function drawTrain() {
      const t = crashing || (gameOver && crashT > 0) ? crashT : 0;
      // carriages first, so the engine sits on top
      for (let i = cars.length - 1; i >= 0; i--) {
        const c = cars[i];
        const x = c.x + crashDir * t * i * 20;
        const y = carY(i);
        const angle = crashDir * t * (0.3 + 0.3 * i);
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(angle);
        if (i === 0) drawEngine('#ffffff', '#6b1212', true, redBody);
        else drawCarriage('#ffffff', '#6b1212', redBody);
        ctx.restore();
      }
    }

    function drawEffects() {
      puffs.forEach((p) => {
        const a = p.age / 40;
        ctx.beginPath();
        ctx.arc(p.x, p.y + p.age * 2.4, 5 + a * 12, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(245, 245, 245, ' + 0.55 * (1 - a) + ')';
        ctx.fill();
      });
      rings.forEach((r) => {
        const a = r.age / 40;
        ctx.beginPath();
        ctx.arc(r.x, r.y, 6 + a * 34, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 255, 255, ' + 0.8 * (1 - a) + ')';
        ctx.lineWidth = 3;
        ctx.stroke();
      });
    }

    // Night: everything goes dark except a glow from the headlight, with
    // little lights on the engine and carriages.
    function drawNight() {
      const ex = cars[0].x;
      const grad = ctx.createRadialGradient(ex, engineY - 90, 40, ex, engineY - 90, 330);
      grad.addColorStop(0, 'rgba(8, 12, 45, 0.15)');
      grad.addColorStop(1, 'rgba(8, 12, 45, 0.7)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, W, H);
      // headlight beam
      const beam = ctx.createLinearGradient(0, engineY - 20, 0, engineY - 190);
      beam.addColorStop(0, 'rgba(255, 244, 180, 0.35)');
      beam.addColorStop(1, 'rgba(255, 244, 180, 0)');
      ctx.fillStyle = beam;
      ctx.beginPath();
      ctx.moveTo(ex - 8, engineY - 22);
      ctx.lineTo(ex + 8, engineY - 22);
      ctx.lineTo(ex + 34, engineY - 190);
      ctx.lineTo(ex - 34, engineY - 190);
      ctx.closePath();
      ctx.fill();
      // little yellow window lights on the carriages
      ctx.fillStyle = 'rgba(255, 230, 120, 0.9)';
      for (let i = 1; i < cars.length; i++) {
        const cx = cars[i].x;
        const cy = carY(i);
        ctx.fillRect(cx - 7, cy - 10, 5, 5);
        ctx.fillRect(cx + 2, cy - 10, 5, 5);
        ctx.fillRect(cx - 7, cy + 3, 5, 5);
        ctx.fillRect(cx + 2, cy + 3, 5, 5);
      }
    }

    function drawOverlay(title, subtitle) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      ctx.font = 'bold 30px sans-serif';
      ctx.fillText(title, W / 2, H / 2 - 16);
      ctx.font = '18px sans-serif';
      ctx.fillText(subtitle, W / 2, H / 2 + 20);
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      drawScenery();

      coins.forEach(drawCoin);
      obstacles.forEach((o) => {
        if (o.kind === 'rock') drawRock(o);
        else if (o.kind === 'barrier') drawBarrier(o);
        else if (o.kind === 'train') drawOncoming(o);
      });
      drawTrain();
      drawShieldBubble();
      drawBoostEffects();
      drawTunnel();
      obstacles.forEach((o) => {
        if (o.kind === 'animal') drawAnimal(o);
      });
      drawStationSign();
      drawEffects();

      if (night) drawNight();
      drawStorm();
      drawShieldHud();
      drawSpeedometer();

      if (levelFlash > 0 && started && !gameOver) {
        const alpha = Math.min(1, levelFlash / 20);
        ctx.fillStyle = 'rgba(255, 235, 90, ' + alpha + ')';
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Level ' + level + '!' + (level === stormLevel ? ' \u26C8\uFE0F Storm!' : ''), W / 2, 70);
      }

      if (!started) {
        drawOverlay('Tap to start', 'Tap left, middle or right to switch tracks!');
      } else if (gameOver) {
        drawOverlay('Derailed!', 'Tap to try again • Score: ' + score);
      }
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function boot(data) {
      if (data && typeof data.best === 'number' && data.best > best) {
        best = data.best;
        bestEl.textContent = 'Best: ' + best;
      }
      draw();
      loop();
    }

    if (window.claude && window.claude.hot && window.claude.hot.snapshot) {
      window.claude.hot.snapshot(() => ({ best }));
    }

    if (window.claude && window.claude.hot && window.claude.hot.ready) {
      window.claude.hot.ready(boot);
    } else {
      boot(window.claude && window.claude.hot ? window.claude.hot.data : null);
    }
  })();
</script>
  </body>
</html>
