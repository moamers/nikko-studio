      (streetCars[g] || []).forEach((c) => {
        const cy = sy + (c.dir > 0 ? 9 : -9);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
        ctx.fillRect(c.x - 10, cy - 4, 22, 10);
        ctx.fillStyle = c.colour;
        roundedRect(c.x - 11, cy - 6, 22, 11, 3);
        ctx.fill();
        ctx.fillStyle = 'rgba(30, 40, 55, 0.75)';
        ctx.fillRect(c.x + c.dir * 3 - 3, cy - 4, 7, 7);
