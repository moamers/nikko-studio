<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plane Game</title>
  </head>
  <body>
    <h1>✈️ Plane Game</h1>
    <p>Drag your finger (or mouse) up and down to fly the plane!</p>
    <canvas id="game" width="400" height="600"></canvas>
    <p id="score">Score: 0</p>

    <style>
      body {
        font-family: sans-serif;
        text-align: center;
        background: #e6f7ff;
      }
      canvas {
        background: #dcf4ff;
        border: 4px solid #333;
        border-radius: 8px;
        touch-action: none;
      }
      #score {
        font-size: 24px;
        font-weight: bold;
      }
    </style>

    <script>
      const canvas = document.getElementById('game');
      const ctx = canvas.getContext('2d');
      const scoreEl = document.getElementById('score');

      const plane = { x: 80, y: 300 };
      const moveSpeed = 28; // how fast arrow keys move the plane
      const followSpeed = 0.75; // how smoothly the plane chases the pointer

      let targetY = plane.y;
      let keys = { up: false, down: false };
      let bars = []; // the white obstacle bars you have to fly through
      let score = 0;
      let gameOver = false;

      // Fluffy clouds drifting in the background, purely for looks — the
      // plane can fly straight through them, they're not obstacles.
      let clouds = [];

      function spawnBackgroundClouds() {
        clouds = [];
        for (let i = 0; i < 6; i++) {
          clouds.push({
            x: Math.random() * canvas.width,
            y: 40 + Math.random() * (canvas.height - 80),
            scale: 0.6 + Math.random() * 0.8,
          });
        }
      }

      function drawCloud(x, y, scale) {
        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.beginPath();
        ctx.arc(x, y, 18 * scale, 0, Math.PI * 2);
        ctx.arc(x + 20 * scale, y - 8 * scale, 22 * scale, 0, Math.PI * 2);
        ctx.arc(x + 42 * scale, y, 18 * scale, 0, Math.PI * 2);
        ctx.arc(x + 20 * scale, y + 6 * scale, 20 * scale, 0, Math.PI * 2);
        ctx.fill();
      }

      function spawnBar() {
        // Starts easy (big gap, slow) and gets trickier the longer you survive.
        const gapHeight = Math.max(85, 190 - score * 6);
        const gapY = 60 + Math.random() * (canvas.height - gapHeight - 120);
        bars.push({ x: canvas.width, gapY, gapHeight, passed: false });
      }

      function barSpeed() {
        return 7; // fast right from the start, the whole game through
      }

      function resetGame() {
        plane.y = canvas.height / 2;
        targetY = plane.y;
        bars = [];
        score = 0;
        gameOver = false;
        spawnBar();
        spawnBackgroundClouds();
      }

      function pointerToY(clientX, clientY) {
        const rect = canvas.getBoundingClientRect();
        return ((clientY - rect.top) / rect.height) * canvas.height;
      }

      canvas.addEventListener('mousedown', () => {
        if (gameOver) resetGame();
      });
      canvas.addEventListener('mousemove', (e) => {
        targetY = pointerToY(e.clientX, e.clientY);
      });
      canvas.addEventListener(
        'touchstart',
        (e) => {
          if (gameOver) resetGame();
          targetY = pointerToY(e.touches[0].clientX, e.touches[0].clientY);
        },
        { passive: true }
      );
      canvas.addEventListener(
        'touchmove',
        (e) => {
          targetY = pointerToY(e.touches[0].clientX, e.touches[0].clientY);
        },
        { passive: true }
      );

      window.addEventListener('keydown', (e) => {
        if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = true;
        if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = true;
        if (e.code === 'Space' && gameOver) resetGame();
      });
      window.addEventListener('keyup', (e) => {
        if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = false;
        if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = false;
      });

      function update() {
        if (gameOver) return;

        // Arrow keys nudge the target directly; otherwise the plane
        // smoothly glides toward wherever the pointer last was.
        if (keys.up) targetY -= moveSpeed;
        if (keys.down) targetY += moveSpeed;
        targetY = Math.max(20, Math.min(canvas.height - 20, targetY));

        plane.y += (targetY - plane.y) * followSpeed;

        clouds.forEach((cloud) => {
          cloud.x -= 0.5; // slower than the bars, so it feels far away
          if (cloud.x < -60) {
            cloud.x = canvas.width + 60;
            cloud.y = 40 + Math.random() * (canvas.height - 80);
          }
        });

        bars.forEach((bar) => {
          bar.x -= barSpeed();

          if (
            plane.x + 12 > bar.x &&
            plane.x - 12 < bar.x + 40 &&
            (plane.y - 12 < bar.gapY || plane.y + 12 > bar.gapY + bar.gapHeight)
          ) {
            gameOver = true;
          }

          if (!bar.passed && bar.x + 40 < plane.x) {
            bar.passed = true;
            score++;
          }
        });

        bars = bars.filter((bar) => bar.x > -50);

        if (bars.length === 0 || bars[bars.length - 1].x < canvas.width - 260) {
          spawnBar();
        }

        scoreEl.textContent = 'Score: ' + score;
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        clouds.forEach((cloud) => drawCloud(cloud.x, cloud.y, cloud.scale));

        ctx.fillStyle = '#ffffff';
        bars.forEach((bar) => {
          ctx.fillRect(bar.x, 0, 40, bar.gapY);
          ctx.fillRect(bar.x, bar.gapY + bar.gapHeight, 40, canvas.height);
        });

        ctx.save();
        ctx.translate(plane.x, plane.y);
        ctx.font = '30px serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('✈️', 0, 0);
        ctx.restore();

        if (gameOver) {
          ctx.fillStyle = 'rgba(0,0,0,0.5)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = 'white';
          ctx.font = '28px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Game Over!', canvas.width / 2, canvas.height / 2 - 20);
          ctx.font = '18px sans-serif';
          ctx.fillText('Click or tap to try again', canvas.width / 2, canvas.height / 2 + 20);
        }
      }

      function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
      }

      resetGame();
      loop();
    </script>
  </body>
</html>
