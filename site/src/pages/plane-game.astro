<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plane Game</title>
  </head>
  <body>
    <h1>✈️ Plane Game</h1>
    <p>Drag your finger (or mouse) up and down to fly the plane!</p>
    <canvas id="game" width="400" height="600"></canvas>
    <p id="score">Score: 0</p>

    <style>
      body {
        font-family: sans-serif;
        text-align: center;
        background: #cdefff;
      }
      canvas {
        background: #aee6ff;
        border: 4px solid #333;
        border-radius: 8px;
        touch-action: none;
      }
      #score {
        font-size: 24px;
        font-weight: bold;
      }
    </style>

    <script>
      const canvas = document.getElementById('game');
      const ctx = canvas.getContext('2d');
      const scoreEl = document.getElementById('score');

      const plane = { x: 80, y: 300 };
      const moveSpeed = 6; // how fast arrow keys move the plane
      const followSpeed = 0.15; // how smoothly the plane chases the pointer

      let targetY = plane.y;
      let keys = { up: false, down: false };
      let clouds = [];
      let score = 0;
      let gameOver = false;

      function spawnCloud() {
        const gapHeight = 220; // nice and big — easy to fly through
        const gapY = 60 + Math.random() * (canvas.height - gapHeight - 120);
        clouds.push({ x: canvas.width, gapY, gapHeight, passed: false });
      }

      function resetGame() {
        plane.y = canvas.height / 2;
        targetY = plane.y;
        clouds = [];
        score = 0;
        gameOver = false;
        spawnCloud();
      }

      function pointerToY(clientX, clientY) {
        const rect = canvas.getBoundingClientRect();
        return ((clientY - rect.top) / rect.height) * canvas.height;
      }

      canvas.addEventListener('mousedown', () => {
        if (gameOver) resetGame();
      });
      canvas.addEventListener('mousemove', (e) => {
        targetY = pointerToY(e.clientX, e.clientY);
      });
      canvas.addEventListener(
        'touchstart',
        (e) => {
          if (gameOver) resetGame();
          targetY = pointerToY(e.touches[0].clientX, e.touches[0].clientY);
        },
        { passive: true }
      );
      canvas.addEventListener(
        'touchmove',
        (e) => {
          targetY = pointerToY(e.touches[0].clientX, e.touches[0].clientY);
        },
        { passive: true }
      );

      window.addEventListener('keydown', (e) => {
        if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = true;
        if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = true;
        if (e.code === 'Space' && gameOver) resetGame();
      });
      window.addEventListener('keyup', (e) => {
        if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = false;
        if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = false;
      });

      function update() {
        if (gameOver) return;

        // Arrow keys nudge the target directly; otherwise the plane
        // smoothly glides toward wherever the pointer last was.
        if (keys.up) targetY -= moveSpeed;
        if (keys.down) targetY += moveSpeed;
        targetY = Math.max(20, Math.min(canvas.height - 20, targetY));

        plane.y += (targetY - plane.y) * followSpeed;

        clouds.forEach((cloud) => {
          cloud.x -= 2; // slow and friendly

          if (
            plane.x + 12 > cloud.x &&
            plane.x - 12 < cloud.x + 40 &&
            (plane.y - 12 < cloud.gapY || plane.y + 12 > cloud.gapY + cloud.gapHeight)
          ) {
            gameOver = true;
          }

          if (!cloud.passed && cloud.x + 40 < plane.x) {
            cloud.passed = true;
            score++;
          }
        });

        clouds = clouds.filter((cloud) => cloud.x > -50);

        if (clouds.length === 0 || clouds[clouds.length - 1].x < canvas.width - 260) {
          spawnCloud();
        }

        scoreEl.textContent = 'Score: ' + score;
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = '#ffffff';
        clouds.forEach((cloud) => {
          ctx.fillRect(cloud.x, 0, 40, cloud.gapY);
          ctx.fillRect(cloud.x, cloud.gapY + cloud.gapHeight, 40, canvas.height);
        });

        ctx.save();
        ctx.translate(plane.x, plane.y);
        ctx.font = '30px serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('✈️', 0, 0);
        ctx.restore();

        if (gameOver) {
          ctx.fillStyle = 'rgba(0,0,0,0.5)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = 'white';
          ctx.font = '28px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Game Over!', canvas.width / 2, canvas.height / 2 - 20);
          ctx.font = '18px sans-serif';
          ctx.fillText('Click or tap to try again', canvas.width / 2, canvas.height / 2 + 20);
        }
      }

      function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
      }

      resetGame();
      loop();
    </script>
  </body>
</html>
