<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plane Dodge</title>
  </head>
  <body>
<style is:global>
  /* Layout: centered single-column game card, canvas fills available width up to a max */
  :root {
    --bg: #f6fdff;
    --card: #ffffff;
    --ink: #1a2a33;
    --ink-soft: #4a6572;
    --sky: #fafdff;
    --accent: #ff6b4a;
    --good: #35b07a;
    --skyline-far: rgba(130, 160, 185, 0.35);
    --skyline-near: rgba(105, 135, 165, 0.5);
    --ground: #6f8192;
    --dim: 0;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0f1b22;
      --card: #16262f;
      --ink: #eaf4f8;
      --ink-soft: #9fb6c0;
      --sky: #1c3440;
      --accent: #ff8a6a;
      --good: #4fd9a0;
      --skyline-far: rgba(80, 120, 145, 0.35);
      --skyline-near: rgba(70, 110, 135, 0.55);
      --ground: #2d4351;
      --dim: 0.3;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0f1b22;
    --card: #16262f;
    --ink: #eaf4f8;
    --ink-soft: #9fb6c0;
    --sky: #1c3440;
    --accent: #ff8a6a;
    --good: #4fd9a0;
    --skyline-far: rgba(80, 120, 145, 0.35);
    --skyline-near: rgba(70, 110, 135, 0.55);
    --ground: #2d4351;
    --dim: 0.3;
    color-scheme: dark;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .wrap {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 24px;
  }

  h1 {
    font-size: clamp(22px, 6vw, 30px);
    margin: 0;
    text-align: center;
  }

  .sub {
    color: var(--ink-soft);
    margin: 0;
    text-align: center;
    font-size: 14px;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    max-height: 70vh;
    background: var(--card);
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background: var(--sky);
    touch-action: manipulation;
  }

  .score {
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .best {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .level {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .controls button {
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    background: var(--card);
    border: 2px solid var(--ink-soft);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
  }

  .controls button:disabled {
    opacity: 0.55;
    cursor: default;
  }

  #boostBtn:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .controls button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .controls button:active {
    transform: scale(0.96);
  }
</style>

<div class="wrap">
  <h1>&#9992;&#65039; Plane Dodge</h1>
  <p class="sub">Drag your finger (or mouse) up and down to fly. Dodge the buildings and other planes, and collect the rainbows!</p>
  <p class="score" id="score">Score: 0</p>
  <p class="level" id="level">Level 1</p>
  <p class="best" id="best">Best: 0</p>
  <div class="stage">
    <canvas id="game" width="400" height="600" aria-label="Plane dodge game"></canvas>
  </div>
  <div class="controls">
    <button type="button" id="easyBtn">&#128034; Easy</button>
    <button type="button" id="normalBtn">&#127918; Normal</button>
    <button type="button" id="boostBtn">&#128640; Boost</button>
    <button type="button" id="soundBtn">&#128266; Sound on</button>
  </div>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const bestEl = document.getElementById('best');
    const levelEl = document.getElementById('level');
    const easyBtn = document.getElementById('easyBtn');
    const normalBtn = document.getElementById('normalBtn');
    const boostBtn = document.getElementById('boostBtn');
    const soundBtn = document.getElementById('soundBtn');
    const pointsPerLevel = 5;

    const W = canvas.width;
    const H = canvas.height;

    const plane = { x: 80, y: 300 };
    const planeSize = 56; // overall size the plane shape is drawn at
    const planeHit = 21; // half-height/width used for collisions
    const moveSpeed = 23;
    const followSpeed = 0.58;
    const buildingW = 46;
    const barSpacing = 260; // distance between pairs of buildings
    const jetSpacing = barSpacing + 120; // more room when a plane flies between them
    const deckH = 14; // the underside of the floating city along the top

    let targetY = plane.y;
    let keys = { up: false, down: false };
    let bars = []; // pairs of buildings: one hanging from the sky city, one from the ground
    let jets = []; // other planes crossing the sky
    let barsPassed = 0;
    // Day and night: one full cycle takes about 100 seconds. 0 is morning,
    // then noon, sunset (about 0.45), night, and back to sunrise.
    let dayClock = 0;
    const dayLength = 6000; // frames
    let nightAmt = 0; // 0 = bright day, 1 = deep night
    let glowAmt = 0; // how much sunset / sunrise colour there is
    let shownMph = 0; // the speedometer needle eases toward the real speed
    const mphPerUnit = 35; // game speed -> miles per hour
    const mphMax = 900;
    let rainbowTime = 0; // frames of rainbow trail left
    let trail = []; // where the plane has just been, for the rainbow trail
    let sparkles = [];
    let score = 0;
    let level = 1;
    let levelFlash = 0;
    let best = 0;
    let bestNormal = 0;
    let bestEasy = 0;
    let easy = false;
    let gameOver = false;
    let started = false;
    let frame = 0;
    let lastTime = null;
    let skylineScroll = 0;
    let barId = 0;

    // boost: a burst of speed and double points
    let boostTime = 0;
    let boostCool = 0;
    const boostDuration = 120; // 2 seconds
    const boostSpeed = 1.5;
    let boostCooldown = 420; // 7 seconds (shorter in easy mode)

    // ---------- the plane (and the other planes) ----------

    // A big white airliner seen from above, nose pointing right.
    function drawAirliner(s, red, gold, shadow) {
      const edge = '#6f7c89';
      ctx.save();
      if (shadow) {
        ctx.shadowColor = 'rgba(30, 50, 70, 0.3)';
        ctx.shadowBlur = 5;
      }
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = edge;
      [-1, 1].forEach((side) => {
        // swept wing
        ctx.beginPath();
        ctx.moveTo(s * 0.2, side * s * 0.12);
        ctx.lineTo(-s * 0.4, side * s * 0.72);
        ctx.lineTo(-s * 0.72, side * s * 0.72);
        ctx.lineTo(-s * 0.5, side * s * 0.12);
        ctx.closePath();
        ctx.fillStyle = '#eef2f6';
        ctx.fill();
        ctx.stroke();
        // tail plane
        ctx.beginPath();
        ctx.moveTo(-s * 0.72, side * s * 0.1);
        ctx.lineTo(-s * 0.98, side * s * 0.36);
        ctx.lineTo(-s * 1.1, side * s * 0.36);
        ctx.lineTo(-s * 1.0, side * s * 0.08);
        ctx.closePath();
        ctx.fillStyle = red;
        ctx.fill();
        ctx.stroke();
      });
      ctx.restore();
      [-1, 1].forEach((side) => {
        // wing tip
        ctx.beginPath();
        ctx.moveTo(-s * 0.4 + 0.5, side * s * 0.7);
        ctx.lineTo(-s * 0.72, side * s * 0.72);
        ctx.lineTo(-s * 0.64, side * s * 0.6);
        ctx.lineTo(-s * 0.33, side * s * 0.6);
        ctx.closePath();
        ctx.fillStyle = red;
        ctx.fill();
        // two engines on each wing
        [[-s * 0.08, side * s * 0.34], [-s * 0.3, side * s * 0.54]].forEach(([ex, ey]) => {
          ctx.beginPath();
          ctx.ellipse(ex, ey, s * 0.2, s * 0.085, 0, 0, Math.PI * 2);
          ctx.fillStyle = '#dfe5eb';
          ctx.fill();
          ctx.strokeStyle = edge;
          ctx.stroke();
          ctx.beginPath();
          ctx.ellipse(ex + s * 0.13, ey, s * 0.07, s * 0.07, 0, -Math.PI / 2, Math.PI / 2);
          ctx.fillStyle = red;
          ctx.fill();
        });
      });
      // fuselage
      ctx.beginPath();
      ctx.ellipse(0, 0, s, s * 0.17, 0, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.save();
      ctx.clip();
      ctx.fillStyle = red; // tail cone
      ctx.fillRect(-s * 1.1, -s * 0.3, s * 0.5, s * 0.6);
      ctx.restore();
      ctx.strokeStyle = edge;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.ellipse(0, 0, s, s * 0.17, 0, 0, Math.PI * 2);
      ctx.stroke();
      // stripe along each side and little windows
      ctx.strokeStyle = gold;
      ctx.lineWidth = 1.6;
      [-1, 1].forEach((side) => {
        ctx.beginPath();
        ctx.moveTo(-s * 0.56, side * s * 0.1);
        ctx.lineTo(s * 0.72, side * s * 0.1);
        ctx.stroke();
      });
      ctx.fillStyle = '#5a7184';
      for (let i = 0; i < 9; i++) {
        const wx = -s * 0.45 + i * s * 0.12;
        ctx.fillRect(wx, -s * 0.045, 2, 2);
        ctx.fillRect(wx, s * 0.025, 2, 2);
      }
      // cockpit
      ctx.beginPath();
      ctx.ellipse(s * 0.78, 0, s * 0.1, s * 0.07, 0, 0, Math.PI * 2);
      ctx.fillStyle = '#2f4358';
      ctx.fill();
    }

    function drawPlane() {
      const s = planeSize * 0.55;
      drawAirliner(s, '#d71920', '#c9a24a', true);
      if (nightAmt > 0.2) {
        const a = Math.min(1, nightAmt * 1.3);
        const blink = Math.floor(frame / 25) % 2 === 0;
        const lamp = (x, y, col, r) => {
          const g = ctx.createRadialGradient(x, y, 0, x, y, r * 3);
          g.addColorStop(0, col);
          g.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.globalAlpha = a;
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(x, y, r * 3, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;
        };
        lamp(-s * 0.55, -s * 0.72, 'rgba(255, 70, 70, 0.95)', 2.2); // red on the left wing tip
        lamp(-s * 0.55, s * 0.72, 'rgba(80, 255, 120, 0.95)', 2.2); // green on the right
        lamp(s * 0.98, 0, 'rgba(255, 255, 235, 0.95)', 2.4); // nose light
        if (blink) lamp(-s * 1.05, 0, 'rgba(255, 255, 255, 0.95)', 2.2); // flashing tail light
      }
    }

    function drawJet(j) {
      ctx.save();
      ctx.globalAlpha = Math.min(1, j.age / 20); // fades in so it does not pop up
      ctx.translate(j.x, j.y);
      ctx.rotate(Math.max(-0.3, Math.min(0.3, j.vy * 0.25)));
      ctx.scale(-1, 1); // flying left, towards you
      drawAirliner(24, j.accent, '#b8c2cc', false);
      ctx.restore();
    }

    // ---------- sound (made with Web Audio, no files needed) ----------
    let audio = null;
    let noiseBuf = null;
    let soundOn = true;
    let hum = null;
    let humIn = 0;

    function getAudio() {
      if (audio) return audio;
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        audio = new AC();
        noiseBuf = audio.createBuffer(1, audio.sampleRate * 0.5, audio.sampleRate);
        const d = noiseBuf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      } catch (e) {
        audio = null;
      }
      return audio;
    }

    function unlockAudio() {
      try {
        const a = getAudio();
        if (a && a.state === 'suspended') a.resume();
      } catch (e) {}
    }

    function noiseBurst(freq, dur, vol, type) {
      try {
        const a = getAudio();
        if (!a || !soundOn) return;
        const src = a.createBufferSource();
        src.buffer = noiseBuf;
        const f = a.createBiquadFilter();
        f.type = type || 'bandpass';
        f.frequency.value = freq;
        const g = a.createGain();
        const t = a.currentTime;
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + dur);
        src.connect(f);
        f.connect(g);
        g.connect(a.destination);
        src.start(t);
        src.stop(t + dur + 0.02);
      } catch (e) {}
    }

    function tone(type, f0, f1, dur, vol, delay) {
      try {
        const a = getAudio();
        if (!a || !soundOn) return;
        const o = a.createOscillator();
        const g = a.createGain();
        const t = a.currentTime + (delay || 0);
        o.type = type;
        o.frequency.setValueAtTime(f0, t);
        o.frequency.linearRampToValueAtTime(f1, t + dur);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(vol, t + 0.04);
        g.gain.setValueAtTime(vol, t + dur * 0.7);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        o.connect(g);
        g.connect(a.destination);
        o.start(t);
        o.stop(t + dur + 0.05);
      } catch (e) {}
    }

    // The jet engine: a low rumble plus rushing air that gets louder and
    // higher the faster you fly.
    function ensureHum() {
      try {
        const a = getAudio();
        if (!a || hum) return;
        const o = a.createOscillator();
        o.type = 'sawtooth';
        const f = a.createBiquadFilter();
        f.type = 'lowpass';
        f.frequency.value = 300;
        const g = a.createGain();
        g.gain.value = 0;
        o.connect(f);
        f.connect(g);
        g.connect(a.destination);
        o.start();
        const n = a.createBufferSource();
        n.buffer = noiseBuf;
        n.loop = true;
        const nf = a.createBiquadFilter();
        nf.type = 'bandpass';
        nf.frequency.value = 900;
        nf.Q.value = 0.5;
        const ng = a.createGain();
        ng.gain.value = 0;
        n.connect(nf);
        nf.connect(ng);
        ng.connect(a.destination);
        n.start();
        hum = { o, f, g, nf, ng };
      } catch (e) {
        hum = null;
      }
    }

    function updateHum(on, speed) {
      try {
        if (!on || !soundOn) {
          if (hum) {
            const t0 = audio.currentTime;
            hum.g.gain.setTargetAtTime(0, t0, 0.08);
            hum.ng.gain.setTargetAtTime(0, t0, 0.08);
          }
          return;
        }
        ensureHum();
        if (!hum) return;
        const t = audio.currentTime;
        hum.o.frequency.setTargetAtTime(55 + speed * 7, t, 0.15);
        hum.f.frequency.setTargetAtTime(220 + speed * 30, t, 0.15);
        hum.g.gain.setTargetAtTime(0.035, t, 0.15);
        hum.nf.frequency.setTargetAtTime(600 + speed * 90, t, 0.15);
        hum.ng.gain.setTargetAtTime(0.014 + speed * 0.003, t, 0.15);
      } catch (e) {}
    }

    function playDing() {
      tone('sine', 900, 1400, 0.2, 0.1);
      tone('sine', 1200, 1800, 0.2, 0.08, 0.1);
    }

    function playBoost() {
      noiseBurst(1200, 0.7, 0.25);
      tone('sawtooth', 110, 460, 0.7, 0.06);
    }

    function playRainbow() {
      [523, 659, 784, 1047].forEach((f, i) => tone('sine', f, f * 1.01, 0.22, 0.09, i * 0.08));
    }

    function playPassBy() {
      noiseBurst(1700, 0.45, 0.2);
      tone('sawtooth', 600, 240, 0.4, 0.035);
    }

    function playCrash() {
      noiseBurst(300, 0.7, 0.4, 'lowpass');
      tone('sawtooth', 200, 45, 0.6, 0.12);
    }

    function setSound(on) {
      soundOn = on;
      soundBtn.innerHTML = on ? '&#128266; Sound on' : '&#128263; Sound off';
      if (!on) updateHum(false, 0);
    }

    soundBtn.addEventListener('click', () => {
      unlockAudio();
      setSound(!soundOn);
    });

    // ---------- easy mode / normal mode ----------
    try {
      bestNormal = Number(localStorage.getItem('planeDodgeBest') || 0);
      bestEasy = Number(localStorage.getItem('planeDodgeBestEasy') || 0);
      easy = localStorage.getItem('planeEasy') === '1';
    } catch (e) {}

    function applyMode() {
      easyBtn.setAttribute('aria-pressed', easy ? 'true' : 'false');
      normalBtn.setAttribute('aria-pressed', easy ? 'false' : 'true');
      boostCooldown = easy ? 300 : 420;
      best = easy ? bestEasy : bestNormal;
      bestEl.textContent = 'Best: ' + best;
    }

    function setMode(wantEasy) {
      if (easy === wantEasy) return;
      easy = wantEasy;
      try {
        localStorage.setItem('planeEasy', easy ? '1' : '0');
      } catch (e) {}
      applyMode();
      if (started) {
        // switching in the middle of a game: go back to the start screen
        resetGame();
        started = false;
        bars = [];
        jets = [];
        updateBoostBtn(true);
      }
    }
    easyBtn.addEventListener('click', () => setMode(true));
    normalBtn.addEventListener('click', () => setMode(false));

    // ---------- boost ----------
    let boostLabel = '';
    function updateBoostBtn(force) {
      const running = started && !gameOver;
      let label = '\u{1F680} Boost';
      if (boostTime > 0) label = '\u{1F525} Zoom!';
      else if (boostCool > 0) label = '\u{1F680} ' + Math.ceil(boostCool / 60) + 's';
      const off = !running || boostTime > 0 || boostCool > 0;
      if (force || label !== boostLabel || boostBtn.disabled !== off) {
        boostLabel = label;
        boostBtn.textContent = label;
        boostBtn.disabled = off;
      }
    }

    function useBoost() {
      unlockAudio();
      if (!started || gameOver || boostTime > 0 || boostCool > 0) return;
      boostTime = boostDuration;
      boostCool = boostCooldown;
      playBoost();
      updateBoostBtn();
    }
    boostBtn.addEventListener('click', useBoost);

    // ---------- the world ----------
    function levelFor(s) {
      return Math.floor(s / pointsPerLevel) + 1;
    }

    // Steady within a level, a little faster each level up.
    function baseSpeed() {
      return Math.min(16.5, 4.7 + (level - 1) * 1.5) * (easy ? 0.75 : 1);
    }

    function worldSpeed() {
      return baseSpeed() * (boostTime > 0 ? boostSpeed : 1);
    }

    // Fluffy clouds drifting in the background, purely for looks — the
    // plane can fly straight through them, they're not obstacles.
    let clouds = [];

    function spawnBackgroundClouds() {
      clouds = [];
      for (let i = 0; i < 6; i++) {
        clouds.push({
          x: Math.random() * W,
          y: 40 + Math.random() * (H - 200),
          scale: 0.6 + Math.random() * 0.8,
        });
      }
    }

    const smooth = (t) => t * t * (3 - 2 * t);
    function nightAmount(p) {
      if (p < 0.4) return 0;
      if (p < 0.55) return smooth((p - 0.4) / 0.15);
      if (p < 0.85) return 1;
      return 1 - smooth((p - 0.85) / 0.15);
    }
    function glowAmount(p) {
      const sunset = Math.max(0, 1 - Math.abs(p - 0.45) / 0.1);
      const sunrise = Math.max(0, 1 - Math.abs(p - 0.94) / 0.08);
      return Math.max(sunset, sunrise);
    }
    const hex = (c) => [parseInt(c.slice(1, 3), 16), parseInt(c.slice(3, 5), 16), parseInt(c.slice(5, 7), 16)];
    const mix = (a, b, t) => {
      const x = hex(a);
      const y = hex(b);
      return 'rgb(' + Math.round(x[0] + (y[0] - x[0]) * t) + ',' + Math.round(x[1] + (y[1] - x[1]) * t) + ',' + Math.round(x[2] + (y[2] - x[2]) * t) + ')';
    };
    const rgbHex = (str) => {
      const m = /rgb\((\d+),(\d+),(\d+)\)/.exec(str);
      return '#' + [1, 2, 3].map((i) => Number(m[i]).toString(16).padStart(2, '0')).join('');
    };
    const mixHex = (a, b, t) => rgbHex(mix(a, b, t));
    // [time, top colour, bottom colour]
    const skyLight = [
      [0.0, '#bfe8ff', '#fafdff'],
      [0.36, '#bfe8ff', '#fafdff'],
      [0.45, '#ff9a76', '#ffd9a8'],
      [0.55, '#2b3a67', '#7b5ea7'],
      [0.64, '#0e1730', '#1d2a4f'],
      [0.84, '#0e1730', '#1d2a4f'],
      [0.92, '#4b5a8f', '#ffb199'],
      [1.0, '#bfe8ff', '#fafdff'],
    ];
    const skyDark = skyLight.map(([t, top, bottom], i) => (i < 2 || i === skyLight.length - 1 ? [t, '#1c3440', '#27465a'] : [t, top, bottom]));

    function skyColours(p, dark) {
      const keys = dark ? skyDark : skyLight;
      for (let i = 0; i < keys.length - 1; i++) {
        if (p >= keys[i][0] && p <= keys[i + 1][0]) {
          const t = (p - keys[i][0]) / (keys[i + 1][0] - keys[i][0]);
          return [mixHex(keys[i][1], keys[i + 1][1], t), mixHex(keys[i][2], keys[i + 1][2], t)];
        }
      }
      return [keys[0][1], keys[0][2]];
    }

    const stars = [];
    for (let i = 0; i < 46; i++) stars.push({ x: (i * 97) % W, y: 22 + ((i * 53) % 330), r: 0.8 + (i % 3) * 0.5, tw: i * 0.7 });

    function drawSky() {
      const dark = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dim')) || 0) > 0;
      const [top, bottom] = skyColours(dayClock, dark);
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, top);
      g.addColorStop(1, bottom);
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);

      // stars come out at night
      if (nightAmt > 0.15) {
        stars.forEach((st) => {
          const tw = 0.6 + 0.4 * Math.sin(frame * 0.05 + st.tw);
          ctx.fillStyle = 'rgba(255, 255, 240, ' + nightAmt * tw + ')';
          ctx.beginPath();
          ctx.arc(st.x, st.y, st.r, 0, Math.PI * 2);
          ctx.fill();
        });
      }

      // the sun crosses the sky by day, the moon by night
      const day = dayClock < 0.5;
      const u = day ? dayClock / 0.5 : (dayClock - 0.5) / 0.5;
      const bx = 36 + (W - 72) * u;
      const by = 60 + (1 - Math.sin(Math.PI * u)) * 150;
      if (day) {
        const warm = Math.max(glowAmt, 0);
        const sg = ctx.createRadialGradient(bx, by, 4, bx, by, 46);
        sg.addColorStop(0, 'rgba(255, 244, 190, 0.95)');
        sg.addColorStop(1, 'rgba(255, 220, 120, 0)');
        ctx.fillStyle = sg;
        ctx.fillRect(bx - 50, by - 50, 100, 100);
        ctx.beginPath();
        ctx.arc(bx, by, 14, 0, Math.PI * 2);
        ctx.fillStyle = warm > 0.2 ? '#ff9b4a' : '#ffd84a';
        ctx.fill();
      } else {
        const mg = ctx.createRadialGradient(bx, by, 4, bx, by, 38);
        mg.addColorStop(0, 'rgba(230, 240, 255, 0.5)');
        mg.addColorStop(1, 'rgba(230, 240, 255, 0)');
        ctx.fillStyle = mg;
        ctx.fillRect(bx - 40, by - 40, 80, 80);
        ctx.beginPath();
        ctx.arc(bx, by, 13, 0, Math.PI * 2);
        ctx.fillStyle = '#f4f1dc';
        ctx.fill();
        ctx.beginPath(); // a bite out of it makes a crescent
        ctx.arc(bx + 6, by - 3, 11, 0, Math.PI * 2);
        ctx.fillStyle = skyColours(dayClock, dark)[0];
        ctx.fill();
      }
    }

    // warm glow low over the city at sunset and sunrise, and darkness at night
    function drawNightAndGlow() {
      if (glowAmt > 0.01) {
        const gg = ctx.createLinearGradient(0, H * 0.45, 0, H);
        gg.addColorStop(0, 'rgba(255, 150, 90, 0)');
        gg.addColorStop(1, 'rgba(255, 130, 70, ' + 0.35 * glowAmt + ')');
        ctx.fillStyle = gg;
        ctx.fillRect(0, 0, W, H);
      }
      if (nightAmt > 0.01) {
        ctx.fillStyle = 'rgba(6, 12, 32, ' + 0.3 * nightAmt + ')';
        ctx.fillRect(0, 0, W, H);
      }
    }

    const phaseLabel = () => {
      const p = dayClock;
      if (p < 0.38) return '\u2600\uFE0F Day';
      if (p < 0.52) return '\u{1F307} Sunset';
      if (p < 0.88) return '\u{1F319} Night';
      if (p < 0.97) return '\u{1F305} Sunrise';
      return '\u2600\uFE0F Day';
    };

    function drawPhasePill() {
      const label = phaseLabel();
      ctx.font = 'bold 13px sans-serif';
      const w = ctx.measureText(label).width + 18;
      ctx.fillStyle = 'rgba(10, 18, 28, 0.55)';
      roundRect(10, deckH + 8, w, 24, 12);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'left';
      ctx.fillText(label, 19, deckH + 25);
    }

    function roundRect(x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    function drawCloud(x, y, scale) {
      ctx.beginPath();
      ctx.arc(x, y, 18 * scale, 0, Math.PI * 2);
      ctx.arc(x + 20 * scale, y - 8 * scale, 22 * scale, 0, Math.PI * 2);
      ctx.arc(x + 42 * scale, y, 18 * scale, 0, Math.PI * 2);
      ctx.arc(x + 20 * scale, y + 6 * scale, 20 * scale, 0, Math.PI * 2);
      ctx.fillStyle = mixHex('#ffffff', '#52638a', nightAmt * 0.85);
      ctx.fill();
      // A soft outline so clouds don't vanish against a very light sky.
      ctx.strokeStyle = 'rgba(120, 170, 200, 0.35)';
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    // Clouds drift in the background right away, even before the first tap,
    // so the start screen isn't empty.
    spawnBackgroundClouds();

    function spawnBar() {
      // Each level has its own fixed gap size — a clear step down, not a slow crawl.
      const gapHeight = Math.max(70, 182 - (level - 1) * 19) * (easy ? 1.25 : 1);
      const gapY = deckH + 50 + Math.random() * (H - gapHeight - 120 - deckH);
      const prev = bars[bars.length - 1];
      // From level 2, some pairs of buildings are followed by extra room with
      // another plane flying in the open air between them.
      const jetNext = level >= 2 && Math.random() < (easy ? 0.2 : 0.5);
      // sometimes a rainbow floats in the gap, ready to collect
      const rainbow =
        Math.random() < (easy ? 0.5 : 0.38)
          ? { dy: (Math.random() - 0.5) * Math.max(0, gapHeight - 90), collected: false }
          : null;
      bars.push({ x: W, gapY, gapHeight, passed: false, id: barId++, jetNext, rainbow });
      if (prev && prev.jetNext) {
        const c1 = prev.gapY + prev.gapHeight / 2;
        const c2 = gapY + gapHeight / 2;
        let y = (c1 + c2) / 2 + (Math.random() - 0.5) * 50;
        // never right where you just were, and never blocking the middle of the next gap
        for (let tries = 0; tries < 3; tries++) {
          if (Math.abs(y - c1) < 55) y = c1 + (y >= c1 ? 55 : -55);
          if (Math.abs(y - c2) < 50) y = c2 + (y >= c2 ? 50 : -50);
        }
        y = Math.max(deckH + 40, Math.min(H - 50, y));
        const accents = ['#1f6fd6', '#2a9d8f', '#f4a261', '#8e44ad', '#e63946'];
        jets.push({
          x: W - jetSpacing / 2,
          y,
          baseY: y,
          phase: Math.random() * 6,
          vy: 0,
          age: 0,
          hw: 22,
          hh: 9,
          speedMul: easy ? 1.0 : 1.08,
          accent: accents[Math.floor(Math.random() * accents.length)],
          whooshed: false,
        });
      }
    }

    function resetGame() {
      plane.y = H / 2;
      targetY = plane.y;
      bars = [];
      jets = [];
      trail = [];
      sparkles = [];
      rainbowTime = 0;
      barsPassed = 0;
      dayClock = 0; // every flight starts in the morning
      score = 0;
      level = 1;
      levelFlash = 0;
      boostTime = 0;
      boostCool = 0;
      scoreEl.textContent = 'Score: 0';
      levelEl.textContent = 'Level 1';
      gameOver = false;
      started = true;
      spawnBar();
      spawnBackgroundClouds();
      updateBoostBtn(true);
    }

    function startOrRestart() {
      if (!started || gameOver) resetGame();
    }

    function pointerToY(clientX, clientY) {
      const rect = canvas.getBoundingClientRect();
      return ((clientY - rect.top) / rect.height) * H;
    }

    canvas.addEventListener('mousedown', (e) => {
      unlockAudio();
      startOrRestart();
      targetY = pointerToY(e.clientX, e.clientY);
    });
    canvas.addEventListener('mousemove', (e) => {
      targetY = pointerToY(e.clientX, e.clientY);
    });
    canvas.addEventListener(
      'touchstart',
      (e) => {
        unlockAudio();
        startOrRestart();
        targetY = pointerToY(e.touches[0].clientX, e.touches[0].clientY);
      },
      { passive: true }
    );
    canvas.addEventListener(
      'touchmove',
      (e) => {
        targetY = pointerToY(e.touches[0].clientX, e.touches[0].clientY);
      },
      { passive: true }
    );

    window.addEventListener('keydown', (e) => {
      unlockAudio();
      if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = true;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = true;
      if (e.code === 'KeyB' || e.code === 'ShiftLeft' || e.code === 'ShiftRight') useBoost();
      if (e.code === 'Space') {
        e.preventDefault();
        startOrRestart();
      }
    });
    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = false;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = false;
    });

    function update() {
      const now = performance.now();
      let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
      lastTime = now;
      step = Math.min(Math.max(step, 0.2), 3); // same speed on 60Hz and 120Hz screens
      frame += step;

      const running = started && !gameOver;
      dayClock = (dayClock + step / dayLength) % 1;
      nightAmt = nightAmount(dayClock);
      glowAmt = glowAmount(dayClock);

      // speedometer: ease toward the speed we are really doing
      shownMph += ((running ? worldSpeed() * mphPerUnit : 0) - shownMph) * (1 - Math.pow(1 - 0.08, step));
      skylineScroll += (running ? worldSpeed() : 1.2) * step;

      // Clouds drift in the background even on the start / game-over screens.
      clouds.forEach((cloud) => {
        cloud.x -= 0.5 * step;
        if (cloud.x < -60) {
          cloud.x = W + 60;
          cloud.y = 40 + Math.random() * (H - 200);
        }
      });

      if (!running) {
        humIn -= step;
        if (humIn <= 0) {
          updateHum(false, 0);
          humIn = 10;
        }
        return;
      }

      humIn -= step;
      if (humIn <= 0) {
        updateHum(true, worldSpeed());
        humIn = 8;
      }

      if (keys.up) targetY -= moveSpeed * step;
      if (keys.down) targetY += moveSpeed * step;
      targetY = Math.max(deckH + 8, Math.min(H - 20, targetY));

      plane.y += (targetY - plane.y) * (1 - Math.pow(1 - followSpeed, step));

      const dist = worldSpeed() * step;
      const slack = easy ? 4 : 0; // easy mode forgives near misses
      const hit = planeHit - slack;

      bars.forEach((bar) => {
        bar.x -= dist;

        if (
          plane.x + hit > bar.x &&
          plane.x - hit < bar.x + buildingW &&
          (plane.y - hit < bar.gapY || plane.y + hit > bar.gapY + bar.gapHeight)
        ) {
          endGame();
        }

        if (!bar.passed && bar.x + buildingW < plane.x) {
          bar.passed = true;
          addScore(boostTime > 0 ? 2 : 1); // double points while boosting
          passedBuildings();
        }

        // collect the rainbow
        if (bar.rainbow && !bar.rainbow.collected) {
          const rx = bar.x + buildingW / 2;
          const ry = bar.gapY + bar.gapHeight / 2 + bar.rainbow.dy;
          if (Math.hypot(rx - plane.x, ry - plane.y) < 34) {
            bar.rainbow.collected = true;
            rainbowTime = 240; // a rainbow trail for 4 seconds
            playRainbow();
            for (let i = 0; i < 14; i++) {
              const a = (i / 14) * Math.PI * 2;
              sparkles.push({ x: rx, y: ry, vx: Math.cos(a) * (1.5 + Math.random() * 2), vy: Math.sin(a) * (1.5 + Math.random() * 2), age: 0, hue: i * 26 });
            }
            addScore(3);
          }
        }
      });

      jets.forEach((j) => {
        j.x -= dist * j.speedMul;
        j.phase += 0.05 * step;
        j.age += step;
        const ny = j.baseY + Math.sin(j.phase) * 14;
        j.vy = (ny - j.y) / Math.max(step, 0.2);
        j.y = ny;
        if (
          Math.abs(plane.x - j.x) < hit + j.hw - 4 - slack &&
          Math.abs(plane.y - j.y) < hit + j.hh - 3 - slack
        ) {
          endGame();
        }
        if (!j.whooshed && j.x < plane.x + 60) {
          j.whooshed = true;
          if (Math.abs(plane.y - j.y) < 90) playPassBy();
        }
      });

      if (rainbowTime > 0) {
        rainbowTime = Math.max(0, rainbowTime - step);
        trail.push({ x: plane.x - 28, y: plane.y });
      }
      trail.forEach((p) => (p.x -= dist));
      trail = trail.filter((p) => p.x > -10);
      sparkles.forEach((p) => {
        p.x += p.vx * step - dist * 0.3;
        p.y += p.vy * step;
        p.age += step;
      });
      sparkles = sparkles.filter((p) => p.age < 30);

      bars = bars.filter((bar) => bar.x > -buildingW - 10);
      jets = jets.filter((j) => j.x > -80);

      const lastBar = bars[bars.length - 1];
      if (!lastBar || lastBar.x < W - (lastBar.jetNext ? jetSpacing : barSpacing)) {
        spawnBar();
      }

      if (boostTime > 0) boostTime = Math.max(0, boostTime - step);
      else boostCool = Math.max(0, boostCool - step);
      updateBoostBtn();

      levelFlash = Math.max(0, levelFlash - step);
    }

    // Points from rainbows and boosting never speed up the levels: you level
    // up by getting past the buildings.
    function addScore(n) {
      score += n;
      scoreEl.textContent = 'Score: ' + score;
    }

    function passedBuildings() {
      barsPassed++;
      const newLevel = levelFor(barsPassed);
      if (newLevel > level) {
        level = newLevel;
        levelEl.textContent = 'Level ' + level;
        levelFlash = 90; // ~1.5s at 60fps
        playDing();
      }
    }

    function endGame() {
      if (gameOver) return;
      gameOver = true;
      boostTime = 0;
      playCrash();
      updateHum(false, 0);
      updateBoostBtn();
      if (score > best) {
        best = score;
        if (easy) bestEasy = best;
        else bestNormal = best;
        bestEl.textContent = 'Best: ' + best;
        try {
          localStorage.setItem(easy ? 'planeDodgeBestEasy' : 'planeDodgeBest', String(best));
        } catch (e) {}
      }
    }

    // ---------- drawing the city ----------
    const palette = ['#7b8fa3', '#8a9aa8', '#6e8397', '#9a8f87', '#7d8f8a', '#8b86a0'];
    const hash = (a, b) => (Math.imul(a + 7919, 73856093) ^ Math.imul(b + 104729, 19349663)) >>> 0;

    // far-away towers drifting past at the bottom, in two layers
    function drawSkyline(scroll, width, minH, maxH, colour, seed) {
      const idx = Math.floor(scroll / width);
      const off = scroll % width;
      ctx.fillStyle = colour;
      for (let i = -1; i < W / width + 2; i++) {
        const g = idx + i;
        const h = minH + (hash(g, seed) % (maxH - minH));
        const x = i * width - off;
        ctx.fillRect(x, H - h, width - 4, h);
        if (hash(g, seed + 1) % 3 === 0) ctx.fillRect(x + width / 2 - 3, H - h - 14, 3, 14); // antenna
      }
    }

    function drawBuilding(x, y, w, h, hang, id) {
      if (h <= 0) return;
      const base = palette[id % palette.length];
      ctx.fillStyle = base;
      ctx.fillRect(x, y, w, h);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.18)';
      ctx.fillRect(x + w - 8, y, 8, h); // shaded side
      ctx.fillStyle = 'rgba(255, 255, 255, 0.18)';
      ctx.fillRect(x, y, 3, h); // lit edge
      // windows
      for (let wy = y + 8; wy < y + h - 12; wy += 16) {
        for (let c = 0; c < 3; c++) {
          const hv = hash(id * 31 + c, Math.floor(wy));
          const lit = nightAmt > 0.5 ? hv % 6 !== 0 : hv % 3 !== 0; // more lights on at night
          ctx.fillStyle = lit ? (nightAmt > 0.5 ? '#fff0b0' : '#ffe9a6') : 'rgba(40, 55, 75, 0.6)';
          ctx.fillRect(x + 7 + c * 13, wy, 8, 9);
        }
      }
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
      // spire: an antenna on the ground ones, a point on the hanging ones
      ctx.fillStyle = '#5a6672';
      if (hang) {
        ctx.beginPath();
        ctx.moveTo(x + w / 2 - 7, y + h);
        ctx.lineTo(x + w / 2 + 7, y + h);
        ctx.lineTo(x + w / 2, y + h + 14);
        ctx.closePath();
        ctx.fill();
      } else {
        ctx.fillRect(x + w / 2 - 1, y - 14, 2, 14);
        ctx.beginPath();
        ctx.arc(x + w / 2, y - 15, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = Math.floor(frame / 30) % 2 ? '#ff4d4d' : '#7a2a2a';
        ctx.fill();
      }
    }

    function drawCityLayers() {
      const cs = getComputedStyle(document.documentElement);
      drawSkyline(skylineScroll * 0.25, 46, 50, 140, cs.getPropertyValue('--skyline-far').trim() || 'rgba(130,160,185,0.35)', 3);
      drawSkyline(skylineScroll * 0.5, 62, 40, 105, cs.getPropertyValue('--skyline-near').trim() || 'rgba(105,135,165,0.5)', 11);
      ctx.fillStyle = cs.getPropertyValue('--ground').trim() || '#6f8192';
      ctx.fillRect(0, H - 6, W, 6);
    }

    // the floating city we fly under: its underside runs along the top
    function drawDeck() {
      ctx.fillStyle = '#7c8a98';
      ctx.fillRect(0, 0, W, deckH);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
      ctx.fillRect(0, deckH - 3, W, 3);
      const off = skylineScroll % 40;
      for (let x = -off; x < W; x += 40) {
        ctx.fillStyle = '#ffe9a6';
        ctx.fillRect(x + 12, deckH - 6, 4, 4);
        ctx.fillStyle = 'rgba(255, 233, 166, ' + (0.25 + 0.4 * nightAmt) + ')';
        ctx.fillRect(x + 8, deckH - 3, 12, 3 + 3 * nightAmt);
      }
    }

    const rainbowColours = ['#e63946', '#f4a261', '#ffd23f', '#52b788', '#4cc9f0', '#9b5de5'];

    function drawRainbow(x, y) {
      const bob = Math.sin(frame * 0.08 + x * 0.05) * 3;
      ctx.save();
      ctx.translate(x, y + bob);
      ctx.lineWidth = 3.2;
      rainbowColours.forEach((col, i) => {
        ctx.beginPath();
        ctx.arc(0, 6, 22 - i * 3.2, Math.PI, Math.PI * 2);
        ctx.strokeStyle = col;
        ctx.stroke();
      });
      // a little cloud at each end
      ctx.fillStyle = '#ffffff';
      [-1, 1].forEach((side) => {
        ctx.beginPath();
        ctx.arc(side * 20, 8, 5, 0, Math.PI * 2);
        ctx.arc(side * 15, 10, 4.5, 0, Math.PI * 2);
        ctx.arc(side * 25, 10, 4, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.restore();
    }

    function drawRainbowTrail() {
      if (trail.length < 2) return;
      ctx.lineWidth = 3.2;
      ctx.lineJoin = 'round';
      rainbowColours.forEach((col, i) => {
        ctx.beginPath();
        trail.forEach((p, k) => (k ? ctx.lineTo(p.x, p.y + (i - 2.5) * 3.2) : ctx.moveTo(p.x, p.y + (i - 2.5) * 3.2)));
        ctx.strokeStyle = col;
        ctx.globalAlpha = 0.9;
        ctx.stroke();
      });
      ctx.globalAlpha = 1;
    }

    function drawSparkles() {
      sparkles.forEach((p) => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 3 * (1 - p.age / 30) + 0.5, 0, Math.PI * 2);
        ctx.fillStyle = 'hsla(' + p.hue + ', 90%, 60%, ' + (1 - p.age / 30) + ')';
        ctx.fill();
      });
    }

    function drawFlame() {
      if (boostTime <= 0) return;
      // speed lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.65)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 9; i++) {
        const y = 30 + ((i * 67) % (H - 60));
        const x = W - (((i * 113 + frame * 30) % (W + 120)) - 40);
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x + 40, y);
        ctx.stroke();
      }
      // flame out of the back
      const len = 22 + Math.random() * 12;
      ctx.fillStyle = 'rgba(255, 140, 30, 0.9)';
      ctx.beginPath();
      ctx.moveTo(plane.x - 34, plane.y - 6);
      ctx.lineTo(plane.x - 34, plane.y + 6);
      ctx.lineTo(plane.x - 34 - len, plane.y);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 235, 120, 0.95)';
      ctx.beginPath();
      ctx.moveTo(plane.x - 34, plane.y - 3);
      ctx.lineTo(plane.x - 34, plane.y + 3);
      ctx.lineTo(plane.x - 34 - len * 0.55, plane.y);
      ctx.closePath();
      ctx.fill();
    }

    function drawSpeedometer() {
      const cx = W - 50;
      const cy = 66;
      const r = 40;
      const a0 = Math.PI * 0.75;
      const a1 = Math.PI * 2.25;
      const frac = Math.min(1, shownMph / mphMax);
      ctx.beginPath();
      ctx.arc(cx, cy, r + 4, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
      ctx.fill();
      ctx.lineCap = 'round';
      ctx.lineWidth = 6;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
      ctx.beginPath();
      ctx.arc(cx, cy, r - 5, a0, a1);
      ctx.stroke();
      // coloured part: green when slow, red when really fast
      if (frac > 0.005) {
        ctx.strokeStyle = 'hsl(' + Math.round(130 - frac * 130) + ', 85%, 55%)';
        ctx.beginPath();
        ctx.arc(cx, cy, r - 5, a0, a0 + (a1 - a0) * frac);
        ctx.stroke();
      }
      ctx.lineCap = 'butt';
      // tick marks every 300 mph
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
      ctx.lineWidth = 2;
      for (let m = 0; m <= mphMax; m += 300) {
        const a = a0 + (a1 - a0) * (m / mphMax);
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(a) * (r - 14), cy + Math.sin(a) * (r - 14));
        ctx.lineTo(cx + Math.cos(a) * (r - 9), cy + Math.sin(a) * (r - 9));
        ctx.stroke();
      }
      // needle
      const na = a0 + (a1 - a0) * frac;
      ctx.strokeStyle = '#ff5a4a';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(na) * (r - 12), cy + Math.sin(na) * (r - 12));
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(cx, cy, 4, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      // numbers
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText(String(Math.round(shownMph)), cx, cy + 22);
      ctx.font = '10px sans-serif';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
      ctx.fillText('mph', cx, cy + 33);
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      drawSky();

      clouds.forEach((cloud) => drawCloud(cloud.x, cloud.y, cloud.scale));
      drawCityLayers();

      bars.forEach((bar) => {
        drawBuilding(bar.x, deckH, buildingW, bar.gapY - deckH, true, bar.id * 2);
        drawBuilding(bar.x, bar.gapY + bar.gapHeight, buildingW, H - 6 - (bar.gapY + bar.gapHeight), false, bar.id * 2 + 1);
      });
      drawDeck();

      bars.forEach((bar) => {
        if (bar.rainbow && !bar.rainbow.collected) drawRainbow(bar.x + buildingW / 2, bar.gapY + bar.gapHeight / 2 + bar.rainbow.dy);
      });
      jets.forEach(drawJet);
      drawRainbowTrail();

      drawFlame();
      drawSparkles();
      ctx.save();
      ctx.translate(plane.x, plane.y);
      const angle = Math.max(-0.4, Math.min(0.4, (targetY - plane.y) / 60));
      ctx.rotate(angle);
      drawPlane();
      ctx.restore();

      drawNightAndGlow();
      const dim = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dim')) || 0;
      if (dim > 0) {
        ctx.fillStyle = 'rgba(5, 12, 28, ' + dim + ')';
        ctx.fillRect(0, 0, W, H);
      }

      drawSpeedometer();
      drawPhasePill();

      if (levelFlash > 0 && started && !gameOver) {
        const alpha = Math.min(1, levelFlash / 20);
        ctx.fillStyle = `rgba(255, 196, 0, ${alpha})`;
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Level ' + level + '!', W / 2, 70);
      }

      if (!started) {
        drawOverlay('Tap to start', 'Dodge the buildings and other planes!');
      } else if (gameOver) {
        drawOverlay('Game Over!', 'Tap to try again • Score: ' + score);
      }
    }

    function drawOverlay(title, subtitle) {
      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      ctx.font = 'bold 30px sans-serif';
      ctx.fillText(title, W / 2, H / 2 - 16);
      ctx.font = '18px sans-serif';
      ctx.fillText(subtitle, W / 2, H / 2 + 20);
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function boot(data) {
      if (data) {
        const n = Math.max(data.bestNormal || 0, data.best || 0);
        if (n > bestNormal) bestNormal = n;
        if ((data.bestEasy || 0) > bestEasy) bestEasy = data.bestEasy;
        best = easy ? bestEasy : bestNormal;
        bestEl.textContent = 'Best: ' + best;
      }
      draw();
      loop();
    }

    applyMode();
    updateBoostBtn(true);

    if (window.claude && window.claude.hot && window.claude.hot.snapshot) {
      window.claude.hot.snapshot(() => ({ bestNormal, bestEasy }));
    }

    if (window.claude && window.claude.hot && window.claude.hot.ready) {
      window.claude.hot.ready(boot);
    } else {
      boot(window.claude && window.claude.hot ? window.claude.hot.data : null);
    }
  })();
</script>
  </body>
</html>
