<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plane Game</title>
  </head>
  <body>
    <h1>✈️ Plane Game</h1>
    <p>Drag your finger (or mouse) up and down to fly the plane!</p>
    <canvas id="game" width="400" height="600"></canvas>
    <p id="score">Score: 0</p>
    <p id="level">Level: 1</p>

    <style>
      body {
        font-family: sans-serif;
        text-align: center;
        background: #f6fdff;
      }
      canvas {
        background: #fafdff;
        border: 4px solid #333;
        border-radius: 8px;
        touch-action: none;
      }
      #score {
        font-size: 24px;
        font-weight: bold;
      }
      #level {
        font-size: 16px;
        color: #4a6572;
        margin-top: -8px;
      }
    </style>

    <script>
      const canvas = document.getElementById('game');
      const ctx = canvas.getContext('2d');
      const scoreEl = document.getElementById('score');
      const levelEl = document.getElementById('level');
      const pointsPerLevel = 5;

      const plane = { x: 80, y: 300 };
      const planeSize = 52; // overall size the plane shape is drawn at
      const planeHit = 21; // half-height/width used for collisions
      const planeColor = '#e63946'; // red
      const planeOutline = '#9c1c2b';

      function drawPlane() {
        // A big white airliner seen from above, nose pointing right, with a red
        // tail, red engine fronts, red wing tips and a gold stripe.
        const s = planeSize * 0.55;
        const red = '#d71920';
        const gold = '#c9a24a';
        const edge = '#6f7c89';
        ctx.save();
        ctx.shadowColor = 'rgba(30, 50, 70, 0.3)';
        ctx.shadowBlur = 5;
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = edge;
        [-1, 1].forEach((side) => {
          // swept wing
          ctx.beginPath();
          ctx.moveTo(s * 0.2, side * s * 0.12);
          ctx.lineTo(-s * 0.4, side * s * 0.72);
          ctx.lineTo(-s * 0.72, side * s * 0.72);
          ctx.lineTo(-s * 0.5, side * s * 0.12);
          ctx.closePath();
          ctx.fillStyle = '#eef2f6';
          ctx.fill();
          ctx.stroke();
          // tail plane
          ctx.beginPath();
          ctx.moveTo(-s * 0.72, side * s * 0.1);
          ctx.lineTo(-s * 0.98, side * s * 0.36);
          ctx.lineTo(-s * 1.1, side * s * 0.36);
          ctx.lineTo(-s * 1.0, side * s * 0.08);
          ctx.closePath();
          ctx.fillStyle = red;
          ctx.fill();
          ctx.stroke();
        });
        ctx.restore();
        [-1, 1].forEach((side) => {
          // red wing tip
          ctx.beginPath();
          ctx.moveTo(-s * 0.4 + 0.5, side * s * 0.7);
          ctx.lineTo(-s * 0.72, side * s * 0.72);
          ctx.lineTo(-s * 0.64, side * s * 0.6);
          ctx.lineTo(-s * 0.33, side * s * 0.6);
          ctx.closePath();
          ctx.fillStyle = red;
          ctx.fill();
          // two engines on each wing
          [[-s * 0.08, side * s * 0.34], [-s * 0.3, side * s * 0.54]].forEach(([ex, ey]) => {
            ctx.beginPath();
            ctx.ellipse(ex, ey, s * 0.2, s * 0.085, 0, 0, Math.PI * 2);
            ctx.fillStyle = '#dfe5eb';
            ctx.fill();
            ctx.strokeStyle = edge;
            ctx.stroke();
            ctx.beginPath();
            ctx.ellipse(ex + s * 0.13, ey, s * 0.07, s * 0.07, 0, -Math.PI / 2, Math.PI / 2);
            ctx.fillStyle = red;
            ctx.fill();
          });
        });
        // fuselage
        ctx.beginPath();
        ctx.ellipse(0, 0, s, s * 0.17, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.save();
        ctx.clip();
        ctx.fillStyle = red; // red tail cone
        ctx.fillRect(-s * 1.1, -s * 0.3, s * 0.5, s * 0.6);
        ctx.restore();
        ctx.strokeStyle = edge;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.ellipse(0, 0, s, s * 0.17, 0, 0, Math.PI * 2);
        ctx.stroke();
        // gold stripe along each side and little windows
        ctx.strokeStyle = gold;
        ctx.lineWidth = 1.6;
        [-1, 1].forEach((side) => {
          ctx.beginPath();
          ctx.moveTo(-s * 0.56, side * s * 0.1);
          ctx.lineTo(s * 0.72, side * s * 0.1);
          ctx.stroke();
        });
        ctx.fillStyle = '#5a7184';
        for (let i = 0; i < 9; i++) {
          const wx = -s * 0.45 + i * s * 0.12;
          ctx.fillRect(wx, -s * 0.045, 2, 2);
          ctx.fillRect(wx, s * 0.025, 2, 2);
        }
        // cockpit
        ctx.beginPath();
        ctx.ellipse(s * 0.78, 0, s * 0.1, s * 0.07, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#2f4358';
        ctx.fill();
      }
      const moveSpeed = 23; // how fast arrow keys move the plane
      const followSpeed = 0.58; // how smoothly the plane chases the pointer

      let targetY = plane.y;
      let keys = { up: false, down: false };
      let bars = []; // the white obstacle bars you have to fly through
      let score = 0;
      let level = 1;
      let levelFlash = 0; // frames left to show the "Level up!" banner
      let gameOver = false;

      function levelFor(s) {
        return Math.floor(s / pointsPerLevel) + 1;
      }

      // Fluffy clouds drifting in the background, purely for looks — the
      // plane can fly straight through them, they're not obstacles.
      let clouds = [];

      function spawnBackgroundClouds() {
        clouds = [];
        for (let i = 0; i < 6; i++) {
          clouds.push({
            x: Math.random() * canvas.width,
            y: 40 + Math.random() * (canvas.height - 80),
            scale: 0.6 + Math.random() * 0.8,
          });
        }
      }

      function drawCloud(x, y, scale) {
        ctx.beginPath();
        ctx.arc(x, y, 18 * scale, 0, Math.PI * 2);
        ctx.arc(x + 20 * scale, y - 8 * scale, 22 * scale, 0, Math.PI * 2);
        ctx.arc(x + 42 * scale, y, 18 * scale, 0, Math.PI * 2);
        ctx.arc(x + 20 * scale, y + 6 * scale, 20 * scale, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        // A soft outline so clouds don't vanish against a very light sky.
        ctx.strokeStyle = 'rgba(120, 170, 200, 0.35)';
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      function spawnBar() {
        // Each level has its own fixed gap size — a clear step down, not a slow crawl.
        const gapHeight = Math.max(74, 190 - (level - 1) * 19);
        const gapY = 60 + Math.random() * (canvas.height - gapHeight - 120);
        bars.push({ x: canvas.width, gapY, gapHeight, passed: false });
      }

      function barSpeed() {
        // Fast within a level, and a notch faster each level up.
        return Math.min(16, 4.4 + (level - 1) * 1.4); // starts slow, ramps up higher in later levels
      }

      function resetGame() {
        plane.y = canvas.height / 2;
        targetY = plane.y;
        bars = [];
        score = 0;
        level = 1;
        levelFlash = 0;
        gameOver = false;
        spawnBar();
        spawnBackgroundClouds();
        levelEl.textContent = 'Level: 1';
      }

      function pointerToY(clientX, clientY) {
        const rect = canvas.getBoundingClientRect();
        return ((clientY - rect.top) / rect.height) * canvas.height;
      }

      canvas.addEventListener('mousedown', () => {
        if (gameOver) resetGame();
      });
      canvas.addEventListener('mousemove', (e) => {
        targetY = pointerToY(e.clientX, e.clientY);
      });
      canvas.addEventListener(
        'touchstart',
        (e) => {
          if (gameOver) resetGame();
          targetY = pointerToY(e.touches[0].clientX, e.touches[0].clientY);
        },
        { passive: true }
      );
      canvas.addEventListener(
        'touchmove',
        (e) => {
          targetY = pointerToY(e.touches[0].clientX, e.touches[0].clientY);
        },
        { passive: true }
      );

      window.addEventListener('keydown', (e) => {
        if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = true;
        if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = true;
        if (e.code === 'Space' && gameOver) resetGame();
      });
      window.addEventListener('keyup', (e) => {
        if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = false;
        if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = false;
      });

      function update() {
        if (gameOver) return;

        // Arrow keys nudge the target directly; otherwise the plane
        // smoothly glides toward wherever the pointer last was.
        if (keys.up) targetY -= moveSpeed;
        if (keys.down) targetY += moveSpeed;
        targetY = Math.max(20, Math.min(canvas.height - 20, targetY));

        plane.y += (targetY - plane.y) * followSpeed;

        clouds.forEach((cloud) => {
          cloud.x -= 0.5; // slower than the bars, so it feels far away
          if (cloud.x < -60) {
            cloud.x = canvas.width + 60;
            cloud.y = 40 + Math.random() * (canvas.height - 80);
          }
        });

        bars.forEach((bar) => {
          bar.x -= barSpeed();

          if (
            plane.x + planeHit > bar.x &&
            plane.x - planeHit < bar.x + 40 &&
            (plane.y - planeHit < bar.gapY || plane.y + planeHit > bar.gapY + bar.gapHeight)
          ) {
            gameOver = true;
          }

          if (!bar.passed && bar.x + 40 < plane.x) {
            bar.passed = true;
            score++;

            const newLevel = levelFor(score);
            if (newLevel > level) {
              level = newLevel;
              levelEl.textContent = 'Level: ' + level;
              levelFlash = 90; // ~1.5s at 60fps
            }
          }
        });

        bars = bars.filter((bar) => bar.x > -50);

        if (bars.length === 0 || bars[bars.length - 1].x < canvas.width - 260) {
          spawnBar();
        }

        if (levelFlash > 0) levelFlash--;

        scoreEl.textContent = 'Score: ' + score;
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        clouds.forEach((cloud) => drawCloud(cloud.x, cloud.y, cloud.scale));

        ctx.fillStyle = '#ffffff';
        bars.forEach((bar) => {
          ctx.fillRect(bar.x, 0, 40, bar.gapY);
          ctx.fillRect(bar.x, bar.gapY + bar.gapHeight, 40, canvas.height);
        });

        ctx.save();
        ctx.translate(plane.x, plane.y);
        drawPlane();
        ctx.restore();

        if (levelFlash > 0) {
          const alpha = Math.min(1, levelFlash / 20);
          ctx.fillStyle = `rgba(255, 196, 0, ${alpha})`;
          ctx.font = 'bold 40px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Level ' + level + '!', canvas.width / 2, 80);
        }

        if (gameOver) {
          ctx.fillStyle = 'rgba(0,0,0,0.5)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = 'white';
          ctx.font = '28px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Game Over!', canvas.width / 2, canvas.height / 2 - 20);
          ctx.font = '18px sans-serif';
          ctx.fillText('Click or tap to try again', canvas.width / 2, canvas.height / 2 + 20);
        }
      }

      function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
      }

      resetGame();
      loop();
    </script>
  </body>
</html>
