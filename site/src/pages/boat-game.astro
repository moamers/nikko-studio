<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Boat Dodge</title>
  </head>
  <body>
<style is:global>
  :root {
    --bg: #f6fdff;
    --card: #ffffff;
    --ink: #1a2a33;
    --ink-soft: #4a6572;
    --sea: #2b8fc4;
    --accent: #e4572e;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0f1b22;
      --card: #16262f;
      --ink: #eaf4f8;
      --ink-soft: #9fb6c0;
      --sea: #15506f;
      --accent: #ff8a6a;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0f1b22;
    --card: #16262f;
    --ink: #eaf4f8;
    --ink-soft: #9fb6c0;
    --sea: #15506f;
    --accent: #ff8a6a;
    color-scheme: dark;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .wrap {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 24px;
  }

  h1 {
    font-size: clamp(22px, 6vw, 30px);
    margin: 0;
    text-align: center;
  }

  .sub {
    color: var(--ink-soft);
    margin: 0;
    text-align: center;
    font-size: 14px;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    max-height: 70vh;
    background: var(--card);
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background: var(--sea);
    touch-action: none;
  }

  .score {
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .level {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .best {
    font-size: 13px;
    color: var(--ink-soft);
  }
</style>

<div class="wrap">
  <h1>&#9973; Boat Dodge</h1>
  <p class="sub">Board your boat at the dock, then drag left and right to sail. Dodge the rocks and sharks, grab the gold! Too slow and the police come: hit Boost to get away. Watch your fuel \u26FD and the storms \u26C8\uFE0F!</p>
  <p class="score" id="score">Score: 0</p>
  <p class="level" id="level">Level 1</p>
  <p class="best" id="best">Best: 0</p>
  <div class="stage">
    <canvas id="game" width="400" height="600" aria-label="Boat dodge game"></canvas>
  </div>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const levelEl = document.getElementById('level');
    const bestEl = document.getElementById('best');

    const W = canvas.width;
    const H = canvas.height;
    const pointsPerLevel = 5;

    // The boat never moves up or down on its own: its spot is fixed, and the
    // sinking animation is drawn as an offset on top, so a restart can never
    // leave it in the wrong place.
    const boatY = H - 130;
    const boat = { x: W / 2, w: 38, h: 64 };
    const boats = [
      { name: 'Red Sailboat', price: 0, boost: 1.6, follow: 0.35, hull: '#d62828', edge: '#8c1a1a' },
      { name: 'Speedboat', price: 120, boost: 1.9, follow: 0.42, hull: '#1b6fd1', edge: '#0f3f7a' },
      { name: 'Jet Racer', price: 250, boost: 2.2, follow: 0.5, hull: '#ffcf1a', edge: '#7a5a00' },
      { name: 'Golden Rocket', price: 400, boost: 2.6, follow: 0.6, hull: '#d4a017', edge: '#6b4a00' },
    ];
    let curBoat = 0;
    let owned = [true, false, false, false];
    const keySpeed = 9;

    let targetX = boat.x;
    let keys = { left: false, right: false, slow: false, boost: false };

    let rocks = []; // rocks and sharks to dodge
    let coins = []; // gold to collect
    let splashes = []; // expanding rings on the water
    let score = 0;
    let level = 1;
    let levelFlash = 0;
    let best = 0;
    let started = false;
    let gameOver = false;
    let coinSpawnIn = 90;
    let scrollY = 0; // makes the waves drift past
    let frame = 0;
    let lastTime = null;

    // wallet, police, boost and the dock
    let wallet = 500;
    let boostEnergy = 100;
    let boosting = false;
    let slowTimer = 0;
    let policeCool = 0;
    let police = null; // { g: how far behind you, state: 'chase' | 'caught', x, flash, fine, t }
    let dock = null; // { stage: 'walk' | 'board' | 'rope' | 'castoff', sx, goal, t, off, ... }
    let toast = null; // { text, t }
    let fuel = 100;
    let fuelOutT = 0;
    let station = null; // a fuel station floating by: { y, side, paid }
    let stationIn = 1300;
    let storm = { state: 'none', t: 0, k: 0, kickIn: 120, kickV: 0, flash: 0, next: 1500 };
    let shopOpen = false;
    let shopMsg = '';
    let endReason = 'wreck';
    const heldBtn = { slow: null, boost: null };
    const slowBtn = { x: 12, y: 542, w: 96, h: 44 };
    const boostBtn = { x: 292, y: 542, w: 96, h: 44 };
    const dockBtn = { x: 176, y: 536, w: 210, h: 48 };
    const shopBtn = { x: 14, y: 536, w: 150, h: 48 };
    const inRect = (p, r) => p.x >= r.x && p.x <= r.x + r.w && p.y >= r.y && p.y <= r.y + r.h;
    const slowHeld = () => keys.slow || heldBtn.slow !== null;
    const boostHeld = () => keys.boost || heldBtn.boost !== null;

    // Sinking animation (the boat tips over and settles in the water, still
    // fully visible).
    let crashing = false;
    let crashTimer = 0;
    const crashDuration = 60;
    let crashDir = 1;
    let crashT = 0; // 0 -> 1 progress, eased
    let crashStartX = 0;
    let crashEndX = 0;

    try {
      best = Number(localStorage.getItem('boatDodgeBest') || 0);
      const w = localStorage.getItem('boatDodgeWallet');
      if (w !== null && !isNaN(Number(w))) wallet = Number(w);
      const o = JSON.parse(localStorage.getItem('boatDodgeOwned') || 'null');
      if (Array.isArray(o) && o.length === boats.length) owned = o.map(Boolean);
      const cb = Number(localStorage.getItem('boatDodgeBoat') || 0);
      if (cb >= 0 && cb < boats.length && owned[cb]) curBoat = cb;
    } catch (e) {}
    owned[0] = true;
    function saveProgress() {
      try {
        localStorage.setItem('boatDodgeWallet', String(Math.floor(wallet)));
        localStorage.setItem('boatDodgeOwned', JSON.stringify(owned));
        localStorage.setItem('boatDodgeBoat', String(curBoat));
      } catch (e) {}
    }
    bestEl.textContent = 'Best: ' + best;

    function levelFor(s) {
      return Math.floor(s / pointsPerLevel) + 1;
    }

    // Starts gentle at level 1 and steps up each level.
    function worldSpeed() {
      return Math.min(12, 3.2 + (level - 1) * 1.05);
    }

    function spawnGap() {
      return Math.max(115, 250 - (level - 1) * 13);
    }

    function spawnRock() {
      const isShark = level >= 2 && Math.random() < 0.3;
      const x = 34 + Math.random() * (W - 68);
      if (isShark) {
        rocks.push({ kind: 'shark', x, y: -50, hw: 13, hh: 24, passed: false, sway: Math.random() * 6 });
      } else {
        const r = 17 + Math.random() * 10;
        rocks.push({ kind: 'rock', x, y: -50, hw: r * 0.85, hh: r * 0.8, r, seed: Math.random() * 10, passed: false });
      }
    }

    function spawnCoin() {
      coins.push({ x: 30 + Math.random() * (W - 60), y: -30, r: 12 });
    }

    function resetGame() {
      boat.x = W / 2;
      targetX = boat.x;
      rocks = [];
      coins = [];
      splashes = [];
      score = 0;
      level = 1;
      levelFlash = 0;
      coinSpawnIn = 90;
      crashing = false;
      crashTimer = 0;
      crashT = 0;
      gameOver = false;
      started = true;
      fuel = 100;
      fuelOutT = 0;
      station = null;
      stationIn = 1300;
      storm = { state: 'none', t: 0, k: 0, kickIn: 120, kickV: 0, flash: 0, next: 1500 };
      endReason = 'wreck';
      boostEnergy = 100;
      boosting = false;
      slowTimer = 0;
      policeCool = 0;
      police = null;
      toast = null;
      heldBtn.slow = null;
      heldBtn.boost = null;
      scoreEl.textContent = 'Score: 0';
      levelEl.textContent = 'Level 1';
      spawnRock();
    }

    // before every trip you go to the ship dock, walk to your boat and board it
    function enterDock() {
      dock = { stage: 'walk', sx: 44, goal: null, t: 0, off: 0, face: 1, px: 0, py: 0, fromX: 0 };
      started = false;
      gameOver = false;
      crashing = false;
      crashT = 0;
      boat.x = W / 2;
      targetX = boat.x;
      rocks = [];
      coins = [];
      splashes = [];
      police = null;
      boosting = false;
      toast = null;
      shopOpen = false;
      shopMsg = '';
      if (wallet < 100) wallet = 100; // pocket money so you can always go on
      saveProgress();
    }

    function startOrRestart() {
      if ((!started || gameOver) && !dock) enterDock();
    }

    function say(text) {
      toast = { text, t: 170 };
    }

    function addPoints(n) {
      score += n;
      scoreEl.textContent = 'Score: ' + score;
    }

    function spawnPolice() {
      police = { g: 200, state: 'chase', x: boat.x, flash: 0, fine: 0, t: 0 };
      say('\u{1F6A8} Police boat! You are too slow. Boost to get away!');
    }

    function payFine() {
      const amount = Math.min(wallet, police.fine);
      wallet -= amount;
      saveProgress();
      police = null;
      slowTimer = 0;
      policeCool = 900;
      say(amount > 0 ? 'Fine paid: -' + amount + ' \u{1F4B0} You may go. Sail on!' : 'You have no money, so only a warning. Sail on!');
    }

    function shopPress(p) {
      if (inRect(p, { x: 100, y: 502, w: 200, h: 40 })) {
        shopOpen = false;
        return;
      }
      for (let i = 0; i < boats.length; i++) {
        const cx = 32 + (i % 2) * 172;
        const cy = 108 + Math.floor(i / 2) * 190;
        if (!inRect(p, { x: cx, y: cy, w: 162, h: 178 })) continue;
        if (owned[i]) {
          curBoat = i;
          shopMsg = boats[i].name + ' is ready! \u26F5';
        } else if (wallet >= boats[i].price) {
          wallet -= boats[i].price;
          owned[i] = true;
          curBoat = i;
          shopMsg = 'You bought the ' + boats[i].name + '! \u{1F389}';
        } else shopMsg = 'Not enough money for the ' + boats[i].name + ' yet \u{1F4B0}';
        saveProgress();
        return;
      }
    }

    function dockPress(p) {
      if (shopOpen) {
        shopPress(p);
        return;
      }
      if (dock.stage === 'walk' && (inRect(p, shopBtn) || (p.x < 150 && p.y > 396 && p.y < 470))) {
        shopOpen = true;
        shopMsg = 'Spend your money on a faster boat!';
        return;
      }
      if (dock.stage === 'walk') {
        if (dock.sx > 105 && inRect(p, dockBtn)) {
          dock.stage = 'board';
          dock.t = 0;
          dock.fromX = dock.sx;
          dock.goal = null;
        } else if (p.y < 530) dock.goal = Math.max(24, Math.min(140, p.x));
      } else if (dock.stage === 'rope' && inRect(p, dockBtn)) {
        dock.stage = 'castoff';
        dock.t = 0;
      }
    }

    function press(p, id) {
      if (dock) {
        dockPress(p);
        return;
      }
      if (police && police.state === 'caught') {
        if (police.t > 30 && inRect(p, { x: 90, y: 330, w: 220, h: 50 })) payFine();
        return;
      }
      if (!started || gameOver) {
        startOrRestart();
        return;
      }
      if (inRect(p, slowBtn)) heldBtn.slow = id;
      else if (inRect(p, boostBtn)) heldBtn.boost = id;
      else targetX = p.x;
    }

    function release(id) {
      if (heldBtn.slow === id) heldBtn.slow = null;
      if (heldBtn.boost === id) heldBtn.boost = null;
    }

    function startCrash() {
      if (crashing || gameOver) return;
      crashing = true;
      crashTimer = crashDuration;
      crashDir = boat.x < W / 2 ? -1 : 1;
      crashStartX = boat.x;
      crashEndX = Math.max(36, Math.min(W - 36, boat.x + crashDir * 14));
      splashes.push({ x: boat.x, y: boatY, age: 0 });
    }

    function endGame() {
      if (gameOver) return;
      gameOver = true;
      if (score > best) {
        best = score;
        bestEl.textContent = 'Best: ' + best;
        try {
          localStorage.setItem('boatDodgeBest', String(best));
        } catch (e) {}
      }
    }

    function easeInOut(t) {
      return t * t * (3 - 2 * t);
    }

    function pointerPt(clientX, clientY) {
      const rect = canvas.getBoundingClientRect();
      return { x: ((clientX - rect.left) / rect.width) * W, y: ((clientY - rect.top) / rect.height) * H };
    }

    canvas.addEventListener('mousedown', (e) => {
      press(pointerPt(e.clientX, e.clientY), 'mouse');
    });
    canvas.addEventListener('mousemove', (e) => {
      const p = pointerPt(e.clientX, e.clientY);
      if (started && !gameOver && !dock && !inRect(p, slowBtn) && !inRect(p, boostBtn) && heldBtn.slow === null && heldBtn.boost === null) targetX = p.x;
    });
    window.addEventListener('mouseup', () => release('mouse'));
    canvas.addEventListener(
      'touchstart',
      (e) => {
        for (const t of e.changedTouches) press(pointerPt(t.clientX, t.clientY), t.identifier);
      },
      { passive: true }
    );
    canvas.addEventListener(
      'touchmove',
      (e) => {
        for (const t of e.changedTouches) {
          const p = pointerPt(t.clientX, t.clientY);
          if (started && !gameOver && !dock && t.identifier !== heldBtn.slow && t.identifier !== heldBtn.boost) targetX = p.x;
        }
      },
      { passive: true }
    );
    const endTouch = (e) => {
      for (const t of e.changedTouches) release(t.identifier);
    };
    canvas.addEventListener('touchend', endTouch, { passive: true });
    canvas.addEventListener('touchcancel', endTouch, { passive: true });

    window.addEventListener('keydown', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.slow = true;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight' || e.code === 'ArrowUp' || e.code === 'KeyW') keys.boost = true;
      if (e.code === 'Space') {
        e.preventDefault();
        if (dock) dockPress({ x: 280, y: 560 });
        else if (police && police.state === 'caught') press({ x: 200, y: 350 }, 'key');
        else startOrRestart();
      }
      if (e.code.startsWith('Arrow')) e.preventDefault();
    });
    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.slow = false;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight' || e.code === 'ArrowUp' || e.code === 'KeyW') keys.boost = false;
    });


    function updateStorm(step) {
      const st = storm;
      if (st.flash > 0) st.flash -= step;
      if (st.state === 'none') {
        st.k = 0;
        if (level >= 2) st.next -= step;
        if (st.next <= 0) {
          st.state = 'warn';
          st.t = 0;
          say('⛈️ A storm is coming! Big waves ahead!');
        }
        return;
      }
      st.t += step;
      if (st.state === 'warn') {
        st.k = Math.min(0.35, st.t / 400);
        if (st.t > 160) {
          st.state = 'on';
          st.t = 0;
        }
      } else if (st.state === 'on') {
        st.k = Math.min(1, 0.35 + st.t / 160);
        // waves shove the boat sideways
        const drift = Math.sin(frame / 38) * 1.3 * st.k * step;
        boat.x += drift;
        targetX += drift;
        st.kickIn -= step;
        if (st.kickIn <= 0) {
          st.kickV = (Math.random() < 0.5 ? -1 : 1) * (9 + Math.random() * 5);
          st.kickIn = 150 + Math.random() * 110;
          splashes.push({ x: boat.x, y: boatY, age: 0 });
        }
        if (Math.random() < 0.004 * step) st.flash = 9;
        if (st.t > 1000) {
          st.state = 'fade';
          st.t = 0;
        }
      } else if (st.state === 'fade') {
        st.k = Math.max(0, 1 - st.t / 160);
        if (st.t > 160) {
          st.state = 'none';
          st.next = 1800 + Math.random() * 1200;
          say('The storm has passed ☀️');
        }
      }
      if (Math.abs(st.kickV) > 0.2) {
        boat.x += st.kickV * step;
        targetX += st.kickV * step;
        st.kickV *= Math.pow(0.86, step);
      }
      boat.x = Math.max(boat.w / 2, Math.min(W - boat.w / 2, boat.x));
      targetX = Math.max(boat.w / 2, Math.min(W - boat.w / 2, targetX));
    }

    function stationZone() {
      return station.side === 0 ? { x: 56, w: 104 } : { x: W - 160, w: 104 };
    }

    function updateStation(step, dist) {
      if (!station) {
        stationIn -= step;
        if (fuel < 30 && stationIn > 240) stationIn = 240;
        if (stationIn <= 0) {
          station = { y: -190, side: Math.random() < 0.5 ? 0 : 1, paid: 0, filling: false };
          say('⛽ A fuel station is coming up!');
        }
        return;
      }
      station.y += dist;
      const z = stationZone();
      const inside = boat.x > z.x && boat.x < z.x + z.w && Math.abs(boatY - (station.y + 85)) < 85;
      if (inside && fuel < 100 && wallet > 0) {
        const gain = Math.min(1.4 * step, 100 - fuel);
        const cost = Math.min(wallet, gain * 0.25);
        fuel += cost < gain * 0.25 ? cost * 4 : gain;
        wallet -= cost;
        station.paid += cost;
        station.filling = true;
      } else if (station.filling) {
        station.filling = false;
        if (station.paid > 0.5) {
          say('⛽ Tank filled! -' + Math.round(station.paid) + ' \u{1F4B0}');
          saveProgress();
        }
        station.paid = 0;
      }
      if (station.y > H + 30) {
        if (station.paid > 0.5) saveProgress();
        station = null;
        stationIn = 1500 + Math.random() * 600;
      }
    }

    function updateDock(step) {
      dock.t += step;
      if (dock.stage === 'walk') {
        if (keys.left || keys.right) {
          dock.goal = null;
          dock.face = keys.left ? -1 : 1;
          dock.sx += dock.face * 2.8 * step;
        } else if (dock.goal !== null) {
          const d = dock.goal - dock.sx;
          if (Math.abs(d) > 2) {
            dock.face = Math.sign(d);
            dock.sx += Math.sign(d) * Math.min(Math.abs(d), 2.8 * step);
          } else dock.goal = null;
        }
        dock.sx = Math.max(24, Math.min(140, dock.sx));
      } else if (dock.stage === 'board') {
        const p = Math.min(1, dock.t / 45);
        dock.px = dock.fromX + (W / 2 - dock.fromX) * p;
        dock.py = 520 + (boatY - 520) * p - Math.sin(p * Math.PI) * 24;
        if (p >= 1) {
          dock.stage = 'rope';
          dock.t = 0;
        }
      } else if (dock.stage === 'castoff') {
        dock.off += 3.4 * step;
        scrollY = (scrollY + 3.4 * step) % 120;
        if (dock.off > 280) {
          dock = null;
          resetGame();
        }
      }
    }

    function update() {
      const now = performance.now();
      let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
      lastTime = now;
      step = Math.min(Math.max(step, 0.2), 3); // same speed on 60Hz and 120Hz screens
      frame += step;

      splashes.forEach((s) => (s.age += step));
      splashes = splashes.filter((s) => s.age < 40);

      if (dock) {
        updateDock(step);
        scrollY = (scrollY + 2 * step) % 120;
        return;
      }

      if (toast) {
        toast.t -= step;
        if (toast.t <= 0) toast = null;
      }

      if (crashing) {
        crashTimer -= step;
        crashT = easeInOut(Math.min(1, Math.max(0, 1 - crashTimer / crashDuration)));
        boat.x = crashStartX + (crashEndX - crashStartX) * crashT;
        if (crashTimer <= 0) {
          crashing = false;
          endGame();
        }
        return;
      }

      // The sea keeps drifting even on the start and game-over screens.
      const running = started && !gameOver;
      if (police && police.state === 'caught') {
        police.t += step;
        police.flash += step;
        return; // the police have stopped you: nothing moves until you pay
      }
      let mult = 1;
      if (running) {
        if (boostHeld() && boostEnergy > 0 && fuel > 0) {
          boosting = true;
          boostEnergy = Math.max(0, boostEnergy - 1.0 * step);
          mult = boats[curBoat].boost;
        } else {
          boosting = false;
          boostEnergy = Math.min(100, boostEnergy + 0.5 * step);
          if (slowHeld()) mult = 0.45;
        }
        // the engine: fuel runs down, and with an empty tank you only drift
        fuel = Math.max(0, fuel - (0.028 + (boosting ? 0.06 : 0)) * step);
        if (fuel <= 0) {
          mult = Math.min(mult, 0.3);
          fuelOutT += step;
          if (fuelOutT > 600) {
            endReason = 'fuel';
            endGame();
            return;
          }
        } else fuelOutT = 0;
      }
      const dist = (running ? worldSpeed() * mult : 2) * step;
      scrollY = (scrollY + dist) % 120;

      if (!running) return;

      updateStorm(step);
      if (keys.left) targetX -= keySpeed * step;
      if (keys.right) targetX += keySpeed * step;
      targetX = Math.max(boat.w / 2, Math.min(W - boat.w / 2, targetX));
      boat.x += (targetX - boat.x) * (1 - Math.pow(1 - boats[curBoat].follow, step));

      rocks.forEach((o) => {
        o.y += dist;
        if (o.kind === 'shark') o.x += Math.sin((frame + o.sway * 20) / 25) * 0.8 * step;

        if (Math.abs(boat.x - o.x) < boat.w / 2 + o.hw - 7 && Math.abs(boatY - o.y) < boat.h / 2 + o.hh - 9) {
          startCrash();
        }

        if (!o.passed && o.y > boatY + boat.h / 2 + o.hh) {
          o.passed = true;
          score++;
          scoreEl.textContent = 'Score: ' + score;
          const newLevel = levelFor(score);
          if (newLevel > level) {
            level = newLevel;
            levelEl.textContent = 'Level ' + level;
            levelFlash = 90;
          }
        }
      });
      rocks = rocks.filter((o) => o.y < H + 80);
      if (rocks.length === 0 || rocks[rocks.length - 1].y > spawnGap()) spawnRock();

      coins.forEach((c) => {
        c.y += dist;
        const dx = boat.x - c.x;
        const dy = boatY - c.y;
        if (Math.sqrt(dx * dx + dy * dy) < c.r + 22) {
          c.collected = true;
          score += 3;
          wallet += 5;
          saveProgress();
          scoreEl.textContent = 'Score: ' + score;
          splashes.push({ x: c.x, y: c.y, age: 18 });
        }
      });
      coins = coins.filter((c) => !c.collected && c.y < H + 40);
      coinSpawnIn -= step;
      if (coinSpawnIn <= 0) {
        spawnCoin();
        coinSpawnIn = 100 + Math.random() * 90;
      }

      levelFlash = Math.max(0, levelFlash - step);

      updateStation(step, dist);

      // go too slow and the police boat comes after you
      policeCool = Math.max(0, policeCool - step);
      const crawling = slowHeld() && !boosting;
      if (!police) {
        if (crawling) slowTimer += step;
        else slowTimer = Math.max(0, slowTimer - step * 0.5);
        if (slowTimer > 120 && policeCool <= 0) spawnPolice();
      } else {
        const rate = 0.55 + (crawling ? 0.6 : 0) - (boosting ? (3.2 * (boats[curBoat].boost - 1)) / 0.6 : 0);
        police.g -= rate * step;
        police.x += (boat.x - police.x) * 0.04 * step;
        police.flash += step;
        if (police.g > 360) {
          police = null;
          slowTimer = 0;
          policeCool = 600;
          addPoints(5);
          say('You outran the police! \u{1F680} +5');
        } else if (police.g <= 45) {
          police.state = 'caught';
          police.t = 0;
          police.fine = 20 + Math.floor(Math.random() * 31); // up to 50
        }
      }
    }

    // ---------- drawing ----------

    function drawSea() {
      const sea = getComputedStyle(document.documentElement).getPropertyValue('--sea').trim() || '#2b8fc4';
      ctx.fillStyle = sea;
      ctx.fillRect(0, 0, W, H);

      // Wave caps drifting down the screen, with a gentle side-to-side shimmer.
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.28)';
      ctx.lineWidth = 2;
      for (let row = -1; row < H / 60 + 1; row++) {
        const y = row * 60 + (scrollY % 60);
        for (let col = 0; col < 6; col++) {
          const x = col * 80 + (row % 2 === 0 ? 20 : 60) + Math.sin(frame / 30 + row + col) * 5;
          ctx.beginPath();
          ctx.arc(x, y, 9, Math.PI * 0.15, Math.PI * 0.85);
          ctx.stroke();
        }
      }
    }

    function drawStorm() {
      const k = storm.k;
      if (k <= 0) return;
      // big waves
      ctx.strokeStyle = 'rgba(255, 255, 255, ' + 0.4 * k + ')';
      ctx.lineWidth = 4;
      for (let row = -1; row < H / 90 + 1; row++) {
        const y = row * 90 + ((scrollY * 1.5) % 90);
        for (let col = 0; col < 4; col++) {
          const x = col * 110 + (row % 2 === 0 ? 30 : 80) + Math.sin(frame / 22 + row + col) * 12;
          ctx.beginPath();
          ctx.arc(x, y, 24 + 6 * Math.sin(frame / 18 + col), Math.PI * 0.12, Math.PI * 0.88);
          ctx.stroke();
        }
      }
    }

    function drawStormOverlay() {
      const k = storm.k;
      if (k <= 0) return;
      ctx.fillStyle = 'rgba(8, 20, 40, ' + 0.42 * k + ')';
      ctx.fillRect(0, 0, W, H);
      ctx.strokeStyle = 'rgba(200, 220, 255, ' + 0.45 * k + ')';
      ctx.lineWidth = 1.5;
      for (let i = 0; i < 46; i++) {
        const x = (i * 97 + frame * 2.2) % (W + 40) - 20;
        const y = (i * 53 + frame * 14) % (H + 40) - 20;
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x - 6, y + 16);
        ctx.stroke();
      }
      if (storm.flash > 0) {
        ctx.fillStyle = 'rgba(255, 255, 255, ' + 0.5 * (storm.flash / 9) + ')';
        ctx.fillRect(0, 0, W, H);
      }
    }

    function drawStation() {
      const st = station;
      const left = st.side === 0;
      const px = left ? 0 : W - 58;
      ctx.fillStyle = '#a8793f';
      ctx.fillRect(px, st.y, 58, 170);
      ctx.strokeStyle = '#8a5f2c';
      ctx.lineWidth = 2;
      for (let yy = st.y + 14; yy < st.y + 170; yy += 14) {
        ctx.beginPath();
        ctx.moveTo(px, yy);
        ctx.lineTo(px + 58, yy);
        ctx.stroke();
      }
      ctx.strokeStyle = '#6b4a22';
      ctx.lineWidth = 4;
      ctx.strokeRect(px, st.y, 58, 170);
      ctx.font = '34px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillStyle = '#000000';
      ctx.fillText('⛽', px + 29, st.y + 95);
      ctx.fillStyle = '#e8a317';
      ctx.fillRect(px + 6, st.y + 8, 46, 18);
      ctx.fillStyle = '#1a1a1a';
      ctx.font = 'bold 12px sans-serif';
      ctx.fillText('FUEL', px + 29, st.y + 21);
      // the bay where you refuel
      const z = stationZone();
      ctx.fillStyle = st.filling ? 'rgba(47, 191, 113, 0.4)' : 'rgba(255, 224, 102, 0.22)';
      ctx.fillRect(z.x, st.y + 4, z.w, 162);
      ctx.setLineDash([8, 8]);
      ctx.strokeStyle = st.filling ? '#2fbf71' : '#ffe066';
      ctx.lineWidth = 3;
      ctx.strokeRect(z.x, st.y + 4, z.w, 162);
      ctx.setLineDash([]);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 13px sans-serif';
      ctx.fillText(st.filling ? '⛽ Filling...' : '⛽ Fuel bay', z.x + z.w / 2, st.y + 88);
    }

    function drawShop() {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.6)';
