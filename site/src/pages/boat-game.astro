      });
      ctx.textAlign = 'center';
      ctx.fillStyle = '#1a2a33';
      ctx.font = 'bold 13px sans-serif';
      ctx.fillText(shopMsg, 200, 494);
      ctx.beginPath();
      ctx.roundRect(100, 502, 200, 40, 20);
      ctx.fillStyle = '#1b4f8a';
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText('Back to the dock ⚓', 200, 528);
    }

    function drawRock(o) {
      const pts = 8;
      ctx.beginPath();
      for (let i = 0; i < pts; i++) {
        const a = (i / pts) * Math.PI * 2;
        const rr = o.r * (0.82 + 0.28 * Math.abs(Math.sin(o.seed + i * 2.3)));
        const px = o.x + Math.cos(a) * rr;
        const py = o.y + Math.sin(a) * rr;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = '#6b6f76';
      ctx.fill();
      ctx.strokeStyle = '#3d4045';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(o.x - o.r * 0.25, o.y - o.r * 0.25, o.r * 0.38, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
      ctx.fill();
      ctx.beginPath();
      ctx.arc(o.x, o.y, o.r + 6, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.lineWidth = 3;
      ctx.stroke();
    }

    function drawShark(o) {
      ctx.save();
      ctx.translate(o.x, o.y);
      ctx.fillStyle = '#7d8a99';
      ctx.strokeStyle = '#46515e';
      ctx.lineWidth = 2;
      // tail
      ctx.beginPath();
      ctx.moveTo(0, -20);
      ctx.lineTo(-11, -34);
      ctx.lineTo(0, -28);
      ctx.lineTo(11, -34);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      // side fins
      ctx.beginPath();
      ctx.moveTo(-8, 2);
      ctx.lineTo(-22, 12);
      ctx.lineTo(-6, 12);
      ctx.moveTo(8, 2);
      ctx.lineTo(22, 12);
      ctx.lineTo(6, 12);
      ctx.fill();
      // body
      ctx.beginPath();
      ctx.ellipse(0, 0, 12, 26, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      // dorsal fin
      ctx.beginPath();
      ctx.moveTo(0, -6);
      ctx.lineTo(7, 8);
      ctx.lineTo(-7, 8);
      ctx.closePath();
      ctx.fillStyle = '#5d6975';
      ctx.fill();
      // eyes
      ctx.fillStyle = '#10151a';
      ctx.beginPath();
      ctx.arc(-5, 17, 1.8, 0, Math.PI * 2);
      ctx.arc(5, 17, 1.8, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawCoin(c) {
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd400';
      ctx.fill();
      ctx.strokeStyle = '#b8860b';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r - 4, 0, Math.PI * 2);
      ctx.strokeStyle = '#fff3b0';
      ctx.stroke();
    }


    // the boats you can sail (also used by the shop): drawn pointing up at 0, 0
    function drawBoatShape(i, flame) {
      const b = boats[i];
      const hull = () => {
        ctx.beginPath();
        ctx.moveTo(0, -33);
        ctx.quadraticCurveTo(19, -10, 15, 28);
        ctx.lineTo(-15, 28);
        ctx.quadraticCurveTo(-19, -10, 0, -33);
        ctx.closePath();
      };
      if (i >= 2 && flame) {
        ctx.fillStyle = i === 3 ? '#ffb000' : '#ff7a1a';
        ctx.beginPath();
        ctx.moveTo(-8, 28);
        ctx.lineTo(0, 28 + 26 + Math.sin(frame / 2) * 5);
        ctx.lineTo(8, 28);
        ctx.fill();
      }
      hull();
      ctx.fillStyle = b.hull;
      ctx.fill();
      ctx.strokeStyle = b.edge;
      ctx.lineWidth = 2;
      ctx.stroke();
      if (i === 0) {
        ctx.beginPath();
        ctx.moveTo(0, -24);
        ctx.quadraticCurveTo(12, -8, 9, 22);
        ctx.lineTo(-9, 22);
        ctx.quadraticCurveTo(-12, -8, 0, -24);
        ctx.closePath();
        ctx.fillStyle = '#f2d9a8';
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(0, -18);
        ctx.quadraticCurveTo(22, -2, 3, 14);
        ctx.lineTo(0, 14);
        ctx.closePath();
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.strokeStyle = '#c9c2b2';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(0, -1, 3, 0, Math.PI * 2);
        ctx.fillStyle = '#6b4f2a';
        ctx.fill();
      } else if (i === 1) {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(-11, -4, 22, 8);
        ctx.fillStyle = '#9fd3ee';
        ctx.beginPath();
        ctx.moveTo(-8, -10);
        ctx.lineTo(8, -10);
        ctx.lineTo(6, -20);
        ctx.lineTo(-6, -20);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = '#333333';
        ctx.fillRect(-5, 24, 10, 9);
      } else if (i === 2) {
        ctx.fillStyle = '#1a1a1a';
        ctx.fillRect(-3, -28, 6, 52);
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(0, -4, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#1a1a1a';
        ctx.beginPath();
        ctx.moveTo(-15, 14);
        ctx.lineTo(-24, 28);
        ctx.lineTo(-12, 26);
        ctx.moveTo(15, 14);
        ctx.lineTo(24, 28);
        ctx.lineTo(12, 26);
        ctx.fill();
      } else {
        ctx.fillStyle = '#fff3b0';
        ctx.fillRect(-4, -26, 8, 50);
        ctx.fillStyle = '#c0392b';
        ctx.beginPath();
        ctx.arc(0, -8, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#b8860b';
        ctx.beginPath();
        ctx.moveTo(-15, 8);
        ctx.lineTo(-28, 30);
        ctx.lineTo(-12, 24);
        ctx.moveTo(15, 8);
        ctx.lineTo(28, 30);
        ctx.lineTo(12, 24);
        ctx.fill();
      }
    }

    function drawBoat() {
      const sink = crashing || (gameOver && crashT > 0) ? crashT : 0;
      const x = boat.x;
      const y = boatY + sink * 30;
      const angle = crashDir * sink * 1.35 + (storm.k > 0 && !dock ? Math.sin(frame / 9) * 0.1 * storm.k : 0);

      // foam trail behind the boat while sailing
      if (!crashing && !gameOver && (started || (dock && dock.stage === 'castoff'))) {
        ctx.fillStyle = boosting ? 'rgba(255, 255, 255, 0.5)' : 'rgba(255, 255, 255, 0.28)';
        ctx.beginPath();
        ctx.moveTo(x - 12, y + 26);
        ctx.lineTo(x - 26 - Math.sin(frame / 10) * 3, y + 92 + (boosting ? 46 : 0));
        ctx.lineTo(x + 26 + Math.sin(frame / 10) * 3, y + 92 + (boosting ? 46 : 0));
        ctx.lineTo(x + 12, y + 26);
        ctx.closePath();
        ctx.fill();
      }

      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      drawBoatShape(curBoat, boosting);

      ctx.restore();
    }

    function drawSplashes() {
      splashes.forEach((s) => {
        const p = s.age / 40;
        ctx.beginPath();
        ctx.arc(s.x, s.y, 6 + p * 34, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 255, 255, ' + 0.7 * (1 - p) + ')';
        ctx.lineWidth = 3;
        ctx.stroke();
      });
    }


    function drawPolice() {
      const p = police;
      const caught = p.state === 'caught';
      const x = caught ? Math.min(W - 30, boat.x + 46) : p.x;
      const y = caught ? boatY + 4 : boatY + p.g;
      if (y > H + 70) return;
      ctx.save();
      ctx.translate(x, y);
      ctx.beginPath();
      ctx.moveTo(0, -33);
      ctx.quadraticCurveTo(19, -10, 15, 28);
      ctx.lineTo(-15, 28);
      ctx.quadraticCurveTo(-19, -10, 0, -33);
      ctx.closePath();
      ctx.fillStyle = '#f4f6f8';
      ctx.fill();
      ctx.strokeStyle = '#1b3a6b';
      ctx.lineWidth = 2.5;
      ctx.stroke();
      ctx.fillStyle = '#1b3a6b';
      ctx.fillRect(-13, -2, 26, 9);
      ctx.fillStyle = '#9fd3ee';
      ctx.fillRect(-8, -18, 16, 12);
      const on = Math.floor(p.flash / 8) % 2 === 0;
      ctx.fillStyle = on ? '#ff2d2d' : '#5a1a1a';
      ctx.beginPath();
      ctx.arc(-6, -22, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = on ? '#1a2a5a' : '#3a7bff';
      ctx.beginPath();
      ctx.arc(6, -22, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      ctx.beginPath();
      ctx.arc(x + (on ? -6 : 6), y - 22, 22, 0, Math.PI * 2);
      ctx.fillStyle = on ? 'rgba(255, 40, 40, 0.28)' : 'rgba(60, 120, 255, 0.28)';
      ctx.fill();
    }

