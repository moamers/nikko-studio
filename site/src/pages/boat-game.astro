<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Boat Dodge</title>
  </head>
  <body>
<style is:global>
  :root {
    --bg: #f6fdff;
    --card: #ffffff;
    --ink: #1a2a33;
    --ink-soft: #4a6572;
    --sea: #2b8fc4;
    --accent: #e4572e;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0f1b22;
      --card: #16262f;
      --ink: #eaf4f8;
      --ink-soft: #9fb6c0;
      --sea: #15506f;
      --accent: #ff8a6a;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0f1b22;
    --card: #16262f;
    --ink: #eaf4f8;
    --ink-soft: #9fb6c0;
    --sea: #15506f;
    --accent: #ff8a6a;
    color-scheme: dark;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .wrap {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 24px;
  }

  h1 {
    font-size: clamp(22px, 6vw, 30px);
    margin: 0;
    text-align: center;
  }

  .sub {
    color: var(--ink-soft);
    margin: 0;
    text-align: center;
    font-size: 14px;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    max-height: 70vh;
    background: var(--card);
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background: var(--sea);
    touch-action: none;
  }

  .score {
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .level {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .best {
    font-size: 13px;
    color: var(--ink-soft);
  }
</style>

<div class="wrap">
  <h1>&#9973; Boat Dodge</h1>
  <p class="sub">Board your boat at the dock, then drag left and right to sail. Dodge the rocks and sharks, grab the gold! Too slow and the police come: hit Boost to get away.</p>
  <p class="score" id="score">Score: 0</p>
  <p class="level" id="level">Level 1</p>
  <p class="best" id="best">Best: 0</p>
  <div class="stage">
    <canvas id="game" width="400" height="600" aria-label="Boat dodge game"></canvas>
  </div>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const levelEl = document.getElementById('level');
    const bestEl = document.getElementById('best');

    const W = canvas.width;
    const H = canvas.height;
    const pointsPerLevel = 5;

    // The boat never moves up or down on its own: its spot is fixed, and the
    // sinking animation is drawn as an offset on top, so a restart can never
    // leave it in the wrong place.
    const boatY = H - 130;
    const boat = { x: W / 2, w: 38, h: 64 };
    const followSpeed = 0.35;
    const keySpeed = 9;

    let targetX = boat.x;
    let keys = { left: false, right: false, slow: false, boost: false };

    let rocks = []; // rocks and sharks to dodge
    let coins = []; // gold to collect
    let splashes = []; // expanding rings on the water
    let score = 0;
    let level = 1;
    let levelFlash = 0;
    let best = 0;
    let started = false;
    let gameOver = false;
    let coinSpawnIn = 90;
    let scrollY = 0; // makes the waves drift past
    let frame = 0;
    let lastTime = null;

    // wallet, police, boost and the dock
    let wallet = 500;
    let boostEnergy = 100;
    let boosting = false;
    let slowTimer = 0;
    let policeCool = 0;
    let police = null; // { g: how far behind you, state: 'chase' | 'caught', x, flash, fine, t }
    let dock = null; // { stage: 'walk' | 'board' | 'rope' | 'castoff', sx, goal, t, off, ... }
    let toast = null; // { text, t }
    const heldBtn = { slow: null, boost: null };
    const slowBtn = { x: 12, y: 542, w: 96, h: 44 };
    const boostBtn = { x: 292, y: 542, w: 96, h: 44 };
    const dockBtn = { x: 90, y: 536, w: 220, h: 48 };
    const inRect = (p, r) => p.x >= r.x && p.x <= r.x + r.w && p.y >= r.y && p.y <= r.y + r.h;
    const slowHeld = () => keys.slow || heldBtn.slow !== null;
    const boostHeld = () => keys.boost || heldBtn.boost !== null;

    // Sinking animation (the boat tips over and settles in the water, still
    // fully visible).
    let crashing = false;
    let crashTimer = 0;
    const crashDuration = 60;
    let crashDir = 1;
    let crashT = 0; // 0 -> 1 progress, eased
    let crashStartX = 0;
    let crashEndX = 0;

    try {
      best = Number(localStorage.getItem('boatDodgeBest') || 0);
    } catch (e) {}
    bestEl.textContent = 'Best: ' + best;

    function levelFor(s) {
      return Math.floor(s / pointsPerLevel) + 1;
    }

    // Starts gentle at level 1 and steps up each level.
    function worldSpeed() {
      return Math.min(12, 3.2 + (level - 1) * 1.05);
    }

    function spawnGap() {
      return Math.max(115, 250 - (level - 1) * 13);
    }

    function spawnRock() {
      const isShark = level >= 2 && Math.random() < 0.3;
      const x = 34 + Math.random() * (W - 68);
      if (isShark) {
        rocks.push({ kind: 'shark', x, y: -50, hw: 13, hh: 24, passed: false, sway: Math.random() * 6 });
      } else {
        const r = 17 + Math.random() * 10;
        rocks.push({ kind: 'rock', x, y: -50, hw: r * 0.85, hh: r * 0.8, r, seed: Math.random() * 10, passed: false });
      }
    }

    function spawnCoin() {
      coins.push({ x: 30 + Math.random() * (W - 60), y: -30, r: 12 });
    }

    function resetGame() {
      boat.x = W / 2;
      targetX = boat.x;
      rocks = [];
      coins = [];
      splashes = [];
      score = 0;
      level = 1;
      levelFlash = 0;
      coinSpawnIn = 90;
      crashing = false;
      crashTimer = 0;
      crashT = 0;
      gameOver = false;
      started = true;
      wallet = 500;
      boostEnergy = 100;
      boosting = false;
      slowTimer = 0;
      policeCool = 0;
      police = null;
      toast = null;
      heldBtn.slow = null;
      heldBtn.boost = null;
      scoreEl.textContent = 'Score: 0';
      levelEl.textContent = 'Level 1';
      spawnRock();
    }

    // before every trip you go to the ship dock, walk to your boat and board it
    function enterDock() {
      dock = { stage: 'walk', sx: 44, goal: null, t: 0, off: 0, face: 1, px: 0, py: 0, fromX: 0 };
      started = false;
      gameOver = false;
      crashing = false;
      crashT = 0;
      boat.x = W / 2;
      targetX = boat.x;
      rocks = [];
      coins = [];
      splashes = [];
      police = null;
      boosting = false;
      toast = null;
    }

    function startOrRestart() {
      if ((!started || gameOver) && !dock) enterDock();
    }

    function say(text) {
      toast = { text, t: 170 };
    }

    function addPoints(n) {
      score += n;
      scoreEl.textContent = 'Score: ' + score;
    }

    function spawnPolice() {
      police = { g: 200, state: 'chase', x: boat.x, flash: 0, fine: 0, t: 0 };
      say('\u{1F6A8} Police boat! You are too slow. Boost to get away!');
    }

    function payFine() {
      const amount = Math.min(wallet, police.fine);
      wallet -= amount;
      police = null;
      slowTimer = 0;
      policeCool = 900;
      say(amount > 0 ? 'Fine paid: -' + amount + ' \u{1F4B0} You may go. Sail on!' : 'You have no money, so only a warning. Sail on!');
    }

    function dockPress(p) {
      if (dock.stage === 'walk') {
        if (dock.sx > 105 && inRect(p, dockBtn)) {
          dock.stage = 'board';
          dock.t = 0;
          dock.fromX = dock.sx;
          dock.goal = null;
        } else if (p.y < 530) dock.goal = Math.max(24, Math.min(140, p.x));
      } else if (dock.stage === 'rope' && inRect(p, dockBtn)) {
        dock.stage = 'castoff';
        dock.t = 0;
      }
    }

    function press(p, id) {
      if (dock) {
        dockPress(p);
        return;
      }
      if (police && police.state === 'caught') {
        if (police.t > 30 && inRect(p, { x: 90, y: 330, w: 220, h: 50 })) payFine();
        return;
      }
      if (!started || gameOver) {
        startOrRestart();
        return;
      }
      if (inRect(p, slowBtn)) heldBtn.slow = id;
      else if (inRect(p, boostBtn)) heldBtn.boost = id;
      else targetX = p.x;
    }

    function release(id) {
      if (heldBtn.slow === id) heldBtn.slow = null;
      if (heldBtn.boost === id) heldBtn.boost = null;
    }

    function startCrash() {
      if (crashing || gameOver) return;
      crashing = true;
      crashTimer = crashDuration;
      crashDir = boat.x < W / 2 ? -1 : 1;
      crashStartX = boat.x;
      crashEndX = Math.max(36, Math.min(W - 36, boat.x + crashDir * 14));
      splashes.push({ x: boat.x, y: boatY, age: 0 });
    }

    function endGame() {
      if (gameOver) return;
      gameOver = true;
      if (score > best) {
        best = score;
        bestEl.textContent = 'Best: ' + best;
        try {
          localStorage.setItem('boatDodgeBest', String(best));
        } catch (e) {}
      }
    }

    function easeInOut(t) {
      return t * t * (3 - 2 * t);
    }

    function pointerPt(clientX, clientY) {
      const rect = canvas.getBoundingClientRect();
      return { x: ((clientX - rect.left) / rect.width) * W, y: ((clientY - rect.top) / rect.height) * H };
    }

    canvas.addEventListener('mousedown', (e) => {
      press(pointerPt(e.clientX, e.clientY), 'mouse');
    });
    canvas.addEventListener('mousemove', (e) => {
      const p = pointerPt(e.clientX, e.clientY);
      if (started && !gameOver && !dock && !inRect(p, slowBtn) && !inRect(p, boostBtn) && heldBtn.slow === null && heldBtn.boost === null) targetX = p.x;
    });
    window.addEventListener('mouseup', () => release('mouse'));
    canvas.addEventListener(
      'touchstart',
      (e) => {
        for (const t of e.changedTouches) press(pointerPt(t.clientX, t.clientY), t.identifier);
      },
      { passive: true }
    );
    canvas.addEventListener(
      'touchmove',
      (e) => {
        for (const t of e.changedTouches) {
          const p = pointerPt(t.clientX, t.clientY);
          if (started && !gameOver && !dock && t.identifier !== heldBtn.slow && t.identifier !== heldBtn.boost) targetX = p.x;
        }
      },
      { passive: true }
    );
    const endTouch = (e) => {
      for (const t of e.changedTouches) release(t.identifier);
    };
    canvas.addEventListener('touchend', endTouch, { passive: true });
    canvas.addEventListener('touchcancel', endTouch, { passive: true });

    window.addEventListener('keydown', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.slow = true;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight' || e.code === 'ArrowUp' || e.code === 'KeyW') keys.boost = true;
      if (e.code === 'Space') {
        e.preventDefault();
        if (dock) dockPress({ x: 200, y: 560 });
        else if (police && police.state === 'caught') press({ x: 200, y: 350 }, 'key');
        else startOrRestart();
      }
      if (e.code.startsWith('Arrow')) e.preventDefault();
    });
    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.slow = false;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight' || e.code === 'ArrowUp' || e.code === 'KeyW') keys.boost = false;
    });

    function updateDock(step) {
      dock.t += step;
      if (dock.stage === 'walk') {
        if (keys.left || keys.right) {
          dock.goal = null;
          dock.face = keys.left ? -1 : 1;
          dock.sx += dock.face * 2.8 * step;
        } else if (dock.goal !== null) {
          const d = dock.goal - dock.sx;
          if (Math.abs(d) > 2) {
            dock.face = Math.sign(d);
            dock.sx += Math.sign(d) * Math.min(Math.abs(d), 2.8 * step);
          } else dock.goal = null;
        }
        dock.sx = Math.max(24, Math.min(140, dock.sx));
      } else if (dock.stage === 'board') {
        const p = Math.min(1, dock.t / 45);
        dock.px = dock.fromX + (W / 2 - dock.fromX) * p;
        dock.py = 520 + (boatY - 520) * p - Math.sin(p * Math.PI) * 24;
        if (p >= 1) {
          dock.stage = 'rope';
          dock.t = 0;
        }
      } else if (dock.stage === 'castoff') {
        dock.off += 3.4 * step;
        scrollY = (scrollY + 3.4 * step) % 120;
        if (dock.off > 280) {
          dock = null;
          resetGame();
        }
      }
    }

    function update() {
      const now = performance.now();
      let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
      lastTime = now;
      step = Math.min(Math.max(step, 0.2), 3); // same speed on 60Hz and 120Hz screens
      frame += step;

      splashes.forEach((s) => (s.age += step));
      splashes = splashes.filter((s) => s.age < 40);

      if (dock) {
        updateDock(step);
        scrollY = (scrollY + 2 * step) % 120;
        return;
      }

      if (toast) {
        toast.t -= step;
        if (toast.t <= 0) toast = null;
      }

      if (crashing) {
        crashTimer -= step;
        crashT = easeInOut(Math.min(1, Math.max(0, 1 - crashTimer / crashDuration)));
        boat.x = crashStartX + (crashEndX - crashStartX) * crashT;
        if (crashTimer <= 0) {
          crashing = false;
          endGame();
        }
        return;
      }

      // The sea keeps drifting even on the start and game-over screens.
      const running = started && !gameOver;
      if (police && police.state === 'caught') {
        police.t += step;
        police.flash += step;
        return; // the police have stopped you: nothing moves until you pay
      }
      let mult = 1;
      if (running) {
        if (boostHeld() && boostEnergy > 0) {
          boosting = true;
          boostEnergy = Math.max(0, boostEnergy - 1.0 * step);
          mult = 1.6;
        } else {
          boosting = false;
          boostEnergy = Math.min(100, boostEnergy + 0.5 * step);
          if (slowHeld()) mult = 0.45;
        }
      }
      const dist = (running ? worldSpeed() * mult : 2) * step;
      scrollY = (scrollY + dist) % 120;

      if (!running) return;

      if (keys.left) targetX -= keySpeed * step;
      if (keys.right) targetX += keySpeed * step;
      targetX = Math.max(boat.w / 2, Math.min(W - boat.w / 2, targetX));
      boat.x += (targetX - boat.x) * (1 - Math.pow(1 - followSpeed, step));

      rocks.forEach((o) => {
        o.y += dist;
        if (o.kind === 'shark') o.x += Math.sin((frame + o.sway * 20) / 25) * 0.8 * step;

        if (Math.abs(boat.x - o.x) < boat.w / 2 + o.hw - 7 && Math.abs(boatY - o.y) < boat.h / 2 + o.hh - 9) {
          startCrash();
        }

        if (!o.passed && o.y > boatY + boat.h / 2 + o.hh) {
          o.passed = true;
          score++;
          scoreEl.textContent = 'Score: ' + score;
          const newLevel = levelFor(score);
          if (newLevel > level) {
            level = newLevel;
            levelEl.textContent = 'Level ' + level;
            levelFlash = 90;
          }
        }
      });
      rocks = rocks.filter((o) => o.y < H + 80);
      if (rocks.length === 0 || rocks[rocks.length - 1].y > spawnGap()) spawnRock();

      coins.forEach((c) => {
        c.y += dist;
        const dx = boat.x - c.x;
        const dy = boatY - c.y;
        if (Math.sqrt(dx * dx + dy * dy) < c.r + 22) {
          c.collected = true;
          score += 3;
          wallet += 5;
          scoreEl.textContent = 'Score: ' + score;
          splashes.push({ x: c.x, y: c.y, age: 18 });
        }
      });
      coins = coins.filter((c) => !c.collected && c.y < H + 40);
      coinSpawnIn -= step;
      if (coinSpawnIn <= 0) {
        spawnCoin();
        coinSpawnIn = 100 + Math.random() * 90;
      }

      levelFlash = Math.max(0, levelFlash - step);

      // go too slow and the police boat comes after you
      policeCool = Math.max(0, policeCool - step);
      const crawling = slowHeld() && !boosting;
      if (!police) {
        if (crawling) slowTimer += step;
        else slowTimer = Math.max(0, slowTimer - step * 0.5);
        if (slowTimer > 120 && policeCool <= 0) spawnPolice();
      } else {
        const rate = 0.55 + (crawling ? 0.6 : 0) - (boosting ? 3.2 : 0);
        police.g -= rate * step;
        police.x += (boat.x - police.x) * 0.04 * step;
        police.flash += step;
        if (police.g > 360) {
          police = null;
          slowTimer = 0;
          policeCool = 600;
          addPoints(5);
          say('You outran the police! \u{1F680} +5');
        } else if (police.g <= 45) {
          police.state = 'caught';
          police.t = 0;
          police.fine = 20 + Math.floor(Math.random() * 31); // up to 50
        }
      }
    }

    // ---------- drawing ----------

    function drawSea() {
      const sea = getComputedStyle(document.documentElement).getPropertyValue('--sea').trim() || '#2b8fc4';
      ctx.fillStyle = sea;
      ctx.fillRect(0, 0, W, H);

      // Wave caps drifting down the screen, with a gentle side-to-side shimmer.
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.28)';
      ctx.lineWidth = 2;
      for (let row = -1; row < H / 60 + 1; row++) {
        const y = row * 60 + (scrollY % 60);
        for (let col = 0; col < 6; col++) {
          const x = col * 80 + (row % 2 === 0 ? 20 : 60) + Math.sin(frame / 30 + row + col) * 5;
          ctx.beginPath();
          ctx.arc(x, y, 9, Math.PI * 0.15, Math.PI * 0.85);
          ctx.stroke();
        }
      }
    }

    function drawRock(o) {
      const pts = 8;
      ctx.beginPath();
      for (let i = 0; i < pts; i++) {
        const a = (i / pts) * Math.PI * 2;
        const rr = o.r * (0.82 + 0.28 * Math.abs(Math.sin(o.seed + i * 2.3)));
        const px = o.x + Math.cos(a) * rr;
        const py = o.y + Math.sin(a) * rr;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = '#6b6f76';
      ctx.fill();
      ctx.strokeStyle = '#3d4045';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(o.x - o.r * 0.25, o.y - o.r * 0.25, o.r * 0.38, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
      ctx.fill();
      ctx.beginPath();
      ctx.arc(o.x, o.y, o.r + 6, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.lineWidth = 3;
      ctx.stroke();
    }

    function drawShark(o) {
      ctx.save();
      ctx.translate(o.x, o.y);
      ctx.fillStyle = '#7d8a99';
      ctx.strokeStyle = '#46515e';
      ctx.lineWidth = 2;
      // tail
      ctx.beginPath();
      ctx.moveTo(0, -20);
      ctx.lineTo(-11, -34);
      ctx.lineTo(0, -28);
      ctx.lineTo(11, -34);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      // side fins
      ctx.beginPath();
      ctx.moveTo(-8, 2);
      ctx.lineTo(-22, 12);
      ctx.lineTo(-6, 12);
      ctx.moveTo(8, 2);
      ctx.lineTo(22, 12);
      ctx.lineTo(6, 12);
      ctx.fill();
      // body
      ctx.beginPath();
      ctx.ellipse(0, 0, 12, 26, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      // dorsal fin
      ctx.beginPath();
      ctx.moveTo(0, -6);
      ctx.lineTo(7, 8);
      ctx.lineTo(-7, 8);
      ctx.closePath();
      ctx.fillStyle = '#5d6975';
      ctx.fill();
      // eyes
      ctx.fillStyle = '#10151a';
      ctx.beginPath();
      ctx.arc(-5, 17, 1.8, 0, Math.PI * 2);
      ctx.arc(5, 17, 1.8, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawCoin(c) {
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd400';
      ctx.fill();
      ctx.strokeStyle = '#b8860b';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r - 4, 0, Math.PI * 2);
      ctx.strokeStyle = '#fff3b0';
      ctx.stroke();
    }

    function drawBoat() {
      const sink = crashing || (gameOver && crashT > 0) ? crashT : 0;
      const x = boat.x;
      const y = boatY + sink * 30;
      const angle = crashDir * sink * 1.35;

      // foam trail behind the boat while sailing
      if (!crashing && !gameOver && (started || (dock && dock.stage === 'castoff'))) {
        ctx.fillStyle = boosting ? 'rgba(255, 255, 255, 0.5)' : 'rgba(255, 255, 255, 0.28)';
        ctx.beginPath();
        ctx.moveTo(x - 12, y + 26);
        ctx.lineTo(x - 26 - Math.sin(frame / 10) * 3, y + 92 + (boosting ? 46 : 0));
        ctx.lineTo(x + 26 + Math.sin(frame / 10) * 3, y + 92 + (boosting ? 46 : 0));
        ctx.lineTo(x + 12, y + 26);
        ctx.closePath();
        ctx.fill();
      }

      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      // hull
      ctx.beginPath();
      ctx.moveTo(0, -33);
      ctx.quadraticCurveTo(19, -10, 15, 28);
      ctx.lineTo(-15, 28);
      ctx.quadraticCurveTo(-19, -10, 0, -33);
      ctx.closePath();
      ctx.fillStyle = '#d62828';
      ctx.fill();
      ctx.strokeStyle = '#8c1a1a';
      ctx.lineWidth = 2;
      ctx.stroke();

      // deck
      ctx.beginPath();
      ctx.moveTo(0, -24);
      ctx.quadraticCurveTo(12, -8, 9, 22);
      ctx.lineTo(-9, 22);
      ctx.quadraticCurveTo(-12, -8, 0, -24);
      ctx.closePath();
      ctx.fillStyle = '#f2d9a8';
      ctx.fill();

      // sail
      ctx.beginPath();
      ctx.moveTo(0, -18);
      ctx.quadraticCurveTo(22, -2, 3, 14);
      ctx.lineTo(0, 14);
      ctx.closePath();
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.strokeStyle = '#c9c2b2';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // mast
      ctx.beginPath();
      ctx.arc(0, -1, 3, 0, Math.PI * 2);
      ctx.fillStyle = '#6b4f2a';
      ctx.fill();

      ctx.restore();
    }

    function drawSplashes() {
      splashes.forEach((s) => {
        const p = s.age / 40;
        ctx.beginPath();
        ctx.arc(s.x, s.y, 6 + p * 34, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 255, 255, ' + 0.7 * (1 - p) + ')';
        ctx.lineWidth = 3;
        ctx.stroke();
      });
    }


    function drawPolice() {
      const p = police;
      const caught = p.state === 'caught';
      const x = caught ? Math.min(W - 30, boat.x + 46) : p.x;
      const y = caught ? boatY + 4 : boatY + p.g;
      if (y > H + 70) return;
      ctx.save();
      ctx.translate(x, y);
      ctx.beginPath();
      ctx.moveTo(0, -33);
      ctx.quadraticCurveTo(19, -10, 15, 28);
      ctx.lineTo(-15, 28);
      ctx.quadraticCurveTo(-19, -10, 0, -33);
      ctx.closePath();
      ctx.fillStyle = '#f4f6f8';
      ctx.fill();
      ctx.strokeStyle = '#1b3a6b';
      ctx.lineWidth = 2.5;
      ctx.stroke();
      ctx.fillStyle = '#1b3a6b';
      ctx.fillRect(-13, -2, 26, 9);
      ctx.fillStyle = '#9fd3ee';
      ctx.fillRect(-8, -18, 16, 12);
      const on = Math.floor(p.flash / 8) % 2 === 0;
      ctx.fillStyle = on ? '#ff2d2d' : '#5a1a1a';
      ctx.beginPath();
      ctx.arc(-6, -22, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = on ? '#1a2a5a' : '#3a7bff';
      ctx.beginPath();
      ctx.arc(6, -22, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      ctx.beginPath();
      ctx.arc(x + (on ? -6 : 6), y - 22, 22, 0, Math.PI * 2);
      ctx.fillStyle = on ? 'rgba(255, 40, 40, 0.28)' : 'rgba(60, 120, 255, 0.28)';
      ctx.fill();
    }

    function drawHud() {
      // wallet
      ctx.fillStyle = 'rgba(10, 25, 35, 0.65)';
      ctx.beginPath();
      ctx.roundRect(10, 10, 112, 32, 16);
      ctx.fill();
      ctx.fillStyle = '#ffe066';
      ctx.font = 'bold 17px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('\u{1F4B0} ' + wallet, 22, 33);
      if (toast) {
        const a = Math.min(1, toast.t / 25);
        ctx.globalAlpha = a;
        ctx.font = 'bold 14px sans-serif';
        const w = Math.min(W - 24, ctx.measureText(toast.text).width + 28);
        ctx.fillStyle = 'rgba(10, 25, 35, 0.8)';
        ctx.beginPath();
        ctx.roundRect(W / 2 - w / 2, 96, w, 34, 17);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.fillText(toast.text, W / 2, 118);
        ctx.globalAlpha = 1;
      }
      // the Slow and Boost buttons
      const slowOn = slowHeld();
      ctx.fillStyle = slowOn ? '#e08a1e' : 'rgba(10, 25, 35, 0.65)';
      ctx.beginPath();
      ctx.roundRect(slowBtn.x, slowBtn.y, slowBtn.w, slowBtn.h, 22);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 15px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('⚓ Slow', slowBtn.x + slowBtn.w / 2, slowBtn.y + 28);
      const bOn = boosting;
      ctx.fillStyle = 'rgba(10, 25, 35, 0.65)';
      ctx.beginPath();
      ctx.roundRect(boostBtn.x, boostBtn.y, boostBtn.w, boostBtn.h, 22);
      ctx.fill();
      ctx.fillStyle = bOn ? '#ff7a1a' : '#2fbf71';
      ctx.beginPath();
      ctx.roundRect(boostBtn.x + 3, boostBtn.y + 3, Math.max(0, (boostBtn.w - 6) * (boostEnergy / 100)), boostBtn.h - 6, 19);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.fillText('\u{1F680} Boost', boostBtn.x + boostBtn.w / 2, boostBtn.y + 28);
    }

    function drawFinePanel() {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.roundRect(40, 170, 320, 230, 20);
      ctx.fill();
      ctx.strokeStyle = '#1b3a6b';
      ctx.lineWidth = 4;
      ctx.stroke();
      ctx.fillStyle = '#1b3a6b';
      ctx.beginPath();
      ctx.roundRect(40, 170, 320, 48, 20);
      ctx.fill();
      ctx.fillRect(40, 196, 320, 22);
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 20px sans-serif';
      ctx.fillText('\u{1F6A8} POLICE! STOP!', 200, 202);
      ctx.font = '44px sans-serif';
      ctx.fillStyle = '#000000';
      ctx.fillText('\u{1F46E}', 200, 262);
      ctx.fillStyle = '#1b3a6b';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText('You were sailing too slowly!', 200, 292);
      ctx.fillText('Your fine is \u{1F4B0} ' + police.fine, 200, 316);
      ctx.font = '12px sans-serif';
      ctx.fillStyle = '#5b6a7a';
      ctx.fillText('You have \u{1F4B0} ' + wallet, 200, 336);
      if (police.t > 30) {
        ctx.fillStyle = '#2fbf71';
        ctx.beginPath();
        ctx.roundRect(90, 346, 220, 44, 22);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 16px sans-serif';
        ctx.fillText('Pay the fine \u{1F4B8}', 200, 374);
      }
    }

    function drawDock() {
      const d = dock;
      ctx.save();
      ctx.translate(0, d.off);
      // a big ship far away
      ctx.font = '90px sans-serif';
      ctx.fillStyle = '#000000';
      ctx.textAlign = 'center';
      ctx.fillText('\u{1F6A2}', 290, 190 + Math.sin(frame / 40) * 3);
      // the dock: planks
      const plank = (x, y, w, h) => {
        ctx.fillStyle = '#a8793f';
        ctx.fillRect(x, y, w, h);
        ctx.strokeStyle = '#8a5f2c';
        ctx.lineWidth = 2;
        for (let yy = y + 14; yy < y + h; yy += 14) {
          ctx.beginPath();
          ctx.moveTo(x, yy);
          ctx.lineTo(x + w, yy);
          ctx.stroke();
        }
        ctx.strokeStyle = '#6b4a22';
        ctx.lineWidth = 4;
        ctx.strokeRect(x, y, w, h);
      };
      plank(-4, 440, 154, 170);
      plank(250, 440, 154, 170);
      plank(-4, 566, W + 8, 40);
      // containers and a crane
      [['#c0392b', 266, 452, 56, 34], ['#2c7fb8', 328, 452, 62, 34], ['#e8a317', 280, 492, 74, 34]].forEach(([c, x, y, w, h]) => {
        ctx.fillStyle = c;
        ctx.fillRect(x, y, w, h);
        ctx.strokeStyle = 'rgba(0,0,0,0.35)';
        ctx.lineWidth = 2;
        ctx.strokeRect(x, y, w, h);
        for (let k = 1; k < 5; k++) {
          ctx.beginPath();
          ctx.moveTo(x + (w / 5) * k, y);
          ctx.lineTo(x + (w / 5) * k, y + h);
          ctx.stroke();
        }
      });
      ctx.font = '54px sans-serif';
      ctx.fillStyle = '#000000';
      ctx.fillText('\u{1F3D7}️', 366, 446);
      // the sign
      ctx.fillStyle = '#5a3a1a';
      ctx.beginPath();
      ctx.roundRect(14, 394, 124, 34, 8);
      ctx.fill();
      ctx.fillStyle = '#ffe9b0';
      ctx.font = 'bold 14px sans-serif';
      ctx.fillText('⚓ SHIP DOCK', 76, 416);
      // bollards, the rope and the gangplank
      [[150, 470], [150, 520], [250, 470]].forEach(([x, y]) => {
        ctx.fillStyle = '#3a3f45';
        ctx.beginPath();
        ctx.arc(x, y, 7, 0, Math.PI * 2);
        ctx.fill();
      });
      if (d.stage !== 'castoff') {
        ctx.strokeStyle = '#d9c28a';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(150, 470);
        ctx.quadraticCurveTo(168, 484, 183, 474);
        ctx.stroke();
      }
      ctx.fillStyle = '#c99a55';
      ctx.beginPath();
      ctx.moveTo(150, 508);
      ctx.lineTo(150, 524);
      ctx.lineTo(188, 504);
      ctx.lineTo(188, 492);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    function drawDockFront() {
      const d = dock;
      // the sailor
      if (d.stage === 'walk' || d.stage === 'board') {
        const x = d.stage === 'walk' ? d.sx : d.px;
        const y = d.stage === 'walk' ? 520 : d.py;
        ctx.fillStyle = 'rgba(0,0,0,0.25)';
        ctx.beginPath();
        ctx.ellipse(x, y + 14 + (d.stage === 'board' ? 0 : 0), 14, 5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.font = '36px sans-serif';
        ctx.fillStyle = '#000000';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F9D1}‍✈️', x, y + 8 + Math.sin(d.t / 5) * (d.stage === 'walk' && d.goal !== null ? 2 : 0));
      }
      let msg = '';
      let label = '';
      if (d.stage === 'walk') {
        msg = d.sx > 105 ? 'You are at the boat! Climb aboard ⛵' : 'Walk along the dock to your boat \u{1F449} Tap the dock';
        if (d.sx > 105) label = 'Board the boat ⛵';
      } else if (d.stage === 'board') msg = 'Climbing aboard...';
      else if (d.stage === 'rope') {
        msg = 'You are on board! Untie the rope.';
        label = 'Untie the rope & sail \u{1FAA2}';
      } else msg = 'Sailing out of the dock... ⛵';
      ctx.fillStyle = 'rgba(10, 25, 35, 0.72)';
      ctx.beginPath();
      ctx.roundRect(20, 20, W - 40, 38, 19);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(msg, W / 2, 44);
      if (label) {
        ctx.fillStyle = '#2fbf71';
        ctx.beginPath();
        ctx.roundRect(dockBtn.x, dockBtn.y, dockBtn.w, dockBtn.h, 24);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 17px sans-serif';
        ctx.fillText(label, W / 2, dockBtn.y + 31);
      }
    }

    function drawOverlay(title, subtitle) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      ctx.font = 'bold 30px sans-serif';
      ctx.fillText(title, W / 2, H / 2 - 16);
      ctx.font = '18px sans-serif';
      ctx.fillText(subtitle, W / 2, H / 2 + 20);
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      drawSea();

      if (dock) drawDock();
      coins.forEach(drawCoin);
      rocks.forEach((o) => (o.kind === 'shark' ? drawShark(o) : drawRock(o)));
      if (police) drawPolice();
      drawBoat();
      drawSplashes();
      if (dock) drawDockFront();
      else if (started && !gameOver) drawHud();
      if (police && police.state === 'caught') drawFinePanel();

      if (levelFlash > 0 && started && !gameOver) {
        const alpha = Math.min(1, levelFlash / 20);
        ctx.fillStyle = 'rgba(255, 220, 80, ' + alpha + ')';
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Level ' + level + '!', W / 2, 70);
      }

      if (!started && !dock) {
        drawOverlay('Tap to start', 'Go to the dock and board your boat!');
      } else if (gameOver) {
        drawOverlay('Shipwrecked!', 'Tap to go back to the dock • Score: ' + score);
      }
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function boot(data) {
      if (data && typeof data.best === 'number' && data.best > best) {
        best = data.best;
        bestEl.textContent = 'Best: ' + best;
      }
      draw();
      loop();
    }

    if (window.claude && window.claude.hot && window.claude.hot.snapshot) {
      window.claude.hot.snapshot(() => ({ best }));
    }

    if (window.claude && window.claude.hot && window.claude.hot.ready) {
      window.claude.hot.ready(boot);
    } else {
      boot(window.claude && window.claude.hot ? window.claude.hot.data : null);
    }
  })();
</script>
  </body>
</html>
