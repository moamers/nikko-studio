    }

    function drawDock() {
      const d = dock;
      ctx.save();
      ctx.translate(0, d.off);
      // a big ship far away
      ctx.font = '90px sans-serif';
      ctx.fillStyle = '#000000';
      ctx.textAlign = 'center';
      ctx.fillText('\u{1F6A2}', 290, 190 + Math.sin(frame / 40) * 3);
      // the dock: planks
      const plank = (x, y, w, h) => {
        ctx.fillStyle = '#a8793f';
        ctx.fillRect(x, y, w, h);
        ctx.strokeStyle = '#8a5f2c';
        ctx.lineWidth = 2;
        for (let yy = y + 14; yy < y + h; yy += 14) {
          ctx.beginPath();
          ctx.moveTo(x, yy);
          ctx.lineTo(x + w, yy);
          ctx.stroke();
        }
        ctx.strokeStyle = '#6b4a22';
        ctx.lineWidth = 4;
        ctx.strokeRect(x, y, w, h);
      };
      plank(-4, 440, 154, 170);
      plank(250, 440, 154, 170);
      plank(-4, 566, W + 8, 40);
      // containers and a crane
      [['#c0392b', 266, 452, 56, 34], ['#2c7fb8', 328, 452, 62, 34], ['#e8a317', 280, 492, 74, 34]].forEach(([c, x, y, w, h]) => {
        ctx.fillStyle = c;
        ctx.fillRect(x, y, w, h);
        ctx.strokeStyle = 'rgba(0,0,0,0.35)';
        ctx.lineWidth = 2;
        ctx.strokeRect(x, y, w, h);
        for (let k = 1; k < 5; k++) {
          ctx.beginPath();
          ctx.moveTo(x + (w / 5) * k, y);
          ctx.lineTo(x + (w / 5) * k, y + h);
          ctx.stroke();
        }
      });
      ctx.font = '54px sans-serif';
      ctx.fillStyle = '#000000';
      ctx.fillText('\u{1F3D7}️', 366, 446);
      // the harbor shop
      ctx.fillStyle = '#efe0b8';
      ctx.fillRect(12, 400, 126, 62);
      ctx.strokeStyle = '#6b4a22';
      ctx.lineWidth = 3;
      ctx.strokeRect(12, 400, 126, 62);
      for (let k = 0; k < 7; k++) {
        ctx.fillStyle = k % 2 ? '#ffffff' : '#d62828';
        ctx.fillRect(12 + k * 18, 400, 18, 16);
      }
      ctx.fillStyle = '#5a3a1a';
      ctx.font = 'bold 13px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('HARBOR SHOP', 75, 440);
      ctx.font = '20px sans-serif';
      ctx.fillStyle = '#000000';
      ctx.fillText('\u{1F6A4}', 75, 458);
      // the ship dock sign
      ctx.fillStyle = '#5a3a1a';
      ctx.beginPath();
      ctx.roundRect(258, 418, 112, 24, 8);
      ctx.fill();
      ctx.fillStyle = '#ffe9b0';
      ctx.font = 'bold 12px sans-serif';
      ctx.fillText('\u2693 SHIP DOCK', 314, 435);
      // bollards, the rope and the gangplank
      [[150, 470], [150, 520], [250, 470]].forEach(([x, y]) => {
        ctx.fillStyle = '#3a3f45';
        ctx.beginPath();
        ctx.arc(x, y, 7, 0, Math.PI * 2);
        ctx.fill();
      });
      if (d.stage !== 'castoff') {
        ctx.strokeStyle = '#d9c28a';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(150, 470);
        ctx.quadraticCurveTo(168, 484, 183, 474);
        ctx.stroke();
      }
      ctx.fillStyle = '#c99a55';
      ctx.beginPath();
      ctx.moveTo(150, 508);
      ctx.lineTo(150, 524);
      ctx.lineTo(188, 504);
      ctx.lineTo(188, 492);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    function drawDockFront() {
      const d = dock;
      // the sailor
      if (d.stage === 'walk' || d.stage === 'board') {
        const x = d.stage === 'walk' ? d.sx : d.px;
        const y = d.stage === 'walk' ? 520 : d.py;
        ctx.fillStyle = 'rgba(0,0,0,0.25)';
        ctx.beginPath();
        ctx.ellipse(x, y + 14 + (d.stage === 'board' ? 0 : 0), 14, 5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.font = '36px sans-serif';
        ctx.fillStyle = '#000000';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F9D1}‍✈️', x, y + 8 + Math.sin(d.t / 5) * (d.stage === 'walk' && d.goal !== null ? 2 : 0));
      }
      let msg = '';
      let label = '';
      if (d.stage === 'walk') {
        msg = d.sx > 105 ? 'You are at the boat! Climb aboard \u26F5' : 'Walk to your boat \u{1F449} or visit the Harbor shop \u{1F3EA}';
        if (d.sx > 105) label = 'Board the boat ⛵';
      } else if (d.stage === 'board') msg = 'Climbing aboard...';
      else if (d.stage === 'rope') {
        msg = 'You are on board! Untie the rope.';
        label = 'Untie the rope \u{1FAA2}';
      } else msg = 'Sailing out of the dock... ⛵';
      ctx.fillStyle = 'rgba(10, 25, 35, 0.72)';
      ctx.beginPath();
      ctx.roundRect(20, 20, W - 40, 38, 19);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(msg, W / 2, 44);
      if (d.stage === 'walk') {
        ctx.fillStyle = '#1b6fd1';
        ctx.beginPath();
        ctx.roundRect(shopBtn.x, shopBtn.y, shopBtn.w, shopBtn.h, 24);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 15px sans-serif';
        ctx.fillText('\u{1F3EA} Harbor shop', shopBtn.x + shopBtn.w / 2, shopBtn.y + 30);
      }
      if (label) {
        ctx.fillStyle = '#2fbf71';
        ctx.beginPath();
        ctx.roundRect(dockBtn.x, dockBtn.y, dockBtn.w, dockBtn.h, 24);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 17px sans-serif';
        ctx.fillText(label, dockBtn.x + dockBtn.w / 2, dockBtn.y + 31);
      }
    }

    function drawOverlay(title, subtitle) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      ctx.font = 'bold 30px sans-serif';
      ctx.fillText(title, W / 2, H / 2 - 16);
      ctx.font = '18px sans-serif';
      ctx.fillText(subtitle, W / 2, H / 2 + 20);
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      drawSea();
      drawStorm();

      if (dock) drawDock();
      if (station) drawStation();
      coins.forEach(drawCoin);
      rocks.forEach((o) => (o.kind === 'shark' ? drawShark(o) : drawRock(o)));
      if (police) drawPolice();
      drawBoat();
      drawSplashes();
      drawStormOverlay();
      if (dock) drawDockFront();
      else if (started && !gameOver) drawHud();
      if (police && police.state === 'caught') drawFinePanel();
      if (shopOpen) drawShop();

      if (levelFlash > 0 && started && !gameOver) {
        const alpha = Math.min(1, levelFlash / 20);
        ctx.fillStyle = 'rgba(255, 220, 80, ' + alpha + ')';
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Level ' + level + '!', W / 2, 70);
      }

      if (!started && !dock) {
        drawOverlay('Tap to start', 'Go to the dock and board your boat!');
      } else if (gameOver) {
        drawOverlay(endReason === 'fuel' ? 'Out of fuel! \u26FD' : 'Shipwrecked!', 'Tap to go back to the dock • Score: ' + score);
      }
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function boot(data) {
      if (data && typeof data.best === 'number' && data.best > best) {
        best = data.best;
        bestEl.textContent = 'Best: ' + best;
      }
      draw();
      loop();
    }

    if (window.claude && window.claude.hot && window.claude.hot.snapshot) {
      window.claude.hot.snapshot(() => ({ best }));
    }

    if (window.claude && window.claude.hot && window.claude.hot.ready) {
      window.claude.hot.ready(boot);
    } else {
      boot(window.claude && window.claude.hot ? window.claude.hot.data : null);
    }
  })();
</script>
  </body>
</html>
