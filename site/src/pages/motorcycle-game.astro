<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Motorcycle Off-Road</title>
  </head>
  <body>
<style is:global>
  :root {
    --bg: #fff8f0;
    --card: #ffffff;
    --ink: #2a1f1a;
    --ink-soft: #6b5a50;
    --road: #b9824a;
    --sand: #e8c98a;
    --accent: #e8590c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #1c1612;
      --card: #2a2019;
      --ink: #f6ece4;
      --ink-soft: #c2ad9e;
      --road: #6e4a2b;
      --sand: #8c7448;
      --accent: #ff8a3d;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #1c1612;
    --card: #2a2019;
    --ink: #f6ece4;
    --ink-soft: #c2ad9e;
    --road: #6e4a2b;
    --sand: #8c7448;
    --accent: #ff8a3d;
    color-scheme: dark;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .wrap {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 24px;
  }

  h1 {
    font-size: clamp(22px, 6vw, 30px);
    margin: 0;
    text-align: center;
  }

  .sub {
    color: var(--ink-soft);
    margin: 0;
    text-align: center;
    font-size: 14px;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    max-height: 70vh;
    background: var(--card);
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background: var(--sand);
    touch-action: none;
  }

  .score {
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .best {
    font-size: 13px;
    color: var(--ink-soft);
    margin: 0;
  }

  .level {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin: 0;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .controls button {
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    background: var(--card);
    border: 2px solid var(--ink-soft);
    border-radius: 999px;
    padding: 9px 16px;
    cursor: pointer;
    user-select: none;
  }

  .controls button:active {
    transform: scale(0.96);
  }

  .controls button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  #boostBtn {
    font-weight: 800;
    border: 3px solid #8c1a1a;
    background: #ff6b4a;
    color: #fff;
    touch-action: none;
  }

  #boostBtn:active {
    background: #e63946;
  }

  #trickBtn {
    font-weight: 800;
    font-size: 17px;
    border: 3px solid #0b6b3a;
    background: #1fbf6a;
    color: #fff;
    touch-action: none;
  }

  #trickBtn:active {
    background: #0f9a4f;
  }

  #turboBtn {
    font-weight: 800;
    font-size: 17px;
    border: 3px solid #5a1a8c;
    background: #8e44ad;
    color: #fff;
    touch-action: none;
  }

  #turboBtn:active {
    background: #6c3483;
  }

  .boost-bar {
    width: 100px;
    height: 13px;
    background: #ddd;
    border: 2px solid #333;
    border-radius: 999px;
    overflow: hidden;
  }

  .boost-fill {
    height: 100%;
    width: 100%;
    background: #ffd400;
    transition: width 80ms linear;
  }
</style>

<div class="wrap">
  <h1>&#127949;&#65039; Motorcycle Off-Road</h1>
  <p class="sub">Drag your finger (or mouse) left and right to steer. Dodge the rocks and logs, hit the ramps to jump, do tricks in the air for bonus points, grab coins and the blue shield, and hold Boost for speed!</p>
  <p class="score" id="score">Score: 0</p>
  <p class="level" id="level">Level 1</p>
  <p class="best" id="best">Best: 0</p>
  <div class="stage">
    <canvas id="game" width="400" height="600" aria-label="Motorcycle off-road game"></canvas>
  </div>
  <div class="controls">
    <button id="trickBtn">&#129336; TRICK</button>
    <button id="turboBtn">&#9889; VERY FAST</button>
    <button id="boostBtn">&#128640; BOOST</button>
    <div class="boost-bar"><div id="boostFill" class="boost-fill"></div></div>
    <button id="easyBtn" aria-pressed="false">&#128034; Easy</button>
    <button id="soundBtn" aria-pressed="false">&#128266; Sound on</button>
  </div>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const bestEl = document.getElementById('best');
    const levelEl = document.getElementById('level');
    const boostBtn = document.getElementById('boostBtn');
    const boostFill = document.getElementById('boostFill');
    const turboBtn = document.getElementById('turboBtn');
    const trickBtn = document.getElementById('trickBtn');
    const easyBtn = document.getElementById('easyBtn');
    const soundBtn = document.getElementById('soundBtn');
    const pointsPerLevel = 5;

    const W = canvas.width;
    const H = canvas.height;

    const roadLeft = 60;
    const roadRight = W - 60;

    const bikeStartY = H - 130;
    const bike = { x: W / 2, y: bikeStartY, w: 20, h: 52 };

    // ---------- sound: a synthesized engine, made on the first tap ----------
    let audioCtx = null;
    let engineOsc = null;
    let engineOsc2 = null;
    let engineGain = null;
    let soundOn = true;

    function ensureAudio() {
      // Never let a sound failure block the game from starting.
      try {
        if (audioCtx) {
          if (audioCtx.state === 'suspended') audioCtx.resume();
          return;
        }
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        engineGain = audioCtx.createGain();
        engineGain.gain.value = 0;
        engineOsc = audioCtx.createOscillator();
        engineOsc.type = 'sawtooth';
        engineOsc2 = audioCtx.createOscillator();
        engineOsc2.type = 'square';
        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 520;
        engineOsc.connect(filter);
        engineOsc2.connect(filter);
        filter.connect(engineGain).connect(audioCtx.destination);
        engineOsc.start();
        engineOsc2.start();
      } catch (e) {
        audioCtx = null;
      }
    }

    function updateEngine() {
      if (!audioCtx || !engineGain) return;
      try {
        const running = soundOn && started && !gameOver && !crashing;
        const t = audioCtx.currentTime;
        const rev = worldSpeed();
        // the engine buzzes higher the faster you go, with a rattle on top
        engineOsc.frequency.setTargetAtTime(55 + rev * 9 + Math.sin(frameCount / 3) * 2, t, 0.05);
        engineOsc2.frequency.setTargetAtTime(27 + rev * 4.5, t, 0.05);
        engineGain.gain.setTargetAtTime(running ? (fastNow() ? 0.075 : 0.045) : 0, t, 0.08);
      } catch (e) {}
    }

    function blip(freq, freq2, dur, vol) {
      if (!audioCtx || !soundOn) return;
      try {
        const o = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        o.type = 'triangle';
        const t = audioCtx.currentTime;
        o.frequency.setValueAtTime(freq, t);
        o.frequency.linearRampToValueAtTime(freq2, t + dur);
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        o.connect(g).connect(audioCtx.destination);
        o.start(t);
        o.stop(t + dur);
      } catch (e) {}
    }

    function crashSound() {
      if (!audioCtx || !soundOn) return;
      try {
        const len = Math.floor(audioCtx.sampleRate * 0.5);
        const buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const src = audioCtx.createBufferSource();
        const g = audioCtx.createGain();
        g.gain.value = 0.35;
        src.buffer = buf;
        src.connect(g).connect(audioCtx.destination);
        src.start();
      } catch (e) {}
    }

    soundBtn.addEventListener('click', () => {
      soundOn = !soundOn;
      soundBtn.setAttribute('aria-pressed', String(!soundOn));
      soundBtn.innerHTML = soundOn ? '&#128266; Sound on' : '&#128263; Sound off';
      ensureAudio();
      updateEngine();
    });

    // ---------- state ----------
    let targetX = bike.x;
    const keys = { left: false, right: false };
    const moveSpeed = 15;
    const followSpeed = 0.35;
    let lean = 0; // how far the bike leans into a turn
    let easy = false; // easy mode: slower, with more room between things to dodge
    let air = 0; // frames left in the air after a jump
    const airTotal = 66; // long enough for two tricks
    // Tricks in the air: press TRICK while flying. Finish them before you land.
    const trickDur = 24;
    const trickNames = ['Backflip', '360 spin', 'Double flip', 'Super spin'];
    let trickT = 0; // frames left in the trick being done
    let trickKind = 0;
    let tricksDone = 0; // finished tricks in this jump
    let trickPoints = 0;
    let airBonus = 0; // things cleared while flying
    let ramps = [];
    let rampSpawnIn = 200;
    let turbo = false;
    let smashed = []; // obstacles blown away by the very fast button
    let popups = []; // little "+1" and "Nice!" texts

    let traffic = [];
    let coins = [];
    let shields = [];
    let laneLines = [];
    let scenery = []; // palm trees and rocks beside the road
    let score = 0;
    let level = 1;
    let levelFlash = 0;
    let best = 0;
    let gameOver = false;
    let started = false;

    let boosting = false;
    let boostEnergy = 100;
    const boostDrain = 1.3;
    const boostRegen = 0.5;
    const boostMultiplier = 2.4;
    const turboMultiplier = 3.4; // the very fast button: faster, and it lasts about three times as long
    const turboDrain = 0.45;

    let coinSpawnIn = 90;
    let shieldOn = false;
    let shieldSpawnIn = 450;
    let shieldFlash = 0;
    let invuln = 0;

    // Crash: the rider tumbles off the road into the sand.
    let crashing = false;
    let crashTimer = 0;
    const crashDuration = 55;
    let crashAngle = 0;
    let crashSpin = 1;
    let crashStartX = 0;
    let crashStartY = 0;
    let crashTargetX = 0;
    let crashTargetY = 0;
    let dust = [];
    let frameCount = 0;
    let lastTime = null; // so game speed does not depend on the screen refresh rate

    function easeOut(t) {
      return t * t * (3 - 2 * t);
    }

    function levelFor(s) {
      return Math.floor(s / pointsPerLevel) + 1;
    }

    try {
      best = Number(localStorage.getItem('motorcycleOffroadBest') || 0);
      easy = localStorage.getItem('motorcycleEasy') === '1';
    } catch (e) {}
    function applyEasy() {
      easyBtn.setAttribute('aria-pressed', String(easy));
      easyBtn.innerHTML = easy ? '&#128034; Easy: on' : '&#128034; Easy';
    }
    applyEasy();
    easyBtn.addEventListener('click', () => {
      easy = !easy;
      applyEasy();
      try {
        localStorage.setItem('motorcycleEasy', easy ? '1' : '0');
      } catch (e) {}
    });
    bestEl.textContent = 'Best: ' + best;

    function startCrash() {
      if (crashing || gameOver) return;
      crashing = true;
      crashTimer = crashDuration;
      crashAngle = 0;
      const dir = bike.x < (roadLeft + roadRight) / 2 ? -1 : 1;
      crashSpin = dir;
      crashStartX = bike.x;
      crashStartY = bike.y;
      crashTargetX = dir < 0 ? roadLeft - 26 : roadRight + 26;
      crashTargetY = bike.y + 40;
      crashSound();
    }

    // ---------- spawning ----------
    // Things in the way: boulders, logs and cacti.
    function spawnTraffic() {
      const r = Math.random();
      const kind = r < 0.4 ? 'rock' : r < 0.75 || level < 2 ? 'cactus' : 'log';
      const size = kind === 'rock' ? 34 + Math.random() * 14 : kind === 'cactus' ? 24 : 78;
      const w = size;
      const h = kind === 'log' ? 24 : kind === 'cactus' ? 34 : size;
      const x = roadLeft + 10 + w / 2 + Math.random() * (roadRight - roadLeft - 20 - w);
      traffic.push({ x, y: -h, w, h, kind, seed: Math.random() * 6, passed: false });
    }

    // A jump: ride up the ramp and you fly.
    function spawnRamp() {
      const x = roadLeft + 44 + Math.random() * (roadRight - roadLeft - 88);
      ramps.push({ x, y: -40, w: 64, h: 46, used: false });
    }

    const fastNow = () => (turbo || boosting) && boostEnergy > 0;

    function spawnShield() {
      shields.push({ x: roadLeft + 24 + Math.random() * (roadRight - roadLeft - 48), y: -30, r: 15 });
    }

    function spawnCoin() {
      coins.push({ x: roadLeft + 24 + Math.random() * (roadRight - roadLeft - 48), y: -30, r: 12 });
    }

    function baseSpeed() {
      // Starts gentle at level 1, a clear step up with each level.
      return Math.min(14, 4.2 + (level - 1) * 1.2) * (easy ? 0.7 : 1);
    }

    function worldSpeed() {
      if (turbo && boostEnergy > 0) return Math.min(40, baseSpeed() * turboMultiplier);
      return boosting && boostEnergy > 0 ? baseSpeed() * boostMultiplier : baseSpeed();
    }

    function spawnGap() {
      // A little room is always left for a bike to squeeze through.
      return Math.max(130, 230 - (level - 1) * 12) * (easy ? 1.45 : 1);
    }

    function spawnLaneLines() {
      laneLines = [];
      for (let i = 0; i < 8; i++) laneLines.push({ y: i * 80 });
      scenery = [];
      for (let i = 0; i < 9; i++) {
        scenery.push({ side: i % 2, y: i * 75, off: 6 + ((i * 17) % 26), kind: i % 3 === 0 ? 'rock' : i % 3 === 1 ? 'bush' : 'palm' });
      }
    }
    spawnLaneLines();

    function resetGame() {
      bike.x = W / 2;
      bike.y = bikeStartY;
      targetX = bike.x;
      lean = 0;
      traffic = [];
      coins = [];
      shields = [];
      ramps = [];
      rampSpawnIn = 200;
      air = 0;
      airBonus = 0;
      trickT = 0;
      tricksDone = 0;
      trickPoints = 0;
      turbo = false;
      popups = [];
      dust = [];
      score = 0;
      level = 1;
      levelFlash = 0;
      scoreEl.textContent = 'Score: 0';
      levelEl.textContent = 'Level 1';
      gameOver = false;
      started = true;
      boosting = false;
      boostEnergy = 100;
      coinSpawnIn = 90;
      shieldOn = false;
      shieldSpawnIn = 450 + Math.random() * 300;
      shieldFlash = 0;
      invuln = 0;
      crashing = false;
      crashTimer = 0;
      crashAngle = 0;
      spawnTraffic();
    }

    function startOrRestart() {
      if (!started || gameOver) resetGame();
      ensureAudio();
    }

    // ---------- controls ----------
    function pointerToX(clientX) {
      const rect = canvas.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * W;
    }

    canvas.addEventListener('mousedown', (e) => {
      startOrRestart();
      targetX = pointerToX(e.clientX);
    });
    canvas.addEventListener('mousemove', (e) => {
      targetX = pointerToX(e.clientX);
    });
    canvas.addEventListener(
      'touchstart',
      (e) => {
        startOrRestart();
        targetX = pointerToX(e.touches[0].clientX);
      },
      { passive: true }
    );
    canvas.addEventListener(
      'touchmove',
      (e) => {
        targetX = pointerToX(e.touches[0].clientX);
      },
      { passive: true }
    );

    function startBoost(e) {
      e.preventDefault();
      ensureAudio();
      boosting = true;
    }
    function stopBoost() {
      boosting = false;
    }
    function doTrick() {
      if (!started || gameOver || crashing || air <= 0 || trickT > 0) return;
      if (air < trickDur * 0.6) return; // too late: not enough sky left
      trickT = trickDur;
      trickKind = tricksDone % trickNames.length;
      blip(300, 700, 0.25, 0.15);
    }
    function pressTrick(e) {
      e.preventDefault();
      ensureAudio();
      doTrick();
    }
    trickBtn.addEventListener('mousedown', pressTrick);
    trickBtn.addEventListener('touchstart', pressTrick, { passive: false });

    function startTurbo(e) {
      e.preventDefault();
      ensureAudio();
      turbo = true;
    }
    function stopTurbo() {
      turbo = false;
    }
    turboBtn.addEventListener('mousedown', startTurbo);
    turboBtn.addEventListener('touchstart', startTurbo, { passive: false });
    turboBtn.addEventListener('mouseup', stopTurbo);
    turboBtn.addEventListener('mouseleave', stopTurbo);
    turboBtn.addEventListener('touchend', stopTurbo);
    turboBtn.addEventListener('touchcancel', stopTurbo);
    boostBtn.addEventListener('mousedown', startBoost);
    boostBtn.addEventListener('touchstart', startBoost, { passive: false });
    boostBtn.addEventListener('mouseup', stopBoost);
    boostBtn.addEventListener('mouseleave', stopBoost);
    boostBtn.addEventListener('touchend', stopBoost);
    boostBtn.addEventListener('touchcancel', stopBoost);

    window.addEventListener('keydown', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = true;
      if (e.code === 'KeyF') turbo = true;
      if (e.code === 'KeyT' || e.code === 'ArrowUp') doTrick();
      if (e.code === 'Space') {
        e.preventDefault();
        if (started && !gameOver && air > 0) doTrick();
        else startOrRestart();
      }
    });
    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = false;
      if (e.code === 'KeyF') turbo = false;
    });

    // ---------- update ----------
    function update() {
      const now = performance.now();
      let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
      lastTime = now;
      step = Math.min(Math.max(step, 0.2), 3); // same game speed on 60Hz and 120Hz screens
      frameCount += step;

      if (crashing) {
        crashTimer -= step;
        const t = easeOut(Math.min(1, Math.max(0, 1 - crashTimer / crashDuration)));
        bike.x = crashStartX + (crashTargetX - crashStartX) * t;
        bike.y = crashStartY + (crashTargetY - crashStartY) * t;
        crashAngle = crashSpin * Math.PI * 3 * t;
        if (frameCount % 3 < step) dust.push({ x: bike.x, y: bike.y + 10, age: 0 });
        dust.forEach((d) => (d.age += step));
        dust = dust.filter((d) => d.age < 30);
        air = 0;
        trickT = 0;
        tricksDone = 0;
        trickPoints = 0;
        if (crashTimer <= 0) {
          crashing = false;
          endGame();
        }
        updateEngine();
        return;
      }

      const speed = started && !gameOver ? worldSpeed() : 3;
      const dist = speed * step;
      laneLines.forEach((line) => {
        line.y += dist;
        if (line.y > H) line.y -= 8 * 80;
      });
      scenery.forEach((s) => {
        s.y += dist;
        if (s.y > H + 40) s.y -= 9 * 75;
      });

      if (!started || gameOver) {
        boosting = false;
        turbo = false;
        updateEngine();
        return;
      }

      if (keys.left) targetX -= moveSpeed * step;
      if (keys.right) targetX += moveSpeed * step;
      targetX = Math.max(roadLeft + bike.w / 2 + 2, Math.min(roadRight - bike.w / 2 - 2, targetX));

      const before = bike.x;
      bike.x += (targetX - bike.x) * (1 - Math.pow(1 - followSpeed, step));
      // lean into the turn
      const sway = (bike.x - before) / step;
      lean += (Math.max(-0.4, Math.min(0.4, sway * 0.06)) - lean) * (1 - Math.pow(1 - 0.25, step));

      if (turbo && boostEnergy > 0) {
        boostEnergy = Math.max(0, boostEnergy - turboDrain * step);
      } else if (boosting && boostEnergy > 0) {
        boostEnergy = Math.max(0, boostEnergy - boostDrain * step);
      } else {
        boosting = false;
        turbo = false;
        boostEnergy = Math.min(100, boostEnergy + boostRegen * step);
      }
      if (air > 0) {
        air -= step;
        if (trickT > 0) {
          trickT -= step;
          if (trickT <= 0) {
            // the trick is complete: points, and bigger for each one in a row
            trickT = 0;
            const tp = 5 + tricksDone * 3;
            const name = trickNames[tricksDone % trickNames.length];
            tricksDone++;
            trickPoints += tp;
            popups.push({ x: bike.x, y: bike.y - 70 - tricksDone * 14, text: '\u{1F938} ' + name + '! +' + tp, age: 0 });
            blip(660, 1320, 0.2, 0.18);
          }
        }
        if (air <= 0) {
          air = 0;
          // landing: a puff of dust and the points for the jump
          let tricky = trickPoints;
          if (tricksDone >= 2) {
            tricky += 5;
            popups.push({ x: bike.x, y: bike.y - 130, text: 'Combo! +5', age: 0 });
          }
          if (trickT > 0) popups.push({ x: bike.x, y: bike.y - 56, text: 'Oops, too late!', age: 0 });
          const pts = 3 + airBonus + tricky;
          score += pts;
          scoreEl.textContent = 'Score: ' + score;
          trickT = 0;
          tricksDone = 0;
          trickPoints = 0;
          popups.push({ x: bike.x, y: bike.y - 40, text: airBonus > 0 || tricky > 0 ? 'Great jump! +' + pts : 'Jump! +' + pts, age: 0 });
          for (let i = 0; i < 4; i++) dust.push({ x: bike.x + (i - 1.5) * 8, y: bike.y + 14, age: 0 });
          airBonus = 0;
          invuln = Math.max(invuln, 30); // a moment to steer clear after landing
          blip(260, 120, 0.15, 0.2);
        }
      }
      popups.forEach((p) => (p.age += step));
      popups = popups.filter((p) => p.age < 60);
      dust.forEach((d) => (d.age += step));
      dust = dust.filter((d) => d.age < 30);
      boostFill.style.width = boostEnergy + '%';

      traffic.forEach((other) => {
        other.y += dist;

        if (
          !other.smashed &&
          Math.abs(bike.x - other.x) < (bike.w + other.w) / 2 - 3 &&
          Math.abs(bike.y - other.y) < (bike.h + other.h) / 2 - 5
        ) {
          if (air > 0) {
            // flying over it
          } else if (turbo && boostEnergy > 0) {
            // the very fast button: you smash straight through
            other.smashed = true;
            other.passed = true;
            score += 2;
            scoreEl.textContent = 'Score: ' + score;
            popups.push({ x: other.x, y: other.y, text: 'Smash! +2', age: 0 });
            for (let i = 0; i < 5; i++) dust.push({ x: other.x + (i - 2) * 8, y: other.y, age: 0 });
            blip(200, 90, 0.18, 0.2);
          } else if (invuln > 0) {
            // still protected for a moment after the shield popped
          } else if (shieldOn) {
            shieldOn = false;
            invuln = 45;
            shieldFlash = 60;
            other.passed = true;
            other.y = H + 200; // the vehicle you bumped is swept aside
            blip(300, 900, 0.3, 0.2);
          } else {
            startCrash();
          }
        }

        if (!other.passed && other.y - other.h / 2 > bike.y + bike.h / 2) {
          other.passed = true;
          if (air > 0) airBonus++;
          score++;
          scoreEl.textContent = 'Score: ' + score;
          const newLevel = levelFor(score);
          if (newLevel > level) {
            level = newLevel;
            levelEl.textContent = 'Level ' + level;
            levelFlash = 90;
            blip(520, 1040, 0.35, 0.18);
          }
        }
      });
      traffic = traffic.filter((other) => !other.smashed && other.y < H + 120);

      // ramps: ride onto one to jump
      ramps.forEach((r) => {
        r.y += dist;
        if (!r.used && air <= 0 && Math.abs(bike.x - r.x) < r.w / 2 + 4 && Math.abs(bike.y - r.y) < r.h / 2) {
          r.used = true;
          air = airTotal;
          airBonus = 0;
          trickT = 0;
          tricksDone = 0;
          trickPoints = 0;
          blip(360, 880, 0.35, 0.2);
        }
      });
      ramps = ramps.filter((r) => r.y < H + 60);
      rampSpawnIn -= dist / 5;
      if (rampSpawnIn <= 0) {
        // never put a ramp right in front of a thing, so landing is not unfair
        if (traffic.every((o) => o.y > 110)) {
          spawnRamp();
          rampSpawnIn = (easy ? 330 : 480) + Math.random() * 250;
        } else {
          rampSpawnIn = 20;
        }
      }

      if (traffic.length === 0 || traffic[traffic.length - 1].y - traffic[traffic.length - 1].h / 2 > spawnGap()) {
        spawnTraffic();
      }

      coins.forEach((coin) => {
        coin.y += dist;
        if (Math.hypot(bike.x - coin.x, bike.y - coin.y) < coin.r + 16) {
          coin.collected = true;
          score += 3;
          scoreEl.textContent = 'Score: ' + score;
          blip(880, 1320, 0.15, 0.15);
        }
      });
      coins = coins.filter((coin) => !coin.collected && coin.y < H + 40);
      coinSpawnIn -= step;
      if (coinSpawnIn <= 0) {
        spawnCoin();
        coinSpawnIn = 110 + Math.random() * 90;
      }

      shields.forEach((sh) => {
        sh.y += dist;
        if (Math.hypot(bike.x - sh.x, bike.y - sh.y) < sh.r + 16) {
          sh.collected = true;
          shieldOn = true;
          blip(500, 1000, 0.3, 0.18);
        }
      });
      shields = shields.filter((sh) => !sh.collected && sh.y < H + 40);
      if (!shieldOn && shields.length === 0) {
        shieldSpawnIn -= step;
        if (shieldSpawnIn <= 0) {
          spawnShield();
          shieldSpawnIn = 500 + Math.random() * 400;
        }
      }

      levelFlash = Math.max(0, levelFlash - step);
      shieldFlash = Math.max(0, shieldFlash - step);
      invuln = Math.max(0, invuln - step);
      updateEngine();
    }

    function endGame() {
      if (gameOver) return;
      gameOver = true;
      if (score > best) {
        best = score;
        bestEl.textContent = 'Best: ' + best;
        try {
          localStorage.setItem('motorcycleOffroadBest', String(best));
        } catch (e) {}
      }
    }

    // ---------- drawing ----------
    function roundedBox(x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    function drawObstacle(o) {
      const x = o.x;
      const y = o.y;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
      if (o.kind === 'rock') {
        ctx.beginPath();
        ctx.ellipse(x + 4, y + 5, o.w / 2, o.h / 2, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#8d8f94';
        ctx.beginPath();
        ctx.moveTo(x - o.w / 2, y + 4);
        ctx.lineTo(x - o.w * 0.3, y - o.h / 2);
        ctx.lineTo(x + o.w * 0.15, y - o.h * 0.42);
        ctx.lineTo(x + o.w / 2, y - 2);
        ctx.lineTo(x + o.w * 0.3, y + o.h / 2);
        ctx.lineTo(x - o.w * 0.25, y + o.h * 0.45);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = '#4f5155';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = 'rgba(255, 255, 255, 0.28)';
        ctx.beginPath();
        ctx.ellipse(x - o.w * 0.12, y - o.h * 0.15, o.w * 0.18, o.h * 0.12, -0.5, 0, Math.PI * 2);
        ctx.fill();
      } else if (o.kind === 'cactus') {
        ctx.fillRect(x - 8, y - 14, 20, 34);
        ctx.fillStyle = '#2f8a46';
        roundedBox(x - 6, y - 17, 12, 34, 6);
        ctx.fill();
        roundedBox(x - 15, y - 4, 8, 14, 4);
        ctx.fill();
        roundedBox(x + 7, y - 10, 8, 14, 4);
        ctx.fill();
        ctx.strokeStyle = '#1d5c2f';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(x, y - 14);
        ctx.lineTo(x, y + 14);
        ctx.stroke();
      } else {
        ctx.fillRect(x - o.w / 2 + 3, y - o.h / 2 + 4, o.w, o.h);
        ctx.fillStyle = '#7a4a21';
        roundedBox(x - o.w / 2, y - o.h / 2, o.w, o.h, 10);
        ctx.fill();
        ctx.strokeStyle = '#4a2c12';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = '#c28a52';
        ctx.beginPath();
        ctx.ellipse(x + o.w / 2 - 6, y, 5, o.h / 2 - 3, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.25)';
        ctx.beginPath();
        ctx.moveTo(x - o.w / 2 + 10, y - 5);
        ctx.lineTo(x + o.w / 2 - 16, y - 5);
        ctx.moveTo(x - o.w / 2 + 16, y + 5);
        ctx.lineTo(x + o.w / 2 - 22, y + 5);
        ctx.stroke();
      }
    }

    function drawRamp(r) {
      const x = r.x - r.w / 2;
      const y = r.y - r.h / 2;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
      ctx.fillRect(x + 4, y + 5, r.w, r.h);
      // a dirt mound, narrower at the top where you launch
      ctx.fillStyle = '#9a6a3a';
      ctx.beginPath();
      ctx.moveTo(x, y + r.h);
      ctx.lineTo(x + 8, y);
      ctx.lineTo(x + r.w - 8, y);
      ctx.lineTo(x + r.w, y + r.h);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#5c3a1a';
      ctx.lineWidth = 2;
      ctx.stroke();
      // yellow chevrons pointing along the ramp
      ctx.strokeStyle = '#ffd400';
      ctx.lineWidth = 4;
      for (let i = 0; i < 3; i++) {
        const cy = y + 12 + i * 11;
        ctx.beginPath();
        ctx.moveTo(r.x - 12, cy + 5);
        ctx.lineTo(r.x, cy - 3);
        ctx.lineTo(r.x + 12, cy + 5);
        ctx.stroke();
      }
    }

    function drawBike(x, y, angle, flame, lift, flip) {
      // the shadow stays on the ground while the bike flies
      ctx.fillStyle = 'rgba(0, 0, 0, ' + (0.25 - lift * 0.12) + ')';
      ctx.fillRect(x - 7 + lift * 12, y - 22 + lift * 14, 18, 52);
      ctx.save();
      ctx.translate(x, y - lift * 34);
      ctx.scale(1 + lift * 0.45, 1 + lift * 0.45);
      ctx.rotate(angle);
      if (flip > 0) {
        // a backflip turns the bike end over end, seen from above as a squash and stretch
        const p = 1 - flip;
        if (flip < 1 && trickKind % 2 === 0) ctx.scale(1, Math.cos(p * Math.PI * 2 * (1 + (trickKind >= 2 ? 1 : 0))));
        else ctx.rotate(p * Math.PI * 2 * (trickKind >= 2 ? 2 : 1));
      }
      if (flame) {
        const f = (turbo ? 20 : 10) + Math.random() * 12;
        ctx.fillStyle = '#ffd400';
        ctx.beginPath();
        ctx.moveTo(-5, 28);
        ctx.lineTo(0, 28 + f + 6);
        ctx.lineTo(5, 28);
        ctx.fill();
        ctx.fillStyle = '#ff6b4a';
        ctx.beginPath();
        ctx.moveTo(-3, 28);
        ctx.lineTo(0, 28 + f);
        ctx.lineTo(3, 28);
        ctx.fill();
      }
      // wheels
      ctx.fillStyle = '#1b1b1b';
      roundedBox(-4, -28, 8, 18, 4);
      ctx.fill();
      roundedBox(-4, 12, 8, 18, 4);
      ctx.fill();
      // body and tank
      ctx.fillStyle = '#d62828';
      roundedBox(-6, -14, 12, 34, 6);
      ctx.fill();
      ctx.strokeStyle = '#8c1a1a';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.fillStyle = '#f4a261';
      roundedBox(-4, -10, 8, 10, 3);
      ctx.fill();
      // handlebars
      ctx.strokeStyle = '#2b2b2b';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(-12, -12);
      ctx.lineTo(12, -12);
      ctx.stroke();
      // rider: arms, body and helmet
      ctx.strokeStyle = '#2a4d8f';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(-6, 2);
      ctx.lineTo(-11, -11);
      ctx.moveTo(6, 2);
      ctx.lineTo(11, -11);
      ctx.stroke();
      ctx.fillStyle = '#2a4d8f';
      roundedBox(-7, -2, 14, 16, 6);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(0, -2, 7, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd400';
      ctx.fill();
      ctx.strokeStyle = '#8a6d00';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.fillStyle = 'rgba(30, 40, 60, 0.85)';
      ctx.fillRect(-5, -7, 10, 3);
      ctx.restore();
    }

    function drawPalm(x, y) {
      ctx.strokeStyle = '#2f8a46';
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      for (let i = 0; i < 7; i++) {
        const a = (i / 7) * Math.PI * 2 + 0.3;
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x + Math.cos(a) * 13, y + Math.sin(a) * 13);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(x, y, 3, 0, Math.PI * 2);
      ctx.fillStyle = '#7a5a3a';
      ctx.fill();
    }

    function drawCoin(x, y, r) {
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd400';
      ctx.fill();
      ctx.strokeStyle = '#b8860b';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(x, y, r - 4, 0, Math.PI * 2);
      ctx.strokeStyle = '#fff3b0';
      ctx.stroke();
    }

    function drawShieldPickup(x, y, r) {
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = '#29c5f6';
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x, y - 8);
      ctx.lineTo(x + 7, y - 5);
      ctx.lineTo(x + 6, y + 2);
      ctx.quadraticCurveTo(x + 5, y + 8, x, y + 10);
      ctx.quadraticCurveTo(x - 5, y + 8, x - 6, y + 2);
      ctx.lineTo(x - 7, y - 5);
      ctx.closePath();
      ctx.fillStyle = '#ffffff';
      ctx.fill();
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      const css = getComputedStyle(document.documentElement);
      const sand = css.getPropertyValue('--sand').trim() || '#e8c98a';
      const road = css.getPropertyValue('--road').trim() || '#4a4d52';

      // desert either side of the highway
      ctx.fillStyle = sand;
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.06)';
      laneLines.forEach((line, i) => {
        ctx.beginPath();
        ctx.ellipse(20 + ((i * 37) % 24), line.y + 30, 18, 5, 0, 0, Math.PI * 2);
        ctx.ellipse(W - 20 - ((i * 29) % 24), line.y + 60, 18, 5, 0, 0, Math.PI * 2);
        ctx.fill();
      });
      scenery.forEach((s) => {
        const x = s.side === 0 ? roadLeft - 22 - s.off : roadRight + 22 + s.off;
        if (s.kind === 'palm') {
          drawPalm(x, s.y);
        } else if (s.kind === 'bush') {
          ctx.fillStyle = '#6f8f4a';
          ctx.beginPath();
          ctx.arc(x, s.y, 9, 0, Math.PI * 2);
          ctx.arc(x + 8, s.y + 3, 7, 0, Math.PI * 2);
          ctx.arc(x - 7, s.y + 4, 6, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.fillStyle = '#a08a63';
          ctx.beginPath();
          ctx.ellipse(x, s.y, 10, 7, 0.4, 0, Math.PI * 2);
          ctx.fill();
        }
      });

      // the dirt trail, with tyre tracks and little stones
      ctx.fillStyle = road;
      ctx.fillRect(roadLeft, 0, roadRight - roadLeft, H);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.14)';
      [W / 2 - 46, W / 2 - 38, W / 2 + 38, W / 2 + 46].forEach((tx) => ctx.fillRect(tx - 2, 0, 4, H));
      ctx.fillStyle = 'rgba(0, 0, 0, 0.12)';
      laneLines.forEach((line, i) => {
        ctx.beginPath();
        ctx.arc(roadLeft + 20 + ((i * 53) % 190), line.y + 20 + (i % 3) * 22, 3, 0, Math.PI * 2);
        ctx.arc(roadLeft + 40 + ((i * 71) % 150), line.y + 55, 2.5, 0, Math.PI * 2);
        ctx.fill();
      });
      // the edges of the trail: stones and dry tufts instead of barriers
      ctx.fillStyle = 'rgba(80, 50, 20, 0.35)';
      ctx.fillRect(roadLeft - 4, 0, 4, H);
      ctx.fillRect(roadRight, 0, 4, H);
      laneLines.forEach((line, i) => {
        ctx.fillStyle = '#8d8f94';
        ctx.beginPath();
        ctx.ellipse(roadLeft - 8, line.y + 10 + (i % 3) * 20, 6, 4, 0, 0, Math.PI * 2);
        ctx.ellipse(roadRight + 8, line.y + 40 - (i % 3) * 12, 6, 4, 0, 0, Math.PI * 2);
        ctx.fill();
      });

      coins.forEach((coin) => drawCoin(coin.x, coin.y, coin.r));
      shields.forEach((sh) => drawShieldPickup(sh.x, sh.y, sh.r));
      ramps.forEach(drawRamp);
      traffic.forEach(drawObstacle);

      dust.forEach((d) => {
        const p = d.age / 30;
        ctx.beginPath();
        ctx.arc(d.x, d.y, 5 + p * 14, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(200, 170, 110, ${0.7 * (1 - p)})`;
        ctx.fill();
      });

      // the bike is always visible, even on the start screen
      if (crashing) drawBike(bike.x, bike.y, crashAngle, false, 0, 0);
      else {
        const lift = air > 0 ? Math.sin(Math.PI * (1 - air / airTotal)) : 0;
        drawBike(bike.x, bike.y, lean + (air > 0 && trickT <= 0 ? Math.sin(frameCount / 5) * 0.12 : 0), started && !gameOver && fastNow(), lift, trickT > 0 ? trickT / trickDur : 0);
        if (started && !gameOver && air > 0 && trickT <= 0 && tricksDone === 0 && air > trickDur) {
          ctx.fillStyle = 'rgba(31, 191, 106, 0.95)';
          ctx.font = 'bold 20px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Press TRICK!', W / 2, 100);
        }
      }

      if (shieldOn && !crashing && !gameOver) {
        ctx.beginPath();
        ctx.arc(bike.x, bike.y, 38 + Math.sin(frameCount / 8) * 2, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(41, 197, 246, 0.95)';
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.fillStyle = 'rgba(41, 197, 246, 0.95)';
        ctx.font = 'bold 14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('SHIELD READY', W / 2, 52);
      }
      if (shieldFlash > 0 && !gameOver) {
        const p = 1 - shieldFlash / 60;
        ctx.beginPath();
        ctx.arc(bike.x, bike.y, 38 + p * 50, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(41, 197, 246, ${shieldFlash / 60})`;
        ctx.lineWidth = 4;
        ctx.stroke();
        ctx.fillStyle = `rgba(41, 197, 246, ${Math.min(1, shieldFlash / 20)})`;
        ctx.font = 'bold 22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Shield saved you!', W / 2, 112);
      }

      if (started && !gameOver) {
        if (turbo && boostEnergy > 0) {
          ctx.fillStyle = 'rgba(190, 110, 255, 0.98)';
          ctx.font = 'bold 22px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('\u26A1 VERY FAST! \u26A1', W / 2, 30);
        } else if (boosting && boostEnergy > 0) {
          ctx.fillStyle = 'rgba(255, 180, 0, 0.95)';
          ctx.font = 'bold 20px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('BOOST!', W / 2, 30);
        }
        if (easy) {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
          ctx.font = 'bold 13px sans-serif';
          ctx.textAlign = 'right';
          ctx.fillText('\u{1F422} Easy mode', W - 12, H - 22);
        }
        popups.forEach((p) => {
          ctx.fillStyle = 'rgba(255, 255, 255, ' + (1 - p.age / 60) + ')';
          ctx.strokeStyle = 'rgba(0, 0, 0, ' + 0.6 * (1 - p.age / 60) + ')';
          ctx.lineWidth = 3;
          ctx.font = 'bold 18px sans-serif';
          ctx.textAlign = 'center';
          ctx.strokeText(p.text, p.x, p.y - p.age * 0.6);
          ctx.fillText(p.text, p.x, p.y - p.age * 0.6);
        });
        // speedometer
        const kmh = Math.round(worldSpeed() * 10);
        roundedBox(10, H - 44, 96, 32, 10);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 18px sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(kmh + ' km/h', 20, H - 22);
      }

      if (levelFlash > 0 && started && !gameOver) {
        ctx.fillStyle = `rgba(255, 196, 0, ${Math.min(1, levelFlash / 20)})`;
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Level ' + level + '!', W / 2, 70);
      }

      if (!started) {
        drawOverlay('Tap to start', 'Dodge the rocks. Hit the ramps!');
      } else if (gameOver) {
        drawOverlay('Wipe out!', 'Tap to try again • Score: ' + score);
      }
    }

    function drawOverlay(title, subtitle) {
      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      ctx.font = 'bold 30px sans-serif';
      ctx.fillText(title, W / 2, H / 2 - 16);
      ctx.font = '18px sans-serif';
      ctx.fillText(subtitle, W / 2, H / 2 + 20);
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function boot(data) {
      if (data && typeof data.best === 'number' && data.best > best) {
        best = data.best;
        bestEl.textContent = 'Best: ' + best;
      }
      draw();
      loop();
    }

    if (window.claude && window.claude.hot && window.claude.hot.snapshot) {
      window.claude.hot.snapshot(() => ({ best }));
    }

    if (window.claude && window.claude.hot && window.claude.hot.ready) {
      window.claude.hot.ready(boot);
    } else {
      boot(window.claude && window.claude.hot ? window.claude.hot.data : null);
    }
  })();
</script>
  </body>
</html>
