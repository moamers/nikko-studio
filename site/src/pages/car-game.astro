    // the food court: stalls along the back, tables and chairs in front
    function drawFoodCourt() {
      const sh = mallShopsData[mallShop];
      ctx.fillStyle = sh.wall;
      ctx.fillRect(0, 0, W, 360);
      ctx.fillStyle = sh.floor;
      ctx.fillRect(0, 360, W, H - 360);
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.1)';
      ctx.lineWidth = 1.5;
      for (let y = 370; y < H; y += 28) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(W, y);
        ctx.stroke();
      }
      for (let x = 20; x < W; x += 56) {
        ctx.beginPath();
        ctx.moveTo(x, 360);
        ctx.lineTo(200 + (x - 200) * 1.8, H);
        ctx.stroke();
      }
      // lamps hanging down
      for (let x = 60; x < W; x += 90) {
        ctx.strokeStyle = '#6b5a48';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, 44);
        ctx.stroke();
        ctx.fillStyle = '#ffd166';
        ctx.beginPath();
        ctx.arc(x, 50, 10, Math.PI, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(255, 240, 180, 0.15)';
        ctx.beginPath();
        ctx.moveTo(x - 10, 50);
        ctx.lineTo(x + 10, 50);
        ctx.lineTo(x + 34, 330);
        ctx.lineTo(x - 34, 330);
        ctx.fill();
      }
      ctx.fillStyle = sh.colour;
      roundedRect(100, 66, 200, 34, 8);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 18px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(eidParty ? '\u{1F389} EID BREAKFAST PARTY' : '\u{1F37D}️ FOOD COURT • مطاعم', 200, 89);
      if (eidParty) {
        // flags, balloons and confetti for the Eid party
        const fcols = ['#e63946', '#ffd166', '#2a9d8f', '#4a90d9', '#f15bb5', '#52b788'];
        ctx.strokeStyle = '#7b5a3a';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(0, 108);
        ctx.quadraticCurveTo(200, 138, 400, 108);
        ctx.stroke();
        for (let k = 0; k < 16; k++) {
          const u = (k + 0.5) / 16;
          const fx = u * 400;
          const fy = (1 - u) * (1 - u) * 108 + 2 * (1 - u) * u * 123 + u * u * 108;
          ctx.fillStyle = fcols[k % 6];
          ctx.beginPath();
          ctx.moveTo(fx - 8, fy);
          ctx.lineTo(fx + 8, fy);
          ctx.lineTo(fx, fy + 16);
          ctx.fill();
        }
        ctx.font = '26px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#000000';
        [[24, 190], [376, 190], [46, 230], [354, 232]].forEach(([bx, by], k) => ctx.fillText(k % 2 ? '\u{1F388}' : '\u{1F38A}', bx, by + Math.sin(mallTime / 20 + k) * 5));
        ctx.font = '22px sans-serif';
        ctx.fillText('\u{1F3EE}', 70, 120 + Math.sin(mallTime / 25) * 3);
