        drawShopper(px, py, ['#f2c9a0', '#d71920', '#26344a'], 0.7, 1, false, 0, mallBag.length > 0 && !mallTrolley);
      }
      // hints
      const nd = nearMallDoor();
      if (nd >= 0 && !mallRide) {
        ctx.fillStyle = 'rgba(10, 18, 28, 0.82)';
        roundedRect(mallDoorX(nd) - 66, 262, 132, 26, 13);
