<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Car Game</title>
  </head>
  <body>
    <h1>🏎️ Car Game</h1>
    <p>Drag your finger (or mouse) left and right to steer! Grab the gold coins and the blue shield.</p>
    <canvas id="game" width="400" height="600"></canvas>
    <p id="score">Score: 0</p>
    <p id="level">Level: 1</p>

    <div class="boost-row">
      <button id="boostBtn">🚀 BOOST</button>
      <div class="boost-bar">
        <div id="boostFill" class="boost-fill"></div>
      </div>
    </div>

    <style>
      body {
        font-family: sans-serif;
        text-align: center;
        background: #f6fdff;
      }
      canvas {
        background: #555555;
        border: 4px solid #333;
        border-radius: 8px;
        touch-action: none;
      }
      #score {
        font-size: 24px;
        font-weight: bold;
      }
      #level {
        font-size: 16px;
        color: #4a6572;
        margin-top: -8px;
      }
      .boost-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 12px;
      }
      #boostBtn {
        font-size: 16px;
        font-weight: bold;
        padding: 10px 18px;
        border: 3px solid #8c1a1a;
        border-radius: 999px;
        background: #ff6b4a;
        color: white;
        cursor: pointer;
        touch-action: none;
        user-select: none;
      }
      #boostBtn:active {
        background: #e63946;
      }
      .boost-bar {
        width: 110px;
        height: 14px;
        background: #ddd;
        border: 2px solid #333;
        border-radius: 999px;
        overflow: hidden;
      }
      .boost-fill {
        height: 100%;
        width: 100%;
        background: #ffd400;
        transition: width 80ms linear;
      }
    </style>

    <script>
      const canvas = document.getElementById('game');
      const ctx = canvas.getContext('2d');
      const scoreEl = document.getElementById('score');
      const levelEl = document.getElementById('level');
      const boostBtn = document.getElementById('boostBtn');
      const boostFill = document.getElementById('boostFill');
      const pointsPerLevel = 5;

      const roadLeft = 60;
      const roadRight = canvas.width - 60;

      const carStartY = canvas.height - 130;
      const car = { x: canvas.width / 2, y: carStartY, w: 36, h: 60 };
      const carColor = '#d62828'; // red
      const carOutline = '#8c1a1a';

      // A synthesized police siren — no audio file needed. Created lazily on
      // the first tap/click/key so the browser's autoplay rules allow it.
      let audioCtx = null;
      let sirenOsc = null;
      let sirenGain = null;

      function ensureAudio() {
        // Never let anything here throw — a sound failure must not be able
        // to block the game from starting.
        try {
          if (audioCtx) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            return;
          }
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          sirenOsc = audioCtx.createOscillator();
          sirenGain = audioCtx.createGain();
          sirenOsc.type = 'sine';
          sirenGain.gain.value = 0;
          sirenOsc.connect(sirenGain).connect(audioCtx.destination);
          sirenOsc.start();
        } catch (e) {}
      }

      function policeWarning() {
        return !police && !gameOver && !crashing && slowTimer > slowThreshold - policeWarnFrames;
      }

      function updateSiren() {
        if (!audioCtx) return;
        const wailing = !gameOver && (!!police || policeWarning());
        const targetVol = wailing ? 0.05 : 0;
        sirenGain.gain.linearRampToValueAtTime(targetVol, audioCtx.currentTime + 0.15);
        if (wailing) {
          sirenOsc.frequency.setValueAtTime(650 + Math.sin(frameCount / 15) * 150, audioCtx.currentTime);
        }
      }

      let targetX = car.x;
      let keys = { left: false, right: false };
      const moveSpeed = 15; // how fast arrow keys move the car
      const followSpeed = 0.5; // how smoothly the car chases the pointer

      let traffic = []; // the other cars coming down the road
      let coins = []; // gold coins you can collect for bonus points
      let laneLines = [];
      let score = 0;
      let level = 1;
      let levelFlash = 0; // frames left to show the "Level up!" banner
      let gameOver = false;

      // Boost: hold the button (or Shift) to speed everything up for a
      // moment. Draining/refilling an energy bar keeps it a choice, not a
      // free always-on speed.
      let boosting = false;
      let boostEnergy = 100;
      const boostDrain = 1.3;
      const boostRegen = 0.5;
      const boostMultiplier = 2.8;

      let coinSpawnIn = 90;

      // Shield power-up: grab the blue shield to survive one crash or arrest.
      let shields = [];
      let shieldOn = false;
      let shieldSpawnIn = 450;
      let shieldFlash = 0; // frames left of the "Shield saved you!" pop
      let invuln = 0; // brief protection right after the shield pops

      // A police car waits behind you. Coast too long without boosting and
      // it starts closing in; boost to pull away and lose it.
      let police = null;
      let slowTimer = 0;
      let busted = false;
      const slowThreshold = 300; // ~5s of not boosting before it appears
      const policeApproach = 1.0; // how fast it creeps up while you coast (slow, so you see it coming)
      const policeWarnFrames = 150; // ~2.5s of flashing warning before it appears
      const policeRetreat = 6.5; // how fast it falls back while you boost

      // Crash: the car spins out and swings off the nearest edge of the
      // bridge into the sea, with a splash where it goes in.
      let crashing = false;
      let crashTimer = 0;
      const crashDuration = 50;
      let crashAngle = 0;
      let crashSpin = 1;
      let crashStartX = 0;
      let crashStartY = 0;
      let crashTargetX = 0;
      let crashTargetY = 0;
      let splashed = false;
      let splashes = []; // expanding ripple rings where the car hit the water
      let frameCount = 0;
      let lastTime = null; // so game speed does not depend on the screen refresh rate

      function startCrash() {
        if (crashing || gameOver) return;
        crashing = true;
        crashTimer = crashDuration;
        crashAngle = 0;
        splashed = false;

        const roadMid = (roadLeft + roadRight) / 2;
        const direction = car.x < roadMid ? -1 : 1;
        crashSpin = direction;
        crashStartX = car.x;
        crashStartY = car.y;
        crashTargetX = direction < 0 ? roadLeft - 34 : roadRight + 34; // whole car fits in the water strip
        crashTargetY = car.y + 50;
      }

      function easeOut(t) {
        return t * t * (3 - 2 * t); // smoothstep
      }

      function levelFor(s) {
        return Math.floor(s / pointsPerLevel) + 1;
      }

      function spawnTraffic() {
        const w = 36;
        const h = 56;
        const x = roadLeft + 20 + Math.random() * (roadRight - roadLeft - 40 - w) + w / 2;
        const colors = ['#6a4c93', '#ffb703', '#2a9d8f', '#f4a261'];
        const color = colors[Math.floor(Math.random() * colors.length)];
        traffic.push({ x, y: -60, w, h, color, passed: false });
      }

      function spawnShield() {
        const x = roadLeft + 24 + Math.random() * (roadRight - roadLeft - 48);
        shields.push({ x, y: -30, r: 15 });
      }

      function spawnCoin() {
        const x = roadLeft + 24 + Math.random() * (roadRight - roadLeft - 48);
        coins.push({ x, y: -30, r: 12 });
      }

      function baseSpeed() {
        // Starts slow at level 1, a clear step up with each level.
        return Math.min(17, 5 + (level - 1) * 1.8);
      }

      function worldSpeed() {
        return boosting && boostEnergy > 0 ? baseSpeed() * boostMultiplier : baseSpeed();
      }

      function spawnGap() {
        // The road gets busier each level — new cars arrive sooner.
        return Math.max(95, 210 - (level - 1) * 17);
      }

      function spawnLaneLines() {
        laneLines = [];
        for (let i = 0; i < 8; i++) {
          laneLines.push({ y: i * 80 });
        }
      }

      function resetGame() {
        car.x = canvas.width / 2;
        car.y = carStartY; // the crash swing moves the car, so put it back
        targetX = car.x;
        traffic = [];
        coins = [];
        score = 0;
        level = 1;
        levelFlash = 0;
        gameOver = false;
        boosting = false;
        boostEnergy = 100;
        coinSpawnIn = 90;
        police = null;
        slowTimer = 0;
        busted = false;
        crashing = false;
        crashTimer = 0;
        crashAngle = 0;
        splashed = false;
        splashes = [];
        shields = [];
        shieldOn = false;
        shieldSpawnIn = 450 + Math.random() * 300;
        shieldFlash = 0;
        invuln = 0;
        if (audioCtx) sirenGain.gain.setValueAtTime(0, audioCtx.currentTime);
        spawnTraffic();
        spawnLaneLines();
        levelEl.textContent = 'Level: 1';
      }

      function pointerToX(clientX) {
        const rect = canvas.getBoundingClientRect();
        return ((clientX - rect.left) / rect.width) * canvas.width;
      }

      canvas.addEventListener('mousedown', (e) => {
        ensureAudio();
        if (gameOver) resetGame();
        targetX = pointerToX(e.clientX);
      });
      canvas.addEventListener('mousemove', (e) => {
        targetX = pointerToX(e.clientX);
      });
      canvas.addEventListener(
        'touchstart',
        (e) => {
          ensureAudio();
          if (gameOver) resetGame();
          targetX = pointerToX(e.touches[0].clientX);
        },
        { passive: true }
      );
      canvas.addEventListener(
        'touchmove',
        (e) => {
          targetX = pointerToX(e.touches[0].clientX);
        },
        { passive: true }
      );

      function startBoost(e) {
        e.preventDefault();
        ensureAudio();
        boosting = true;
      }
      function stopBoost() {
        boosting = false;
      }
      boostBtn.addEventListener('mousedown', startBoost);
      boostBtn.addEventListener('touchstart', startBoost, { passive: false });
      boostBtn.addEventListener('mouseup', stopBoost);
      boostBtn.addEventListener('mouseleave', stopBoost);
      boostBtn.addEventListener('touchend', stopBoost);
      boostBtn.addEventListener('touchcancel', stopBoost);

      window.addEventListener('keydown', (e) => {
        if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
        if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
        if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = true;
        if (e.code === 'Space' && gameOver) resetGame();
      });
      window.addEventListener('keyup', (e) => {
        if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
        if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
        if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = false;
      });

      function update() {
        const now = performance.now();
        let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
        lastTime = now;
        step = Math.min(Math.max(step, 0.2), 3); // same game speed on 60Hz and 120Hz screens
        frameCount += step;

        if (crashing) {
          crashTimer -= step;
          const t = easeOut(Math.min(1, Math.max(0, 1 - crashTimer / crashDuration)));
          car.x = crashStartX + (crashTargetX - crashStartX) * t;
          car.y = crashStartY + (crashTargetY - crashStartY) * t;
          crashAngle = crashSpin * Math.PI * 4 * t; // two full spins, finishing upright

          if (!splashed && (car.x < roadLeft || car.x > roadRight)) {
            splashed = true;
            splashes.push({ x: car.x, y: car.y, age: 0 });
          }

          splashes.forEach((s) => (s.age += step));
          splashes = splashes.filter((s) => s.age < 26);

          if (crashTimer <= 0) {
            crashing = false;
            gameOver = true;
            if (audioCtx) sirenGain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 0.2);
          }
          return; // freeze traffic, coins and the police car while spinning out
        }

        if (gameOver) {
          boosting = false;
          return;
        }

        if (keys.left) targetX -= moveSpeed * step;
        if (keys.right) targetX += moveSpeed * step;
        targetX = Math.max(roadLeft + car.w / 2, Math.min(roadRight - car.w / 2, targetX));

        car.x += (targetX - car.x) * (1 - Math.pow(1 - followSpeed, step));

        if (boosting && boostEnergy > 0) {
          boostEnergy = Math.max(0, boostEnergy - boostDrain * step);
        } else {
          boosting = false;
          boostEnergy = Math.min(100, boostEnergy + boostRegen * step);
        }
        boostFill.style.width = boostEnergy + '%';

        const speed = worldSpeed();
        const dist = speed * step;

        laneLines.forEach((line) => {
          line.y += dist;
          if (line.y > ctx.canvas.height) line.y -= 8 * 80;
        });

        traffic.forEach((other) => {
          other.y += dist;

          if (
            Math.abs(car.x - other.x) < (car.w + other.w) / 2 - 6 &&
            Math.abs(car.y - other.y) < (car.h + other.h) / 2 - 6
          ) {
            if (invuln > 0) {
              // still protected for a moment after the shield popped
            } else if (shieldOn) {
              shieldOn = false;
              invuln = 45;
              shieldFlash = 60;
              other.passed = true;
              other.y = ctx.canvas.height + 200; // the car you bumped is swept aside
            } else {
              startCrash();
            }
          }

          if (!other.passed && other.y > car.y + car.h) {
            other.passed = true;
            score++;

            const newLevel = levelFor(score);
            if (newLevel > level) {
              level = newLevel;
              levelEl.textContent = 'Level: ' + level;
              levelFlash = 90; // ~1.5s
            }
          }
        });

        traffic = traffic.filter((other) => other.y < ctx.canvas.height + 80);

        if (traffic.length === 0 || traffic[traffic.length - 1].y > spawnGap()) {
          spawnTraffic();
        }

        coins.forEach((coin) => {
          coin.y += dist;

          const dx = car.x - coin.x;
          const dy = car.y - coin.y;
          if (Math.sqrt(dx * dx + dy * dy) < coin.r + Math.min(car.w, car.h) / 2) {
            coin.collected = true;
            score += 3;
          }
        });
        coins = coins.filter((coin) => !coin.collected && coin.y < ctx.canvas.height + 40);

        coinSpawnIn -= step;
        if (coinSpawnIn <= 0) {
          spawnCoin();
          coinSpawnIn = 110 + Math.random() * 90;
        }

        shields.forEach((sh) => {
          sh.y += dist;
          const dx = car.x - sh.x;
          const dy = car.y - sh.y;
          if (Math.sqrt(dx * dx + dy * dy) < sh.r + Math.min(car.w, car.h) / 2) {
            sh.collected = true;
            shieldOn = true;
          }
        });
        shields = shields.filter((sh) => !sh.collected && sh.y < ctx.canvas.height + 40);

        if (!shieldOn && shields.length === 0) {
          shieldSpawnIn -= step;
          if (shieldSpawnIn <= 0) {
            spawnShield();
            shieldSpawnIn = 500 + Math.random() * 400;
          }
        }

        // The police car. Coasting too long (not boosting) first triggers a
        // flashing warning, then the police appears in the OTHER lane, well back
        // and off-screen, and creeps up. It has to line up with you to bust you.
        if (boosting) {
          slowTimer = 0;
        } else {
          slowTimer += step;
        }

        if (!police && slowTimer >= slowThreshold) {
          const laneX = car.x < (roadLeft + roadRight) / 2 ? roadRight - 55 : roadLeft + 55;
          police = { x: laneX, y: ctx.canvas.height + 60 };
        }

        if (police) {
          police.y += (boosting ? policeRetreat : -policeApproach) * step;
          // stays in its own lane until it is on screen, then drifts toward yours
    if (police.y < ctx.canvas.height) police.x += (car.x - police.x) * (1 - Math.pow(1 - 0.015, step));

          const caught = police.y - car.y < 14;
          if (caught && Math.abs(police.x - car.x) < 34) {
            if (shieldOn) {
              shieldOn = false;
              invuln = 45;
              shieldFlash = 60;
              police = null;
              slowTimer = 0;
            } else {
              busted = true;
              startCrash();
            }
          } else if (caught) {
            police.y = car.y + 14; // right beside you, sliding into your lane
          } else if (police.y > ctx.canvas.height + 140) {
            police = null;
            slowTimer = 0;
          }
        }

        levelFlash = Math.max(0, levelFlash - step);
        shieldFlash = Math.max(0, shieldFlash - step);
        invuln = Math.max(0, invuln - step);

        updateSiren();

        scoreEl.textContent = 'Score: ' + score;
      }

      function drawCar(x, y, w, h, color, outline) {
        const r = 8;
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.moveTo(x - w / 2 + r, y - h / 2);
        ctx.arcTo(x + w / 2, y - h / 2, x + w / 2, y - h / 2 + r, r);
        ctx.lineTo(x + w / 2, y + h / 2 - r);
        ctx.arcTo(x + w / 2, y + h / 2, x + w / 2 - r, y + h / 2, r);
        ctx.lineTo(x - w / 2 + r, y + h / 2);
        ctx.arcTo(x - w / 2, y + h / 2, x - w / 2, y + h / 2 - r, r);
        ctx.lineTo(x - w / 2, y - h / 2 + r);
        ctx.arcTo(x - w / 2, y - h / 2, x - w / 2 + r, y - h / 2, r);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = outline;
        ctx.lineWidth = 2;
        ctx.stroke();

        // A little windshield so cars read as cars, not just boxes.
        ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
        ctx.fillRect(x - w / 2 + 6, y - h / 2 + 10, w - 12, h / 3);
      }

      function drawPoliceCar(x, y, w, h) {
        drawCar(x, y, w, h, '#f2ecdf', '#222');

        // Black door stripe.
        ctx.fillStyle = '#222';
        ctx.fillRect(x - w / 2, y - 6, w, 10);

        // Flashing red/blue light bar on the roof.
        const litRed = Math.floor(frameCount / 8) % 2 === 0;
        ctx.fillStyle = litRed ? '#ff3b30' : '#2b45f0';
        ctx.fillRect(x - 10, y - h / 2 - 8, 20, 7);
      }

      function drawPoliceGlow() {
        const cw = ctx.canvas.width;
        const ch = ctx.canvas.height;
        const red = Math.floor(frameCount / 8) % 2 === 0;
        const g = ctx.createLinearGradient(0, ch, 0, ch - 90);
        g.addColorStop(0, red ? 'rgba(255, 59, 48, 0.75)' : 'rgba(43, 69, 240, 0.75)');
        g.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = g;
        ctx.fillRect(0, ch - 90, cw, 90);
      }

      function drawShieldPickup(x, y, r) {
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = '#29c5f6';
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(x, y - 8);
        ctx.lineTo(x + 7, y - 5);
        ctx.lineTo(x + 6, y + 2);
        ctx.quadraticCurveTo(x + 5, y + 8, x, y + 10);
        ctx.quadraticCurveTo(x - 5, y + 8, x - 6, y + 2);
        ctx.lineTo(x - 7, y - 5);
        ctx.closePath();
        ctx.fillStyle = '#ffffff';
        ctx.fill();
      }

      function drawShieldEffects() {
        const cw = ctx.canvas.width;
        if (shieldOn && !crashing && !gameOver) {
          const pulse = 40 + Math.sin(frameCount / 8) * 2;
          ctx.beginPath();
          ctx.arc(car.x, car.y, pulse, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(41, 197, 246, 0.95)';
          ctx.lineWidth = 3;
          ctx.stroke();
          ctx.fillStyle = 'rgba(41, 197, 246, 0.95)';
          ctx.font = 'bold 14px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('SHIELD READY', cw / 2, 52);
        }
        if (shieldFlash > 0 && !gameOver) {
          const p = 1 - shieldFlash / 60;
          ctx.beginPath();
          ctx.arc(car.x, car.y, 40 + p * 50, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(41, 197, 246, ${shieldFlash / 60})`;
          ctx.lineWidth = 4;
          ctx.stroke();
          ctx.fillStyle = `rgba(41, 197, 246, ${Math.min(1, shieldFlash / 20)})`;
          ctx.font = 'bold 22px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Shield saved you!', cw / 2, 112);
        }
      }

      function drawCoin(x, y, r) {
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = '#ffd400';
        ctx.fill();
        ctx.strokeStyle = '#b8860b';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(x, y, r - 4, 0, Math.PI * 2);
        ctx.strokeStyle = '#fff3b0';
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // The sea either side of the bridge.
        ctx.fillStyle = '#1f6f9c';
        ctx.fillRect(0, 0, roadLeft, canvas.height);
        ctx.fillRect(roadRight, 0, canvas.width - roadRight, canvas.height);

        // Wave caps drifting with the road, with their own gentle side-to-
        // side shimmer so the sea keeps moving even when the road doesn't.
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
        ctx.lineWidth = 2;
        laneLines.forEach((line, i) => {
          [0, 40].forEach((yStep, j) => {
            const y = line.y + yStep;
            const bob = Math.sin(frameCount / 18 + i * 1.7 + j) * 5;
            [20, 46, 72].forEach((xOffset, k) => {
              const r = 8 + ((i + k) % 2) * 3;
              ctx.beginPath();
              ctx.arc(xOffset + bob, y + 14, r, Math.PI * 0.15, Math.PI * 0.85);
              ctx.stroke();
              ctx.beginPath();
              ctx.arc(canvas.width - xOffset - bob, y + 44, r, Math.PI * 0.15, Math.PI * 0.85);
              ctx.stroke();
            });
          });
        });

        // The bridge deck.
        ctx.fillStyle = '#555555';
        ctx.fillRect(roadLeft, 0, roadRight - roadLeft, canvas.height);

        // Scrolling centre line.
        ctx.strokeStyle = '#f2ecdf';
        ctx.lineWidth = 4;
        ctx.setLineDash([24, 24]);
        laneLines.forEach((line) => {
          ctx.beginPath();
          ctx.moveTo(canvas.width / 2, line.y);
          ctx.lineTo(canvas.width / 2, line.y + 24);
          ctx.stroke();
        });
        ctx.setLineDash([]);

        // Bridge guardrails: a concrete curb with posts along each edge.
        ctx.fillStyle = '#c9c2b2';
        ctx.fillRect(roadLeft - 10, 0, 10, canvas.height);
        ctx.fillRect(roadRight, 0, 10, canvas.height);
        ctx.fillStyle = '#8c8577';
        laneLines.forEach((line) => {
          ctx.fillRect(roadLeft - 10, line.y, 10, 14);
          ctx.fillRect(roadRight, line.y, 10, 14);
        });

        coins.forEach((coin) => drawCoin(coin.x, coin.y, coin.r));

      shields.forEach((sh) => drawShieldPickup(sh.x, sh.y, sh.r));
      if ((police || policeWarning()) && !gameOver) drawPoliceGlow();

        traffic.forEach((other) => drawCar(other.x, other.y, other.w, other.h, other.color, '#333'));

        if (police) {
          drawPoliceCar(police.x, police.y, car.w, car.h);
        }

        if (crashing) {
          ctx.save();
          ctx.translate(car.x, car.y);
          ctx.rotate(crashAngle);
          drawCar(0, 0, car.w, car.h, carColor, carOutline);
          ctx.restore();

          splashes.forEach((s) => {
            const p = s.age / 26;
            ctx.beginPath();
            ctx.arc(s.x, s.y, 6 + p * 34, 0, Math.PI * 2);
            ctx.strokeStyle = `rgba(255, 255, 255, ${0.6 * (1 - p)})`;
            ctx.lineWidth = 3;
            ctx.stroke();
          });
        } else {
          drawCar(car.x, car.y, car.w, car.h, carColor, carOutline);
        }

        if (boosting && boostEnergy > 0) {
          ctx.fillStyle = 'rgba(255, 180, 0, 0.9)';
          ctx.font = 'bold 20px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('BOOST!', canvas.width / 2, 30);
        } else if (police && !crashing && !gameOver) {
          ctx.fillStyle = 'rgba(255, 59, 48, 0.9)';
          ctx.font = 'bold 18px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('🚨 Boost to lose the police!', canvas.width / 2, 30);
        } else if (policeWarning()) {
          ctx.fillStyle = 'rgba(255, 59, 48, 0.95)';
          ctx.font = 'bold 18px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('🚨 Police coming! Hold BOOST!', ctx.canvas.width / 2, 30);
        }

        drawShieldEffects();
        if (levelFlash > 0) {
          const alpha = Math.min(1, levelFlash / 20);
          ctx.fillStyle = `rgba(255, 196, 0, ${alpha})`;
          ctx.font = 'bold 40px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Level ' + level + '!', canvas.width / 2, 80);
        }

        if (gameOver) {
          ctx.fillStyle = 'rgba(0,0,0,0.5)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = 'white';
          ctx.font = '28px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(busted ? 'Busted!' : 'Game Over!', canvas.width / 2, canvas.height / 2 - 20);
          ctx.font = '18px sans-serif';
          ctx.fillText('Click or tap to try again', canvas.width / 2, canvas.height / 2 + 20);
        }
      }

      function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
      }

      resetGame();
      loop();
    </script>
  </body>
</html>
