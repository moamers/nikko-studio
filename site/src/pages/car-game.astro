lShopW = 220;\n    const mallShopX0 = 120;\n    const mallWorldW = mallShopX0 + mallShopsData.length * mallShopW + 120;\n    const mallFloorY = 400;\n    const mallLimit = 3600; // one minute inside\n    const mallGraceLength = 600; // 10 more seconds after the buzzer\n    const mallPerson = { x: 150, y: 505, moving: false, stepT: 0, dir: 1 };\n    let mallMode = false;\n    let mallName = '';\n    let mallTime = 0;\n    let mallGrace = 0;\n    let mallBuzzT = 0;\n    let mallWallet = 0;\n    let mallBag = [];\n    let mallList = []; // indexes into mallProducts\n    let mallDone = [];\n    let mallListBonus = false;\n    let mallMsg = '';\n    let mallMsgT = 0;\n    let mallLost = false;\n    let mallLostMedal = false;\n    let mallFlash = 0;\n    let mallCamX = 0;\n    let mallShop = -1; // the shop you are inside, or -1 on the shopping street\n    let mallShoppers = [];\n    let mallShopFolk = [];\n    let mallPlants = [];\n    let mallTime2 = 0;\n    let mallGoto = null; // a place (across the mall) you tapped to walk to\n    const mallBtn = document.getElementById('mallBtn');\n    const shopperLook = [\n      ['#f2c9a0', '#e63946', '#2a4d8f'], ['#c68c5c', '#2a9d8f', '#3a3a4a'], ['#8d5a3b', '#f4a261', '#264653'],\n      ['#f2c9a0', '#6a4c93', '#4a4a4a'], ['#e0ac84', '#ffd166', '#1d3557'], ['#6f4426', '#ffffff', '#7a5a3a'],\n      ['#f2c9a0', '#48bfe3', '#5a189a'], ['#c68c5c', '#ef476f', '#2b2d42'],\n    ];\n\n    function mallShopLeft(i) {\n      return mallShopX0 + i * mallShopW;\n    }\n    const mallDoorX = (i) => mallShopLeft(i) + mallShopW / 2;\n\n    function makeShoppers() {\n      mallShoppers = [];\n      for (let k = 0; k \u003c 14; k++) {\n        const look = shopperLook[k % shopperLook.length];\n        mallShoppers.push({\n          x: 160 + ((k * 197) % (mallWorldW - 320)),\n          y: 452 + ((k * 37) % 86),\n          dir: k % 2 ? 1 : -1,\n          v: k % 5 === 0 ? 0 : 0.35 + ((k * 13) % 7) * 0.1,\n          look,\n          bag: k % 3 !== 1,\