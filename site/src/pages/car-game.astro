<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Car Dodge Dubai</title>
  </head>
  <body>
<style is:global>
  :root {
    --bg: #fff8ec;
    --card: #ffffff;
    --ink: #2a2118;
    --ink-soft: #6b5a48;
    --road: #555a60;
    --sand: #e6d5ab;
    --accent: #c8741a;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #1c1612;
      --card: #2a2019;
      --ink: #f6ece4;
      --ink-soft: #c2ad9e;
      --road: #3a3d42;
      --sand: #6d6144;
      --accent: #ffb84d;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #1c1612;
    --card: #2a2019;
    --ink: #f6ece4;
    --ink-soft: #c2ad9e;
    --road: #3a3d42;
    --sand: #6d6144;
    --accent: #ffb84d;
    color-scheme: dark;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .wrap {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 24px;
  }

  h1 {
    font-size: clamp(22px, 6vw, 30px);
    margin: 0;
    text-align: center;
  }

  .skyline {
    width: 100%;
    max-width: 400px;
    height: auto;
    color: var(--ink-soft);
    margin-block: -4px;
  }

  .sub {
    color: var(--ink-soft);
    margin: 0;
    text-align: center;
    font-size: 14px;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    max-height: 70vh;
    background: var(--card);
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background: var(--sand);
    touch-action: none;
  }

  .score {
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .best {
    font-size: 13px;
    color: var(--ink-soft);
    margin: 0;
  }

  .level {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin: 0;
  }

  .boost-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  #boostBtn {
    font-size: 15px;
    font-weight: bold;
    padding: 9px 16px;
    border: 3px solid #8c1a1a;
    border-radius: 999px;
    background: #ff6b4a;
    color: white;
    cursor: pointer;
    touch-action: none;
    user-select: none;
  }

  #boostBtn:active {
    background: #e63946;
  }

  .boost-bar {
    width: 100px;
    height: 13px;
    background: #ddd;
    border: 2px solid #333;
    border-radius: 999px;
    overflow: hidden;
  }

  .boost-fill {
    height: 100%;
    width: 100%;
    background: #ffd400;
    transition: width 80ms linear;
  }

  /* the big button for getting out of the car, back in, or out of the mall */
  #actBtn {
    width: 100%;
    font-size: 24px;
    font-weight: 800;
    padding: 18px 20px;
    border: 3px solid #0b6b3a;
    border-radius: 999px;
    background: #1fbf6a;
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(31, 191, 106, 0.45);
    animation: actPulse 1.1s ease-in-out infinite;
  }

  #actBtn[hidden] {
    display: none;
  }

  @keyframes actPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.03); }
  }

  @media (prefers-reduced-motion: reduce) {
    #actBtn { animation: none; }
  }
</style>

<div class="wrap">
  <h1>&#127950;&#65039; Car Dodge Dubai</h1>
  <svg class="skyline" viewBox="0 0 400 76" role="img" aria-label="The Dubai skyline: Burj Khalifa, Burj Al Arab and the Dubai Frame">
    <g fill="currentColor" opacity="0.55">
      <rect x="8" y="46" width="14" height="30"/><rect x="24" y="36" width="12" height="40"/>
      <polygon points="54,76 56,48 60,40 63,26 65,10 66,2 67,10 69,26 72,40 76,48 78,76"/>
      <rect x="86" y="40" width="16" height="36"/><rect x="104" y="52" width="12" height="24"/>
      <rect x="168" y="44" width="12" height="32"/><rect x="182" y="30" width="10" height="46"/>
      <rect x="296" y="42" width="14" height="34"/><rect x="312" y="30" width="10" height="46"/>
      <rect x="324" y="50" width="14" height="26"/><rect x="342" y="38" width="12" height="38"/><rect x="358" y="46" width="14" height="30"/>
    </g>
    <g fill="currentColor" opacity="0.8">
      <polygon points="196,76 198,50 201,42 203,28 205,14 206,4 207,0 208,4 209,14 211,28 213,42 216,50 218,76"/>
      <path d="M236 76 Q236 36 252 12 L255 8 Q276 36 276 76 Z"/><rect x="254" y="0" width="2" height="12"/>
    </g>
    <g fill="#d4a72c">
      <rect x="122" y="22" width="9" height="54"/><rect x="144" y="22" width="9" height="54"/><rect x="122" y="22" width="31" height="10"/>
    </g>
    <path d="M0 74 H400" stroke="currentColor" stroke-width="2" opacity="0.5"/>
  </svg>
  <p class="sub">Drive from your home in Dubai to the malls. Drag your finger (or mouse) left and right to steer past the traffic, follow the road signs, grab coins and the blue shield, and boost for speed! When you arrive, park in the indoor car park, get out, shop in the mall (ride the escalator, go inside the shops), put your bags in the boot and drive home.</p>
  <p class="score" id="score">Score: 0</p>
  <p class="level" id="level">Level 1</p>
  <p class="best" id="best">Best: 0</p>
  <div class="stage">
    <canvas id="game" width="400" height="600" aria-label="Car dodge game in Dubai"></canvas>
  </div>
  <button id="actBtn" type="button" hidden>&#128682; Get out of the car</button>
  <div class="boost-row">
    <button id="boostBtn">&#128640; BOOST</button>
    <div class="boost-bar"><div id="boostFill" class="boost-fill"></div></div>
  </div>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const bestEl = document.getElementById('best');
    const levelEl = document.getElementById('level');
    const boostBtn = document.getElementById('boostBtn');
    const boostFill = document.getElementById('boostFill');
    const actBtn = document.getElementById('actBtn');
    const pointsPerLevel = 7;

    const W = canvas.width;
    const H = canvas.height;

    const roadLeft = 60;
    const roadRight = W - 60;

    const carStartY = H - 130;
    const car = { x: W / 2, y: carStartY, w: 36, h: 60 };
    const carColor = '#d62828'; // red
    const carOutline = '#8c1a1a';

    function roundedRect(x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    // ---------- Dubai buildings seen from above ----------
    const cityHash = (a, b) => (Math.imul(a + 7919, 73856093) ^ Math.imul(b + 104729, 19349663)) >>> 0;
    const roofColours = ['#e4cfa3', '#d9b98a', '#f1e6cf', '#a9c7da', '#cfa86b', '#f5f0e6', '#b9cbd6', '#e8dcc0', '#c9a37a'];
    function drawRoof(x, y, w, h, hv) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
      ctx.fillRect(x + 4, y + 4, w, h); // shadow
      ctx.fillStyle = roofColours[hv % roofColours.length];
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.28)';
      ctx.fillRect(x + 2, y + 2, w - 4, 3); // sunny edge
      const kind = (hv >>> 4) % 6;
      if (kind === 0) {
        // air-con boxes
        ctx.fillStyle = '#7e868e';
        ctx.fillRect(x + 6, y + 8, 12, 9);
        ctx.fillRect(x + w - 18, y + h - 17, 12, 9);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
        ctx.fillRect(x + 8, y + 10, 8, 5);
      } else if (kind === 1 && w >= 50) {
        // helipad
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2, Math.min(w, h) * 0.32, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
        ctx.lineWidth = 2.5;
        ctx.stroke();
        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
        ctx.font = 'bold 14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('H', x + w / 2, y + h / 2 + 5);
      } else if (kind === 2) {
        // skylight
        ctx.fillStyle = 'rgba(190, 230, 255, 0.7)';
        ctx.fillRect(x + w / 2 - 9, y + h / 2 - 7, 18, 14);
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';
        ctx.lineWidth = 1;
        ctx.strokeRect(x + w / 2 - 9, y + h / 2 - 7, 18, 14);
      } else if (kind === 3) {
        // water tank
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2, 9, 0, Math.PI * 2);
        ctx.fillStyle = '#8d6e50';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(x + w / 2 - 2, y + h / 2 - 2, 4, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
        ctx.fill();
      }
    }

    function drawPalm(px, py) {
      ctx.strokeStyle = '#2f8a46';
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      for (let i = 0; i < 7; i++) {
        const a = (i / 7) * Math.PI * 2 + 0.3;
        ctx.beginPath();
        ctx.moveTo(px, py);
        ctx.quadraticCurveTo(px + Math.cos(a) * 7, py + Math.sin(a) * 7 - 1, px + Math.cos(a) * 12, py + Math.sin(a) * 12 + 2);
        ctx.stroke();
      }
      ctx.lineCap = 'butt';
      ctx.beginPath();
      ctx.arc(px, py, 3, 0, Math.PI * 2);
      ctx.fillStyle = '#8d6e50';
      ctx.fill();
    }

    function drawPark(x, y, w, h, hv) {
      ctx.fillStyle = '#6fbf73';
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
      for (let i = 0; i < 2; i++) {
        const tx = x + 14 + ((hv >>> (i * 3)) % Math.max(10, w - 28));
        const ty = y + 14 + ((hv >>> (i * 3 + 1)) % Math.max(10, h - 28));
        drawPalm(tx, ty);
      }
    }

    function drawTower(x, y, w, h) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
      ctx.beginPath();
      ctx.moveTo(x + 4, y + 4);
      ctx.lineTo(x + w + 4, y + 4);
      ctx.lineTo(x + w + 22, y + h + 24);
      ctx.lineTo(x + 18, y + h + 24);
      ctx.fill();
      const g = ctx.createLinearGradient(x, y, x + w, y + h);
      g.addColorStop(0, '#d6ecf8');
      g.addColorStop(1, '#7fa9c4');
      ctx.fillStyle = g;
      ctx.fillRect(x + 3, y + 3, w - 6, h - 6);
      ctx.strokeStyle = '#4f7b96';
      ctx.lineWidth = 2;
      ctx.strokeRect(x + 3, y + 3, w - 6, h - 6);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
      ctx.fillRect(x + 8, y + 8, w - 16, 5);
      ctx.fillStyle = '#4f7b96';
      ctx.fillRect(x + w / 2 - 6, y + h / 2 - 6, 12, 12);
      ctx.beginPath();
      ctx.arc(x + w / 2, y + h / 2, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
    }

    function drawBurj(x, y, w, h) {
      const cx = x + w / 2;
      const cy = y + h / 2;
      const r = Math.min(w, h) * 0.24;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
      ctx.beginPath();
      ctx.moveTo(cx - 6, cy);
      ctx.lineTo(cx + 6, cy);
      ctx.lineTo(cx + 40, cy + 72);
      ctx.lineTo(cx + 26, cy + 76);
      ctx.fill();
      ctx.fillStyle = '#e9eef2';
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
      [90, 210, 330].forEach((deg) => {
        const a = (deg * Math.PI) / 180;
        ctx.beginPath();
        ctx.arc(cx + Math.cos(a) * r * 1.05, cy - Math.sin(a) * r * 1.05, r, 0, Math.PI * 2);
        ctx.fillStyle = '#b7c3cd';
        ctx.fill();
        ctx.strokeStyle = '#7d8c99';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      });
      ctx.beginPath();
      ctx.arc(cx, cy, r * 0.7, 0, Math.PI * 2);
      ctx.fillStyle = '#8a99a6';
      ctx.fill();
      ctx.beginPath();
      ctx.arc(cx, cy, 3, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.font = 'bold 8px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillStyle = '#5a6874';
      ctx.fillText('BURJ', cx, y + h - 4);
    }

    function drawMosque(x, y, w, h) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.18)';
      ctx.fillRect(x + 4, y + 4, w, h);
      ctx.fillStyle = '#f1e6cf';
      ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = '#a8895a';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
      ctx.fillStyle = '#4f9d6f';
      ctx.fillRect(x + 6, y + 6, w - 12, h - 12);
      const cx = x + w / 2;
      const cy = y + h / 2;
      ctx.beginPath();
      ctx.arc(cx, cy, Math.min(w, h) * 0.28, 0, Math.PI * 2);
      ctx.fillStyle = '#e8c75a';
      ctx.fill();
      ctx.strokeStyle = '#a8861c';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(cx, cy, Math.min(w, h) * 0.12, 0, Math.PI * 2);
      ctx.fillStyle = '#fff3b0';
      ctx.fill();
      [[x + 5, y + 5], [x + w - 5, y + 5], [x + 5, y + h - 5], [x + w - 5, y + h - 5]].forEach(([mx, my]) => {
        ctx.beginPath();
        ctx.arc(mx, my, 4, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.strokeStyle = '#a8895a';
        ctx.lineWidth = 1;
        ctx.stroke();
      });
    }

    function drawFrame(x, y, w, h) {
      ctx.fillStyle = '#e9dfc4';
      ctx.fillRect(x, y, w, h);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
      ctx.fillRect(x + 10, y + 8, 10, h - 14);
      ctx.fillRect(x + w - 18, y + 8, 10, h - 14);
      ctx.fillRect(x + 10, y + 8, w - 18, 10);
      ctx.fillStyle = '#d4a72c';
      ctx.fillRect(x + 6, y + 4, 10, h - 12);
      ctx.fillRect(x + w - 16, y + 4, 10, h - 12);
      ctx.fillRect(x + 6, y + 4, w - 12, 10);
      ctx.fillStyle = '#fff0b0';
      ctx.fillRect(x + 8, y + 5, 3, h - 14);
      ctx.fillRect(x + w - 14, y + 5, 3, h - 14);
      ctx.fillStyle = '#7d9b6a';
      ctx.fillRect(x + 20, y + 20, w - 40, h - 30);
    }


    // ---------- sounds: a police siren and little chimes, made on the first tap ----------
    let audioCtx = null;
    let sirenOsc = null;
    let sirenGain = null;

    function ensureAudio() {
      // Never let anything here throw: a sound failure must not block the game.
      try {
        if (audioCtx) {
          if (audioCtx.state === 'suspended') audioCtx.resume();
          return;
        }
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        sirenOsc = audioCtx.createOscillator();
        sirenGain = audioCtx.createGain();
        sirenOsc.type = 'sine';
        sirenGain.gain.value = 0;
        sirenOsc.connect(sirenGain).connect(audioCtx.destination);
        sirenOsc.start();
      } catch (e) {
        audioCtx = null;
      }
    }

    function blip(freq, freq2, dur, vol, delay) {
      if (!audioCtx) return;
      try {
        const o = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        o.type = 'triangle';
        const t = audioCtx.currentTime + (delay || 0);
        o.frequency.setValueAtTime(freq, t);
        o.frequency.linearRampToValueAtTime(freq2, t + dur);
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        o.connect(g).connect(audioCtx.destination);
        o.start(t);
        o.stop(t + dur);
      } catch (e) {}
    }

    function policeWarning() {
      return phase === 'drive' && !police && !gameOver && !crashing && !arriving && slowTimer > slowThreshold - policeWarnFrames;
    }

    function updateSiren() {
      if (!audioCtx || !sirenGain) return;
      try {
        const wailing = phase === 'drive' && !gameOver && (!!police || policeWarning());
        sirenGain.gain.linearRampToValueAtTime(wailing ? 0.05 : 0, audioCtx.currentTime + 0.15);
        if (wailing) sirenOsc.frequency.setValueAtTime(650 + Math.sin(frameCount / 15) * 150, audioCtx.currentTime);
      } catch (e) {}
    }

    // ---------- the trip: home, a mall, and back home ----------
    const malls = [
      { name: 'Dubai Mall', ar: 'دبي مول', colour: '#7d4a92', kind: 'mall' },
      { name: 'Mall of the Emirates', ar: 'مول الإمارات', colour: '#c0392b', kind: 'mall' },
      { name: 'Ibn Battuta Mall', ar: 'ابن بطوطة مول', colour: '#2a9d8f', kind: 'mall' },
      { name: 'City Centre Mirdif', ar: 'سيتي سنتر مردف', colour: '#e08a1e', kind: 'mall' },
      { name: 'Dubai Marina Mall', ar: 'دبي مارينا مول', colour: '#1f78c1', kind: 'mall' },
      { name: 'Dubai Hills Mall', ar: 'دبي هيلز مول', colour: '#3a7d44', kind: 'mall' },
      { name: 'Nakheel Mall', ar: 'نخيل مول', colour: '#b5651d', kind: 'mall' },
      { name: 'Festival City Mall', ar: 'فستيفال سيتي مول', colour: '#d1495b', kind: 'mall' },
      { name: 'BurJuman', ar: 'برجمان', colour: '#4b3f72', kind: 'mall' },
      { name: 'Al Ghurair Centre', ar: 'الغرير سنتر', colour: '#00798c', kind: 'mall' },
      { name: 'Deira City Centre', ar: 'ديرة سيتي سنتر', colour: '#e07a5f', kind: 'mall' },
      { name: 'Dubai Outlet Mall', ar: 'دبي أوتلت مول', colour: '#5e548e', kind: 'mall' },
      { name: 'The Beach Mall', ar: 'ذا بيتش مول', colour: '#2a9fd6', kind: 'mall' },
    ];
    let lastMall = -1;
    function pickMall() {
      let i;
      do {
        i = Math.floor(Math.random() * malls.length);
      } while (i === lastMall);
      lastMall = i;
      return malls[i];
    }
    const homeDest = { name: 'Home', ar: 'المنزل', colour: '#2d6a4f', kind: 'home' };
    const tourist = ['Burj Khalifa', 'Dubai Frame', 'Palm Jumeirah', 'Burj Al Arab', 'Dubai Creek'];

    // phase: start (at home) -> drive -> park -> walk -> mall -> walk -> drive home -> park -> walk -> home
    let phase = 'start';
    let tripNo = 0;
    let dest = malls[0];
    let leg = 'out'; // out to the mall, or back home
    let tripLen = 6000;
    let travel = 0; // how far you have driven on this road
    let arriving = false;
    let arriveT = 0;
    let shopped = false; // you have been in the mall on this trip
    let msg = '';
    let msgT = 0;

    let targetX = car.x;
    let hold = null; // where a finger or the mouse is pressing (for parking and walking)
    const keys = { left: false, right: false, up: false, down: false };
    const moveSpeed = 15;
    const followSpeed = 0.5;

    let traffic = [];
    let coins = [];
    let laneLines = [];
    let signs = [];
    let nextSignAt = 120;
    let signIdx = 0;
    let nextGantryAt = 900;
    let score = 0;
    let level = 1;
    let levelFlash = 0;
    let best = 0;
    let gameOver = false;
    let started = false;

    // Boost: hold the button (or Shift) to speed everything up for a moment.
    let boosting = false;
    let boostEnergy = 100;
    const boostDrain = 1.3;
    const boostRegen = 0.5;
    const boostMultiplier = 2.8;

    let coinSpawnIn = 90;

    // Shield power-up: grab the blue shield to survive one crash or arrest.
    let shields = [];
    let shieldOn = false;
    let shieldSpawnIn = 300;
    let shieldFlash = 0;
    let invuln = 0;

    // A police car waits behind you. Coast too long without boosting and it
    // starts closing in; boost to pull away and lose it.
    let police = null;
    let slowTimer = 0;
    let busted = false;
    const slowThreshold = Infinity; // there is no police in this game any more
    const policeApproach = 0.75;
    const policeWarnFrames = 150;
    const policeRetreat = 6.5;

    // Crash: the car spins out and swings off the road into the roadside.
    let crashing = false;
    let crashTimer = 0;
    const crashDuration = 50;
    let crashAngle = 0;
    let crashSpin = 1;
    let crashStartX = 0;
    let crashStartY = 0;
    let crashTargetX = 0;
    let crashTargetY = 0;
    let splashed = false;
    let splashes = [];
    let frameCount = 0;
    let lastTime = null; // so game speed does not depend on the screen refresh rate

    function easeOut(t) {
      return t * t * (3 - 2 * t);
    }

    function levelFor(s) {
      return Math.floor(s / pointsPerLevel) + 1;
    }

    try {
      best = Number(localStorage.getItem('carDodgeBest') || 0);
    } catch (e) {}
    bestEl.textContent = 'Best: ' + best;

    function say(text, frames) {
      msg = text;
      msgT = frames || 150;
    }

    function addScore(n) {
      score += n;
      scoreEl.textContent = 'Score: ' + score;
      const newLevel = levelFor(score);
      if (newLevel > level) {
        level = newLevel;
        levelEl.textContent = 'Level ' + level;
        levelFlash = 90;
        blip(520, 1040, 0.3, 0.12);
      }
    }

    function startCrash() {
      if (crashing || gameOver) return;
      crashing = true;
      crashTimer = crashDuration;
      crashAngle = 0;
      splashed = false;
      const roadMid = (roadLeft + roadRight) / 2;
      const direction = car.x < roadMid ? -1 : 1;
      crashSpin = direction;
      crashStartX = car.x;
      crashStartY = car.y;
      crashTargetX = direction < 0 ? roadLeft - 26 : roadRight + 26;
      crashTargetY = car.y + 50;
    }

    // ---------- the road ----------
    function spawnTraffic() {
      const w = 36;
      const h = 56;
      const x = roadLeft + 20 + Math.random() * (roadRight - roadLeft - 40 - w) + w / 2;
      const colors = ['#6a4c93', '#ffb703', '#2a9d8f', '#f4a261', '#e9ecef', '#457b9d'];
      traffic.push({ x, y: -60, w, h, color: colors[Math.floor(Math.random() * colors.length)], passed: false });
    }

    function spawnShield() {
      shields.push({ x: roadLeft + 24 + Math.random() * (roadRight - roadLeft - 48), y: -30, r: 15 });
    }

    function spawnCoin() {
      coins.push({ x: roadLeft + 24 + Math.random() * (roadRight - roadLeft - 48), y: -30, r: 12 });
    }

    function baseSpeed() {
      // Starts slow at level 1, a clear step up with each level.
      return Math.min(10, 3.6 + (level - 1) * 0.8);
    }

    function worldSpeed() {
      return boosting && boostEnergy > 0 ? baseSpeed() * boostMultiplier : baseSpeed();
    }

    function spawnGap() {
      return Math.max(150, 290 - (level - 1) * 10);
    }

    function spawnLaneLines() {
      laneLines = [];
      for (let i = 0; i < 8; i++) laneLines.push({ y: i * 80 });
    }
    spawnLaneLines();

    // Road signs. They stand at the side of the road and come towards you.
    function spawnSign() {
      const remaining = tripLen - travel;
      const side = signIdx % 2 ? 1 : -1;
      let kind;
      if (remaining < 650) kind = 'exit';
      else {
        const cycle = ['speed', 'dest', 'camel', 'dest', 'tourist', 'speed', 'dest', 'warn'];
        kind = cycle[signIdx % cycle.length];
      }
      if (leg === 'home' && (kind === 'dest' || kind === 'exit') && Math.random() < 0.4) kind = kind === 'exit' ? 'exit' : 'home';
      signs.push({ kind, side, y: -40, text: tourist[signIdx % tourist.length], km: Math.max(1, Math.round(remaining / 700)) });
      signIdx++;
    }

    function spawnGantry() {
      signs.push({ kind: 'gantry', side: 0, y: -40, km: Math.max(1, Math.round((tripLen - travel) / 700)) });
    }

    function startLeg(newLeg) {
      leg = newLeg;
      dest = newLeg === 'out' ? (tripNo === 0 ? malls[0] : pickMall()) : homeDest;
      if (newLeg === 'out' && tripNo === 0) lastMall = 0;
      tripLen = 4200 + Math.random() * 1200;
      travel = 0;
      arriving = false;
      arriveT = 0;
      signs = [];
      signIdx = 0;
      nextSignAt = 160;
      nextGantryAt = 700;
      traffic = [];
      coins = [];
      shields = [];
      police = null;
      slowTimer = 0;
      busted = false;
      car.x = W / 2;
      car.y = carStartY;
      targetX = car.x;
      crashing = false;
      crashAngle = 0;
      splashes = [];
      phase = 'drive';
      spawnTraffic();
      say((newLeg === 'out' ? 'Drive to ' : 'Drive back ') + dest.name + '!', 170);
    }

    function resetGame() {
      score = 0;
      level = 1;
      levelFlash = 0;
      scoreEl.textContent = 'Score: 0';
      levelEl.textContent = 'Level 1';
      gameOver = false;
      started = true;
      boosting = false;
      boostEnergy = 100;
      coinSpawnIn = 90;
      shieldOn = false;
      shieldSpawnIn = 250 + Math.random() * 200;
      shieldFlash = 0;
      invuln = 0;
      tripNo = 0;
      shopped = false;
      mallBag = [];
      bootDone = false;
      if (audioCtx && sirenGain) sirenGain.gain.setValueAtTime(0, audioCtx.currentTime);
      startLeg('out');
    }

    function nextTrip() {
      tripNo++;
      shopped = false;
      mallBag = [];
      bootDone = false;
      startLeg('out');
    }

    function startOrRestart() {
      ensureAudio();
      if (phase === 'start' || gameOver) resetGame();
      else if (phase === 'homedone') nextTrip();
    }

    // ---------- the car park, in front of a mall or your home ----------
    const bayW = 44;
    const bayH = 70;
    const bayRows = [206, 338];
    function bayRect(i) {
      const row = i < 8 ? 0 : 1;
      const col = i % 8;
      return { x: col < 4 ? 12 + col * bayW : 212 + (col - 4) * bayW, y: bayRows[row], w: bayW, h: bayH, row };
    }
    let bays = [];
    let targetBay = 0;
    let lotKind = 'home';
    let parked = false;
    let parkedT = 0;
    let lotCars = [];
    const me = { x: 200, y: 450, hurt: 0, stepT: 0, moving: false };
    let leftCar = false;
    let nearCar = false;

    function makeLot(kind) {
      lotKind = kind;
      const cols = ['#6a4c93', '#ffb703', '#2a9d8f', '#f4a261', '#e9ecef', '#457b9d', '#8d99ae', '#e76f51'];
      bays = [];
      for (let i = 0; i < 16; i++) bays.push({ occupied: Math.random() < 0.62, colour: cols[Math.floor(Math.random() * cols.length)] });
      const empties = bays.map((b, i) => i).filter((i) => !bays[i].occupied);
      targetBay = empties.length ? empties[Math.floor(Math.random() * empties.length)] : 3;
      bays[targetBay].occupied = false;
      // a few more empty bays, so there are choices
      for (let k = 0; k < 2; k++) {
        const j = Math.floor(Math.random() * 16);
        if (j !== targetBay) bays[j].occupied = false;
      }
    }
    function bayCentre(i) {
      const r = bayRect(i);
      return { x: r.x + r.w / 2, y: r.y + r.h / 2 };
    }

    function enterLot() {
      phase = 'park';
      makeLot(dest.kind);
      parked = false;
      parkedT = 0;
      hold = null;
      car.x = 200;
      car.y = 566;
      boosting = false;
      police = null;
      if (audioCtx && sirenGain) sirenGain.gain.setValueAtTime(0, audioCtx.currentTime);
      say('Arrived at ' + dest.name + '! Park in the glowing bay.', 220);
    }

    // does a rectangle hit a parked car?
    function hitsParked(cx, cy, hw, hh) {
      for (let i = 0; i < bays.length; i++) {
        if (!bays[i].occupied) continue;
        const r = bayRect(i);
        if (Math.abs(cx - (r.x + r.w / 2)) < hw + 17 && Math.abs(cy - (r.y + r.h / 2)) < hh + 29) return true;
      }
      return false;
    }

    function inputDir(fromX, fromY) {
      let dx = 0;
      let dy = 0;
      if (hold) {
        const d = Math.hypot(hold.x - fromX, hold.y - fromY);
        if (d > 5) {
          dx = (hold.x - fromX) / d;
          dy = (hold.y - fromY) / d;
        }
      }
      if (keys.left) dx -= 1;
      if (keys.right) dx += 1;
      if (keys.up) dy -= 1;
      if (keys.down) dy += 1;
      const len = Math.hypot(dx, dy);
      return { dx: dx / Math.max(1, len), dy: dy / Math.max(1, len), moving: len > 0.01 };
    }

    function updatePark(step) {
      const d = inputDir(car.x, car.y);
      if (d.moving) {
        const nx = Math.max(24, Math.min(W - 24, car.x + d.dx * 2.5 * step));
        const ny = Math.max(236, Math.min(H - 34, car.y + d.dy * 2.5 * step));
        if (!hitsParked(nx, car.y, 16, 28)) car.x = nx;
        if (!hitsParked(car.x, ny, 16, 28)) car.y = ny;
      }
      const c = bayCentre(targetBay);
      if (Math.abs(car.x - c.x) < 9 && Math.abs(car.y - c.y) < 12 && !d.moving) parkedT += step;
      else if (Math.abs(car.x - c.x) < 9 && Math.abs(car.y - c.y) < 12) parkedT += 0;
      else parkedT = 0;
      if (!parked && parkedT > 35) {
        parked = true;
        addScore(5);
        say('Parked! \u{1F17F}️ +5  Now get out of the car.', 200);
        blip(660, 990, 0.2, 0.12);
        blip(990, 1320, 0.25, 0.12, 0.15);
      }
      if (parked && !(Math.abs(car.x - c.x) < 12 && Math.abs(car.y - c.y) < 15)) parked = false;
    }

    function getOutOfCar() {
      if (phase !== 'park' || !parked) return;
      phase = 'walk';
      const r = bayRect(targetBay);
      me.x = car.x;
      me.y = r.y + r.h + 16;
      me.hurt = 0;
      leftCar = false;
      hold = null;
      lotCars = [
        { x: 60, y: 307, dir: 1, v: 1.5, colour: '#2a9d8f' },
        { x: 300, y: 307, dir: -1, v: 1.3, colour: '#ffb703' },
        { x: 120, y: 470, dir: 1, v: 1.7, colour: '#6a4c93' },
        { x: 330, y: 535, dir: -1, v: 1.4, colour: '#e76f51' },
      ];
      say('Walk to ' + (dest.kind === 'mall' ? dest.name : 'your home') + '!', 190);
      blip(520, 520, 0.12, 0.1);
    }

    // open the boot and put the shopping bags inside
    function startBoot() {
      if (phase !== 'walk' || !shopped || !nearCar || bootT > 0 || bootDone) return;
      bootT = 1;
      blip(300, 500, 0.2, 0.1);
    }

    function getInCar() {
      if (phase !== 'walk' || !shopped || !nearCar) return;
      blip(420, 420, 0.12, 0.1);
      startLeg('home');
    }

    function updateWalk(step) {
      if (bootT > 0) {
        bootT += step;
        if (bootT > 30 + mallBag.length * 14 + 80) {
          bootT = 0;
          bootDone = true;
          addScore(5 + mallBag.length);
          say('Bags in the boot! +' + (5 + mallBag.length), 150);
          blip(660, 990, 0.2, 0.1);
        }
        return;
      }
      me.hurt = Math.max(0, me.hurt - step);
      const d = inputDir(me.x, me.y);
      me.moving = d.moving;
      if (d.moving) {
        const nx = Math.max(14, Math.min(W - 14, me.x + d.dx * 2.2 * step));
        const ny = Math.max(150, Math.min(H - 12, me.y + d.dy * 2.2 * step));
        const hitCar = (px, py) => hitsParked(px, py, 5, 5) || (Math.abs(px - car.x) < 22 && Math.abs(py - car.y) < 34 && phase === 'walk');
        if (!hitCar(nx, me.y)) me.x = nx;
        if (!hitCar(me.x, ny)) me.y = ny;
        // the building: only the door lets you in
        if (me.y < 188 && Math.abs(me.x - 200) >= 28) me.y = 188;
        me.stepT += step;
      }
      lotCars.forEach((c) => {
        c.x += c.dir * c.v * step;
        if (c.x > W + 60) c.x = -60;
        if (c.x < -60) c.x = W + 60;
        if (me.hurt <= 0 && Math.abs(me.x - c.x) < 34 && Math.abs(me.y - c.y) < 20) {
          me.hurt = 70;
          score = Math.max(0, score - 3);
          scoreEl.textContent = 'Score: ' + score;
          const r = bayRect(targetBay);
          me.x = car.x;
          me.y = r.y + r.h + 16;
          say('Ouch! Watch out for the cars', 120);
          blip(220, 140, 0.25, 0.14);
        }
      });
      const far = Math.hypot(me.x - car.x, me.y - car.y);
      if (far > 70) leftCar = true;
      nearCar = leftCar && far < 44;
      // through the front door
      if (me.y < 186 && Math.abs(me.x - 200) < 28) {
        if (dest.kind === 'mall' && leg === 'out' && !shopped) enterMall();
        else if (leg === 'home') finishHome();
        else if (dest.kind === 'mall') leaveBackToCar();
      }
    }

    function leaveBackToCar() {
      me.y = 200;
    }

    function finishHome() {
      phase = 'homedone';
      addScore(20);
      say('Home sweet home! \u{1F3E0}', 300);
      blip(523, 523, 0.15, 0.12);
      blip(659, 659, 0.15, 0.12, 0.15);
      blip(784, 784, 0.3, 0.12, 0.3);
      if (score > best) saveBest();
    }

    function saveBest() {
      best = score;
      bestEl.textContent = 'Best: ' + best;
      try {
        localStorage.setItem('carDodgeBest', String(best));
      } catch (e) {}
    }

    // ---------- inside the mall: two floors, escalators, benches and real shops ----------
    // A long shopping street with an escalator in the middle that takes you to the
    // upper floor. Tap a shop door to go in, then tap the things you want to buy.
    const mallShopsData = [
      { name: 'Ice Cream', emoji: '\u{1F366}', colour: '#f7a8c4', wall: '#ffe3ee', floor: '#f6efe6', items: [['\u{1F366}', 'Ice cream', 1], ['\u{1F36B}', 'Chocolate', 1], ['\u{1F9C1}', 'Cupcake', 2]] },
      { name: 'Book Shop', emoji: '\u{1F4DA}', colour: '#7fb2d9', wall: '#dcebf7', floor: '#b08a63', items: [['\u{1F4DA}', 'Books', 2], ['\u{1F4D6}', 'Story book', 1], ['✏️', 'Pencil', 1]] },
      { name: 'Pizza', emoji: '\u{1F355}', colour: '#e8a33d', wall: '#fff0cf', floor: '#c9553d', items: [['\u{1F355}', 'Pizza', 2], ['\u{1F964}', 'Drink', 1], ['\u{1F35F}', 'Chips', 1]] },
      { name: 'Toy Store', emoji: '\u{1F9F8}', colour: '#a98be0', wall: '#ece4fb', floor: '#e8d36a', items: [['\u{1F9F8}', 'Teddy bear', 3], ['\u{1F697}', 'Toy car', 2], ['\u{1FA81}', 'Kite', 2]] },
      { name: 'Clothes', emoji: '\u{1F457}', colour: '#ee8f8c', wall: '#fde6e4', floor: '#d9d2c8', items: [['\u{1F457}', 'Dress', 3], ['\u{1F455}', 'T-shirt', 2], ['\u{1F9E2}', 'Cap', 1]] },
      { name: 'Shoes', emoji: '\u{1F45F}', colour: '#5fb98a', wall: '#dff3e8', floor: '#9a8f82', items: [['\u{1F45F}', 'Trainers', 4], ['\u{1FA74}', 'Sandals', 2], ['\u{1F97E}', 'Boots', 3]] },
      { name: 'Phones', emoji: '\u{1F4F1}', colour: '#4f6d8f', wall: '#e1e8f0', floor: '#cfd5dc', items: [['\u{1F4F1}', 'Phone', 5], ['\u{1F3A7}', 'Headphones', 3], ['\u{1F50C}', 'Charger', 1]] },
      { name: 'Sports', emoji: '⚽', colour: '#52a8e0', wall: '#e0f0fa', floor: '#7fa86a', items: [['⚽', 'Football', 2], ['\u{1F3C0}', 'Basketball', 2], ['\u{1F3BE}', 'Tennis ball', 1]] },
      { name: 'Bakery', emoji: '\u{1F950}', colour: '#d9a066', wall: '#faeedd', floor: '#ead9bf', items: [['\u{1F950}', 'Croissant', 1], ['\u{1F35E}', 'Bread', 1], ['\u{1F382}', 'Birthday cake', 4]] },
      { name: 'Jewellery', emoji: '\u{1F48D}', colour: '#b49a4d', wall: '#f5efdc', floor: '#2f2a3a', items: [['\u{1F48D}', 'Ring', 5], ['⌚', 'Watch', 4], ['\u{1F4FF}', 'Necklace', 2]] },
      { name: 'Perfume', emoji: '\u{1F9F4}', colour: '#c77dba', wall: '#f8e6f3', floor: '#e7dce6', items: [['\u{1F9F4}', 'Perfume', 3], ['\u{1F339}', 'Rose', 1], ['\u{1FA9E}', 'Mirror', 2]] },
      { name: 'Games', emoji: '\u{1F3AE}', colour: '#4a5fc1', wall: '#e3e6f7', floor: '#2f3350', items: [['\u{1F3AE}', 'Video game', 4], ['\u{1F579}️', 'Joystick', 2], ['\u{1F3B2}', 'Dice game', 1]] },
    ];
    const mallSlotX = [0, 100, 200, 400, 500, 600]; // the six shops on each floor; the escalator is in the middle
    const mallWorldW = 700;
    const mallEscX = 350;
    const mm = { x: 200, y: 505, dir: 1, stepT: 0, moving: false, goto: null };
    let mallFloor = 0;
    let mallShop = -1; // the shop you are inside, or -1 on the shopping street
    let mallDone = [];
    let mallBag = [];
    let mallWallet = 0;
    let mallShoppers = [];
    let mallShopFolk = [];
    let mallCamX = 0;
    let mallRide = null; // riding the escalator
    let mallTime = 0;
    let mallDifferent = new Set();
    let bootT = 0; // the boot panel is open
    let bootDone = false;
    const shopperLook = [
      ['#f2c9a0', '#e63946', '#2a4d8f'], ['#c68c5c', '#2a9d8f', '#3a3a4a'], ['#8d5a3b', '#f4a261', '#264653'],
      ['#f2c9a0', '#6a4c93', '#4a4a4a'], ['#e0ac84', '#ffd166', '#1d3557'], ['#6f4426', '#ffffff', '#7a5a3a'],
    ];
    const mallShelfX = [96, 200, 304];
    const mallShopIdx = (slot) => mallFloor * 6 + slot;
    const mallDoorX = (slot) => mallSlotX[slot] + 50;

    function enterMall() {
      phase = 'mall';
      mm.x = 200;
      mm.y = 505;
      mm.goto = null;
      mm.dir = 1;
      mallFloor = 0;
      mallShop = -1;
      mallRide = null;
      mallCamX = 0;
      mallWallet = 20;
      mallBag = [];
      mallDone = mallShopsData.map(() => [false, false, false]);
      mallDifferent = new Set();
      bootDone = false;
      bootT = 0;
      mallShoppers = [];
      for (let k = 0; k < 14; k++) {
        mallShoppers.push({ x: 60 + ((k * 167) % 580), y: 455 + ((k * 31) % 85), floor: k % 2, dir: k % 2 ? 1 : -1, v: k % 5 === 0 ? 0 : 0.35 + (k % 4) * 0.12, look: shopperLook[k % 6], bag: k % 2 === 0, t: k * 7, pause: 0 });
      }
      hold = null;
      say('Welcome to ' + dest.name + '! Tap a shop door, or ride the escalator.', 260);
      blip(988, 988, 0.15, 0.1);
      blip(1318, 1318, 0.2, 0.1, 0.14);
    }

    function leaveMall() {
      if (phase !== 'mall') return;
      shopped = true;
      mallShop = -1;
      phase = 'walk';
      me.x = 200;
      me.y = 200;
      me.hurt = 0;
      leftCar = true;
      hold = null;
      say(mallBag.length ? 'Walk back to your car. Put your bags in the boot!' : 'Walk back to your car and get in!', 220);
    }

    function nearMallDoor() {
      for (let s = 0; s < 6; s++) if (Math.abs(mm.x - mallDoorX(s)) < 36) return s;
      return -1;
    }
    const nearMallEsc = () => Math.abs(mm.x - mallEscX) < 42;
    function nearShelf() {
      for (let k = 0; k < 3; k++) if (Math.abs(mm.x - mallShelfX[k]) < 40) return k;
      return -1;
    }

    function enterShop(slot) {
      mallShop = mallShopIdx(slot);
      mm.x = 70;
      mm.y = 500;
      mm.goto = null;
      hold = null;
      mallShopFolk = [
        { x: 190, y: 470, dir: 1, v: 0.35, look: shopperLook[(slot + 2) % 6], bag: false, kid: false, t: 0, pause: 0 },
        { x: 330, y: 520, dir: -1, v: 0.3, look: shopperLook[(slot + 4) % 6], bag: true, kid: slot % 2 === 0, t: 7, pause: 0 },
      ];
      say('Welcome to ' + mallShopsData[mallShop].name + '! Tap what you want to buy.', 200);
      blip(988, 988, 0.15, 0.08);
      blip(1318, 1318, 0.2, 0.08, 0.14);
    }

    function leaveShop() {
      const slot = mallShop % 6;
      mallShop = -1;
      mm.x = mallDoorX(slot);
      mm.y = 505;
      mm.goto = null;
      hold = null;
    }

    function rideEscalator() {
      if (mallRide) return;
      mm.x = mallEscX;
      mm.goto = null;
      mallRide = { t: 0, dir: mallFloor === 0 ? 1 : -1 };
      say(mallFloor === 0 ? 'Going up to the upper floor!' : 'Going down to the ground floor!', 110);
      blip(400, 800, 0.4, 0.08);
    }

    function mallBuy(k) {
      const sh = mallShopsData[mallShop];
      const [emoji, name, price] = sh.items[k];
      if (mallDone[mallShop][k]) {
        say('You already bought the ' + name.toLowerCase() + '!', 80);
        return;
      }
      if (mallWallet < price) {
        say('Not enough coins for the ' + name.toLowerCase() + '!', 100);
        blip(220, 160, 0.2, 0.08);
        return;
      }
      mallWallet -= price;
      mallDone[mallShop][k] = true;
      mallBag.push(emoji);
      addScore(2);
      say('Bought ' + emoji + ' +2', 100);
      [880, 1175, 1568].forEach((f, j) => blip(f, f, 0.12, 0.1, j * 0.06));
      mallDifferent.add(mallShop);
      if (mallDifferent.size === 3) {
        addScore(10);
        say('\u{1F389} Bought from 3 different shops! +10', 180);
        [523, 659, 784, 1047].forEach((f, j) => blip(f, f, 0.18, 0.1, 0.25 + j * 0.08));
      }
    }

    // press the action: go in a shop, ride the escalator, buy, or go out
    function mallAction() {
      if (phase !== 'mall' || mallRide) return;
      if (mallShop < 0) {
        const d = nearMallDoor();
        if (d >= 0) enterShop(d);
        else if (nearMallEsc()) rideEscalator();
      } else {
        const k = nearShelf();
        if (k >= 0) mallBuy(k);
        else if (mm.x < 70) leaveShop();
      }
    }

    function mallPress(p) {
      mm.goto = null;
      if (mallRide) return;
      if (mallShop < 0) {
        for (let s = 0; s < 6; s++) {
          const sx = mallDoorX(s) - mallCamX;
          if (p.x > sx - 40 && p.x < sx + 40 && p.y > 240 && p.y < 420) {
            mm.goto = mallDoorX(s);
            return;
          }
        }
        const ex = mallEscX - mallCamX;
        if (p.x > ex - 56 && p.x < ex + 56 && p.y > 200 && p.y < 440) {
          mm.goto = mallEscX;
          return;
        }
      } else {
        if (p.x < 70 && p.y > 170 && p.y < 420) {
          mm.goto = 20;
          return;
        }
        for (let k = 0; k < 3; k++) {
          if (Math.abs(p.x - mallShelfX[k]) < 44 && p.y > 300 && p.y < 440) {
            mm.goto = mallShelfX[k];
            return;
          }
        }
      }
      hold = p;
    }

    function wander(sh, step, minX, maxX) {
      sh.t += step;
      if (sh.v === 0) return;
      if (sh.pause > 0) {
        sh.pause -= step;
        return;
      }
      sh.x += sh.dir * sh.v * step;
      if (sh.x < minX || sh.x > maxX) {
        sh.dir = -sh.dir;
        sh.x = Math.max(minX, Math.min(maxX, sh.x));
      }
      if (Math.random() < 0.002 * step) sh.pause = 60 + Math.random() * 120;
    }

    function updateMall(step) {
      mallTime += step;
      if (mallRide) {
        mallRide.t += step;
        if (mallRide.t >= 90) {
          mallFloor = mallRide.dir > 0 ? 1 : 0;
          mallRide = null;
          mm.x = mallEscX;
          mm.y = 505;
          say(mallFloor === 1 ? 'Upper floor: more shops!' : 'Ground floor', 100);
        }
        return;
      }
      let dx = 0;
      let dy = 0;
      if (mm.goto !== null) {
        if (Math.abs(mm.goto - mm.x) < 6) {
          mm.goto = null;
          mallAction();
        } else dx = mm.goto > mm.x ? 1 : -1;
      }
      if (hold) {
        mm.goto = null;
        const px = hold.x + (mallShop < 0 ? mallCamX : 0);
        if (Math.abs(px - mm.x) > 5) dx = px > mm.x ? 1 : -1;
        if (Math.abs(hold.y - mm.y) > 6) dy = hold.y > mm.y ? 1 : -1;
      }
      if (keys.left) dx -= 1;
      if (keys.right) dx += 1;
      if (keys.up) dy -= 1;
      if (keys.down) dy += 1;
      mm.moving = dx !== 0 || dy !== 0;
      if (mm.moving) {
        if (dx !== 0) mm.dir = dx > 0 ? 1 : -1;
        const maxX = mallShop < 0 ? mallWorldW - 30 : 380;
        mm.x = Math.max(mallShop < 0 ? 30 : 22, Math.min(maxX, mm.x + Math.sign(dx) * 2.8 * step));
        mm.y = Math.max(452, Math.min(548, mm.y + Math.sign(dy) * 1.8 * step));
        mm.stepT += step;
      }
      if (mallShop < 0) {
        mallShoppers.forEach((s) => wander(s, step, 60, mallWorldW - 60));
        const want = Math.max(0, Math.min(mallWorldW - W, mm.x - 200));
        mallCamX += (want - mallCamX) * (1 - Math.pow(1 - 0.12, step));
      } else {
        mallShopFolk.forEach((s) => wander(s, step, 60, 360));
        if (mm.x <= 24) leaveShop();
      }
    }

    // ---------- the big button: out of the car, into the car, out of the mall ----------
    let actLabel = null;
    function updateAct() {
      let label = null;
      if (!gameOver) {
        if (phase === 'park' && parked) label = '\u{1F6AA} Get out of the car';
        else if (phase === 'walk' && leg === 'out' && shopped && nearCar && bootT <= 0) label = mallBag.length && !bootDone ? '\u{1F9F3} Put the bags in the boot' : '\u{1F697} Get in the car';
        else if (phase === 'mall') label = '\u{1F6AA} Leave the mall';
      }
      if (label !== actLabel) {
        actLabel = label;
        actBtn.hidden = !label;
        if (label) actBtn.textContent = label;
      }
    }
    actBtn.addEventListener('click', () => {
      ensureAudio();
      if (phase === 'park') getOutOfCar();
      else if (phase === 'walk') {
        if (mallBag.length && !bootDone) startBoot();
        else getInCar();
      }
      else if (phase === 'mall') leaveMall();
    });

    // ---------- input ----------
    function pointerPt(clientX, clientY) {
      const rect = canvas.getBoundingClientRect();
      return { x: ((clientX - rect.left) / rect.width) * W, y: ((clientY - rect.top) / rect.height) * H };
    }

    function pressAt(clientX, clientY) {
      startOrRestart();
      const p = pointerPt(clientX, clientY);
      if (phase === 'drive') targetX = p.x;
      else if (phase === 'mall') mallPress(p);
      else if (phase === 'park' || phase === 'walk') hold = p;
    }
    function moveTo(clientX, clientY) {
      const p = pointerPt(clientX, clientY);
      if (phase === 'drive') targetX = p.x;
      else if (hold) hold = p;
    }

    canvas.addEventListener('mousedown', (e) => pressAt(e.clientX, e.clientY));
    canvas.addEventListener('mousemove', (e) => moveTo(e.clientX, e.clientY));
    canvas.addEventListener('touchstart', (e) => pressAt(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    canvas.addEventListener('touchmove', (e) => moveTo(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    window.addEventListener('mouseup', () => (hold = null));
    window.addEventListener('touchend', () => (hold = null));
    window.addEventListener('touchcancel', () => (hold = null));

    function startBoost(e) {
      e.preventDefault();
      ensureAudio();
      boosting = true;
    }
    function stopBoost() {
      boosting = false;
    }
    boostBtn.addEventListener('mousedown', startBoost);
    boostBtn.addEventListener('touchstart', startBoost, { passive: false });
    boostBtn.addEventListener('mouseup', stopBoost);
    boostBtn.addEventListener('mouseleave', stopBoost);
    boostBtn.addEventListener('touchend', stopBoost);
    boostBtn.addEventListener('touchcancel', stopBoost);

    window.addEventListener('keydown', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
      if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = true;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = true;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = true;
      if (e.code.startsWith('Arrow')) e.preventDefault();
      if (e.code === 'Enter' || e.code === 'KeyE') {
        if (phase === 'mall') mallAction();
        else actBtn.click();
      }
      if (e.code === 'Space') {
        e.preventDefault();
        if (phase === 'mall') mallAction();
        else startOrRestart();
      }
    });
    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
      if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = false;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = false;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = false;
    });

    // ---------- driving ----------
    function updateDrive(step) {
      if (crashing) {
        crashTimer -= step;
        const t = easeOut(Math.min(1, Math.max(0, 1 - crashTimer / crashDuration)));
        car.x = crashStartX + (crashTargetX - crashStartX) * t;
        car.y = crashStartY + (crashTargetY - crashStartY) * t;
        crashAngle = crashSpin * Math.PI * 4 * t;
        if (!splashed && (car.x < roadLeft || car.x > roadRight)) {
          splashed = true;
          splashes.push({ x: car.x, y: car.y, age: 0 });
        }
        splashes.forEach((s) => (s.age += step));
        splashes = splashes.filter((s) => s.age < 26);
        if (crashTimer <= 0) {
          crashing = false;
          endGame();
          if (audioCtx && sirenGain) sirenGain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 0.2);
        }
        return; // freeze everything while spinning out
      }
      if (gameOver) {
        laneLines.forEach((line) => {
          line.y += 3 * step;
          if (line.y > H) line.y -= 8 * 80;
        });
        return;
      }

      let speed = worldSpeed();
      if (arriving) {
        arriveT -= step;
        speed *= Math.max(0, arriveT / 90);
        if (arriveT <= 0) {
          enterLot();
          return;
        }
      }
      const dist = speed * step;
      travel += dist;
      laneLines.forEach((line) => {
        line.y += dist;
        if (line.y > H) line.y -= 8 * 80;
      });
      signs.forEach((s) => (s.y += dist));
      signs = signs.filter((s) => s.y < H + 60);
      const remaining = tripLen - travel;
      if (!arriving) {
        if (travel >= nextSignAt) {
          spawnSign();
          nextSignAt += 230;
        }
        if (travel >= nextGantryAt && remaining > 500) {
          spawnGantry();
          nextGantryAt += 1500;
        }
      }

      if (keys.left) targetX -= moveSpeed * step;
      if (keys.right) targetX += moveSpeed * step;
      targetX = Math.max(roadLeft + car.w / 2, Math.min(roadRight - car.w / 2, targetX));
      car.x += (targetX - car.x) * (1 - Math.pow(1 - followSpeed, step));

      if (boosting && boostEnergy > 0) boostEnergy = Math.max(0, boostEnergy - boostDrain * step);
      else {
        boosting = false;
        boostEnergy = Math.min(100, boostEnergy + boostRegen * step);
      }
      boostFill.style.width = boostEnergy + '%';

      traffic.forEach((other) => {
        other.y += dist;
        if (Math.abs(car.x - other.x) < (car.w + other.w) / 2 - 11 && Math.abs(car.y - other.y) < (car.h + other.h) / 2 - 11) {
          if (invuln > 0) {
            // still protected for a moment after the shield popped
          } else if (shieldOn) {
            shieldOn = false;
            invuln = 45;
            shieldFlash = 60;
            other.passed = true;
            other.y = H + 200;
          } else {
            startCrash();
          }
        }
        if (!other.passed && other.y > car.y + car.h) {
          other.passed = true;
          addScore(1);
        }
      });
      traffic = traffic.filter((other) => other.y < H + 80);
      if (!arriving && remaining > 250 && (traffic.length === 0 || traffic[traffic.length - 1].y > spawnGap())) spawnTraffic();

      coins.forEach((coin) => {
        coin.y += dist;
        if (Math.hypot(car.x - coin.x, car.y - coin.y) < coin.r + Math.min(car.w, car.h) / 2) {
          coin.collected = true;
          addScore(3);
          blip(880, 1320, 0.12, 0.1);
        }
      });
      coins = coins.filter((coin) => !coin.collected && coin.y < H + 40);
      coinSpawnIn -= step;
      if (coinSpawnIn <= 0) {
        if (!arriving && remaining > 250) spawnCoin();
        coinSpawnIn = 80 + Math.random() * 70;
      }

      shields.forEach((sh) => {
        sh.y += dist;
        if (Math.hypot(car.x - sh.x, car.y - sh.y) < sh.r + Math.min(car.w, car.h) / 2) {
          sh.collected = true;
          shieldOn = true;
        }
      });
      shields = shields.filter((sh) => !sh.collected && sh.y < H + 40);
      if (!shieldOn && shields.length === 0 && !arriving) {
        shieldSpawnIn -= step;
        if (shieldSpawnIn <= 0) {
          if (remaining > 250) spawnShield();
          shieldSpawnIn = 350 + Math.random() * 300;
        }
      }

      // The police car. Coasting too long (not boosting) first triggers a
      // flashing warning, then the police appears and creeps up.
      if (boosting || arriving) slowTimer = 0;
      else slowTimer += step;
      if (false && !police && slowTimer >= slowThreshold) {
        const laneX = car.x < (roadLeft + roadRight) / 2 ? roadRight - 55 : roadLeft + 55;
        police = { x: laneX, y: H + 60 };
      }
      if (police) {
        police.y += (boosting ? policeRetreat : -policeApproach) * step;
        if (police.y < H) police.x += (car.x - police.x) * (1 - Math.pow(1 - 0.015, step));
        const caught = police.y - car.y < 14;
        if (caught && Math.abs(police.x - car.x) < 34) {
          if (shieldOn) {
            shieldOn = false;
            invuln = 45;
            shieldFlash = 60;
            police = null;
            slowTimer = 0;
          } else {
            busted = true;
            startCrash();
          }
        } else if (caught) police.y = car.y + 14;
        else if (police.y > H + 140) {
          police = null;
          slowTimer = 0;
        }
      }

      // you have arrived: slow down and turn off into the car park
      if (!arriving && travel >= tripLen) {
        arriving = true;
        arriveT = 90;
        traffic = [];
        coins = [];
        shields = [];
        police = null;
        addScore(10);
        say('You have arrived at ' + dest.name + '!', 120);
        blip(660, 990, 0.2, 0.1);
      }
      levelFlash = Math.max(0, levelFlash - step);
      shieldFlash = Math.max(0, shieldFlash - step);
      invuln = Math.max(0, invuln - step);
    }

    function endGame() {
      if (gameOver) return;
      gameOver = true;
      if (score > best) saveBest();
    }

    function update() {
      const now = performance.now();
      let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
      lastTime = now;
      step = Math.min(Math.max(step, 0.2), 3); // same game speed on 60Hz and 120Hz screens
      frameCount += step;
      msgT = Math.max(0, msgT - step);
      if (phase === 'drive') updateDrive(step);
      else if (phase === 'park') updatePark(step);
      else if (phase === 'walk') updateWalk(step);
      else if (phase === 'mall') updateMall(step);
      else {
        // at home before you set off: the road lines keep still
      }
      if (phase !== 'drive') {
        boosting = false;
        levelFlash = Math.max(0, levelFlash - step);
      }
      updateSiren();
      updateAct();
    }

    // ---------- drawing: the cars ----------
    function drawCar(x, y, w, h, color, outline) {
      const r = 8;
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.moveTo(x - w / 2 + r, y - h / 2);
      ctx.arcTo(x + w / 2, y - h / 2, x + w / 2, y - h / 2 + r, r);
      ctx.lineTo(x + w / 2, y + h / 2 - r);
      ctx.arcTo(x + w / 2, y + h / 2, x + w / 2 - r, y + h / 2, r);
      ctx.lineTo(x - w / 2 + r, y + h / 2);
      ctx.arcTo(x - w / 2, y + h / 2, x - w / 2, y + h / 2 - r, r);
      ctx.lineTo(x - w / 2, y - h / 2 + r);
      ctx.arcTo(x - w / 2, y - h / 2, x - w / 2 + r, y - h / 2, r);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = outline;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
      ctx.fillRect(x - w / 2 + 6, y - h / 2 + 10, w - 12, h / 3);
    }

    function drawPoliceCar(x, y, w, h) {
      drawCar(x, y, w, h, '#f2ecdf', '#222');
      ctx.fillStyle = '#222';
      ctx.fillRect(x - w / 2, y - 6, w, 10);
      ctx.fillStyle = Math.floor(frameCount / 8) % 2 === 0 ? '#ff3b30' : '#2b45f0';
      ctx.fillRect(x - 10, y - h / 2 - 8, 20, 7);
    }

    function drawPoliceGlow() {
      const red = Math.floor(frameCount / 8) % 2 === 0;
      const g = ctx.createLinearGradient(0, H, 0, H - 90);
      g.addColorStop(0, red ? 'rgba(255, 59, 48, 0.75)' : 'rgba(43, 69, 240, 0.75)');
      g.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = g;
      ctx.fillRect(0, H - 90, W, 90);
    }

    function drawShieldPickup(x, y, r) {
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = '#29c5f6';
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x, y - 8);
      ctx.lineTo(x + 7, y - 5);
      ctx.lineTo(x + 6, y + 2);
      ctx.quadraticCurveTo(x + 5, y + 8, x, y + 10);
      ctx.quadraticCurveTo(x - 5, y + 8, x - 6, y + 2);
      ctx.lineTo(x - 7, y - 5);
      ctx.closePath();
      ctx.fillStyle = '#ffffff';
      ctx.fill();
    }

    function drawCoin(x, y, r) {
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd400';
      ctx.fill();
      ctx.strokeStyle = '#b8860b';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(x, y, r - 4, 0, Math.PI * 2);
      ctx.strokeStyle = '#fff3b0';
      ctx.stroke();
    }

    // ---------- drawing: the road through Dubai ----------
    function drawSideCity(sand) {
      const period = 96;
      const idx = Math.floor(travel / period);
      const base = travel % period;
      [[0, 50, 0], [350, 400, 1]].forEach(([x0, x1, c]) => {
        ctx.fillStyle = sand;
        ctx.fillRect(x0, 0, x1 - x0, H);
        for (let r = -1; r < H / period + 1; r++) {
          const g = idx - r;
          const hv = cityHash(g, c);
          const gap = 6 + (hv % 9);
          const h = 56 + ((hv >>> 8) % 26);
          const y = r * period + base + (period - h) / 2 - gap / 2;
          const inset = (hv >>> 12) % 4;
          const x = x0 + 2 + inset;
          const w = x1 - x0 - 4 - inset - ((hv >>> 14) % 3);
          const lm = (hv >>> 9) % 40;
          if ((hv >>> 3) % 7 === 0) drawPark(x - 1, y, w + 2, h, hv);
          else if (lm < 3 && w >= 40) drawTower(x, y, w, h);
          else if (lm === 3 && w >= 44) drawBurj(x, y, w, h);
          else if (lm === 4 && w >= 40) drawMosque(x, y, w, h);
          else if (lm === 5 && w >= 40) drawFrame(x, y, w, h);
          else drawRoof(x, y, w, h, hv >>> 2);
        }
      });
    }

    function fitText(text, maxW, size, weight) {
      let s = size;
      ctx.font = (weight || 'bold') + ' ' + s + 'px sans-serif';
      while (s > 6 && ctx.measureText(text).width > maxW) {
        s--;
        ctx.font = (weight || 'bold') + ' ' + s + 'px sans-serif';
      }
    }

    function panel(x, y, w, h, fill, stroke) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
      roundedRect(x - w / 2 + 3, y - h / 2 + 5, w, h, 4);
      ctx.fill();
      roundedRect(x - w / 2, y - h / 2, w, h, 4);
      ctx.fillStyle = fill;
      ctx.fill();
      ctx.strokeStyle = stroke;
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    // A road sign at the side of the road, with its post.
    function drawRoadSign(s) {
      const x = s.side < 0 ? 25 : 375;
      const y = s.y;
      ctx.fillStyle = '#6b6b6b';
      ctx.fillRect(x - 1.5, y + 10, 3, 24);
      ctx.textAlign = 'center';
      if (s.kind === 'speed') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
        ctx.beginPath();
        ctx.arc(x + 3, y + 5, 18, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(x, y, 18, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.strokeStyle = '#d62828';
        ctx.lineWidth = 5;
        ctx.stroke();
        ctx.fillStyle = '#111111';
        ctx.font = 'bold 14px sans-serif';
        ctx.fillText('120', x, y + 5);
      } else if (s.kind === 'camel' || s.kind === 'warn') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
        ctx.beginPath();
        ctx.moveTo(x + 3, y - 17);
        ctx.lineTo(x + 24, y + 19);
        ctx.lineTo(x - 18, y + 19);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(x, y - 20);
        ctx.lineTo(x + 21, y + 15);
        ctx.lineTo(x - 21, y + 15);
        ctx.closePath();
        ctx.fillStyle = '#ffd23f';
        ctx.fill();
        ctx.strokeStyle = '#d62828';
        ctx.lineWidth = 4;
        ctx.lineJoin = 'round';
        ctx.stroke();
        ctx.fillStyle = '#111111';
        if (s.kind === 'camel') {
          ctx.font = '15px sans-serif';
          ctx.fillText('\u{1F42A}', x, y + 10);
        } else {
          ctx.font = 'bold 18px sans-serif';
          ctx.fillText('!', x, y + 11);
        }
      } else if (s.kind === 'dest') {
        panel(x, y, 46, 38, '#1b7f4b', '#ffffff');
        ctx.fillStyle = '#ffffff';
        fitText(dest.name, 42, 9);
        ctx.fillText(dest.name, x, y - 8);
        fitText(dest.ar, 42, 8, '');
        ctx.fillText(dest.ar, x, y + 2);
        ctx.fillStyle = '#ffd23f';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText(s.km + ' km', x, y + 15);
      } else if (s.kind === 'tourist') {
        panel(x, y, 46, 34, '#7a4a21', '#ffffff');
        ctx.font = '13px sans-serif';
        ctx.fillStyle = '#ffffff';
        ctx.fillText('\u{1F3D9}️', x, y - 3);
        fitText(s.text, 42, 8);
        ctx.fillText(s.text, x, y + 11);
      } else if (s.kind === 'exit') {
        const flash = Math.floor(frameCount / 14) % 2 === 0;
        panel(x, y, 48, 40, '#1b7f4b', flash ? '#ffd23f' : '#ffffff');
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 13px sans-serif';
        ctx.fillText('EXIT ➡', x, y - 6);
        fitText(dest.name, 44, 8);
        ctx.fillText(dest.name, x, y + 5);
        ctx.fillStyle = '#ffd23f';
        ctx.font = 'bold 9px sans-serif';
        ctx.fillText(dest.kind === 'home' ? '\u{1F3E0}' : '\u{1F17F}️', x, y + 16);
      } else if (s.kind === 'home') {
        panel(x, y, 46, 34, '#1f5fa8', '#ffffff');
        ctx.fillStyle = '#ffffff';
        ctx.font = '14px sans-serif';
        ctx.fillText('\u{1F3E0}', x, y - 2);
        ctx.font = 'bold 10px sans-serif';
        ctx.fillText('Home • المنزل', x, y + 12);
      }
    }

    // A big green sign over the whole road
    function drawGantry(s) {
      const y = s.y;
      ctx.fillStyle = '#6b6b6b';
      ctx.fillRect(roadLeft - 12, y - 6, 6, 40);
      ctx.fillRect(roadRight + 6, y - 6, 6, 40);
      ctx.globalAlpha = 0.82;
      ctx.fillStyle = '#1b7f4b';
      ctx.fillRect(roadLeft - 12, y - 8, roadRight - roadLeft + 24, 26);
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.strokeRect(roadLeft - 10, y - 6, roadRight - roadLeft + 20, 22);
      ctx.globalAlpha = 1;
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 11px sans-serif';
      ctx.fillText('⬆ Dubai • دبي', W / 2 - 62, y + 9);
      fitText('⬆ ' + dest.name + ' ' + s.km + ' km', 130, 11);
      ctx.fillText('⬆ ' + dest.name + ' ' + s.km + ' km', W / 2 + 62, y + 9);
    }

    function drawDrive() {
      const css = getComputedStyle(document.documentElement);
      const sand = css.getPropertyValue('--sand').trim() || '#e6d5ab';
      const road = css.getPropertyValue('--road').trim() || '#555a60';
      drawSideCity(sand);
      // the road
      ctx.fillStyle = road;
      ctx.fillRect(roadLeft, 0, roadRight - roadLeft, H);
      ctx.strokeStyle = '#f2ecdf';
      ctx.lineWidth = 4;
      ctx.setLineDash([24, 24]);
      laneLines.forEach((line) => {
        ctx.beginPath();
        ctx.moveTo(W / 2, line.y);
        ctx.lineTo(W / 2, line.y + 24);
        ctx.stroke();
      });
      ctx.setLineDash([]);
      // kerbs
      ctx.fillStyle = '#c9c2b2';
      ctx.fillRect(roadLeft - 10, 0, 10, H);
      ctx.fillRect(roadRight, 0, 10, H);
      ctx.fillStyle = '#e8b923';
      laneLines.forEach((line) => {
        ctx.fillRect(roadLeft - 10, line.y, 10, 14);
        ctx.fillRect(roadRight, line.y, 10, 14);
      });
      signs.filter((s) => s.kind !== 'gantry').forEach(drawRoadSign);

      coins.forEach((coin) => drawCoin(coin.x, coin.y, coin.r));
      shields.forEach((sh) => drawShieldPickup(sh.x, sh.y, sh.r));
      if ((police || policeWarning()) && !gameOver) drawPoliceGlow();
      traffic.forEach((other) => drawCar(other.x, other.y, other.w, other.h, other.color, '#333'));
      if (police) drawPoliceCar(police.x, police.y, car.w, car.h);

      if (crashing) {
        ctx.save();
        ctx.translate(car.x, car.y);
        ctx.rotate(crashAngle);
        drawCar(0, 0, car.w, car.h, carColor, carOutline);
        ctx.restore();
        splashes.forEach((s) => {
          const p = s.age / 26;
          ctx.beginPath();
          ctx.arc(s.x, s.y, 6 + p * 34, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(200, 165, 100, ' + 0.7 * (1 - p) + ')';
          ctx.lineWidth = 4;
          ctx.stroke();
        });
      } else {
        drawCar(car.x, car.y, car.w, car.h, carColor, carOutline);
      }
      signs.filter((s) => s.kind === 'gantry').forEach(drawGantry);

      // the shield bubble
      if (shieldOn && !crashing && !gameOver) {
        ctx.beginPath();
        ctx.arc(car.x, car.y, 40 + Math.sin(frameCount / 8) * 2, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(41, 197, 246, 0.95)';
        ctx.lineWidth = 3;
        ctx.stroke();
      }
      if (shieldFlash > 0 && !gameOver) {
        const p = 1 - shieldFlash / 60;
        ctx.beginPath();
        ctx.arc(car.x, car.y, 40 + p * 50, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(41, 197, 246, ' + shieldFlash / 60 + ')';
        ctx.lineWidth = 4;
        ctx.stroke();
        ctx.fillStyle = 'rgba(41, 197, 246, ' + Math.min(1, shieldFlash / 20) + ')';
        ctx.font = 'bold 22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Shield saved you!', W / 2, 140);
      }

      // the trip bar at the top
      if (!gameOver) {
        const frac = Math.max(0, Math.min(1, travel / tripLen));
        ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
        roundedRect(50, 8, W - 100, 38, 14);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 13px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText((dest.kind === 'home' ? '\u{1F3E0} ' : '\u{1F6CD}️ ') + dest.name + ' • ' + Math.max(0, Math.ceil((tripLen - travel) / 700)) + ' km', W / 2, 26);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
        roundedRect(64, 33, W - 128, 7, 3.5);
        ctx.fill();
        ctx.fillStyle = dest.colour;
        if (frac > 0.02) {
          roundedRect(64, 33, (W - 128) * frac, 7, 3.5);
          ctx.fill();
        }
      }
      if (started && !gameOver && !arriving) {
        if (boosting && boostEnergy > 0) {
          ctx.fillStyle = 'rgba(255, 180, 0, 0.95)';
          ctx.font = 'bold 20px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('BOOST!', W / 2, 74);
        }
      }
      if (arriving) {
        ctx.fillStyle = 'rgba(0, 0, 0, ' + 0.5 * Math.max(0, 1 - arriveT / 90) + ')';
        ctx.fillRect(0, 0, W, H);
      }
    }

    // ---------- drawing: car parks and the buildings ----------
    function drawLot() {
      const css = getComputedStyle(document.documentElement);
      const road = css.getPropertyValue('--road').trim() || '#555a60';
      drawGarageWall();
      // the concrete floor of the car park
      ctx.fillStyle = '#8f9298';
      ctx.fillRect(0, 172, W, 30);
      ctx.fillStyle = '#e8b923';
      ctx.fillRect(0, 198, W, 4);
      ctx.fillStyle = '#5d6066';
      ctx.fillRect(0, 202, W, H - 202);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.08)';
      [[60, 480, 30], [310, 330, 22], [150, 560, 26], [340, 520, 18]].forEach(([ox, oy, r]) => {
        ctx.beginPath();
        ctx.ellipse(ox, oy, r, r * 0.5, 0, 0, Math.PI * 2);
        ctx.fill();
      });
      // bay lines and the cars parked in them
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.75)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 16; i++) {
        const r = bayRect(i);
        ctx.beginPath();
        ctx.moveTo(r.x, r.y);
        ctx.lineTo(r.x, r.y + r.h);
        ctx.moveTo(r.x + r.w, r.y);
        ctx.lineTo(r.x + r.w, r.y + r.h);
        ctx.moveTo(r.x, r.row === 0 ? r.y : r.y + r.h);
        ctx.lineTo(r.x + r.w, r.row === 0 ? r.y : r.y + r.h);
        ctx.stroke();
      }
      // a walkway to the door
      ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
      for (let y = 206; y < H - 10; y += 26) ctx.fillRect(194, y, 12, 14);
      bays.forEach((b, i) => {
        if (!b.occupied) return;
        const c = bayCentre(i);
        drawCar(c.x, c.y, 34, 58, b.colour, '#333');
      });
      // the bay you should park in
      if (phase === 'park' || phase === 'walk') {
        const r = bayRect(targetBay);
        const glow = 0.35 + 0.25 * Math.sin(frameCount / 8);
        if (phase === 'park') {
          ctx.fillStyle = 'rgba(61, 220, 132, ' + glow + ')';
          ctx.fillRect(r.x + 2, r.y + 2, r.w - 4, r.h - 4);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
          ctx.font = 'bold 22px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('P', r.x + r.w / 2, r.y + r.h / 2 + 8);
        }
      }
      // cars driving about in the car park
      if (phase === 'walk') {
        lotCars.forEach((c) => {
          ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
          ctx.fillRect(c.x - 26, c.y - 12, 54, 28);
          roundedRect(c.x - 28, c.y - 14, 56, 28, 7);
          ctx.fillStyle = c.colour;
          ctx.fill();
          ctx.fillStyle = 'rgba(30, 40, 55, 0.75)';
          ctx.fillRect(c.x + c.dir * 10 - 6, c.y - 10, 12, 20);
          ctx.fillStyle = '#ffe9a0';
          ctx.fillRect(c.x + c.dir * 27, c.y - 10, 2, 5);
          ctx.fillRect(c.x + c.dir * 27, c.y + 5, 2, 5);
        });
      }
      // your car (with its boot open while you pack)
      if (phase === 'start' || phase === 'park' || phase === 'walk' || phase === 'homedone') {
        drawCar(car.x, car.y, car.w, car.h, carColor, carOutline);
        if (phase === 'walk' && bootT > 0) {
          ctx.fillStyle = '#9b1c1c';
          ctx.fillRect(car.x - 14, car.y + car.h / 2, 28, 6);
        }
      }
      if (phase === 'park' && parked) {
        ctx.fillStyle = 'rgba(31, 191, 106, 0.95)';
        ctx.font = 'bold 20px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Parked! ✅', car.x, car.y - 40);
      }
      // you, walking
      if (phase === 'walk') {
        if (me.hurt <= 0 || Math.floor(me.hurt / 6) % 2 === 0) {
          ctx.save();
          ctx.translate(me.x, me.y);
          ctx.scale(1.7, 1.7);
          const lift = me.moving ? Math.abs(Math.sin(me.stepT * 0.45)) * 3 : 0;
          ctx.beginPath();
          ctx.arc(0, -lift, 5, 0, Math.PI * 2);
          ctx.fillStyle = '#d71920';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(0, -7 - lift, 3.5, 0, Math.PI * 2);
          ctx.fillStyle = '#f2c9a0';
          ctx.fill();
          ctx.restore();
        }
        // an arrow to the door
        const bob = Math.sin(frameCount / 8) * 4;
        ctx.fillStyle = '#fff3a0';
        ctx.beginPath();
        ctx.moveTo(192, 176 + bob);
        ctx.lineTo(208, 176 + bob);
        ctx.lineTo(200, 190 + bob);
        ctx.fill();
        if (nearCar && leg === 'out' && shopped && bootT <= 0) {
          ctx.fillStyle = 'rgba(31, 191, 106, 0.9)';
          ctx.font = 'bold 14px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('\u{1F697} Your car', Math.min(W - 46, Math.max(46, car.x)), car.y - 38);
        }
      }
    }

    function drawGarageLight() {
      // pools of light under the lamps, and darker corners: it is indoors
      [[70, 300], [200, 300], [330, 300], [70, 470], [200, 470], [330, 470]].forEach(([lx, ly]) => {
        const g = ctx.createRadialGradient(lx, ly, 4, lx, ly, 110);
        g.addColorStop(0, 'rgba(255, 250, 215, 0.16)');
        g.addColorStop(1, 'rgba(255, 250, 215, 0)');
        ctx.fillStyle = g;
        ctx.fillRect(lx - 110, ly - 110, 220, 220);
      });
      const v = ctx.createLinearGradient(0, 200, 0, H);
      v.addColorStop(0, 'rgba(0, 0, 0, 0)');
      v.addColorStop(1, 'rgba(0, 0, 0, 0.28)');
      ctx.fillStyle = v;
      ctx.fillRect(0, 200, W, H - 200);
    }

    // a person seen from the side, walking
    function drawShopper(x, y, look, scale, dir, moving, t, bag) {
      const [skin, shirt, pants] = look;
      const swing = moving ? Math.sin(t * 0.22) : 0;
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale * dir, scale);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.18)';
      ctx.beginPath();
      ctx.ellipse(0, 0, 15, 4, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = pants;
      ctx.lineWidth = 6;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(-3, -34);
      ctx.lineTo(-3 + swing * 9, -2);
      ctx.moveTo(4, -34);
      ctx.lineTo(4 - swing * 9, -2);
      ctx.stroke();
      roundedRect(-10, -66, 20, 34, 8);
      ctx.fillStyle = shirt;
      ctx.fill();
      ctx.strokeStyle = skin;
      ctx.lineWidth = 5;
      ctx.beginPath();
      ctx.moveTo(0, -62);
      ctx.lineTo(8 + swing * 3, -42);
      ctx.stroke();
      if (bag) {
        roundedRect(5 + swing * 3, -44, 13, 15, 2);
        ctx.fillStyle = '#c77dff';
        ctx.fill();
        ctx.strokeStyle = '#7b2cbf';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(8 + swing * 3, -44);
        ctx.lineTo(11 + swing * 3, -50);
        ctx.lineTo(15 + swing * 3, -44);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(0, -75, 9, 0, Math.PI * 2);
      ctx.fillStyle = skin;
      ctx.fill();
      ctx.fillStyle = '#2b2118';
      ctx.beginPath();
      ctx.arc(0, -78, 9, Math.PI, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawSitter(x, y, look) {
      const [skin, shirt, pants] = look;
      ctx.fillStyle = shirt;
      roundedRect(x - 9, y - 40, 18, 26, 7);
      ctx.fill();
      ctx.strokeStyle = pants;
      ctx.lineWidth = 7;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(x - 2, y - 14);
      ctx.lineTo(x + 14, y - 14);
      ctx.lineTo(x + 14, y + 2);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(x, y - 49, 8, 0, Math.PI * 2);
      ctx.fillStyle = skin;
      ctx.fill();
      ctx.fillStyle = '#2b2118';
      ctx.beginPath();
      ctx.arc(x, y - 52, 8, Math.PI, Math.PI * 2);
      ctx.fill();
    }

    function drawBench(x, y, sitter) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.16)';
      ctx.fillRect(x - 36, y - 2, 72, 7);
      ctx.fillStyle = '#7a5a3a';
      ctx.fillRect(x - 36, y - 22, 72, 6);
      ctx.fillRect(x - 36, y - 38, 72, 6);
      ctx.fillStyle = '#5b4026';
      ctx.fillRect(x - 33, y - 16, 5, 16);
      ctx.fillRect(x + 28, y - 16, 5, 16);
      if (sitter) drawSitter(x, y - 18, sitter);
    }

    function drawPlant(x, y) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
      ctx.beginPath();
      ctx.ellipse(x, y, 22, 6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#b86f3a';
      ctx.fillRect(x - 14, y - 26, 28, 26);
      ctx.fillStyle = '#8f5428';
      ctx.fillRect(x - 14, y - 26, 28, 5);
      ctx.strokeStyle = '#7a5a3a';
      ctx.lineWidth = 5;
      ctx.beginPath();
      ctx.moveTo(x, y - 26);
      ctx.lineTo(x, y - 90);
      ctx.stroke();
      ctx.strokeStyle = '#2f8a46';
      ctx.lineWidth = 6;
      ctx.lineCap = 'round';
      [-2.6, -2.1, -1.6, -1.1, -0.6].forEach((a) => {
        ctx.beginPath();
        ctx.moveTo(x, y - 90);
        ctx.quadraticCurveTo(x + Math.cos(a) * 22, y - 90 + Math.sin(a) * 18 - 6, x + Math.cos(a) * 36, y - 90 + Math.sin(a) * 6 + 22);
        ctx.stroke();
      });
    }

    // the escalator in the middle of the mall: moving steps going up (or down)
    function drawEscalator(up) {
      const x1 = 308;
      const y1 = 398;
      const x2 = 392;
      const y2 = 214;
      // the hall behind it
      ctx.fillStyle = '#e6e0d4';
      ctx.fillRect(300, 130, 100, 270);
      ctx.fillStyle = 'rgba(190, 225, 245, 0.55)';
      ctx.fillRect(306, 146, 88, 60);
      ctx.strokeStyle = '#8f877b';
      ctx.lineWidth = 3;
      ctx.strokeRect(306, 146, 88, 60);
      ctx.fillStyle = '#2b2230';
      ctx.fillRect(310, 218, 80, 22);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 11px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(up ? '⬆ UP • Level 1' : '⬇ DOWN • Ground', 350, 233);
      // the moving staircase
      ctx.save();
      const ang = Math.atan2(y2 - y1, x2 - x1);
      const len = Math.hypot(x2 - x1, y2 - y1);
      ctx.translate(x1, y1);
      ctx.rotate(ang);
      ctx.fillStyle = '#4a4f57';
      ctx.fillRect(0, -17, len, 34);
      const move = ((mallTime * 0.6) % 14) * (up ? 1 : -1);
      for (let s = -14; s < len + 14; s += 14) {
        const sx = s + move;
        if (sx < 0 || sx > len - 2) continue;
        ctx.fillStyle = '#9aa0a8';
        ctx.fillRect(sx, -16, 11, 32);
        ctx.fillStyle = '#d4d8dd';
        ctx.fillRect(sx, -16, 11, 3);
      }
      // the handrails
      ctx.fillStyle = '#1a1d22';
      ctx.fillRect(0, -23, len, 6);
      ctx.fillRect(0, 17, len, 6);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';
      ctx.fillRect(0, -22, len, 1.5);
      ctx.restore();
      ctx.fillStyle = '#c4baa6';
      ctx.fillRect(388, y2 - 24, 12, 10);
      ctx.fillRect(300, y1 - 2, 14, 8);
    }

    function drawMallStreet() {
      const cx = mallCamX;
      const upper = mallFloor === 1;
      ctx.fillStyle = '#efe9df';
      ctx.fillRect(0, 0, W, H);
      ctx.save();
      ctx.translate(-cx, 0);
      // the high ceiling with skylights
      const ceil = ctx.createLinearGradient(0, 0, 0, 128);
      ceil.addColorStop(0, upper ? '#e8dcc8' : '#d9d2c6');
      ceil.addColorStop(1, '#efe9df');
      ctx.fillStyle = ceil;
      ctx.fillRect(cx, 0, W, 130);
      for (let x = 20; x < mallWorldW; x += 130) {
        ctx.fillStyle = '#fffbe9';
        ctx.fillRect(x, 10, 90, 28);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
        ctx.fillRect(x, 10, 90, 5);
        ctx.fillStyle = '#b9b2a6';
        ctx.fillRect(x + 30, 10, 2, 28);
        ctx.fillRect(x + 60, 10, 2, 28);
        ctx.fillStyle = (x / 130) % 2 ? '#e63946' : '#2a9d8f';
        ctx.beginPath();
        ctx.moveTo(x + 22, 40);
        ctx.lineTo(x + 66, 40);
        ctx.lineTo(x + 44, 78);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 10px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText((x / 130) % 2 ? 'SALE' : 'WELCOME', x + 44, 56);
      }
      ctx.fillStyle = '#2b2230';
      roundedRect(10, 84, 120, 22, 8);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 12px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(upper ? 'UPPER FLOOR' : 'GROUND FLOOR', 20, 99);
      // the six shops on this floor
      for (let s = 0; s < 6; s++) {
        const sh = mallShopsData[mallShopIdx(s)];
        const x0 = mallSlotX[s];
        ctx.fillStyle = sh.wall;
        ctx.fillRect(x0, 130, 100, 270);
        ctx.fillStyle = '#2b2230';
        ctx.fillRect(x0 + 4, 134, 92, 32);
        ctx.fillStyle = sh.colour;
        ctx.fillRect(x0 + 4, 134, 92, 4);
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 13px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(sh.emoji + ' ' + sh.name, x0 + 50, 157);
        for (let k = 0; k < 6; k++) {
          ctx.fillStyle = k % 2 ? sh.colour : '#ffffff';
          ctx.fillRect(x0 + 4 + k * 15.3, 168, 15.3, 12);
        }
        ctx.fillStyle = '#d6edf9';
        ctx.fillRect(x0 + 8, 190, 84, 90);
        ctx.strokeStyle = '#8f877b';
        ctx.lineWidth = 2;
        ctx.strokeRect(x0 + 8, 190, 84, 90);
        ctx.font = '22px sans-serif';
        ctx.fillStyle = '#000000';
        ctx.fillText(sh.items[0][0], x0 + 28, 240);
        ctx.fillText(sh.items[1][0], x0 + 70, 240);
        ctx.fillText(sh.items[2][0], x0 + 50, 270);
        const dx = x0 + 50;
        ctx.fillStyle = '#6b5a48';
        ctx.fillRect(dx - 22, 290, 44, 110);
        const inside = ctx.createLinearGradient(0, 293, 0, 400);
        inside.addColorStop(0, sh.wall);
        inside.addColorStop(1, '#fff6e0');
        ctx.fillStyle = inside;
        ctx.fillRect(dx - 19, 293, 38, 107);
        ctx.fillStyle = '#e63946';
        roundedRect(dx - 17, 298, 34, 14, 4);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 10px sans-serif';
        ctx.fillText('OPEN', dx, 309);
        ctx.fillStyle = '#bdb5a8';
        ctx.fillRect(x0 - 2, 130, 4, 270);
      }
      drawEscalator(!upper);
      // the shiny floor
      const floor = ctx.createLinearGradient(0, 400, 0, H);
      floor.addColorStop(0, upper ? '#eadfce' : '#e6dfd3');
      floor.addColorStop(0.5, '#f2ece2');
      floor.addColorStop(1, '#d8d0c3');
      ctx.fillStyle = floor;
      ctx.fillRect(cx, 400, W, H - 400);
      ctx.strokeStyle = 'rgba(120, 110, 95, 0.16)';
      ctx.lineWidth = 1.5;
      [408, 426, 452, 486, 530, 586].forEach((y) => {
        ctx.beginPath();
        ctx.moveTo(cx, y);
        ctx.lineTo(cx + W, y);
        ctx.stroke();
      });
      const xc = cx + 200;
      for (let k = Math.floor((cx - 300) / 50); k < (cx + W + 300) / 50; k++) {
        ctx.beginPath();
        ctx.moveTo(k * 50, 400);
        ctx.lineTo(xc + (k * 50 - xc) * 2, H);
        ctx.stroke();
      }
      ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
      ctx.fillRect(cx, 550, W, 8);
      // the things on the floor: benches, plants, people and you
      const things = [];
      [100, 250, 450, 650].forEach((bx, i) => things.push({ y: 446, draw: () => drawBench(bx, 446, i % 2 ? shopperLook[(i + 1) % 6] : null) }));
      [20, 300, 400, 680].forEach((px) => things.push({ y: 440, draw: () => drawPlant(px, 440) }));
      mallShoppers.filter((s) => s.floor === mallFloor).forEach((s) => things.push({ y: s.y, draw: () => drawShopper(s.x, s.y, s.look, 0.8 + (s.y - 440) / 330, s.dir, s.v > 0 && s.pause <= 0, s.t, s.bag) }));
      if (!mallRide) things.push({ y: mm.y, draw: () => drawShopper(mm.x, mm.y, ['#f2c9a0', '#d71920', '#26344a'], 0.95 + (mm.y - 440) / 330, mm.dir, mm.moving, mm.stepT, mallBag.length > 0) });
      things.sort((a, b) => a.y - b.y).forEach((t) => t.draw());
      if (mallRide) {
        // riding the escalator
        const u = Math.min(1, mallRide.t / 90);
        const f = mallRide.dir > 0 ? u : 1 - u;
        const px = 316 + f * 70;
        const py = 392 - f * 168;
        drawShopper(px, py, ['#f2c9a0', '#d71920', '#26344a'], 0.7, 1, false, 0, mallBag.length > 0);
      }
      // hints
      const nd = nearMallDoor();
      if (nd >= 0 && !mallRide) {
        ctx.fillStyle = 'rgba(10, 18, 28, 0.82)';
        roundedRect(mallDoorX(nd) - 66, 262, 132, 26, 13);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F6AA} Tap the door to go in', mallDoorX(nd), 280);
      } else if (nearMallEsc() && !mallRide) {
        ctx.fillStyle = 'rgba(10, 18, 28, 0.82)';
        roundedRect(mallEscX - 70, 262, 140, 26, 13);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(upper ? '⬇ Tap to ride down' : '⬆ Tap to ride up', mallEscX, 280);
      }
      ctx.restore();
      if (mallRide && mallRide.t > 72) {
        ctx.fillStyle = 'rgba(255, 255, 255, ' + (mallRide.t - 72) / 18 + ')';
        ctx.fillRect(0, 0, W, H);
      }
    }

    // inside a shop: shelves, a counter, the shopkeeper and the things for sale
    function drawShopInside() {
      const sh = mallShopsData[mallShop];
      ctx.fillStyle = sh.wall;
      ctx.fillRect(0, 0, W, 360);
      ctx.fillStyle = sh.floor;
      ctx.fillRect(0, 360, W, H - 360);
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.1)';
      ctx.lineWidth = 1.5;
      for (let y = 370; y < H; y += 28) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(W, y);
        ctx.stroke();
      }
      ctx.fillStyle = '#fffbe9';
      for (let x = 50; x < W; x += 110) ctx.fillRect(x, 0, 60, 8);
      ctx.fillStyle = sh.colour;
      roundedRect(110, 78, 180, 34, 8);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 18px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(sh.emoji + ' ' + sh.name, 200, 102);
      [150, 210, 270].forEach((sy, r) => {
        ctx.fillStyle = '#8a6c4a';
        ctx.fillRect(70, sy + 22, 330, 6);
        ctx.font = '22px sans-serif';
        ctx.fillStyle = '#000000';
        for (let k = 0; k < 9; k++) ctx.fillText(sh.items[(k + r) % 3][0], 82 + k * 36, sy + 20);
      });
      // the exit door
      ctx.fillStyle = '#5a5046';
      ctx.fillRect(0, 170, 62, 240);
      ctx.fillStyle = '#fff6e0';
      ctx.fillRect(0, 178, 54, 232);
      ctx.fillStyle = '#2a9d5f';
      roundedRect(4, 146, 48, 22, 5);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 13px sans-serif';
      ctx.fillText('EXIT', 28, 162);
      // the counter and the shopkeeper
      ctx.fillStyle = '#6b4a2e';
      ctx.fillRect(296, 318, 104, 70);
      ctx.fillStyle = '#8f6a45';
      ctx.fillRect(296, 318, 104, 8);
      ctx.fillStyle = '#3a3f46';
      ctx.fillRect(330, 296, 30, 22);
      ctx.fillStyle = '#9be7a0';
      ctx.fillRect(334, 300, 22, 8);
      drawShopper(372, 322, ['#e0ac84', '#2a9d8f', '#3a3a4a'], 0.95, -1, false, mallTime, false);
      // the things for sale on stands
      for (let k = 0; k < 3; k++) {
        const [emoji, name, price] = sh.items[k];
        const x = mallShelfX[k];
        const bought = mallDone[mallShop][k];
        ctx.fillStyle = 'rgba(0, 0, 0, 0.16)';
        ctx.beginPath();
        ctx.ellipse(x, 442, 36, 8, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#d9d2c6';
        ctx.fillRect(x - 30, 380, 60, 60);
        ctx.fillStyle = '#b9b2a6';
        ctx.fillRect(x - 30, 380, 60, 8);
        ctx.globalAlpha = bought ? 0.25 : 1;
        ctx.font = '38px sans-serif';
        ctx.fillStyle = '#000000';
        ctx.textAlign = 'center';
        ctx.fillText(emoji, x, 376);
        ctx.globalAlpha = 1;
        ctx.fillStyle = bought ? '#52b788' : '#ffffff';
        roundedRect(x - 32, 400, 64, 28, 6);
        ctx.fill();
        ctx.strokeStyle = '#2a2a3a';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.fillStyle = bought ? '#ffffff' : '#2a2a3a';
        ctx.font = 'bold 10px sans-serif';
        ctx.fillText(bought ? '✅ sold' : name.length > 11 ? name.slice(0, 11) : name, x, 413);
        ctx.fillText(bought ? '' : '\u{1F4B0} ' + price, x, 425);
      }
      const things = [];
      mallShopFolk.forEach((p) => things.push({ y: p.y, draw: () => drawShopper(p.x, p.y, p.look, 0.9 + (p.y - 440) / 330, p.dir, p.v > 0 && p.pause <= 0, p.t, p.bag) }));
      things.push({ y: mm.y, draw: () => drawShopper(mm.x, mm.y, ['#f2c9a0', '#d71920', '#26344a'], 0.95 + (mm.y - 440) / 330, mm.dir, mm.moving, mm.stepT, mallBag.length > 0) });
      things.sort((a, b) => a.y - b.y).forEach((t) => t.draw());
      const nk = nearShelf();
      if (nk >= 0 && !mallDone[mallShop][nk]) {
        ctx.fillStyle = 'rgba(10, 18, 28, 0.85)';
        roundedRect(mallShelfX[nk] - 62, 330, 124, 24, 12);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Tap to buy ' + sh.items[nk][0] + ' \u{1F4B0}' + sh.items[nk][2], mallShelfX[nk], 346);
      }
    }

    function drawMall() {
      if (mallShop >= 0) drawShopInside();
      else drawMallStreet();
      // your coins and bags
      ctx.fillStyle = 'rgba(10, 18, 28, 0.7)';
      roundedRect(8, 44, 112, 28, 14);
      ctx.fill();
      ctx.fillStyle = '#ffd400';
      ctx.font = 'bold 13px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('\u{1F4B0} ' + mallWallet, 18, 63);
      ctx.fillStyle = '#ffffff';
      ctx.fillText('\u{1F6CD}️ ' + mallBag.length, 72, 63);
    }

    // ---------- the indoor car park ----------
    function drawGarageWall() {
      // the ceiling, with lights and pipes
      const ceil = ctx.createLinearGradient(0, 0, 0, 52);
      ceil.addColorStop(0, '#2a2d32');
      ceil.addColorStop(1, '#43474d');
      ctx.fillStyle = ceil;
      ctx.fillRect(0, 0, W, 52);
      ctx.fillStyle = '#6f757c';
      ctx.fillRect(0, 12, W, 4);
      ctx.fillRect(0, 22, W, 3);
      [30, 150, 270].forEach((x) => {
        ctx.fillStyle = 'rgba(255, 252, 225, 0.22)';
        ctx.beginPath();
        ctx.moveTo(x, 34);
        ctx.lineTo(x + 100, 34);
        ctx.lineTo(x + 130, 172);
        ctx.lineTo(x - 30, 172);
        ctx.fill();
        ctx.fillStyle = '#fffbe9';
        ctx.fillRect(x, 30, 100, 8);
      });
      // the back wall
      const wall = ctx.createLinearGradient(0, 52, 0, 172);
      wall.addColorStop(0, '#9a9ca2');
      wall.addColorStop(1, '#7b7e85');
      ctx.fillStyle = wall;
      ctx.fillRect(0, 52, W, 120);
      ctx.fillStyle = '#e8b923';
      for (let x = 0; x < W; x += 28) ctx.fillRect(x, 160, 14, 12);
      ctx.fillStyle = '#2b2b2b';
      for (let x = 14; x < W; x += 28) ctx.fillRect(x, 160, 14, 12);
      // concrete pillars
      [18, 110, 290, 382].forEach((x) => {
        ctx.fillStyle = '#b3b5ba';
        ctx.fillRect(x - 12, 52, 24, 120);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.14)';
        ctx.fillRect(x + 4, 52, 8, 120);
        ctx.fillStyle = '#e8b923';
        for (let y = 140; y < 172; y += 12) ctx.fillRect(x - 12, y, 24, 6);
      });
      // the sign and the lift doors
      roundedRect(128, 62, 144, 46, 8);
      ctx.fillStyle = lotKind === 'home' ? '#2d6a4f' : dest.colour;
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2.5;
      ctx.stroke();
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      if (lotKind === 'home') {
        ctx.font = 'bold 15px sans-serif';
        ctx.fillText('\u{1F3E0} MY HOME', 200, 82);
        ctx.font = '12px sans-serif';
        ctx.fillText('بيتي • Lift ⬆', 200, 99);
      } else {
        fitText(dest.name, 130, 15);
        ctx.fillText('\u{1F6CD}️ ' + dest.name, 200, 82);
        fitText(dest.ar, 130, 12, '');
        ctx.fillText(dest.ar + ' • Lift ⬆', 200, 99);
      }
      ctx.fillStyle = '#5b5f66';
      ctx.fillRect(166, 118, 68, 54);
      const metal = ctx.createLinearGradient(170, 0, 230, 0);
      metal.addColorStop(0, '#aeb4bb');
      metal.addColorStop(0.5, '#eef1f4');
      metal.addColorStop(1, '#aeb4bb');
      ctx.fillStyle = metal;
      ctx.fillRect(170, 122, 28, 50);
      ctx.fillRect(202, 122, 28, 50);
      ctx.fillStyle = '#2a9d5f';
      ctx.fillRect(196, 112, 8, 6);
      // signs on the wall
      ctx.fillStyle = '#1b7f4b';
      roundedRect(14, 66, 56, 22, 4);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 11px sans-serif';
      ctx.fillText('EXIT \u{1F3C3}', 42, 81);
      ctx.fillStyle = '#1f5fa8';
      roundedRect(330, 66, 56, 22, 4);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.fillText('\u{1F17F}️ Level 2', 358, 81);
    }

    // the boot of the car: the shopping bags go inside
    function drawBootPanel() {
      if (bootT <= 0) return;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
      ctx.fillRect(0, 0, W, H);
      const x = 40;
      const y = 150;
      // the open lid
      const lid = Math.min(1, bootT / 25);
      ctx.fillStyle = carColor;
      roundedRect(x + 10, y - 40 * lid, 300, 40 * lid + 6, 10);
      ctx.fill();
      ctx.fillStyle = '#2b2f35';
      roundedRect(x, y, 320, 220, 14);
      ctx.fill();
      ctx.fillStyle = '#3d424a';
      roundedRect(x + 12, y + 12, 296, 196, 10);
      ctx.fill();
      // the spare wheel
      ctx.beginPath();
      ctx.arc(x + 262, y + 62, 36, 0, Math.PI * 2);
      ctx.fillStyle = '#16181b';
      ctx.fill();
      ctx.beginPath();
      ctx.arc(x + 262, y + 62, 16, 0, Math.PI * 2);
      ctx.fillStyle = '#6b727b';
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 15px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('\u{1F9F3} Your boot', x + 160, y + 236 + 14);
      // the bags drop in one after another
      mallBag.forEach((emoji, i) => {
        const t0 = 30 + i * 14;
        const p = Math.max(0, Math.min(1, (bootT - t0) / 22));
        if (p <= 0) return;
        const col = i % 4;
        const row = Math.floor(i / 4);
        const rx = x + 40 + col * 46;
        const ry = y + 120 + row * 40;
        const ay = ry - (1 - p) * 120 - Math.sin(p * Math.PI) * 10;
        ctx.fillStyle = ['#c77dff', '#ff9f1c', '#2ec4b6', '#ef476f'][i % 4];
        roundedRect(rx - 16, ay - 18, 32, 36, 4);
        ctx.fill();
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.font = '18px sans-serif';
        ctx.fillStyle = '#000000';
        ctx.fillText(emoji, rx, ay + 6);
      });
      if (bootT > 30 + mallBag.length * 14 + 25) {
        ctx.fillStyle = '#8af0b4';
        ctx.font = 'bold 20px sans-serif';
        ctx.fillText('All packed! ✅', W / 2, 120);
      }
    }

    function drawMessage() {
      if (msgT <= 0) return;
      const a = Math.min(1, msgT / 30);
      ctx.fillStyle = 'rgba(10, 18, 28, ' + 0.8 * a + ')';
      roundedRect(W / 2 - 170, 84, 340, 30, 15);
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 255, 255, ' + a + ')';
      ctx.font = 'bold 13px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(msg, W / 2, 104);
    }

    function drawOverlay(title, subtitle, sub2) {
      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'white';
      ctx.textAlign = 'center';
      ctx.font = 'bold 30px sans-serif';
      ctx.fillText(title, W / 2, H / 2 - 16);
      ctx.font = '18px sans-serif';
      ctx.fillText(subtitle, W / 2, H / 2 + 20);
      if (sub2) {
        ctx.font = '14px sans-serif';
        ctx.fillText(sub2, W / 2, H / 2 + 48);
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      if (phase === 'drive') drawDrive();
      else if (phase === 'mall') drawMall();
      else {
        drawLot();
        drawGarageLight();
        drawBootPanel();
      }

      if (phase === 'park' || phase === 'walk' || phase === 'mall') {
        ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
        roundedRect(70, 8, W - 140, 30, 15);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText((dest.kind === 'home' ? '\u{1F3E0} ' : '\u{1F6CD}️ ') + dest.name, W / 2, 28);
      }
      if (levelFlash > 0 && started && !gameOver) {
        ctx.fillStyle = 'rgba(255, 196, 0, ' + Math.min(1, levelFlash / 20) + ')';
        ctx.font = 'bold 36px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Level ' + level + '!', W / 2, 150);
      }
      if (!gameOver) drawMessage();
      if (phase === 'start') {
        drawOverlay('Tap to start', 'Drive from your home to ' + dest.name, 'Follow the road signs!');
      } else if (gameOver) {
        drawOverlay('Crashed!', 'Tap to try again • Score: ' + score, 'Trips finished: ' + tripNo);
      } else if (phase === 'homedone') {
        drawOverlay('Home sweet home! \u{1F3E0}', 'Trip ' + (tripNo + 1) + ' done • Score: ' + score, 'Tap for your next trip');
      }
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    function boot(data) {
      if (data && typeof data.best === 'number' && data.best > best) {
        best = data.best;
        bestEl.textContent = 'Best: ' + best;
      }
      // the title screen: your car in its bay at home
      dest = malls[0];
      makeLot('home');
      const c = bayCentre(targetBay);
      car.x = c.x;
      car.y = c.y;
      draw();
      loop();
    }

    if (window.claude && window.claude.hot && window.claude.hot.snapshot) {
      window.claude.hot.snapshot(() => ({ best }));
    }

    if (window.claude && window.claude.hot && window.claude.hot.ready) {
      window.claude.hot.ready(boot);
    } else {
      boot(window.claude && window.claude.hot ? window.claude.hot.data : null);
    }
  })();
</script>
  </body>
</html>
