.fillRect(x - 24, y, 48, 7);\n        ctx.fillStyle = '#8d969e';\n        ctx.fillRect(x - 15, 0, 3, H);\n        ctx.fillRect(x + 12, 0, 3, H);\n        ctx.restore();\n        // railings\n        ctx.fillStyle = '#5b4026';\n        ctx.fillRect(x - 34, ev.top - 8, 3, ev.len + 16);\n        ctx.fillRect(x + 31, ev.top - 8, 3, ev.len + 16);\n        for (let y = ev.top; y \u003c= ev.top + ev.len; y += 25) {\n          ctx.fillRect(x - 36, y - 2, 7, 5);\n          ctx.fillRect(x + 29, y - 2, 7, 5);\n        }\n      });\n    }\n\n    // A tunnel through a hill. The hill covers everything beside the tracks;\n    // inside it is dark, with just a headlight glow around the engine.\n    // A wall of red bricks, in rows that are shifted like a real brick wall.\n    function drawBricks(x, y, w, h, colour) {\n      ctx.save();\n      ctx.beginPath();\n      ctx.rect(x, y, w, h);\n      ctx.clip();\n      ctx.fillStyle = colour;\n      ctx.fillRect(x, y, w, h);\n      const rowH = 12;\n      const brickW = 26;\n      ctx.strokeStyle = 'rgba(235, 215, 195, 0.55)';\n      ctx.lineWidth = 1.5;\n      ctx.beginPath();\n      for (let r = 0; r * rowH \u003c= h; r++) {\n        const ry = y + r * rowH;\n        ctx.moveTo(x, ry);\n        ctx.lineTo(x + w, ry);\n        const shift = r % 2 ? brickW / 2 : 0;\n        for (let bx = x - shift; bx \u003c x + w; bx += brickW) {\n          ctx.moveTo(bx, ry);\n          ctx.lineTo(bx, ry + rowH);\n        }\n      }\n      ctx.stroke();\n      // a few darker and lighter bricks so it does not look flat\n      for (let r = 0; r * rowH \u003c= h; r++) {\n        const shift = r % 2 ? brickW / 2 : 0;\n        for (let c = 0; c \u003c Math.ceil(w / brickW) + 1; c++) {\n          const n = (r * 7 + c * 13) % 9;\n          if (n > 2) continue;\n          ctx.fillStyle = n === 0 ? 'rgba(0, 0, 0, 0.14)' : n === 1 ? 'rgba(255, 255, 255, 0.10)' : 'rgba(60, 20, 10, 0.12)';\n          ctx.fillRect(x - shift + c * brickW + 1, y + r * rowH + 1, brickW - 2, rowH - 2);\n        }\n      }\n      ctx.restore();\n    }\n\n    function drawTunnel() {\n      const ev = eventInfo();\n      if (onGround() || onMono() || ev.kind !== 'tunnel' || ev.top > H || ev.top + ev.len \u003c 0) return;\n      const y0 = ev.top;\n      const bands = [[0, 50], [110, 170], [230, 290], [350, W]];\n      bands.forEach(([x0, x1]) => drawBricks(x0, y0, x1 - x0, ev.len, '#a8543b'));\n      // darkness over the three tracks, lit by the headlight\n      ctx.save();\n      ctx.beginPath();\n      laneX.forEach((x) => ctx.rect(x - 30, y0, 60, ev.len));\n      ctx.clip();\n      const ex = cars[0].x;\n      const grad = ctx.createRadialGradient(ex, engineY - 60, 30, ex, engineY - 60, 250);\n      grad.addColorStop(0, 'rgba(0, 0, 10, 0.25)');\n      grad.addColorStop(1, 'rgba(0, 0, 10, 0.78)');\n      ctx.fillStyle = grad;\n      ctx.fillRect(0, y0, W, ev.len);\n      ctx.restore();\n      // stone mouths at both ends (the tracks pass through the gaps)\n      [y0, y0 + ev.len - 22].forEach((y) => {\n        bands.forEach(([x0, x1]) => {\n          drawBricks(x0, y, x1 - x0, 22, '#8c4330');\n          ctx.fillStyle = '#b9b2a6';\n          ctx.fillRect(x0, y + 17, x1 - x0, 5);\n          ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';\n          ctx.fillRect(x0, y + 21, x1 - x0, 1);\n        });\n      });\n    }\n\n    function drawAnimal(o) {\n      if (o.scared) {\n        ctx.fillStyle = '#e63946';\n        ctx.font = 'bold 20px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('!', o.x, o.y - o.hh - 12);\n      }\n      const d = o.dir;\n      const swing = Math.sin(o.phase) * 3;\n      ctx.save();\n      ctx.translate(o.x, o.y);\n      // legs peeking out at the sides\n      ctx.fillStyle = '#3a2a20';\n      for (let i = 0; i \u003c 2; i++) {\n        const lx = (i === 0 ? -0.5 : 0.45) * o.hw;\n        ctx.fillRect(lx - 2 + swing * (i ? -1 : 1), -o.hh - 3, 4, 5);\n        ctx.fillRect(lx - 2 - swing * (i ? -1 : 1), o.hh - 2, 4, 5);\n      }\n      if (o.animal === 'cow') {\n        ctx.fillStyle = '#ffffff';\n        roundedRect(-o.hw, -o.hh, o.hw * 2, o.hh * 2, 8);\n        ctx.fill();\n        ctx.strokeStyle = '#555a60';\n        ctx.lineWidth = 1.5;\n        ctx.stroke();\n        ctx.fillStyle = '#2a2a2e';\n        ctx.beginPath();\n        ctx.ellipse(-d * 7, -3, 6, 4, 0.4, 0, Math.PI * 2);\n        ctx.ellipse(d * 2, 4, 5, 3.5, -0.3, 0, Math.PI * 2);\n        ctx.fill();\n        // tail\n        ctx.strokeStyle = '#2a2a2e';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.moveTo(-d * o.hw, 0);\n        ctx.lineTo(-d * (o.hw + 7), swing);\n        ctx.stroke();\n        // head\n        ctx.fillStyle = '#ffffff';\n        ctx.beginPath();\n        ctx.arc(d * (o.hw + 3), 0, 8, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n        ctx.fillStyle = '#f4a6b0';\n        ctx.beginPath();\n        ctx.arc(d * (o.hw + 8), 0, 4.5, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = '#d9c9a0';\n        ctx.fillRect(d * (o.hw + 1) - 1.5, -10, 3, 4);\n        ctx.fillRect(d * (o.hw + 1) - 1.5, 6, 3, 4);\n      } else {\n        ctx.fillStyle = '#f3efe2';\n        [[-9, -3], [0, -5], [9, -3], [-8, 4], [1, 5], [9, 4]].forEach(([bx, by]) => {\n          ctx.beginPath();\n          ctx.arc(bx * (o.hw / 12), by, 8, 0, Math.PI * 2);\n          ctx.fill();\n        });\n        ctx.strokeStyle = 'rgba(0, 0, 0, 0.25)';\n        ctx.lineWidth = 1;\n        ctx.beginPath();\n        ctx.arc(0, 0, o.hw - 3, 0, Math.PI * 2);\n        ctx.stroke();\n        ctx.fillStyle = '#3b3b40';\n        ctx.beginPath();\n        ctx.arc(d * (o.hw + 3), 0, 6, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillRect(d * (o.hw + 1) - 1.5, -9, 3, 4);\n        ctx.fillRect(d * (o.hw + 1) - 1.5, 5, 3, 4);\n      }\n      ctx.restore();\n    }\n\n    function drawRock(o) {\n      const r = 18;\n      ctx.beginPath();\n      for (let i = 0; i \u003c 8; i++) {\n        const a = (i / 8) * Math.PI * 2;\n        const rr = r * (0.82 + 0.28 * Math.abs(Math.sin(o.seed + i * 2.3)));\n        const px = o.x + Math.cos(a) * rr;\n        const py = o.y + Math.sin(a) * rr;\n        if (i === 0) ctx.moveTo(px, py);\n        else ctx.lineTo(px, py);\n      }\n      ctx.closePath();\n      ctx.fillStyle = '#6b6f76';\n      ctx.fill();\n      ctx.strokeStyle = '#3d4045';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.arc(o.x - 6, o.y - 6, 6, 0, Math.PI * 2);\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';\n      ctx.fill();\n    }\n\n    function drawBarrier(o) {\n      const x0 = o.x - 28;\n      ctx.fillStyle = '#ffffff';\n      ctx.fillRect(x0, o.y - 8, 56, 16);\n      ctx.fillStyle = '#ff8c1a';\n      for (let i = 0; i \u003c 4; i++) ctx.fillRect(x0 + i * 14 + 3, o.y - 8, 7, 16);\n      ctx.strokeStyle = '#7a4a10';\n      ctx.lineWidth = 2;\n      ctx.strokeRect(x0, o.y - 8, 56, 16);\n      ctx.fillStyle = '#4a4f55';\n      ctx.fillRect(x0 - 4, o.y - 12, 6, 24);\n      ctx.fillRect(x0 + 54, o.y - 12, 6, 24);\n    }\n\n    function roundedRect(x, y, w, h, r) {\n      ctx.beginPath();\n      ctx.moveTo(x + r, y);\n      ctx.arcTo(x + w, y, x + w, y + h, r);\n      ctx.arcTo(x + w, y + h, x, y + h, r);\n      ctx.arcTo(x, y + h, x, y, r);\n      ctx.arcTo(x, y, x + w, y, r);\n      ctx.closePath();\n    }\n\n    // A bullet train, drawn from above, nose pointing up: white and sleek,\n    // with a long pointed nose and a coloured stripe.\n    const whiteBody = ['#dfe6ec', '#ffffff', '#cfd8e0'];\n    const blueBody = ['#1a56b0', '#3d8bf0', '#164a96'];\n    const tramBody = ['#d97a12', '#ffa83d', '#c26a0c'];\n    const monoBody = ['#14296b', '#2c4fb0', '#0b1a45']; // dark blue\n    // your train takes the colour of the line you are on\n    const trainLook = {\n      red: { body: ['#c91f2e', '#ff5d62', '#9a1420'], dark: '#5e0b14', stripe: '#ff8a8e' },\n      green: { body: ['#17934f', '#4fdc8c', '#0f6a38'], dark: '#08411f', stripe: '#8af0b4' },\n      blue: { body: blueBody, dark: '#0d2f66', stripe: '#8fbcff' },\n      tram: { body: ['#8d96a1', '#ffffff', '#6f7882'], dark: '#4a525b', stripe: '#d7dee6' }, // shiny silver\n      monorail: { body: monoBody, dark: '#050d26', stripe: '#9db8ff' },\n    };\n    function drawEngine(stripe, outline, headlight, body) {\n      body = body || whiteBody;\n      ctx.beginPath();\n      ctx.moveTo(-16, 25);\n      ctx.lineTo(-16, -4);\n      ctx.bezierCurveTo(-16, -17, -8, -25, 0, -29);\n      ctx.bezierCurveTo(8, -25, 16, -17, 16, -4);\n      ctx.lineTo(16, 25);\n      ctx.closePath();\n      const g = ctx.createLinearGradient(-16, 0, 16, 0);\n      g.addColorStop(0, body[0]);\n      g.addColorStop(0.5, body[1]);\n      g.addColorStop(1, body[2]);\n      ctx.fillStyle = g;\n      ctx.fill();\n      ctx.strokeStyle = outline;\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      // stripe down each side\n      ctx.fillStyle = stripe;\n      ctx.fillRect(-15, -2, 4, 26);\n      ctx.fillRect(11, -2, 4, 26);\n      // windscreen\n      ctx.beginPath();\n      ctx.moveTo(-9, -8);\n      ctx.bezierCurveTo(-9, -15, -4, -20, 0, -22);\n      ctx.bezierCurveTo(4, -20, 9, -15, 9, -8);\n      ctx.closePath();\n      ctx.fillStyle = '#26323d';\n      ctx.fill();\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';\n      ctx.fillRect(-6, -13, 5, 2);\n      // roof stripe and vents\n      ctx.fillStyle = stripe;\n      ctx.fillRect(-2, -3, 4, 28);\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';\n      ctx.fillRect(-9, 8, 18, 3);\n      ctx.fillRect(-9, 15, 18, 3);\n      if (headlight) {\n        ctx.beginPath();\n        ctx.arc(0, -27, 3, 0, Math.PI * 2);\n        ctx.fillStyle = '#fff3a0';\n        ctx.fill();\n      }\n    }\n\n    function drawCarriage(stripe, outline, body) {\n      body = body || whiteBody;\n      roundedRect(-16, -22, 32, 44, 7);\n      const g = ctx.createLinearGradient(-16, 0, 16, 0);\n      g.addColorStop(0, body[0]);\n      g.addColorStop(0.5, body[1]);\n      g.addColorStop(1, body[2]);\n      ctx.fillStyle = g;\n      ctx.fill();\n      ctx.strokeStyle = outline;\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      ctx.fillStyle = stripe;\n      ctx.fillRect(-15, -20, 4, 40);\n      ctx.fillRect(11, -20, 4, 40);\n      ctx.fillRect(-2, -20, 4, 40);\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';\n      ctx.fillRect(-9, -12, 18, 3);\n      ctx.fillRect(-9, 9, 18, 3);\n    }\n\n    function drawOncoming(o) {\n      if (o.scared) {\n        ctx.fillStyle = '#e63946';\n        ctx.font = 'bold 22px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('!', o.x, o.y - o.hh - 18);\n      }\n      // an oncoming train: engine facing down, with a carriage behind it\n      ctx.save();\n      ctx.translate(o.x, o.y + 22);\n      ctx.rotate(Math.PI);\n      drawEngine('#e63946', '#3b4752', true);\n      ctx.restore();\n      ctx.save();\n      ctx.translate(o.x, o.y - 30);\n      drawCarriage('#e63946', '#3b4752');\n      ctx.restore();\n      ctx.beginPath();\n      ctx.arc(o.x, o.y + 50, 14, 0, Math.PI * 2);\n      ctx.fillStyle = 'rgba(255, 243, 160, 0.35)';\n      ctx.fill();\n    }\n\n    function drawShieldPickup(c) {\n      const pulse = 1 + 0.08 * Math.sin(frame * 0.12);\n      const g = ctx.createRadialGradient(c.x - 4, c.y - 4, 2, c.x, c.y, c.r * pulse);\n      g.addColorStop(0, 'rgba(210, 240, 255, 0.95)');\n      g.addColorStop(1, 'rgba(60, 150, 255, 0.85)');\n      ctx.beginPath();\n      ctx.arc(c.x, c.y, c.r * pulse, 0, Math.PI * 2);\n      ctx.fillStyle = g;\n      ctx.fill();\n      ctx.strokeStyle = '#ffffff';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      // little shield badge\n      ctx.beginPath();\n      ctx.moveTo(c.x - 7, c.y - 7);\n      ctx.lineTo(c.x + 7, c.y - 7);\n      ctx.lineTo(c.x + 7, c.y + 1);\n      ctx.quadraticCurveTo(c.x + 7, c.y + 8, c.x, c.y + 11);\n      ctx.quadraticCurveTo(c.x - 7, c.y + 8, c.x - 7, c.y + 1);\n      ctx.closePath();\n      ctx.fillStyle = '#1d4e89';\n      ctx.fill();\n    }\n\n    function drawShieldBubble() {\n      if (shieldTime \u003c= 0 || crashing) return;\n      if (shieldTime \u003c 120 && Math.floor(shieldTime / 6) % 2 === 0) return; // flicker when running out\n      const cx = (cars[0].x + cars[cars.length - 1].x) / 2;\n      const top = engineY - 30;\n      const bottom = carY(cars.length - 1) + 28;\n      const cy = (top + bottom) / 2;\n      const rx = 34 + Math.abs(cars[0].x - cars[cars.length - 1].x) / 2;\n      const ry = (bottom - top) / 2 + 4;\n      const pulse = 1 + 0.03 * Math.sin(frame * 0.2);\n      const g = ctx.createRadialGradient(cx, cy, ry * 0.3, cx, cy, ry * pulse);\n      g.addColorStop(0, 'rgba(120, 200, 255, 0.05)');\n      g.addColorStop(1, 'rgba(120, 200, 255, 0.4)');\n      ctx.save();\n      ctx.translate(cx, cy);\n      ctx.scale(rx / ry, 1);\n      ctx.beginPath();\n      ctx.arc(0, 0, ry * pulse, 0, Math.PI * 2);\n      ctx.restore();\n      ctx.fillStyle = g;\n      ctx.fill();\n      ctx.strokeStyle = 'rgba(190, 230, 255, 0.95)';\n      ctx.lineWidth = 3;\n      ctx.stroke();\n    }\n\n    function drawBoostEffects() {\n      if (boostTime \u003c= 0) return;\n      // speed lines\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';\n      ctx.lineWidth = 2;\n      for (let i = 0; i \u003c 14; i++) {\n        const x = (i * 97) % W;\n        const y = ((i * 131 + frame * 28) % (H + 80)) - 40;\n        ctx.beginPath();\n        ctx.moveTo(x, y);\n        ctx.lineTo(x, y + 36);\n        ctx.stroke();\n      }\n      // flame out of the back\n      const fx = cars[cars.length - 1].x;\n      const fy = carY(cars.length - 1) + 24;\n      const len = 26 + Math.random() * 14;\n      ctx.fillStyle = 'rgba(255, 140, 30, 0.9)';\n      ctx.beginPath();\n      ctx.moveTo(fx - 9, fy);\n      ctx.lineTo(fx + 9, fy);\n      ctx.lineTo(fx, fy + len);\n      ctx.closePath();\n      ctx.fill();\n      ctx.fillStyle = 'rgba(255, 235, 120, 0.95)';\n      ctx.beginPath();\n      ctx.moveTo(fx - 4, fy);\n      ctx.lineTo(fx + 4, fy);\n      ctx.lineTo(fx, fy + len * 0.55);\n      ctx.closePath();\n      ctx.fill();\n    }\n\n    // The \"next station\" information panel, like the screens inside the metro.\n    function drawStationPanel() {\n      if (!started || gameOver) return;\n      const doorsOpen = dwell > 0;\n      const k = doorsOpen ? doorK : nextStationK();\n      const line = lineOf();\n      const name = stationName(k);\n      const dist = doorsOpen ? 0 : Math.max(0, stationPassAt(k) - scrollTotal);\n      const arriving = !doorsOpen && dist \u003c 1100;\n      const x = 40;\n      const y = H - 52;\n      const w = W - 80;\n      const h = 42;\n      const flash = arriving && Math.floor(frame / 24) % 2 === 0;\n      roundedRect(x, y, w, h, 10);\n      ctx.fillStyle = doorsOpen ? 'rgba(20, 120, 70, 0.93)' : arriving ? (flash ? line.colour : line.dark) : 'rgba(16, 24, 38, 0.82)';\n      ctx.fill();\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n      ctx.lineWidth = 1.5;\n      ctx.stroke();\n      // red route line along the bottom: how far to the next station\n      const total = stationSpan;\n      const frac = doorsOpen ? Math.min(1, dwell / dwellTotal) : 1 - Math.min(1, dist / total);\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';\n      ctx.fillRect(x + 10, y + h - 7, w - 20, 3);\n      ctx.fillStyle = line.colour;\n      ctx.fillRect(x + 10, y + h - 7, (w - 20) * frac, 3);\n      ctx.beginPath();\n      ctx.arc(x + 10 + (w - 20) * frac, y + h - 5.5, 4, 0, Math.PI * 2);\n      ctx.fillStyle = '#ffffff';\n      ctx.fill();\n      const nameAr = stationNameAr(k);\n      // small words on top: English on the left, Arabic on the right\n      ctx.textAlign = 'left';\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';\n      ctx.font = 'bold 9px sans-serif';\n      ctx.fillText(doorsOpen ? 'DOORS OPEN \\u2022 ' + doorSide.toUpperCase() + ' SIDE ' + (doorSide === 'left' ? '\\u25C0' : '\\u25B6') + ' \\u2022 ' + Math.ceil(dwell / 60) + 's' : line.name.toUpperCase() + ' \\u2022 ' + (arriving ? 'ARRIVING' : k === terminusK ? 'FINAL STOP' : 'NEXT') + ' \\u2022 ' + Math.round(dist / 5) + ' m', x + 12, y + 13);\n      ctx.textAlign = 'right';\n      ctx.font = '11px sans-serif';\n      ctx.fillText(doorsOpen ? (doorSide === 'right' ? 'الأبواب على الجانب الأيمن' : 'الأبواب على الجانب الأيسر') : arriving ? 'نصل الآن' : 'المحطة القادمة', x + w - 12, y + 13);\n      // the station's name in English and in Arabic\n      ctx.fillStyle = '#ffffff';\n      ctx.textAlign = 'left';\n      let size = 17;\n      ctx.font = 'bold ' + size + 'px sans-serif';\n      while (size > 10 && ctx.measureText(name).width > w * 0.5) {\n        size--;\n        ctx.font = 'bold ' + size + 'px sans-serif';\n      }\n      ctx.fillText(name, x + 12, y + 30);\n      ctx.textAlign = 'right';\n      size = 17;\n      ctx.font = 'bold ' + size + 'px sans-serif';\n      while (size > 10 && ctx.measureText(nameAr).width > w * 0.42) {\n        size--;\n        ctx.font = 'bold ' + size + 'px sans-serif';\n      }\n      ctx.fillText(nameAr, x + w - 12, y + 30);\n    }\n\n    // The line map: every station of the line you are on, the ones you have\n    // stopped at ticked, a little train showing where you are, and the\n    // interchanges where you can change to the other line.\n    function drawMapOverlay() {\n      if (!mapOpen) return;\n      const line = lineOf();\n      const names = line.names.concat([line.end.name]); // the last station comes at the end\n      const ars = line.ar.concat([line.end.ar]);\n      const total = names.length;\n      const endIdx = total - 1;\n      const x0 = 30;\n      const y0 = 24;\n      const w = W - 60;\n      const h = H - 36;\n      roundedRect(x0, y0, w, h, 16);\n      ctx.fillStyle = 'rgba(12, 18, 30, 0.95)';\n      ctx.fill();\n      ctx.strokeStyle = line.colour;\n      ctx.lineWidth = 3;\n      ctx.stroke();\n      ctx.fillStyle = '#ffffff';\n      ctx.textAlign = 'center';\n      ctx.font = 'bold 19px sans-serif';\n      ctx.fillText(line.name.toUpperCase() + ' MAP', W / 2, y0 + 30);\n      ctx.font = '14px sans-serif';\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';\n      ctx.fillText(line.nameAr, W / 2, y0 + 50);\n\n      const lineX = x0 + 44;\n      const top = y0 + 86;\n      const gap = (h - 178) / (total - 1);\n      const yOf = (i) => top + i * gap;\n      const nextIdx = nextStationK() === terminusK ? endIdx : lineIndexAt(nextStationK());\n      // the track between the stations\n      for (let i = 0; i \u003c total - 1; i++) {\n        ctx.beginPath();\n        ctx.moveTo(lineX, yOf(i));\n        ctx.lineTo(lineX, yOf(i + 1));\n        ctx.lineWidth = 6;\n        ctx.strokeStyle = ridden.includes(i) && ridden.includes(i + 1) ? line.colour : 'rgba(255, 255, 255, 0.25)';\n        ctx.stroke();\n      }\n      // the stations\n      for (let i = 0; i \u003c total; i++) {\n        const y = yOf(i);\n        const passed = i === endIdx ? won : ridden.includes(i);\n        const isNext = i === nextIdx;\n        const otherKey = i \u003c endIdx ? lineWith(names[i]) : null;\n        const other = otherKey ? metroLines[otherKey] : null;\n        const change = other !== null;\n        ctx.beginPath();\n        ctx.arc(lineX, y, isNext ? 11 : 9, 0, Math.PI * 2);\n        ctx.fillStyle = passed ? line.colour : isNext ? '#ffffff' : 'rgba(12, 18, 30, 1)';\n        ctx.fill();\n        ctx.lineWidth = isNext ? 4 : 3;\n        ctx.strokeStyle = passed ? '#ffffff' : isNext ? line.colour : change ? other.colour : 'rgba(255, 255, 255, 0.45)';\n        ctx.stroke();\n        if (passed) {\n          ctx.beginPath();\n          ctx.moveTo(lineX - 4, y);\n          ctx.lineTo(lineX - 1, y + 3.5);\n          ctx.lineTo(lineX + 5, y - 3.5);\n          ctx.lineWidth = 2.2;\n          ctx.strokeStyle = '#ffffff';\n          ctx.stroke();\n        }\n        ctx.textAlign = 'left';\n        ctx.fillStyle = passed ? '#ffffff' : isNext ? '#ffe066' : 'rgba(255, 255, 255, 0.6)';\n        ctx.font = (isNext || passed ? 'bold ' : '') + '15px sans-serif';\n        ctx.fillText(names[i], lineX + 24, y + (change ? 1 : 5));\n        ctx.textAlign = 'right';\n        ctx.font = '13px sans-serif';\n        ctx.fillText(ars[i], x0 + w - 18, y + 5);\n        if (change) {\n          ctx.textAlign = 'left';\n          ctx.fillStyle = other.colour;\n          ctx.font = 'bold 10px sans-serif';\n          ctx.fillText('\\u21C4 Change for ' + other.name, lineX + 24, y + 14);\n        }\n        if (isNext) {\n          ctx.textAlign = 'left';\n          ctx.fillStyle = '#ffe066';\n          ctx.font = 'bold 9px sans-serif';\n          ctx.fillText(i === endIdx ? 'FINAL STOP' : 'NEXT STOP', lineX + 24, y - 10);\n        } else if (i === endIdx) {\n          ctx.textAlign = 'left';\n          ctx.fillStyle = '#ffe066';\n          ctx.font = 'bold 10px sans-serif';\n          ctx.fillText('\\u{1F3C1} End of the line \\u2022 reach level ' + finalLevel, lineX + 24, y + 14);\n        }\n      }\n      // where the train is right now\n      const toStop = stationPassAt(nextStationK()) - scrollTotal;\n      const frac = Math.min(1, Math.max(0, toStop / stationSpan));\n      const P = nextStationK() === terminusK ? endIdx - frac : lineIndexAt(lastStoppedK) + 1 - frac;\n      const pos = Math.min(total - 0.5, Math.max(-0.4, P));\n      const ty = top + pos * gap;\n      roundedRect(lineX - 17, ty - 9, 34, 18, 9);\n      ctx.fillStyle = '#1f6fd6';\n      ctx.fill();\n      ctx.strokeStyle = '#ffffff';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      ctx.fillStyle = '#ffffff';\n      ctx.font = '12px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('\\u{1F684}', lineX, ty + 4.5);\n      // summary\n      ctx.fillStyle = '#ffffff';\n      ctx.textAlign = 'center';\n      ctx.font = 'bold 15px sans-serif';\n      ctx.fillText('Stations: ' + (lastStoppedK + 1) + '  \\u2022  Delivered: ' + delivered + '  \\u2022  On board: ' + onboard.length, W / 2, y0 + h - 34);\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';\n      ctx.font = '12px sans-serif';\n      ctx.fillText('Tap anywhere to carry on', W / 2, y0 + h - 14);\n    }\n\n    function drawSpeedometer() {\n      const cx = W - 50;\n      const cy = 52;\n      const r = 40;\n      const a0 = Math.PI * 0.75;\n      const a1 = Math.PI * 2.25;\n      const frac = Math.min(1, shownMph / mphMax);\n      ctx.beginPath();\n      ctx.arc(cx, cy, r + 4, 0, Math.PI * 2);\n      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';\n      ctx.fill();\n      // dial track\n      ctx.lineCap = 'round';\n      ctx.lineWidth = 6;\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';\n      ctx.beginPath();\n      ctx.arc(cx, cy, r - 5, a0, a1);\n      ctx.stroke();\n      // coloured part: green when slow, red when really fast\n      if (frac > 0.005) {\n        ctx.strokeStyle = 'hsl(' + Math.round(130 - frac * 130) + ', 85%, 55%)';\n        ctx.beginPath();\n        ctx.arc(cx, cy, r - 5, a0, a0 + (a1 - a0) * frac);\n        ctx.stroke();\n      }\n      ctx.lineCap = 'butt';\n      // tick marks every 100 mph\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n      ctx.lineWidth = 2;\n      for (let m = 0; m \u003c= mphMax; m += 100) {\n        const a = a0 + (a1 - a0) * (m / mphMax);\n        ctx.beginPath();\n        ctx.moveTo(cx + Math.cos(a) * (r - 14), cy + Math.sin(a) * (r - 14));\n        ctx.lineTo(cx + Math.cos(a) * (r - 9), cy + Math.sin(a) * (r - 9));\n        ctx.stroke();\n      }\n      // needle\n      const na = a0 + (a1 - a0) * frac;\n      ctx.strokeStyle = '#ff5a4a';\n      ctx.lineWidth = 3;\n      ctx.beginPath();\n      ctx.moveTo(cx, cy);\n      ctx.lineTo(cx + Math.cos(na) * (r - 12), cy + Math.sin(na) * (r - 12));\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.arc(cx, cy, 4, 0, Math.PI * 2);\n      ctx.fillStyle = '#ffffff';\n      ctx.fill();\n      // numbers\n      ctx.fillStyle = '#ffffff';\n      ctx.textAlign = 'center';\n      ctx.font = 'bold 15px sans-serif';\n      ctx.fillText(String(Math.round(shownMph)), cx, cy + 22);\n      ctx.font = '10px sans-serif';\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';\n      ctx.fillText('mph', cx, cy + 33);\n      // kilometres per hour too, in a little label under the dial\n      const kmh = Math.round(shownMph * 1.60934) + ' km/h';\n      ctx.font = 'bold 12px sans-serif';\n      const kw = ctx.measureText(kmh).width + 16;\n      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';\n      roundedRect(cx - kw / 2, cy + r + 8, kw, 19, 9.5);\n      ctx.fill();\n      ctx.fillStyle = '#ffffff';\n      ctx.textAlign = 'center';\n      ctx.fillText(kmh, cx, cy + r + 22);\n    }\n\n    function drawStorm() {\n      if (rainAmt > 0.01) {\n        // gloomy sky\n        ctx.fillStyle = 'rgba(14, 24, 48, ' + 0.3 * rainAmt + ')';\n        ctx.fillRect(0, 0, W, H);\n        // rain\n        ctx.strokeStyle = 'rgba(205, 225, 255, 0.55)';\n        ctx.lineWidth = 1.5;\n        ctx.beginPath();\n        const n = Math.floor(drops.length * rainAmt);\n        for (let i = 0; i \u003c n; i++) {\n          const d = drops[i];\n          ctx.moveTo(d.x, d.y);\n          ctx.lineTo(d.x + d.len * 0.28, d.y - d.len);\n        }\n        ctx.stroke();\n      }\n      if (flash > 0.02) {\n        if (bolt && flash > 0.3) {\n          ctx.lineJoin = 'round';\n          ctx.strokeStyle = 'rgba(200, 220, 255, ' + flash * 0.5 + ')';\n          ctx.lineWidth = 9;\n          ctx.beginPath();\n          bolt.forEach(([bx, by], i) => (i ? ctx.lineTo(bx, by) : ctx.moveTo(bx, by)));\n          ctx.stroke();\n          ctx.strokeStyle = 'rgba(255, 255, 255, ' + Math.min(1, flash * 1.2) + ')';\n          ctx.lineWidth = 3;\n          ctx.stroke();\n        }\n        ctx.fillStyle = 'rgba(235, 240, 255, ' + 0.5 * flash + ')';\n        ctx.fillRect(0, 0, W, H);\n      }\n    }\n\n    function drawPerson(x, y, colour, hop) {\n      const lift = Math.abs(Math.sin(hop)) * 3;\n      ctx.beginPath();\n      ctx.arc(x, y - lift, 5, 0, Math.PI * 2);\n      ctx.fillStyle = colour;\n      ctx.fill();\n      ctx.beginPath();\n      ctx.arc(x, y - 7 - lift, 3.5, 0, Math.PI * 2);\n      ctx.fillStyle = '#f2c9a0';\n      ctx.fill();\n    }\n\n    function drawBoarding() {\n      boarding.forEach((p) => drawPerson(p.x, p.y, p.colour, p.delay > 0 ? 0 : p.hop));\n      alighting.forEach((p) => {\n        if (p.delay > 0) return; // still inside the train\n        ctx.globalAlpha = Math.max(0, 1 - p.fade / 22);\n        drawPerson(p.x, p.y, p.colour, p.hop);\n        ctx.globalAlpha = 1;\n      });\n    }\n\n    function drawFloaters() {\n      floaters.forEach((f) => {\n        const a = 1 - f.age / (f.text && f.text.length > 4 ? 90 : 45);\n        ctx.fillStyle = f.text && f.text.length > 4 ? 'rgba(255, 110, 90, ' + a + ')' : 'rgba(255, 240, 120, ' + a + ')';\n        ctx.font = 'bold ' + (f.text && f.text.length > 4 ? 18 : 16) + 'px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText(f.text || '+1', f.x, f.y - f.age * (f.text && f.text.length > 4 ? 0.3 : 0.6));\n      });\n    }\n\n    function drawPassengerPill() {\n      if (!started || gameOver) return;\n      const label = '\\u{1F465} ' + onboard.length + (dwell > 0 ? '   \\u2B07' + offHere + ' \\u2B06' + onHere : '');\n      ctx.font = 'bold 14px sans-serif';\n      const w = ctx.measureText(label).width + 20;\n      ctx.fillStyle = 'rgba(10, 18, 28, 0.6)';\n      roundedRect(10, 38, w, 24, 12);\n      ctx.fill();\n      ctx.fillStyle = '#ffffff';\n      ctx.textAlign = 'left';\n      ctx.fillText(label, 20, 55);\n    }\n\n    function drawChances() {\n      if (!started || gameOver) return;\n      const label = '\\u2764\\uFE0F'.repeat(chances) + '\\u{1F90D}'.repeat(maxChances - chances);\n      ctx.font = '14px sans-serif';\n      const w = ctx.measureText(label).width + 20;\n      ctx.fillStyle = 'rgba(10, 18, 28, 0.6)';\n      roundedRect(10, 68, w, 24, 12);\n      ctx.fill();\n      ctx.textAlign = 'left';\n      ctx.fillStyle = '#ffffff';\n      ctx.fillText(label, 20, 85);\n    }\n\n    function drawHurtGlow() {\n      if (hurtTime \u003c= 0 || crashing) return;\n      const cx = (cars[0].x + cars[cars.length - 1].x) / 2;\n      const top = engineY - 30;\n      const bottom = carY(cars.length - 1) + 28;\n      const cy = (top + bottom) / 2;\n      const rx = 30 + Math.abs(cars[0].x - cars[cars.length - 1].x) / 2;\n      const a = 0.35 + 0.35 * Math.abs(Math.sin(frame * 0.25));\n      ctx.beginPath();\n      ctx.ellipse(cx, cy, rx, (bottom - top) / 2 + 4, 0, 0, Math.PI * 2);\n      ctx.strokeStyle = 'rgba(255, 120, 80, ' + a + ')';\n      ctx.lineWidth = 4;\n      ctx.stroke();\n    }\n\n    function drawShieldHud() {\n      if (shieldTime \u003c= 0 || !started || gameOver) return;\n      const w = 90;\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';\n      roundedRect(10, 10, w + 36, 22, 11);\n      ctx.fill();\n      ctx.fillStyle = '#55b6ff';\n      roundedRect(32, 16, Math.max(2, w * (shieldTime / shieldDuration)), 10, 5);\n      ctx.fill();\n      ctx.font = '14px sans-serif';\n      ctx.textAlign = 'left';\n      ctx.fillStyle = 'white';\n      ctx.fillText('🛡️', 14, 27);\n    }\n\n    function drawCoin(c) {\n      if (c.kind === 'shield') return drawShieldPickup(c);\n      ctx.beginPath();\n      ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);\n      ctx.fillStyle = '#ffd400';\n      ctx.fill();\n      ctx.strokeStyle = '#b8860b';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.arc(c.x, c.y, c.r - 4, 0, Math.PI * 2);\n      ctx.strokeStyle = '#fff3b0';\n      ctx.stroke();\n    }\n\n    function drawTrain() {\n      const t = crashing || (gameOver && crashT > 0) ? crashT : 0;\n      // carriages first, so the engine sits on top\n      for (let i = cars.length - 1; i >= 0; i--) {\n        const c = cars[i];\n        const x = c.x + crashDir * t * i * 20;\n        const y = carY(i);\n        const angle = crashDir * t * (0.3 + 0.3 * i);\n        ctx.save();\n        ctx.translate(x, y);\n        ctx.rotate(angle);\n        const onTram = currentLine === 'tram';\n        const onMonoLine = currentLine === 'monorail';\n        const look = trainLook[currentLine] || trainLook.red;\n        if (i === 0) drawEngine(look.stripe, look.dark, true, look.body);\n        else drawCarriage(look.stripe, look.dark, look.body);\n        if (onTram) {\n          // a bright shiny streak down the silver tram\n          ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';\n          ctx.fillRect(-10, i === 0 ? -20 : -24, 3, i === 0 ? 44 : 48);\n          ctx.fillStyle = 'rgba(40, 50, 60, 0.18)';\n          ctx.fillRect(7, i === 0 ? -14 : -24, 3, i === 0 ? 38 : 48);\n        }\n        if (dwell > 0 && !crashing) {\n          // open doors: bright green door panels on the platform side\n          const sx = doorSide === 'left' ? -1 : 1;\n          ctx.fillStyle = '#3ddc84';\n          ctx.strokeStyle = '#146b3a';\n          ctx.lineWidth = 1;\n          [-9, 5].forEach((dy) => {\n            ctx.fillRect(sx * 16 - 2, dy, 4, 10);\n            ctx.strokeRect(sx * 16 - 2, dy, 4, 10);\n          });\n        }\n        ctx.restore();\n      }\n    }\n\n    function drawEffects() {\n      puffs.forEach((p) => {\n        const a = p.age / 40;\n        ctx.beginPath();\n        ctx.arc(p.x, p.y + p.age * 2.4, 5 + a * 12, 0, Math.PI * 2);\n        ctx.fillStyle = 'rgba(245, 245, 245, ' + 0.55 * (1 - a) + ')';\n        ctx.fill();\n      });\n      rings.forEach((r) => {\n        const a = r.age / 40;\n        ctx.beginPath();\n        ctx.arc(r.x, r.y, 6 + a * 34, 0, Math.PI * 2);\n        ctx.strokeStyle = 'rgba(255, 255, 255, ' + 0.8 * (1 - a) + ')';\n        ctx.lineWidth = 3;\n        ctx.stroke();\n      });\n    }\n\n    // Night: everything goes dark except a glow from the headlight, with\n    // little lights on the engine and carriages.\n    function drawNight() {\n      const ex = cars[0].x;\n      const grad = ctx.createRadialGradient(ex, engineY - 90, 40, ex, engineY - 90, 330);\n      grad.addColorStop(0, 'rgba(8, 12, 45, 0.15)');\n      grad.addColorStop(1, 'rgba(8, 12, 45, 0.7)');\n      ctx.fillStyle = grad;\n      ctx.fillRect(0, 0, W, H);\n      // headlight beam\n      const beam = ctx.createLinearGradient(0, engineY - 20, 0, engineY - 190);\n      beam.addColorStop(0, 'rgba(255, 244, 180, 0.35)');\n      beam.addColorStop(1, 'rgba(255, 244, 180, 0)');\n      ctx.fillStyle = beam;\n      ctx.beginPath();\n      ctx.moveTo(ex - 8, engineY - 22);\n      ctx.lineTo(ex + 8, engineY - 22);\n      ctx.lineTo(ex + 34, engineY - 190);\n      ctx.lineTo(ex - 34, engineY - 190);\n      ctx.closePath();\n      ctx.fill();\n      // little yellow window lights on the carriages\n      ctx.fillStyle = 'rgba(255, 230, 120, 0.9)';\n      for (let i = 1; i \u003c cars.length; i++) {\n        const cx = cars[i].x;\n        const cy = carY(i);\n        ctx.fillRect(cx - 7, cy - 10, 5, 5);\n        ctx.fillRect(cx + 2, cy - 10, 5, 5);\n        ctx.fillRect(cx - 7, cy + 3, 5, 5);\n        ctx.fillRect(cx + 2, cy + 3, 5, 5);\n      }\n    }\n\n    // A shiny gold trophy cup with the level number on it.\n    function drawTrophy(cx, cy, size, label, shine) {\n      const g = ctx.createLinearGradient(cx - size * 0.5, 0, cx + size * 0.5, 0);\n      g.addColorStop(0, '#c99a1e');\n      g.addColorStop(0.45, '#ffe066');\n      g.addColorStop(1, '#b8860b');\n      ctx.save();\n      ctx.strokeStyle = '#d9a920';\n      ctx.lineWidth = size * 0.09;\n      [-1, 1].forEach((side) => {\n        ctx.beginPath();\n        ctx.arc(cx + side * size * 0.52, cy - size * 0.22, size * 0.2, side > 0 ? -Math.PI / 2 : Math.PI / 2, side > 0 ? Math.PI / 2 : Math.PI * 1.5, false);\n        ctx.stroke();\n      });\n      ctx.fillStyle = g;\n      ctx.beginPath();\n      ctx.moveTo(cx - size * 0.5, cy - size * 0.5);\n      ctx.lineTo(cx + size * 0.5, cy - size * 0.5);\n      ctx.bezierCurveTo(cx + size * 0.5, cy + size * 0.05, cx + size * 0.25, cy + size * 0.3, cx, cy + size * 0.3);\n      ctx.bezierCurveTo(cx - size * 0.25, cy + size * 0.3, cx - size * 0.5, cy + size * 0.05, cx - size * 0.5, cy - size * 0.5);\n      ctx.closePath();\n      ctx.fill();\n      ctx.strokeStyle = '#8a6508';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      ctx.fillRect(cx - size * 0.09, cy + size * 0.28, size * 0.18, size * 0.28);\n      ctx.fillStyle = '#b8860b';\n      ctx.fillRect(cx - size * 0.4, cy + size * 0.54, size * 0.8, size * 0.14);\n      ctx.fillStyle = '#6b4a06';\n      ctx.fillRect(cx - size * 0.3, cy + size * 0.68, size * 0.6, size * 0.1);\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';\n      ctx.fillRect(cx - size * 0.38, cy - size * 0.42, size * 0.1, size * 0.4);\n      if (label !== undefined) {\n        ctx.fillStyle = '#6b4a06';\n        ctx.textAlign = 'center';\n        ctx.font = 'bold ' + Math.round(size * 0.42) + 'px sans-serif';\n        ctx.fillText(String(label), cx, cy - size * 0.1);\n      }\n      if (shine) {\n        // twinkling stars around it\n        ctx.fillStyle = '#fff6b0';\n        for (let i = 0; i \u003c 5; i++) {\n          const a = frame * 0.05 + i * 1.26;\n          const sx = cx + Math.cos(a) * size * 0.85;\n          const sy = cy - size * 0.1 + Math.sin(a * 1.3) * size * 0.7;\n          const r = 2 + 2 * Math.abs(Math.sin(frame * 0.12 + i));\n          ctx.beginPath();\n          ctx.moveTo(sx, sy - r * 2);\n          ctx.lineTo(sx + r * 0.6, sy - r * 0.6);\n          ctx.lineTo(sx + r * 2, sy);\n          ctx.lineTo(sx + r * 0.6, sy + r * 0.6);\n          ctx.lineTo(sx, sy + r * 2);\n          ctx.lineTo(sx - r * 0.6, sy + r * 0.6);\n          ctx.lineTo(sx - r * 2, sy);\n          ctx.lineTo(sx - r * 0.6, sy - r * 0.6);\n          ctx.closePath();\n          ctx.fill();\n        }\n      }\n      ctx.restore();\n    }\n\n    // A medal on a ribbon: red or green for the lines, gold with a star for Metro Master.\n    function drawMedal(cx, cy, r, kind, earned, shine) {\n      const colour = kind === 'green' ? '#00a04a' : kind === 'blue' ? '#0a6ed1' : kind === 'tram' ? '#f28c28' : kind === 'monorail' ? '#8e44ad' : kind === 'master' ? '#2a2a3a' : '#e21836';\n      const ribbon = kind === 'green' ? '#007a38' : kind === 'blue' ? '#064a8f' : kind === 'tram' ? '#a85a0e' : kind === 'monorail' ? '#5b2c6f' : kind === 'master' ? '#c99a1e' : '#a8112a';\n      ctx.save();\n      if (!earned) ctx.globalAlpha = 0.3;\n      // ribbon\n      ctx.fillStyle = ribbon;\n      [-1, 1].forEach((side) => {\n        ctx.beginPath();\n        ctx.moveTo(cx + side * r * 0.95, cy - r * 1.9);\n        ctx.lineTo(cx + side * r * 0.35, cy - r * 1.9);\n        ctx.lineTo(cx - side * r * 0.2, cy - r * 0.3);\n        ctx.lineTo(cx + side * r * 0.4, cy - r * 0.3);\n        ctx.closePath();\n        ctx.fill();\n      });\n      // the medal itself\n      const rim = ctx.createLinearGradient(cx - r, cy - r, cx + r, cy + r);\n      rim.addColorStop(0, '#ffe066');\n      rim.addColorStop(0.5, '#e0a81a');\n      rim.addColorStop(1, '#fff0a0');\n      ctx.beginPath();\n      ctx.arc(cx, cy, r, 0, Math.PI * 2);\n      ctx.fillStyle = rim;\n      ctx.fill();\n      ctx.beginPath();\n      ctx.arc(cx, cy, r * 0.74, 0, Math.PI * 2);\n      ctx.fillStyle = colour;\n      ctx.fill();\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';\n      ctx.lineWidth = 1.5;\n      ctx.stroke();\n      ctx.textAlign = 'center';\n      if (kind === 'master') {\n        ctx.fillStyle = '#ffe066';\n        ctx.font = 'bold ' + Math.round(r * 1.1) + 'px sans-serif';\n        ctx.fillText('\\u2605', cx, cy + r * 0.38);\n      } else {\n        ctx.font = Math.round(r * 0.95) + 'px sans-serif';\n        ctx.fillText('\\u{1F684}', cx, cy + r * 0.33);\n      }\n      ctx.restore();\n      if (shine && earned) {\n        ctx.fillStyle = '#fff6b0';\n        for (let i = 0; i \u003c 4; i++) {\n          const a = frame * 0.05 + i * 1.6;\n          const sx = cx + Math.cos(a) * r * 1.5;\n          const sy = cy - r * 0.2 + Math.sin(a * 1.3) * r * 1.2;\n          const q = 2 + 2 * Math.abs(Math.sin(frame * 0.12 + i));\n          ctx.beginPath();\n          ctx.moveTo(sx, sy - q * 2);\n          ctx.lineTo(sx + q * 0.6, sy - q * 0.6);\n          ctx.lineTo(sx + q * 2, sy);\n          ctx.lineTo(sx + q * 0.6, sy + q * 0.6);\n          ctx.lineTo(sx, sy + q * 2);\n          ctx.lineTo(sx - q * 0.6, sy + q * 0.6);\n          ctx.lineTo(sx - q * 2, sy);\n          ctx.lineTo(sx - q * 0.6, sy - q * 0.6);\n          ctx.closePath();\n          ctx.fill();\n        }\n      }\n    }\n\n    function drawOverlay(title, subtitle) {\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';\n      ctx.fillRect(0, 0, W, H);\n      ctx.fillStyle = 'white';\n      ctx.textAlign = 'center';\n      ctx.font = 'bold 30px sans-serif';\n      ctx.fillText(title, W / 2, H / 2 - 16);\n      ctx.font = '18px sans-serif';\n      ctx.fillText(subtitle, W / 2, H / 2 + 20);\n    }\n\n    function draw() {\n      if (mallMode) {\n        drawMall();\n        return;\n      }\n      if (walkMode) {\n        drawWalk();\n        return;\n      }\n      ctx.clearRect(0, 0, W, H);\n      drawScenery();\n\n      coins.forEach(drawCoin);\n      obstacles.forEach((o) => {\n        if (o.kind === 'rock') drawRock(o);\n        else if (o.kind === 'barrier') drawBarrier(o);\n        else if (o.kind === 'train') drawOncoming(o);\n      });\n      drawBoarding();\n      drawTrain();\n      drawHurtGlow();\n      drawFloaters();\n      drawShieldBubble();\n      drawBoostEffects();\n      drawTunnel();\n      obstacles.forEach((o) => {\n        if (o.kind === 'animal') drawAnimal(o);\n      });\n      drawStationSign();\n      drawEffects();\n\n      if (night) drawNight();\n      drawStorm();\n      drawShieldHud();\n      drawPassengerPill();\n      drawChances();\n      drawSpeedometer();\n      drawRideLabel();\n      drawStationPanel();\n      if (started && !gameOver && dwell > 0 && !changedHere && isInterchange(lastStoppedK)) {\n        // a hint that you can change line here\n        const o = metroLines[targetLineAt(lastStoppedK)];\n        const text = '\\u{1F501} Change here for the ' + o.name + '!';\n        ctx.font = 'bold 15px sans-serif';\n        const tw = ctx.measureText(text).width + 24;\n        roundedRect(W / 2 - tw / 2, 120, tw, 30, 15);\n        ctx.fillStyle = o.colour;\n        ctx.fill();\n        ctx.strokeStyle = '#ffffff';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n        ctx.fillStyle = '#ffffff';\n        ctx.textAlign = 'center';\n        ctx.fillText(text, W / 2, 140);\n      }\n\n      if (levelFlash > 0 && started && !gameOver) {\n        const alpha = Math.min(1, levelFlash / 20);\n        ctx.fillStyle = 'rgba(255, 235, 90, ' + alpha + ')';\n        ctx.font = 'bold 36px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('Level ' + level + '!' + (level === stormLevel ? ' \\u26C8\\uFE0F Storm!' : ''), W / 2, 70);\n      }\n\n      if (calmFlash > 0 && started && !gameOver) {\n        const alpha = Math.min(1, calmFlash / 25);\n        ctx.fillStyle = 'rgba(190, 255, 200, ' + alpha + ')';\n        ctx.font = 'bold 22px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('\\u{1F308} Clear track ahead!', W / 2, 185);\n      }\n      if (quietT > 0 && started && !gameOver) {\n        ctx.fillStyle = 'rgba(190, 255, 235, 0.95)';\n        ctx.font = 'bold 15px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('\\u{1F54A}\\uFE0F Calm minute \\u2022 ' + Math.ceil(quietT / 60) + 's', W / 2, 205);\n      }\n\n      // the last station is coming\n      if (finalFlash > 0 && started && !gameOver) {\n        const alpha = Math.min(1, finalFlash / 25);\n        ctx.fillStyle = 'rgba(255, 255, 255, ' + alpha + ')';\n        ctx.font = 'bold 22px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('\\u{1F3C1} Last stop: ' + lineOf().end.name, W / 2, 150);\n      }\n\n      // banner when you beat your record level in the middle of a journey\n      if (recordFlash > 0 && started && !gameOver) {\n        const alpha = Math.min(1, recordFlash / 25);\n        ctx.fillStyle = 'rgba(255, 224, 102, ' + alpha + ')';\n        ctx.font = 'bold 26px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('\\u{1F3C6} New record!', W / 2, 108);\n      }\n\n      if (!started) {\n        drawOverlay('Tap to start', 'Tap left, middle or right to switch tracks!');\n        if (bestLevel > 0) {\n          drawTrophy(W / 2, 170, 44, bestLevel, false);\n          ctx.fillStyle = '#ffe066';\n          ctx.font = 'bold 15px sans-serif';\n          ctx.textAlign = 'center';\n          ctx.fillText('Your best level', W / 2, 242);\n        }\n        // the medals you have won so far (faded when not yet won)\n        const have = [medals.red > 0, medals.green > 0, medals.blue > 0, medals.tram > 0, medals.monorail > 0, medals.red > 0 && medals.green > 0 && medals.blue > 0 && medals.tram > 0];\n        ['red', 'green', 'blue', 'tram', 'monorail', 'master'].forEach((kind, i) => {\n          const mx = W / 2 - 125 + i * 50;\n          drawMedal(mx, 66, 15, kind, have[i], false);\n          ctx.fillStyle = have[i] ? '#ffe066' : 'rgba(255, 255, 255, 0.45)';\n          ctx.font = '10px sans-serif';\n          ctx.textAlign = 'center';\n          ctx.fillText(kind === 'master' ? 'Master' : kind === 'red' ? 'Red' : kind === 'green' ? 'Green' : kind === 'blue' ? 'Blue' : kind === 'monorail' ? 'Mono' : 'Tram', mx, 92);\n        });\n      } else if (gameOver) {\n        drawOverlay(won ? 'Journey complete! \\u{1F389}' : mallLost ? 'Stuck in the mall! \\u{1F6CD}\\uFE0F' : 'Derailed!', (won ? 'Tap to play again \\u2022 Score: ' : 'Tap to try again • Score: ') + score);\n        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';\n        ctx.font = '15px sans-serif';\n        ctx.fillText('Stations: ' + (lastStoppedK + 1) + '  \\u2022  Passengers delivered: ' + delivered, W / 2, H / 2 + 50);\n        if (won) {\n          ctx.fillStyle = '#ffffff';\n          ctx.font = 'bold 16px sans-serif';\n          ctx.fillText('\\u{1F3C1} You reached ' + lineOf().end.name + '!', W / 2, H / 2 + 78);\n        }\n        if (mallLost) {\n          ctx.fillStyle = '#ffb3b3';\n          ctx.font = 'bold 15px sans-serif';\n          ctx.textAlign = 'center';\n          ctx.fillText(mallLostMedal ? '\\u{1F396}\\uFE0F You lost a Green Line medal!' : 'Luckily you had no Green Line medal to lose', W / 2, H / 2 + 78);\n        }\n        const record = recordThisRun && level >= 2;\n        if (won) {\n          // the trophy on the left, the medal for this line on the right\n          drawTrophy(W / 2 - 62, 165, 42, bestLevel, record);\n          drawMedal(W / 2 + 62, 178, 30, currentLine, true, newMedals.length > 0);\n          if (newMedals.includes('master')) drawMedal(W / 2 + 120, 190, 20, 'master', true, true);\n          ctx.fillStyle = '#ffe066';\n          ctx.font = 'bold 15px sans-serif';\n          ctx.textAlign = 'center';\n          const nm = newMedals.length ? '\\u{1F396}\\uFE0F New medal: ' + (newMedals.includes('master') ? lineOf().name + ' + Metro Master!' : lineOf().name + '!') : '\\u{1F396}\\uFE0F ' + lineOf().name + ' medal \\u00D7' + medals[currentLine];\n          ctx.fillText(nm, W / 2, H / 2 + 106);\n        } else {\n          drawTrophy(W / 2, 165, 46, bestLevel, record);\n        }\n        ctx.fillStyle = record ? '#fff6b0' : '#ffe066';\n        ctx.font = 'bold 16px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText(won ? (record ? '\\u{1F3C6} New record! Level ' + level : 'Level ' + level + ' \\u2022 best ' + bestLevel) : record ? '\\u{1F3C6} New record! Level ' + level : 'Best level: ' + bestLevel + ' (you reached ' + level + ')', W / 2, 245);\n      }\n\n      drawMapOverlay();\n    }\n\n    function loop() {\n      update();\n      draw();\n      requestAnimationFrame(loop);\n    }\n\n    function boot(data) {\n      if (data) {\n        const n = Math.max(data.bestNormal || 0, data.best || 0);\n        if (n > bestNormal) bestNormal = n;\n        if ((data.bestEasy || 0) > bestEasy) bestEasy = data.bestEasy;\n        if ((data.bestLevelNormal || 0) > bestLevelNormal) bestLevelNormal = data.bestLevelNormal;\n        if ((data.bestLevelEasy || 0) > bestLevelEasy) bestLevelEasy = data.bestLevelEasy;\n        if ((data.medals && data.medals.red || 0) > medals.red) medals.red = data.medals.red;\n        if ((data.medals && data.medals.green || 0) > medals.green) medals.green = data.medals.green;\n        if ((data.medals && data.medals.blue || 0) > medals.blue) medals.blue = data.medals.blue;\n        if ((data.medals && data.medals.tram || 0) > medals.tram) medals.tram = data.medals.tram;\n        if ((data.medals && data.medals.monorail || 0) > medals.monorail) medals.monorail = data.medals.monorail;\n        saveMedals();\n        updateMedalsEl();\n        applyMode();\n      }\n      draw();\n      loop();\n      if (rideCfg) {\n        startOrRestart();\n        postSize();\n        setInterval(postSize, 600);\n      }\n    }\n\n    if (window.claude && window.claude.hot && window.claude.hot.snapshot) {\n      window.claude.hot.snapshot(() => ({ bestNormal, bestEasy, bestLevelNormal, bestLevelEasy, medals }));\n    }\n\n    if (window.claude && window.claude.hot && window.claude.hot.ready) {\n      window.claude.hot.ready(boot);\n    } else {\n      boot(window.claude && window.claude.hot ? window.claude.hot.data : null);\n    }\n  })();\n\u003c/script>\n\u003c/body>\u003c/html>";
    // ---------- the Dubai Metro: every mall has a station on one line ----------
    const lineInfo = {
      red: {
        name: 'Red Line', ar: 'المسار الأحمر', sign: '#d62828', train: '#c91f2e',
        end: { name: 'Centrepoint', ar: 'سنتر بوينت' },
        mids: [['Business Bay', 'الخليج التجاري'], ['Union', 'الاتحاد'], ['Emirates Towers', 'أبراج الإمارات'], ['Financial Centre', 'المركز المالي']],
      },
      green: {
        name: 'Green Line', ar: 'المسار الأخضر', sign: '#1f9d55', train: '#1f9d55',
        end: { name: 'Etisalat', ar: 'اتصالات' },
        mids: [['Creek', 'كريك'], ['Oud Metha', 'عود ميثاء'], ['Baniyas Square', 'ساحة بني ياس'], ['Al Ras', 'الراس']],
      },
      blue: {
        name: 'Blue Line', ar: 'المسار الأزرق', sign: '#1f5fbf', train: '#1f5fbf',
        end: { name: 'Academic City', ar: 'المدينة الأكاديمية' },
        mids: [['Dubai Creek Harbour', 'ميناء خور دبي'], ['Ras Al Khor', 'رأس الخور'], ['International City', 'المدينة العالمية'], ['Silicon Oasis', 'واحة السيليكون']],
      },
      tram: {
        name: 'Dubai Tram', ar: 'ترام دبي', sign: '#7d8791', train: '#c8d0d8',
        end: { name: 'Palm Jumeirah', ar: 'نخلة جميرا' },
        mids: [['Marina Walk', 'مارينا ووك'], ['JBR 1', 'جي بي آر 1'], ['The Walk', 'ذا ووك'], ['Mina Seyahi', 'ميناء السيهة']],
      },
      monorail: {
        name: 'Palm Monorail', ar: 'مونوريل النخلة', sign: '#1b2a6b', train: '#1b2a6b',
        end: { name: 'Atlantis The Palm', ar: 'أتلانتس النخلة' },
        mids: [['Palm Gateway', 'بوابة النخلة'], ['Palm Jumeirah Station', 'محطة نخلة جميرا'], ['Aquaventure', 'أكوافنتشر']],
      },
    };
    const lineKeys = ['red', 'green', 'blue', 'tram', 'monorail'];
    // which line each mall's station is on
    const mallLineMap = {
      'Dubai Mall': 'red', 'Mall of the Emirates': 'red', 'Ibn Battuta Mall': 'red',
      'Marina Mall': 'tram', 'Dubai Marina Mall': 'tram', 'The Beach Mall': 'tram',
      'Nakheel Mall': 'monorail',
      'Deira City Centre': 'green', 'BurJuman': 'green', 'Al Ghurair Centre': 'green', 'Wafi Mall': 'green',
      'Dubai Hills Mall': 'blue', 'Festival City Mall': 'blue', 'City Centre Mirdif': 'blue', 'Dubai Outlet Mall': 'blue',
    };
    const mallLine = (name) => mallLineMap[name] || 'red';
    const homeStation = { name: 'Home Station', ar: 'محطة البيت', home: true };
    const mallStationCache = {};
    function stationOfMall(name) {
      const m = malls.find((x) => x.name === name);
      if (!m) return null;
      if (!mallStationCache[name]) mallStationCache[name] = { name: name + ' Station', ar: 'محطة ' + m.ar, mall: name, line: mallLine(name) };
      return mallStationCache[name];
    }
    const mallStations = malls.map((m) => stationOfMall(m.name));
    const mallByName = (name) => malls.find((m) => m.name === name) || malls[0];
    const metroDest = { name: 'Metro stations', ar: 'محطات المترو', colour: '#d62828', kind: 'metro', sub: 'Park & Ride' };
    function parkRideDest(st) {
      return { name: st.name, ar: st.ar, colour: lineInfo[st.line || 'red'].sign, kind: 'metro', station: st };
    }
    let lotStation = null; // the metro station whose car park you are in
    const lotName = () => (lotKind === 'home' ? 'Home' : lotKind === 'metro' ? (lotStation ? lotStation.name : '') : dest.name);
    const carIsHere = () => lotLevel === carLevel && carKindNow === lotKind && carPlaceName === lotName();
    let carPlaceName = 'Home';
    const carStation = () => {
      if (carKindNow === 'mall') return stationOfMall(carPlaceName);
      if (carKindNow === 'metro') return mallStations.find((s) => s.name === carPlaceName) || null;
      return null;
    };

    // the medals you have won, one for each line
    let medals = {};
    try {
      medals = JSON.parse(localStorage.getItem('carDodgeMedals') || '{}') || {};
    } catch (e) {
      medals = {};
    }
    function saveMedals() {
      try {
        localStorage.setItem('carDodgeMedals', JSON.stringify(medals));
      } catch (e) {}
    }
    // the train trip from a mall to the end of its line and back
    let trip = null; // { st, line, stage: 'out' | 'end' | 'back', timer }
    const terminusCache = {};
    function terminusOf(key) {
      if (!terminusCache[key]) terminusCache[key] = { name: lineInfo[key].end.name, ar: lineInfo[key].end.ar, line: key, terminus: true };
      return terminusCache[key];
    }

    function saveCarPlace() {
      try {
        localStorage.setItem('carDodgePlace', JSON.stringify({ kind: carKindNow, name: carPlaceName, level: carLevel, bay: carBay }));
      } catch (e) {}
    }
    // where you left your car last time (it stays there, even if the game ends)
    function loadCarPlace() {
      try {
        const saved = JSON.parse(localStorage.getItem('carDodgePlace') || 'null');
        if (saved && saved.level >= 1 && saved.level <= 12 && saved.bay >= 0 && saved.bay < 16) {
          carKindNow = saved.kind;
          carPlaceName = saved.name;
          carLevel = saved.level;
          carBay = saved.bay;
          // a car left at a station name from an older version goes home
          if (carKindNow !== 'home' && !carStation()) {
            carKindNow = 'home';
            carPlaceName = 'Home';
          }
          return;
        }
        const old = JSON.parse(localStorage.getItem('carDodgeCar') || 'null');
        if (old && old.level >= 1 && old.level <= 12 && old.bay >= 0 && old.bay < 16) {
          carKindNow = 'home';
          carPlaceName = 'Home';
          carLevel = old.level;
          carBay = old.bay;
          return;
        }
      } catch (e) {}
      carKindNow = 'home';
      carPlaceName = 'Home';
      carLevel = 3;
      carBay = 5;
    }

    // ---- the station and its metro map
    const stn = { st: homeStation };
    let metroOpen = false;
    let metroButtons = [];
    let rideBox = null;
    let rideFrame = null;
    let rideTo = null;
    let rideKind = 'home';
    let derailed = false;
    let metroEver = false;
    const stnLine = () => lineInfo[stn.st.line || 'red'];

    function enterStation(st) {
      phase = 'station';
      stn.st = st;
      mallTrolley = false;
      hold = null;
      say('Welcome to ' + st.name + '! \u{1F687}', 200);
      blip(988, 988, 0.15, 0.1);
      openMetro();
    }

    function openMetro() {
      const st = stn.st;
      if (st.terminus && (!trip || trip.timer > 0)) return;
      const b = [];
      let y = 168;
      if (st.terminus) {
        const L = lineInfo[st.line];
        b.push({ kind: 'back', label: '\u{1F687} Back to ' + trip.st.mall, sub: L.mids.length + 1 + ' stops', x: 200, y, w: 340, h: 42 });
      } else if (st.home) {
        const cs = carStation();
        if (cs) {
          b.push({ kind: 'carride', st: cs, label: '\u{1F697} To my car: ' + carPlaceName, sub: '3 stops', x: 200, y, w: 340, h: 42 });
          y += 50;
        }
        y += 40;
        b.push({ kind: 'home', label: '\u{1F3E0} To my building', x: 200, y, w: 320, h: 38 });
      } else {
        const L = lineInfo[st.line];
        b.push({ kind: 'medal', label: '\u{1F3C5} Ride the ' + L.name + ' to the end', sub: L.mids.length + 1 + ' stops', x: 200, y, w: 340, h: 42 });
        y += 50 + 40;
        b.push({ kind: 'mall', label: '\u{1F6CD}️ Up to ' + st.mall, x: 200, y, w: 320, h: 38 });
        y += 44;
        b.push({ kind: 'lot', label: '\u{1F17F}️ Park & Ride car park', x: 200, y, w: 320, h: 38 });
      }
      metroButtons = b;
      metroOpen = true;
      blip(700, 700, 0.08, 0.08);
    }

    function metroPress(p) {
      if (p.x > 120 && p.x < 280 && p.y > 508 && p.y < 548) {
        metroOpen = false;
        return;
      }
      for (const b of metroButtons) {
        if (Math.abs(p.x - b.x) < b.w / 2 && Math.abs(p.y - b.y) < b.h / 2) {
          metroOpen = false;
          if (b.kind === 'medal') startMedalTrip(stn.st);
          else if (b.kind === 'back') startBackTrip();
          else if (b.kind === 'carride') startCarRide(b.st);
          else if (b.kind === 'mall') {
            dest = mallByName(stn.st.mall);
            enterMallAt(0);
          } else if (b.kind === 'lot') {
            lotStation = stn.st;
            dest = parkRideDest(stn.st);
            enterLotFromStation();
          } else if (b.kind === 'home') {
            openLift('home', { type: 'metro', val: 0 });
          }
          return;
        }
      }
    }

    // out of the station into its Park & Ride car park
    function enterLotFromStation() {
      phase = 'walk';
      lotKind = 'metro';
      lotLevel = 1;
      levelBays = levelBays || {};
      bays = makeLevel(1);
      if (carIsHere()) {
        bays[carBay].occupied = false;
        const c = bayCentre(carBay);
        car.x = c.x;
        car.y = c.y;
      }
      shopped = true;
      me.x = 200;
      me.y = 205;
      me.hurt = 0;
      leftCar = true;
      hold = null;
      lotCars = [{ x: 330, y: 500, dir: -1, v: 1.0, colour: '#e76f51' }];
      say(carIsHere() ? 'Your car is here! Walk to it. \u{1F697}' : 'Your car is not in this car park.', 180);
    }

    // ---- the train: the train game runs inside the car game
    function startRide(kind, to, rc) {
      rideTo = to;
      rideKind = kind;
      const cfg = Object.assign({ startScore: 15 }, rc);
      phase = 'ride';
      derailed = false;
      metroEver = true;
      document.body.classList.add('riding');
      rideBox = document.getElementById('rideBox');
      rideBox.hidden = false;
      rideBox.innerHTML = '';
      rideFrame = document.createElement('iframe');
      rideFrame.setAttribute('title', 'Metro ride');
      rideFrame.style.cssText = 'width:100%;max-width:440px;height:1000px;border:0;border-radius:16px;background:transparent;';
      rideFrame.srcdoc = TRAIN_DOC.replace('<body>', '<body><script>window.__ride = ' + JSON.stringify(cfg) + ';<\/script>');
      rideBox.appendChild(rideFrame);
      blip(500, 900, 0.3, 0.1);
    }

    // from the home station to where your car was left
    function startCarRide(to) {
      const L = lineInfo.red;
      startRide('home', to, { line: 'red', names: [L.mids[0][0], L.mids[1][0]], ar: [L.mids[0][1], L.mids[1][1]], endName: to.name, endAr: to.ar, stops: 3 });
    }

    // from a mall station to the end of its line (and a medal)
    function startMedalTrip(st) {
      const L = lineInfo[st.line];
      trip = { st, line: st.line, stage: 'out', timer: 0 };
      startRide('out', terminusOf(st.line), { line: st.line, names: L.mids.map((m) => m[0]), ar: L.mids.map((m) => m[1]), endName: L.end.name, endAr: L.end.ar, stops: L.mids.length + 1 });
    }

    // the train coming the other way, back to the mall where your car is
    function startBackTrip() {
      const L = lineInfo[trip.line];
      trip.stage = 'back';
      startRide('back', trip.st, { line: trip.line, reverse: true, names: L.mids.map((m) => m[0]).reverse(), ar: L.mids.map((m) => m[1]).reverse(), endName: trip.st.name, endAr: trip.st.ar, stops: L.mids.length + 1 });
    }

    function endRide() {
      document.body.classList.remove('riding');
      if (rideBox) {
        rideBox.hidden = true;
        rideBox.innerHTML = '';
      }
      rideFrame = null;
    }

    function arriveAtTerminus() {
      const key = trip.line;
      const first = !medals[key];
      medals[key] = true;
      saveMedals();
      phase = 'station';
      stn.st = terminusOf(key);
      trip.stage = 'end';
      trip.timer = 300; // 5 seconds, then the train back
      metroOpen = false;
      say('\u{1F3C5} You reached the end of the ' + lineInfo[key].name + '! ' + (first ? 'A new medal!' : 'Medal!'), 290);
      [523, 659, 784, 1047].forEach((f, i) => blip(f, f, 0.2, 0.12, i * 0.14));
    }

    window.addEventListener('message', (e) => {
      const m = e.data;
      if (!m || !rideFrame || e.source !== rideFrame.contentWindow) return;
      if (m.type === 'rideSize' && m.h > 300) {
        rideFrame.style.height = Math.min(1700, m.h + 4) + 'px';
      } else if (m.type === 'rideDone' && phase === 'ride') {
        endRide();
        if (m.won) {
          addScore(10 + Math.round((m.score || 0) / 4));
          window.scrollTo(0, 0);
          if (rideKind === 'out') arriveAtTerminus();
          else if (rideKind === 'back') {
            const st = trip.st;
            trip = null;
            enterStation(st);
            say('Back at ' + st.mall + '! Go to your car \u{1F697}', 260);
          } else {
            enterStation(rideTo);
            say('You have arrived at ' + rideTo.name + '! \u{1F687} +10', 220);
          }
        } else {
          trip = null;
          derailed = true;
          phase = 'station';
          crashing = false;
          endGame();
        }
      }
    });

    // the metro station seen from inside, in the colours of its line
    function drawMedal(x, y, r, colour, spin) {
      ctx.fillStyle = colour;
      ctx.fillRect(x - r * 0.7, y - r * 1.9, r * 0.55, r * 1.3);
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(x + r * 0.15, y - r * 1.9, r * 0.55, r * 1.3);
      const g = ctx.createRadialGradient(x - r * 0.3, y - r * 0.3, r * 0.1, x, y, r);
      g.addColorStop(0, '#fff3a8');
      g.addColorStop(1, '#e0a419');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#a87408';
      ctx.lineWidth = Math.max(2, r * 0.1);
      ctx.stroke();
      ctx.fillStyle = colour;
      ctx.font = 'bold ' + Math.round(r * 1.1) + 'px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('★', x, y + r * 0.38);
    }

    function drawStation() {
      const st = stn.st;
      const L = lineInfo[st.line || 'red'];
      const cs = L.sign;
      // the ceiling with silver arches
      const ceil = ctx.createLinearGradient(0, 0, 0, 130);
      ceil.addColorStop(0, '#dfe3e8');
      ceil.addColorStop(1, '#f2f4f7');
      ctx.fillStyle = ceil;
      ctx.fillRect(0, 0, W, 400);
      ctx.strokeStyle = 'rgba(120, 130, 145, 0.5)';
      ctx.lineWidth = 3;
      for (let k = 0; k < 4; k++) {
        ctx.beginPath();
        ctx.moveTo(k * 110 - 20, 0);
        ctx.quadraticCurveTo(k * 110 + 40, 70, k * 110 + 100, 0);
        ctx.stroke();
      }
      for (let x = 30; x < W; x += 120) {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(x, 24, 80, 10);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.beginPath();
        ctx.moveTo(x, 34);
        ctx.lineTo(x + 80, 34);
        ctx.lineTo(x + 110, 200);
        ctx.lineTo(x - 30, 200);
        ctx.fill();
      }
      // the big station sign
      roundedRect(40, 56, 320, 56, 12);
      ctx.fillStyle = cs;
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 26px sans-serif';
      ctx.fillText('M', 70, 94);
      fitText(st.name, 250, 20);
      ctx.fillText(st.name, 215, 84);
      fitText(st.ar, 250, 14, '');
      ctx.fillText(st.ar, 215, 103);
      // the line map on the wall
      roundedRect(30, 132, 340, 76, 8);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.strokeStyle = '#b9c0c9';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = cs;
      ctx.fillRect(48, 168, 304, 6);
      const dots = st.home ? 6 : L.mids.length + 2;
      const hereAt = st.home ? 2 : st.terminus ? dots - 1 : 0;
      for (let i = 0; i < dots; i++) {
        const x = 52 + i * (296 / (dots - 1));
        const here = i === hereAt;
        ctx.beginPath();
        ctx.arc(x, 171, here ? 8 : 5, 0, Math.PI * 2);
        ctx.fillStyle = here ? '#ffd23f' : '#ffffff';
        ctx.fill();
        ctx.strokeStyle = cs;
        ctx.lineWidth = here ? 3 : 2;
        ctx.stroke();
        if (here) {
          ctx.font = '11px sans-serif';
          ctx.fillStyle = '#000000';
          ctx.fillText(st.home ? '\u{1F3E0}' : st.terminus ? '\u{1F3C1}' : '\u{1F6CD}️', x, 156);
        }
      }
      ctx.fillStyle = '#4a4f57';
      ctx.font = 'bold 11px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(L.name.toUpperCase() + ' • ' + L.ar, 200, 200);
      // the floor and the ticket gates
      ctx.fillStyle = '#d4d7dc';
      ctx.fillRect(0, 400, W, H - 400);
      ctx.strokeStyle = 'rgba(80, 90, 105, 0.16)';
      ctx.lineWidth = 1.5;
      [410, 430, 456, 490, 536].forEach((y) => {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(W, y);
        ctx.stroke();
      });
      for (let k = 0; k < 4; k++) {
        const gx = 60 + k * 90;
        ctx.fillStyle = '#8a929c';
        roundedRect(gx - 14, 330, 28, 70, 6);
        ctx.fill();
        ctx.fillStyle = '#3ddc84';
        ctx.beginPath();
        ctx.moveTo(gx, 344);
        ctx.lineTo(gx - 7, 358);
        ctx.lineTo(gx + 7, 358);
        ctx.fill();
        ctx.fillStyle = 'rgba(190, 225, 245, 0.7)';
        ctx.fillRect(gx - 14, 366, 6, 30);
      }
      // the train waiting behind the gates, in the colour of its line
      ctx.fillStyle = L.train;
      roundedRect(30, 236, 340, 80, 14);
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
      ctx.fillRect(30, 262, 340, 8);
      ctx.fillStyle = '#9ccfe8';
      for (let k = 0; k < 6; k++) ctx.fillRect(48 + k * 54, 244, 36, 16);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
      for (let k = 0; k < 5; k++) ctx.fillRect(84 + k * 54 + 6, 276, 4, 34);
      // your medal
      if (st.terminus && trip && trip.timer > 0) {
        const bob = Math.sin(frameCount / 8) * 5;
        drawMedal(200, 284 + bob, 32, L.sign, 0);
        ctx.fillStyle = '#ffffff';
        roundedRect(104, 318 + bob, 192, 22, 11);
        ctx.fill();
        ctx.fillStyle = '#3a3f46';
        ctx.font = 'bold 13px sans-serif';
        ctx.fillText(L.name.toUpperCase() + ' MEDAL!', 200, 334 + bob);
      }
      // people waiting
      const folk = [[110, 470, 0], [300, 490, 1], [70, 520, 2], [340, 530, 3]];
      folk.forEach(([x, y, k]) => drawShopper(x, y, shopperLook[k % 6], 0.9 + (y - 440) / 330, k % 2 ? -1 : 1, false, k * 9, k % 2 === 0));
      drawShopper(200, 505, ['#f2c9a0', '#d71920', '#26344a'], 1, 1, false, 0, mallBag.length > 0);
      // the benches
      drawBench(250, 446, null);
    }

    // the medals on the shelf at home
    function drawMedalShelf() {
      ctx.fillStyle = '#7b5a3a';
      roundedRect(112, 243, 146, 6, 3);
      ctx.fill();
      lineKeys.forEach((key, i) => {
        const x = 128 + i * 26;
        if (medals[key]) {
          drawMedal(x, 233, 9, lineInfo[key].sign, 0);
        } else {
          ctx.strokeStyle = 'rgba(80, 50, 20, 0.35)';
          ctx.lineWidth = 2;
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.arc(x, 233, 9, 0, Math.PI * 2);
          ctx.stroke();
          ctx.setLineDash([]);
        }
      });
    }

    // the metro panel: where to?
    function drawMetroPanel() {
      const st = stn.st;
      const L = stnLine();
      const th = L.sign;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.62)';
      ctx.fillRect(0, 0, W, H);
      roundedRect(20, 40, 360, 520, 18);
      ctx.fillStyle = '#f7f8fa';
      ctx.fill();
      ctx.strokeStyle = th;
      ctx.lineWidth = 4;
      ctx.stroke();
      ctx.fillStyle = th;
      roundedRect(20, 40, 360, 64, 18);
      ctx.fill();
      ctx.fillRect(20, 80, 360, 24);
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 18px sans-serif';
      ctx.fillText(st.home ? '\u{1F687} DUBAI METRO' : '\u{1F687} ' + L.name.toUpperCase(), 200, 70);
      ctx.font = '13px sans-serif';
      fitText('You are at ' + st.name, 330, 13, '');
      ctx.fillText('You are at ' + st.name, 200, 94);
      ctx.fillStyle = '#3a3f46';
      ctx.font = 'bold 13px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(st.terminus ? 'TIME TO GO BACK TO YOUR CAR:' : st.home ? 'TAKE THE TRAIN:' : 'TAKE THE TRAIN:', 36, 130);
      const leaveY = metroButtons.filter((b) => b.kind === 'mall' || b.kind === 'home').map((b) => b.y)[0];
      if (leaveY) ctx.fillText('OR LEAVE THE STATION:', 36, leaveY - 36);
      metroButtons.forEach((b) => {
        const train = b.kind === 'medal' || b.kind === 'back' || b.kind === 'carride';
        roundedRect(b.x - b.w / 2, b.y - b.h / 2, b.w, b.h, 12);
        ctx.fillStyle = train ? '#fff1d0' : '#e7f3ea';
        ctx.fill();
        ctx.strokeStyle = train ? th : '#1b7f4b';
        ctx.lineWidth = 2.5;
        ctx.stroke();
        ctx.fillStyle = '#22272d';
        ctx.font = 'bold 15px sans-serif';
        ctx.textAlign = 'left';
        fitText(b.label, b.sub ? 210 : 290, 15);
        ctx.fillText(b.label, b.x - b.w / 2 + 12, b.y + 5);
        if (b.sub) {
          ctx.textAlign = 'right';
          ctx.font = 'bold 12px sans-serif';
          ctx.fillStyle = th;
          ctx.fillText(b.sub, b.x + b.w / 2 - 12, b.y + 5);
        }
      });
      if (st.home && !carStation()) {
        ctx.fillStyle = '#6b727b';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Your car is at home. Nothing to fetch!', 200, 190);
      }
      if (!st.home && !st.terminus) {
        ctx.fillStyle = '#6b727b';
        ctx.font = '12px sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText('Reach the end of the line for a medal!', 36, 203);
      }
      // the medals you have
      ctx.fillStyle = '#3a3f46';
      ctx.font = 'bold 12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('MY MEDALS', 200, 438);
      lineKeys.forEach((key, i) => {
        const x = 200 + (i - 2) * 58;
        if (medals[key]) {
          drawMedal(x, 468, 15, lineInfo[key].sign, 0);
        } else {
          ctx.strokeStyle = '#b9c0c9';
          ctx.lineWidth = 2;
          ctx.setLineDash([4, 4]);
          ctx.beginPath();
          ctx.arc(x, 468, 15, 0, Math.PI * 2);
          ctx.stroke();
          ctx.setLineDash([]);
        }
      });
      ctx.fillStyle = '#e63946';
      roundedRect(120, 508, 160, 40, 20);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 15px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Close ✖', 200, 533);
    }

    // ---------- the big button: out of the car, into the car, out of the mall ----------
    let actLabel = null;
    function updateAct() {
      let label = null;
      if (!gameOver && !liftOpen && !liftRide && !metroOpen && !fridgeOpen && !buddyAsk && !calOpen && !saltOpen) {
        if (phase === 'park' && parked) label = '\u{1F6AA} Get out of the car';
        else if (phase === 'walk' && nearCar && bootT <= 0 && (departing || (leg === 'out' && shopped))) label = !departing && mallBag.length && !bootDone ? '\u{1F9F3} Put the bags in the boot' : '\u{1F697} Get in the car';
        else if (phase === 'mall') label = isMosque() ? '\u{1F6AA} Leave the mosque' : '\u{1F6AA} Leave the mall';
        else if (phase === 'beach') label = nearSalt() ? '\u{1F354} Order at SALT' : nearKarak() ? '\u2615 Order at KARAK' : '\u{1F6AA} Leave the beach';
        else if (phase === 'station' && !(trip && trip.stage === 'end' && trip.timer > 0)) label = '\u{1F687} Open the metro map';
      }
      if (label !== actLabel) {
        actLabel = label;
        actBtn.hidden = !label;
        if (label) actBtn.textContent = label;
      }
    }
    actBtn.addEventListener('click', () => {
      ensureAudio();
      if (phase === 'park') getOutOfCar();
      else if (phase === 'walk') {
        if (!departing && mallBag.length && !bootDone) startBoot();
        else getInCar();
      }
      else if (phase === 'mall') leaveMall();
      else if (phase === 'beach') {
        if (nearSalt()) openSalt('salt');
        else if (nearKarak()) openSalt('karak');
        else leaveBeach();
      }
      else if (phase === 'station') openMetro();
    });

    // ---------- input ----------
    function pointerPt(clientX, clientY) {
      const rect = canvas.getBoundingClientRect();
      return { x: ((clientX - rect.left) / rect.width) * W, y: ((clientY - rect.top) / rect.height) * H };
    }

    function pressAt(clientX, clientY) {
      const wasIdle = phase === 'start' || phase === 'homedone' || gameOver;
      startOrRestart();
      if (wasIdle) return;
      const p = pointerPt(clientX, clientY);
      if (liftRide) return;
      if (liftOpen) {
        liftPress(p);
        return;
      }
      if (saltOpen) {
        saltPress(p);
        return;
      }
      if (calOpen) {
        calendarPress(p);
        return;
      }
      if (buddyAsk) {
        buddyAskPress(p);
        return;
      }
      if (fridgeOpen) {
        fridgePress(p);
        return;
      }
      if (metroOpen) {
        metroPress(p);
        return;
      }
      if (phase === 'drive' && gateWait > 0 && Math.abs(p.x - (gateGoBtn.x + 70)) < gateGoBtn.w / 2 && Math.abs(p.y - gateGoBtn.y) < gateGoBtn.h / 2) {
        gateWait = 1;
        return;
      }
      if (phase === 'drive') targetX = p.x;
      else if (phase === 'apartment') aptPress(p);
      else if (phase === 'mall') mallPress(p);
      else if (phase === 'park' || phase === 'walk' || phase === 'beach') hold = p;
      else if (phase === 'apartment') aptPress(p);
    }
    function moveTo(clientX, clientY) {
      const p = pointerPt(clientX, clientY);
      if (phase === 'drive') targetX = p.x;
      else if (hold) hold = p;
    }

    canvas.addEventListener('mousedown', (e) => pressAt(e.clientX, e.clientY));
    canvas.addEventListener('mousemove', (e) => moveTo(e.clientX, e.clientY));
    canvas.addEventListener('touchstart', (e) => pressAt(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    canvas.addEventListener('touchmove', (e) => moveTo(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    window.addEventListener('mouseup', () => (hold = null));
    window.addEventListener('touchend', () => (hold = null));
    window.addEventListener('touchcancel', () => (hold = null));

    function startBoost(e) {
      e.preventDefault();
      ensureAudio();
      boosting = true;
    }
    function stopBoost() {
      boosting = false;
    }
    boostBtn.addEventListener('mousedown', startBoost);
    boostBtn.addEventListener('touchstart', startBoost, { passive: false });
    boostBtn.addEventListener('mouseup', stopBoost);
    boostBtn.addEventListener('mouseleave', stopBoost);
    boostBtn.addEventListener('touchend', stopBoost);
    boostBtn.addEventListener('touchcancel', stopBoost);

    window.addEventListener('keydown', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
      if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = true;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = true;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = true;
      if (e.code.startsWith('Arrow')) e.preventDefault();
      if (e.code === 'KeyK' || (e.code === 'Space' && phase === 'beach')) tugKite();
      if (e.code === 'Escape' && liftOpen) closeLift();
      if (e.code === 'Escape' && metroOpen) metroOpen = false;
      if (e.code === 'Escape' && fridgeOpen) fridgeOpen = false;
      if (e.code === 'Escape' && calOpen) calOpen = false;
      if (e.code === 'Escape' && saltOpen) saltOpen = false;
      if (e.code === 'Enter' || e.code === 'KeyE') {
        if (phase === 'mall') mallAction();
        else if (phase === 'apartment') aptKey();
        else actBtn.click();
      }
      if (e.code === 'Space') {
        e.preventDefault();
        if (phase === 'mall') mallAction();
        else if (phase === 'apartment') aptKey();
        else startOrRestart();
      }
    });
    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
      if (e.code === 'ArrowUp' || e.code === 'KeyW') keys.up = false;
      if (e.code === 'ArrowDown' || e.code === 'KeyS') keys.down = false;
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = false;
    });

    // ---------- driving ----------
    function startArrival() {
      arriving = true;
      arriveT = 90;
      traffic = [];
      coins = [];
      shields = [];
      police = null;
      addScore(10);
      say(leg === 'out' ? 'Off to ' + dest.name + '! ' + (dest.kind === 'beach' ? '\u{1F3D6}\uFE0F' : dest.kind === 'mosque' ? '\u{1F54C}' : '\u{1F6CD}\uFE0F') : 'You are home!', 140);
      blip(660, 990, 0.2, 0.1);
    }

    function updateDrive(step) {
      if (crashing) {
        crashTimer -= step;
        const t = easeOut(Math.min(1, Math.max(0, 1 - crashTimer / crashDuration)));
        car.x = crashStartX + (crashTargetX - crashStartX) * t;
        car.y = crashStartY + (crashTargetY - crashStartY) * t;
        crashAngle = crashSpin * Math.PI * 4 * t;
        if (!splashed && (car.x < roadLeft || car.x > roadRight)) {
          splashed = true;
          splashes.push({ x: car.x, y: car.y, age: 0 });
        }
        splashes.forEach((s) => (s.age += step));
        splashes = splashes.filter((s) => s.age < 26);
        if (crashTimer <= 0) {
          crashing = false;
          endGame();
          if (audioCtx && sirenGain) sirenGain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 0.2);
        }
        return; // freeze everything while spinning out
      }
      if (gameOver) {
        laneLines.forEach((line) => {
          line.y += 3 * step;
          if (line.y > H) line.y -= 8 * 80;
        });
        return;
      }

      let speed = worldSpeed();
      if (arriving) {
        arriveT -= step;
        speed *= Math.max(0, arriveT / 90);
        if (arriveT <= 0) {
          enterLot();
          return;
        }
      }
      if (gateWait > 0) {
        gateWait -= step;
        speed = 0;
        if (gateWait <= 0) {
          gateWait = 0;
          say('Off you go! \u{1F6A6}', 90);
          blip(660, 990, 0.2, 0.1);
        }
      }
      const dist = speed * step;
      travel += dist;
      laneLines.forEach((line) => {
        line.y += dist;
        if (line.y > H) line.y -= 8 * 80;
      });
      signs.forEach((s) => (s.y += dist));
      signs = signs.filter((s) => s.y < H + 60);
      const remaining = tripLen - travel;
      if (!arriving) {
        if (travel >= nextSignAt) {
          spawnSign();
          nextSignAt += 230;
        }
        if (travel >= nextGantryAt && remaining > 500) {
          spawnGantry();
          nextGantryAt += 1500;
        }
      }

      if (keys.left) targetX -= moveSpeed * step;
      if (keys.right) targetX += moveSpeed * step;
      targetX = Math.max(roadLeft + car.w / 2, Math.min(roadRight - car.w / 2, targetX));
      car.x += (targetX - car.x) * (1 - Math.pow(1 - followSpeed, step));

      if (boosting && boostEnergy > 0) boostEnergy = Math.max(0, boostEnergy - boostDrain * step);
      else {
        boosting = false;
        boostEnergy = Math.min(100, boostEnergy + boostRegen * step);
      }
      boostFill.style.width = boostEnergy + '%';

      traffic.forEach((other) => {
        other.y += dist;
        if (Math.abs(car.x - other.x) < (car.w + other.w) / 2 - 11 && Math.abs(car.y - other.y) < (car.h + other.h) / 2 - 11) {
          if (invuln > 0) {
            // still protected for a moment after the shield popped
          } else if (shieldOn) {
            shieldOn = false;
            invuln = 45;
            shieldFlash = 60;
            other.passed = true;
            other.y = H + 200;
          } else {
            startCrash();
          }
        }
        if (!other.passed && other.y > car.y + car.h) {
          other.passed = true;
          addScore(1);
        }
      });
      traffic = traffic.filter((other) => other.y < H + 80);
      if (!arriving && remaining > 250 && (traffic.length === 0 || traffic[traffic.length - 1].y > spawnGap())) spawnTraffic();

      coins.forEach((coin) => {
        coin.y += dist;
        if (Math.hypot(car.x - coin.x, car.y - coin.y) < coin.r + Math.min(car.w, car.h) / 2) {
          coin.collected = true;
          addScore(3);
          blip(880, 1320, 0.12, 0.1);
        }
      });
      coins = coins.filter((coin) => !coin.collected && coin.y < H + 40);
      coinSpawnIn -= step;
      if (coinSpawnIn <= 0) {
        if (!arriving && remaining > 250) spawnCoin();
        coinSpawnIn = 80 + Math.random() * 70;
      }

      shields.forEach((sh) => {
        sh.y += dist;
        if (Math.hypot(car.x - sh.x, car.y - sh.y) < sh.r + Math.min(car.w, car.h) / 2) {
          sh.collected = true;
          shieldOn = true;
        }
      });
      shields = shields.filter((sh) => !sh.collected && sh.y < H + 40);
      if (!shieldOn && shields.length === 0 && !arriving) {
        shieldSpawnIn -= step;
        if (shieldSpawnIn <= 0) {
          if (remaining > 250) spawnShield();
          shieldSpawnIn = 350 + Math.random() * 300;
        }
      }

      // The police car. Coasting too long (not boosting) first triggers a
      // flashing warning, then the police appears and creeps up.
      if (boosting || arriving || gateWait > 0) slowTimer = 0;
      else slowTimer += step;
      if (false && !police && slowTimer >= slowThreshold) {
        const laneX = car.x < (roadLeft + roadRight) / 2 ? roadRight - 55 : roadLeft + 55;
        police = { x: laneX, y: H + 60 };
      }
      if (police) {
        police.y += (boosting ? policeRetreat : -policeApproach) * step;
        if (police.y < H) police.x += (car.x - police.x) * (1 - Math.pow(1 - 0.015, step));
        const caught = police.y - car.y < 14;
        if (caught && Math.abs(police.x - car.x) < 34) {
          if (shieldOn) {
            shieldOn = false;
            invuln = 45;
            shieldFlash = 60;
            police = null;
            slowTimer = 0;
          } else {
            busted = true;
            startCrash();
          }
        } else if (caught) police.y = car.y + 14;
        else if (police.y > H + 140) {
          police = null;
          slowTimer = 0;
        }
      }

      // at 0 km the road splits into lanes: you drive through the one you choose
      if (leg === 'out' && !gateRow && !arriving && remaining < 520) {
        gateRow = { y: car.y - remaining, passed: false };
        say('Choose a tunnel! Steer into the one you want.', 230);
      }
      if (gateRow && !gateRow.passed) {
        gateRow.y += dist;
        // the road stops in front of the tunnels: 10 seconds to choose
        if (!gateStopped && gateRow.y >= car.y - 230) {
          gateStopped = true;
          gateWait = 600;
          traffic = [];
          coins = [];
          shields = [];
          say('Choose your tunnel! You have 10 seconds \u23F1\uFE0F', 240);
        }
        if (gateRow.y >= car.y) {
          gateRow.passed = true;
          dest = laneDests[laneAt(car.x)];
          if (dest.kind === 'metro') {
            // the metro tunnel leads to one of the stations with a mall
            lotStation = mallStations[Math.floor(Math.random() * mallStations.length)];
            dest = parkRideDest(lotStation);
          }
          startArrival();
        }
      } else if (gateRow) {
        gateRow.y += dist;
      }
      if (leg === 'home' && !arriving && travel >= tripLen) startArrival();
      levelFlash = Math.max(0, levelFlash - step);
      shieldFlash = Math.max(0, shieldFlash - step);
      invuln = Math.max(0, invuln - step);
    }

    function endGame() {
      if (gameOver) return;
      gameOver = true;
      towed = false;
      if (!derailed && carKindNow !== 'home') {
        // after a crash your car is towed back to the car park of your building
        carKindNow = 'home';
        carPlaceName = 'Home';
        carLevel = 3;
        carBay = 5;
        saveCarPlace();
        towed = true;
      }
      if (score > best) saveBest();
    }

    function update() {
      const now = performance.now();
      let step = lastTime === null ? 1 : (now - lastTime) / (1000 / 60);
      lastTime = now;
      step = Math.min(Math.max(step, 0.2), 3); // same game speed on 60Hz and 120Hz screens
      frameCount += step;
      msgT = Math.max(0, msgT - step);
      if (liftRide) {
        updateLiftRide(step);
        updateAct();
        return;
      }
      if (phase === 'station' && trip && trip.stage === 'end' && trip.timer > 0) {
        trip.timer -= step;
        if (trip.timer <= 0) {
          say('Go back to your car at ' + trip.st.mall + '! \u{1F697}', 300);
          openMetro();
        }
      }
      if (liftOpen || metroOpen || fridgeOpen || buddyAsk || calOpen || saltOpen) return;
      if (phase === 'drive') updateDrive(step);
      else if (phase === 'park') updatePark(step);
      else if (phase === 'walk') updateWalk(step);
      else if (phase === 'mall') updateMall(step);
      else if (phase === 'beach') updateBeach(step);
      else if (phase === 'apartment') updateApartment(step);
      else {
        // at home before you set off: the road lines keep still
      }
      if (phase !== 'drive') {
        boosting = false;
        levelFlash = Math.max(0, levelFlash - step);
      }
      updateSiren();
      updateAct();
      updateKiteBtn();
    }

    // ---------- drawing: the cars ----------
    function drawCar(x, y, w, h, color, outline) {
      const r = 8;
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.moveTo(x - w / 2 + r, y - h / 2);
      ctx.arcTo(x + w / 2, y - h / 2, x + w / 2, y - h / 2 + r, r);
      ctx.lineTo(x + w / 2, y + h / 2 - r);
      ctx.arcTo(x + w / 2, y + h / 2, x + w / 2 - r, y + h / 2, r);
      ctx.lineTo(x - w / 2 + r, y + h / 2);
      ctx.arcTo(x - w / 2, y + h / 2, x - w / 2, y + h / 2 - r, r);
      ctx.lineTo(x - w / 2, y - h / 2 + r);
      ctx.arcTo(x - w / 2, y - h / 2, x - w / 2 + r, y - h / 2, r);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = outline;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
      ctx.fillRect(x - w / 2 + 6, y - h / 2 + 10, w - 12, h / 3);
    }

    function drawPoliceCar(x, y, w, h) {
      drawCar(x, y, w, h, '#f2ecdf', '#222');
      ctx.fillStyle = '#222';
      ctx.fillRect(x - w / 2, y - 6, w, 10);
      ctx.fillStyle = Math.floor(frameCount / 8) % 2 === 0 ? '#ff3b30' : '#2b45f0';
      ctx.fillRect(x - 10, y - h / 2 - 8, 20, 7);
    }

    function drawPoliceGlow() {
      const red = Math.floor(frameCount / 8) % 2 === 0;
      const g = ctx.createLinearGradient(0, H, 0, H - 90);
      g.addColorStop(0, red ? 'rgba(255, 59, 48, 0.75)' : 'rgba(43, 69, 240, 0.75)');
      g.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = g;
      ctx.fillRect(0, H - 90, W, 90);
    }

    function drawShieldPickup(x, y, r) {
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = '#29c5f6';
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x, y - 8);
      ctx.lineTo(x + 7, y - 5);
      ctx.lineTo(x + 6, y + 2);
      ctx.quadraticCurveTo(x + 5, y + 8, x, y + 10);
      ctx.quadraticCurveTo(x - 5, y + 8, x - 6, y + 2);
      ctx.lineTo(x - 7, y - 5);
      ctx.closePath();
      ctx.fillStyle = '#ffffff';
      ctx.fill();
    }

    function drawCoin(x, y, r) {
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = '#ffd400';
      ctx.fill();
      ctx.strokeStyle = '#b8860b';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(x, y, r - 4, 0, Math.PI * 2);
      ctx.strokeStyle = '#fff3b0';
      ctx.stroke();
    }

    // ---------- drawing: the road through Dubai ----------
    function drawSideCity(sand) {
      const period = 96;
      const idx = Math.floor(travel / period);
      const base = travel % period;
      [[0, 50, 0], [350, 400, 1]].forEach(([x0, x1, c]) => {
        ctx.fillStyle = sand;
        ctx.fillRect(x0, 0, x1 - x0, H);
        for (let r = -1; r < H / period + 1; r++) {
          const g = idx - r;
          const hv = cityHash(g, c);
          const gap = 6 + (hv % 9);
          const h = 56 + ((hv >>> 8) % 26);
          const y = r * period + base + (period - h) / 2 - gap / 2;
          const inset = (hv >>> 12) % 4;
          const x = x0 + 2 + inset;
          const w = x1 - x0 - 4 - inset - ((hv >>> 14) % 3);
          const lm = (hv >>> 9) % 40;
          if ((hv >>> 3) % 7 === 0) drawPark(x - 1, y, w + 2, h, hv);
          else if (lm < 3 && w >= 40) drawTower(x, y, w, h);
          else if (lm === 3 && w >= 44) drawBurj(x, y, w, h);
          else if (lm === 4 && w >= 40) drawMosque(x, y, w, h);
          else if (lm === 5 && w >= 40) drawFrame(x, y, w, h);
          else drawRoof(x, y, w, h, hv >>> 2);
        }
      });
    }

    function fitText(text, maxW, size, weight) {
      let s = size;
      ctx.font = (weight || 'bold') + ' ' + s + 'px sans-serif';
      while (s > 6 && ctx.measureText(text).width > maxW) {
        s--;
        ctx.font = (weight || 'bold') + ' ' + s + 'px sans-serif';
      }
    }

    function panel(x, y, w, h, fill, stroke) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
      roundedRect(x - w / 2 + 3, y - h / 2 + 5, w, h, 4);
      ctx.fill();
      roundedRect(x - w / 2, y - h / 2, w, h, 4);
      ctx.fillStyle = fill;
      ctx.fill();
      ctx.strokeStyle = stroke;
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    // A road sign at the side of the road, with its post.
    function drawRoadSign(s) {
      const x = s.side < 0 ? 25 : 375;
      const y = s.y;
      ctx.fillStyle = '#6b6b6b';
      ctx.fillRect(x - 1.5, y + 10, 3, 24);
      ctx.textAlign = 'center';
      if (s.kind === 'speed') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
        ctx.beginPath();
        ctx.arc(x + 3, y + 5, 18, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(x, y, 18, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.strokeStyle = '#d62828';
        ctx.lineWidth = 5;
        ctx.stroke();
        ctx.fillStyle = '#111111';
        ctx.font = 'bold 14px sans-serif';
        ctx.fillText('120', x, y + 5);
      } else if (s.kind === 'camel' || s.kind === 'warn') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
        ctx.beginPath();
        ctx.moveTo(x + 3, y - 17);
        ctx.lineTo(x + 24, y + 19);
        ctx.lineTo(x - 18, y + 19);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(x, y - 20);
        ctx.lineTo(x + 21, y + 15);
        ctx.lineTo(x - 21, y + 15);
        ctx.closePath();
        ctx.fillStyle = '#ffd23f';
        ctx.fill();
        ctx.strokeStyle = '#d62828';
        ctx.lineWidth = 4;
        ctx.lineJoin = 'round';
        ctx.stroke();
        ctx.fillStyle = '#111111';
        if (s.kind === 'camel') {
          ctx.font = '15px sans-serif';
          ctx.fillText('\u{1F42A}', x, y + 10);
        } else {
          ctx.font = 'bold 18px sans-serif';
          ctx.fillText('!', x, y + 11);
        }
      } else if (s.kind === 'dest') {
        panel(x, y, 46, 38, '#1b7f4b', '#ffffff');
        ctx.fillStyle = '#ffffff';
        fitText(s.d.name, 42, 9);
        ctx.fillText(s.d.name, x, y - 8);
        fitText(s.d.ar, 42, 8, '');
        ctx.fillText(s.d.ar, x, y + 2);
        ctx.fillStyle = '#ffd23f';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText(s.km + ' km', x, y + 15);
      } else if (s.kind === 'tourist') {
        panel(x, y, 46, 34, '#7a4a21', '#ffffff');
        ctx.font = '13px sans-serif';
        ctx.fillStyle = '#ffffff';
        ctx.fillText('\u{1F3D9}️', x, y - 3);
        fitText(s.text, 42, 8);
        ctx.fillText(s.text, x, y + 11);
      } else if (s.kind === 'exit') {
        const flash = Math.floor(frameCount / 14) % 2 === 0;
        panel(x, y, 48, 40, '#1b7f4b', flash ? '#ffd23f' : '#ffffff');
        ctx.fillStyle = '#ffffff';
        fitText(leg === 'out' ? 'TUNNELS' : 'EXIT', 44, 13);
        ctx.fillText(leg === 'out' ? 'TUNNELS \u2B06' : 'EXIT \u27A1', x, y - 6);
        fitText(leg === 'out' ? 'Choose one' : dest.name, 44, 8);
        ctx.fillText(leg === 'out' ? 'Choose one' : dest.name, x, y + 5);
        ctx.fillStyle = '#ffd23f';
        ctx.font = 'bold 9px sans-serif';
        ctx.fillText(dest.kind === 'home' ? '\u{1F3E0}' : '\u{1F17F}️', x, y + 16);
      } else if (s.kind === 'home') {
        panel(x, y, 46, 34, '#1f5fa8', '#ffffff');
        ctx.fillStyle = '#ffffff';
        ctx.font = '14px sans-serif';
        ctx.fillText('\u{1F3E0}', x, y - 2);
        ctx.font = 'bold 10px sans-serif';
        ctx.fillText('Home • المنزل', x, y + 12);
      }
    }

    // A big green sign over the whole road
    function drawGantry(s) {
      const y = s.y;
      const lanes = leg === 'out';
      const h = lanes ? 40 : 26;
      ctx.fillStyle = '#6b6b6b';
      ctx.fillRect(roadLeft - 12, y - 6, 6, h + 14);
      ctx.fillRect(roadRight + 6, y - 6, 6, h + 14);
      ctx.globalAlpha = 0.84;
      ctx.fillStyle = '#1b7f4b';
      ctx.fillRect(roadLeft - 12, y - 8, roadRight - roadLeft + 24, h);
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.strokeRect(roadLeft - 10, y - 6, roadRight - roadLeft + 20, h - 4);
      ctx.globalAlpha = 1;
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      if (lanes) {
        // one column for each lane
        for (let i = 0; i < laneCount; i++) {
          const cx = roadLeft + i * laneW + laneW / 2;
          const d = laneDests[i];
          const words = d.name.split(' ');
          const half = Math.ceil(words.length / 2);
          const l1 = words.slice(0, half).join(' ');
          const l2 = words.slice(half).join(' ');
          fitText(l1, laneW - 4, 9);
          ctx.fillText(l1, cx, y + 8);
          if (l2) {
            fitText(l2, laneW - 4, 9);
            ctx.fillText(l2, cx, y + 19);
          }
          ctx.font = 'bold 9px sans-serif';
          ctx.fillStyle = '#ffd23f';
          ctx.fillText('\u2B06 ' + s.km + ' km', cx, y + 31);
          ctx.fillStyle = '#ffffff';
          if (i > 0) ctx.fillRect(roadLeft + i * laneW - 1, y - 6, 2, h - 4);
        }
      } else {
        ctx.font = 'bold 11px sans-serif';
        ctx.fillText('\u2B06 Dubai \u2022 دبي', W / 2 - 62, y + 9);
        fitText('\u2B06 Home ' + s.km + ' km', 130, 11);
        ctx.fillText('\u2B06 Home ' + s.km + ' km', W / 2 + 62, y + 9);
      }
    }

    function drawDrive() {
      const css = getComputedStyle(document.documentElement);
      const sand = css.getPropertyValue('--sand').trim() || '#e6d5ab';
      const road = css.getPropertyValue('--road').trim() || '#555a60';
      drawSideCity(sand);
      // the road
      ctx.fillStyle = road;
      ctx.fillRect(roadLeft, 0, roadRight - roadLeft, H);
      ctx.strokeStyle = '#f2ecdf';
      ctx.lineWidth = 4;
      ctx.setLineDash([24, 24]);
      laneLines.forEach((line) => {
        ctx.beginPath();
        ctx.moveTo(W / 2, line.y);
        ctx.lineTo(W / 2, line.y + 24);
        ctx.stroke();
      });
      ctx.setLineDash([]);
      // kerbs
      ctx.fillStyle = '#c9c2b2';
      ctx.fillRect(roadLeft - 10, 0, 10, H);
      ctx.fillRect(roadRight, 0, 10, H);
      ctx.fillStyle = '#e8b923';
      laneLines.forEach((line) => {
        ctx.fillRect(roadLeft - 10, line.y, 10, 14);
        ctx.fillRect(roadRight, line.y, 10, 14);
      });
      signs.filter((s) => s.kind !== 'gantry').forEach(drawRoadSign);
      drawGateLanes();

      coins.forEach((coin) => drawCoin(coin.x, coin.y, coin.r));
      shields.forEach((sh) => drawShieldPickup(sh.x, sh.y, sh.r));
      if ((police || policeWarning()) && !gameOver) drawPoliceGlow();
      traffic.forEach((other) => drawCar(other.x, other.y, other.w, other.h, other.color, '#333'));
      if (police) drawPoliceCar(police.x, police.y, car.w, car.h);

      if (crashing) {
        ctx.save();
        ctx.translate(car.x, car.y);
        ctx.rotate(crashAngle);
        drawCar(0, 0, car.w, car.h, carColor, carOutline);
        ctx.restore();
        splashes.forEach((s) => {
          const p = s.age / 26;
          ctx.beginPath();
          ctx.arc(s.x, s.y, 6 + p * 34, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(200, 165, 100, ' + 0.7 * (1 - p) + ')';
          ctx.lineWidth = 4;
          ctx.stroke();
        });
      } else {
        drawCar(car.x, car.y, car.w, car.h, carColor, carOutline);
      }
      signs.filter((s) => s.kind === 'gantry').forEach(drawGantry);
      drawGateSigns();
      drawGateCountdown();

      // the shield bubble
      if (shieldOn && !crashing && !gameOver) {
        ctx.beginPath();
        ctx.arc(car.x, car.y, 40 + Math.sin(frameCount / 8) * 2, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(41, 197, 246, 0.95)';
        ctx.lineWidth = 3;
        ctx.stroke();
      }
      if (shieldFlash > 0 && !gameOver) {
        const p = 1 - shieldFlash / 60;
        ctx.beginPath();
        ctx.arc(car.x, car.y, 40 + p * 50, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(41, 197, 246, ' + shieldFlash / 60 + ')';
        ctx.lineWidth = 4;
        ctx.stroke();
        ctx.fillStyle = 'rgba(41, 197, 246, ' + Math.min(1, shieldFlash / 20) + ')';
        ctx.font = 'bold 22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Shield saved you!', W / 2, 140);
      }

      // the trip bar at the top
      if (!gameOver) {
        const frac = Math.max(0, Math.min(1, travel / tripLen));
        ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';
        roundedRect(50, 8, W - 100, 38, 14);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 13px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText((leg === 'out' ? '\u{1F6E3}\uFE0F Choose a tunnel at 0 km' : '\u{1F3E0} Home') + ' \u2022 ' + Math.max(0, Math.ceil((tripLen - travel) / 700)) + ' km', W / 2, 26);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
        roundedRect(64, 33, W - 128, 7, 3.5);
        ctx.fill();
        ctx.fillStyle = leg === 'out' ? '#3ddc84' : dest.colour;
        if (frac > 0.02) {
          roundedRect(64, 33, (W - 128) * frac, 7, 3.5);
          ctx.fill();
        }
      }
      if (started && !gameOver && !arriving) {
        if (boosting && boostEnergy > 0) {
          ctx.fillStyle = 'rgba(255, 180, 0, 0.95)';
          ctx.font = 'bold 20px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('BOOST!', W / 2, 74);
        }
      }
      if (arriving) {
        ctx.fillStyle = 'rgba(0, 0, 0, ' + 0.5 * Math.max(0, 1 - arriveT / 90) + ')';
        ctx.fillRect(0, 0, W, H);
      }
    }

    // ---------- drawing: car parks and the buildings ----------
    function drawLot() {
      const css = getComputedStyle(document.documentElement);
      const road = css.getPropertyValue('--road').trim() || '#555a60';
      if (lotOutdoor()) drawOutdoorFront();
      else drawGarageWall();
      // the concrete floor of the car park
      ctx.fillStyle = '#8f9298';
      ctx.fillRect(0, 172, W, 30);
      ctx.fillStyle = '#e8b923';
      ctx.fillRect(0, 198, W, 4);
      ctx.fillStyle = lotOutdoor() ? '#6d7177' : '#5d6066';
      ctx.fillRect(0, 202, W, H - 202);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.08)';
      [[60, 480, 30], [310, 330, 22], [150, 560, 26], [340, 520, 18]].forEach(([ox, oy, r]) => {
        ctx.beginPath();
        ctx.ellipse(ox, oy, r, r * 0.5, 0, 0, Math.PI * 2);
        ctx.fill();
      });
      // bay lines and the cars parked in them
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.75)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 16; i++) {
        const r = bayRect(i);
        ctx.beginPath();
        ctx.moveTo(r.x, r.y);
        ctx.lineTo(r.x, r.y + r.h);
        ctx.moveTo(r.x + r.w, r.y);
        ctx.lineTo(r.x + r.w, r.y + r.h);
        ctx.moveTo(r.x, r.row === 0 ? r.y : r.y + r.h);
        ctx.lineTo(r.x + r.w, r.row === 0 ? r.y : r.y + r.h);
        ctx.stroke();
      }
      // a walkway to the door
      ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
      for (let y = 206; y < H - 10; y += 26) ctx.fillRect(194, y, 12, 14);
      bays.forEach((b, i) => {
        if (!b.occupied) return;
        const c = bayCentre(i);
        drawCar(c.x, c.y, 34, 58, b.colour, '#333');
      });
      // the free bays glow green, and the ramps lead to the other levels
      if (phase === 'park') {
        const glow = 0.3 + 0.2 * Math.sin(frameCount / 8);
        bays.forEach((b, i) => {
          if (b.occupied) return;
          const r = bayRect(i);
          ctx.fillStyle = 'rgba(61, 220, 132, ' + glow + ')';
          ctx.fillRect(r.x + 2, r.y + 2, r.w - 4, r.h - 4);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
          ctx.font = 'bold 22px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('P', r.x + r.w / 2, r.y + r.h / 2 + 8);
        });
      }
      if (phase === 'park' || phase === 'start') drawRamps();
      // cars driving about in the car park
      if (phase === 'walk') {
        lotCars.forEach((c) => {
          ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
          ctx.fillRect(c.x - 26, c.y - 12, 54, 28);
          roundedRect(c.x - 28, c.y - 14, 56, 28, 7);
          ctx.fillStyle = c.colour;
          ctx.fill();
          ctx.fillStyle = 'rgba(30, 40, 55, 0.75)';
          ctx.fillRect(c.x + c.dir * 10 - 6, c.y - 10, 12, 20);
          ctx.fillStyle = '#ffe9a0';
          ctx.fillRect(c.x + c.dir * 27, c.y - 10, 2, 5);
          ctx.fillRect(c.x + c.dir * 27, c.y + 5, 2, 5);
        });
      }
      // your car (with its boot open while you pack)
      if (phase === 'park' || (phase === 'walk' && carIsHere())) {
        drawCar(car.x, car.y, car.w, car.h, carColor, carOutline);
        if (phase === 'walk' && bootT > 0) {
          ctx.fillStyle = '#9b1c1c';
          ctx.fillRect(car.x - 14, car.y + car.h / 2, 28, 6);
        }
      }
      if (phase === 'park' && parked) {
        ctx.fillStyle = 'rgba(31, 191, 106, 0.95)';
        ctx.font = 'bold 20px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Parked! ✅', Math.min(W - 50, Math.max(50, car.x)), car.y - 40);
      }
      // you, walking
      if (phase === 'walk') {
        if (me.hurt <= 0 || Math.floor(me.hurt / 6) % 2 === 0) {
          ctx.save();
          ctx.translate(me.x, me.y);
          ctx.scale(1.7, 1.7);
          const lift = me.moving ? Math.abs(Math.sin(me.stepT * 0.45)) * 3 : 0;
          ctx.beginPath();
          ctx.arc(0, -lift, 5, 0, Math.PI * 2);
          ctx.fillStyle = '#d71920';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(0, -7 - lift, 3.5, 0, Math.PI * 2);
          ctx.fillStyle = '#f2c9a0';
          ctx.fill();
          ctx.restore();
        }
        if (mallTrolley) {
          ctx.font = '22px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillStyle = '#000000';
          ctx.fillText('\u{1F6D2}', me.x + 20, me.y + 8);
        }
        // an arrow to the door
        const bob = Math.sin(frameCount / 8) * 4;
        ctx.fillStyle = '#fff3a0';
        ctx.beginPath();
        ctx.moveTo(192, 176 + bob);
        ctx.lineTo(208, 176 + bob);
        ctx.lineTo(200, 190 + bob);
        ctx.fill();
        if (nearCar && (departing || (leg === 'out' && shopped)) && bootT <= 0) {
          ctx.fillStyle = 'rgba(31, 191, 106, 0.9)';
          ctx.font = 'bold 14px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('\u{1F697} Your car', Math.min(W - 46, Math.max(46, car.x)), car.y - 38);
        }
      }
    }

    // the ramps up and down between the levels of the car park
    function drawRamps() {
      const full = !bays.some((b) => !b.occupied);
      const ramp = (x0, up) => {
        const g = ctx.createLinearGradient(0, 462, 0, 596);
        g.addColorStop(0, up ? '#4a4d52' : '#7b7f86');
        g.addColorStop(1, up ? '#7b7f86' : '#4a4d52');
        ctx.fillStyle = g;
        ctx.fillRect(x0, 462, 76, 134);
        ctx.fillStyle = '#e8b923';
        ctx.fillRect(x0, 462, 4, 134);
        ctx.fillRect(x0 + 72, 462, 4, 134);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
        for (let k = 0; k < 3; k++) {
          const ay = up ? 560 - k * 34 : 490 + k * 34;
          ctx.beginPath();
          ctx.moveTo(x0 + 38, ay + (up ? -10 : 10));
          ctx.lineTo(x0 + 18, ay + (up ? 10 : -10));
          ctx.lineTo(x0 + 58, ay + (up ? 10 : -10));
          ctx.fill();
        }
        ctx.fillStyle = '#1f5fa8';
        roundedRect(x0 + 6, 468, 64, 22, 5);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 11px sans-serif';
        ctx.textAlign = 'center';
        const target = up ? lotLevel + 1 : lotLevel - 1;
        ctx.fillText((up ? '\u2B06 ' : '\u2B07 ') + (target === topLevel() && !indoorMosque() ? 'L' + target + ' Outdoor' : 'Level ' + target), x0 + 38, 483);
      };
      if (lotLevel < topLevel()) ramp(322, true);
      if (lotLevel > 1) ramp(2, false);
      if (full && phase === 'park' && lotLevel < topLevel()) {
        const bob = Math.sin(frameCount / 7) * 6;
        ctx.fillStyle = '#fff3a0';
        ctx.beginPath();
        ctx.moveTo(360, 440 + bob);
        ctx.lineTo(344, 420 + bob);
        ctx.lineTo(376, 420 + bob);
        ctx.fill();
      }
    }

function drawOutdoorFront() {
      if (lotKind === 'mosque') {
        drawMosqueFront();
        return;
      }
      if (lotKind === 'beach') {
        drawBeachFront();
        return;
      }
      if (lotKind === 'metro') {
        drawMetroFront();
        return;
      }
      const sky = ctx.createLinearGradient(0, 0, 0, 172);
      sky.addColorStop(0, '#9fd3ee');
      sky.addColorStop(1, '#e8f4fa');
      ctx.fillStyle = sky;
      ctx.fillRect(0, 0, W, 172);
      // far away towers
      ctx.fillStyle = 'rgba(120, 150, 175, 0.4)';
      [[8, 80, 24], [34, 62, 20], [340, 70, 26], [368, 90, 22]].forEach(([x, y, w]) => ctx.fillRect(x, y, w, 172 - y));
      if (lotKind === 'home') {
        // the apartment building where you live
        ctx.fillStyle = '#f3e7cf';
        ctx.fillRect(86, 14, 228, 158);
        ctx.fillStyle = '#d8c39a';
        ctx.fillRect(86, 14, 228, 10);
        for (let r = 0; r < 6; r++) {
          for (let c = 0; c < 6; c++) {
            const wx = 100 + c * 36;
            const wy = 32 + r * 21;
            ctx.fillStyle = (r + c) % 4 === 0 ? '#ffe9a8' : '#9fc6de';
            ctx.fillRect(wx, wy, 22, 13);
            ctx.fillStyle = '#b9a272';
            ctx.fillRect(wx - 3, wy + 13, 28, 3); // a little balcony
          }
        }
        ctx.fillStyle = '#6b4a2e';
        roundedRect(176, 134, 48, 38, 4);
        ctx.fill();
        ctx.fillStyle = '#c28a52';
        ctx.fillRect(180, 138, 18, 34);
        ctx.fillRect(202, 138, 18, 34);
        ctx.fillStyle = '#ffd23f';
        ctx.beginPath();
        ctx.arc(198, 156, 2, 0, Math.PI * 2);
        ctx.arc(202, 156, 2, 0, Math.PI * 2);
        ctx.fill();
        roundedRect(140, 106, 120, 22, 8);
        ctx.fillStyle = '#2d6a4f';
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 15px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F3E0} MY HOME • بيتي', 200, 122);
      } else {
        // the mall
        ctx.fillStyle = '#efe7da';
        ctx.fillRect(14, 50, 372, 122);
        const glass = ctx.createLinearGradient(0, 56, 0, 120);
        glass.addColorStop(0, '#cfe9f7');
        glass.addColorStop(1, '#8fbfd9');
        ctx.fillStyle = glass;
        ctx.fillRect(24, 100, 352, 36);
        ctx.fillStyle = '#c4baa6';
        for (let x = 24; x <= 376; x += 44) ctx.fillRect(x, 100, 3, 36);
        // the dome
        ctx.beginPath();
        ctx.arc(200, 52, 46, Math.PI, Math.PI * 2);
        ctx.fillStyle = dest.colour;
        ctx.fill();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
        ctx.lineWidth = 3;
        for (let k = 1; k < 4; k++) {
          ctx.beginPath();
          ctx.arc(200, 52, 46, Math.PI + (k * Math.PI) / 4, Math.PI + (k * Math.PI) / 4);
          ctx.moveTo(200, 52);
          ctx.lineTo(200 + Math.cos(Math.PI + (k * Math.PI) / 4) * 46, 52 + Math.sin(Math.PI + (k * Math.PI) / 4) * 46);
          ctx.stroke();
        }
        // the name
        roundedRect(60, 62, 280, 36, 10);
        ctx.fillStyle = dest.colour;
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        fitText(dest.name, 250, 18);
        ctx.fillText(dest.name, 200, 80);
        fitText(dest.ar, 250, 12, '');
        ctx.fillText(dest.ar, 200, 93);
        // the glass doors with a striped awning
        ctx.fillStyle = '#2b3b4a';
        ctx.fillRect(170, 126, 60, 46);
        ctx.fillStyle = 'rgba(160, 215, 240, 0.8)';
        ctx.fillRect(173, 130, 25, 42);
        ctx.fillRect(202, 130, 25, 42);
        for (let k = 0; k < 6; k++) {
          ctx.fillStyle = k % 2 ? '#ffffff' : dest.colour;
          ctx.fillRect(166 + k * 11, 116, 11, 12);
        }
        ctx.font = '13px sans-serif';
        ctx.fillStyle = '#000000';
        ctx.fillText('\u{1F6CD}️', 90, 125);
        ctx.fillText('\u{1F6CD}️', 310, 125);
      }
      // palms on each side
      [[28, 160], [372, 160], [74, 164], [326, 164]].forEach(([px, py]) => {
        ctx.fillStyle = '#7a5a3a';
        ctx.fillRect(px - 2, py - 24, 4, 24);
        drawPalm(px, py - 26);
      });
    }


    function drawGarageLight() {
      if (lotOutdoor()) return; // the roof has no ceiling lights: it is sunny
      // pools of light under the lamps, and darker corners: it is indoors
      [[70, 300], [200, 300], [330, 300], [70, 470], [200, 470], [330, 470]].forEach(([lx, ly]) => {
        const g = ctx.createRadialGradient(lx, ly, 4, lx, ly, 110);
        g.addColorStop(0, 'rgba(255, 250, 215, 0.16)');
        g.addColorStop(1, 'rgba(255, 250, 215, 0)');
        ctx.fillStyle = g;
        ctx.fillRect(lx - 110, ly - 110, 220, 220);
      });
      const v = ctx.createLinearGradient(0, 200, 0, H);
      v.addColorStop(0, 'rgba(0, 0, 0, 0)');
      v.addColorStop(1, 'rgba(0, 0, 0, 0.28)');
      ctx.fillStyle = v;
      ctx.fillRect(0, 200, W, H - 200);
    }

    // a person seen from the side, walking
    function drawShopper(x, y, look, scale, dir, moving, t, bag) {
      const [skin, shirt, pants] = look;
      const swing = moving ? Math.sin(t * 0.22) : 0;
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale * dir, scale);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.18)';
      ctx.beginPath();
      ctx.ellipse(0, 0, 15, 4, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = pants;
      ctx.lineWidth = 6;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(-3, -34);
      ctx.lineTo(-3 + swing * 9, -2);
      ctx.moveTo(4, -34);
      ctx.lineTo(4 - swing * 9, -2);
      ctx.stroke();
      roundedRect(-10, -66, 20, 34, 8);
      ctx.fillStyle = shirt;
      ctx.fill();
      ctx.strokeStyle = skin;
      ctx.lineWidth = 5;
      ctx.beginPath();
      ctx.moveTo(0, -62);
      ctx.lineTo(8 + swing * 3, -42);
      ctx.stroke();
      if (bag) {
        roundedRect(5 + swing * 3, -44, 13, 15, 2);
        ctx.fillStyle = '#c77dff';
        ctx.fill();
        ctx.strokeStyle = '#7b2cbf';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(8 + swing * 3, -44);
        ctx.lineTo(11 + swing * 3, -50);
        ctx.lineTo(15 + swing * 3, -44);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(0, -75, 9, 0, Math.PI * 2);
      ctx.fillStyle = skin;
      ctx.fill();
      ctx.fillStyle = '#2b2118';
      ctx.beginPath();
      ctx.arc(0, -78, 9, Math.PI, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawSitter(x, y, look) {
      const [skin, shirt, pants] = look;
      ctx.fillStyle = shirt;
      roundedRect(x - 9, y - 40, 18, 26, 7);
      ctx.fill();
      ctx.strokeStyle = pants;
      ctx.lineWidth = 7;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(x - 2, y - 14);
      ctx.lineTo(x + 14, y - 14);
      ctx.lineTo(x + 14, y + 2);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(x, y - 49, 8, 0, Math.PI * 2);
      ctx.fillStyle = skin;
      ctx.fill();
      ctx.fillStyle = '#2b2118';
      ctx.beginPath();
      ctx.arc(x, y - 52, 8, Math.PI, Math.PI * 2);
      ctx.fill();
    }

    function drawBench(x, y, sitter) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.16)';
      ctx.fillRect(x - 36, y - 2, 72, 7);
      ctx.fillStyle = '#7a5a3a';
      ctx.fillRect(x - 36, y - 22, 72, 6);
      ctx.fillRect(x - 36, y - 38, 72, 6);
      ctx.fillStyle = '#5b4026';
      ctx.fillRect(x - 33, y - 16, 5, 16);
      ctx.fillRect(x + 28, y - 16, 5, 16);
      if (sitter) drawSitter(x, y - 18, sitter);
    }

    function drawPlant(x, y) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
      ctx.beginPath();
      ctx.ellipse(x, y, 22, 6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#b86f3a';
      ctx.fillRect(x - 14, y - 26, 28, 26);
      ctx.fillStyle = '#8f5428';
      ctx.fillRect(x - 14, y - 26, 28, 5);
      ctx.strokeStyle = '#7a5a3a';
      ctx.lineWidth = 5;
      ctx.beginPath();
      ctx.moveTo(x, y - 26);
      ctx.lineTo(x, y - 90);
      ctx.stroke();
      ctx.strokeStyle = '#2f8a46';
      ctx.lineWidth = 6;
      ctx.lineCap = 'round';
      [-2.6, -2.1, -1.6, -1.1, -0.6].forEach((a) => {
        ctx.beginPath();
        ctx.moveTo(x, y - 90);
        ctx.quadraticCurveTo(x + Math.cos(a) * 22, y - 90 + Math.sin(a) * 18 - 6, x + Math.cos(a) * 36, y - 90 + Math.sin(a) * 6 + 22);
        ctx.stroke();
      });
    }

    // the escalator in the middle of the mall: moving steps going up (or down)
    function drawEscalator(up) {
      const x1 = 308;
      const y1 = 398;
      const x2 = 392;
      const y2 = 214;
      // the hall behind it
      ctx.fillStyle = '#e6e0d4';
      ctx.fillRect(300, 130, 100, 270);
      ctx.fillStyle = 'rgba(190, 225, 245, 0.55)';
      ctx.fillRect(306, 146, 88, 60);
      ctx.strokeStyle = '#8f877b';
      ctx.lineWidth = 3;
      ctx.strokeRect(306, 146, 88, 60);
      ctx.fillStyle = '#2b2230';
      ctx.fillRect(310, 218, 80, 22);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 11px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(up ? '\u2B06 UP \u2022 Level ' + (mallFloor + 1) : '\u2B07 DOWN \u2022 Level ' + (mallFloor - 1), 350, 233);
      // the moving staircase
      ctx.save();
      const ang = Math.atan2(y2 - y1, x2 - x1);
      const len = Math.hypot(x2 - x1, y2 - y1);
      ctx.translate(x1, y1);
      ctx.rotate(ang);
      ctx.fillStyle = '#4a4f57';
      ctx.fillRect(0, -17, len, 34);
      const move = ((mallTime * 0.6) % 14) * (up ? 1 : -1);
      for (let s = -14; s < len + 14; s += 14) {
        const sx = s + move;
        if (sx < 0 || sx > len - 2) continue;
        ctx.fillStyle = '#9aa0a8';
        ctx.fillRect(sx, -16, 11, 32);
        ctx.fillStyle = '#d4d8dd';
        ctx.fillRect(sx, -16, 11, 3);
      }
      // the handrails
      ctx.fillStyle = '#1a1d22';
      ctx.fillRect(0, -23, len, 6);
      ctx.fillRect(0, 17, len, 6);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';
      ctx.fillRect(0, -22, len, 1.5);
      ctx.restore();
