    const curStalls = () => (eidParty ? eidStalls : foodStalls);
    const inFoodCourt = () => mallShop >= 0 && !!mallShopsData[mallShop].food;
    const nearStall = () => {
      for (let k = 0; k < 4; k++) if (Math.abs(mm.x - stallX[k]) < 36) return k;
      return -1;
    };
    const nearTable = () => {
      for (let t = 0; t < 3; t++) if (Math.abs(mm.x - tableX[t]) < 40) return t;
      return -1;
    };

    function orderFood(k) {
      const [emoji, name, price] = curStalls()[k];
      if (mallTray) {
        say('Eat your food first! Find a free table.', 110);
        return;
      }
      if (mallWallet < price) {
        say('Not enough coins for the ' + name.toLowerCase() + '!', 100);
        blip(220, 160, 0.2, 0.08);
        return;
      }
      mallWallet -= price;
      mallTray = { emoji, name, price };
      say('Here is your ' + name.toLowerCase() + ' ' + emoji + '! Tap a free table to sit down.', 180);
      blip(660, 880, 0.15, 0.1);
    }

    function sitDown(t) {
      if (mallEat) return;
      if (!mallTray) {
        say('Order some food first!', 90);
        return;
      }
      if (tableBusy[t]) {
        say('That table is taken. Try another one.', 100);
        return;
      }
      mallEat = { t: 0, table: t, tray: mallTray };
      mm.x = tableX[t] - 30;
      mm.y = 476;
      mm.dir = 1;
      mm.goto = null;
      say('Yum! Eating your ' + mallTray.name.toLowerCase() + '...', 130);
      if (!buddy && !partnerGone) {
        partner = { name: buddyNames[Math.floor(Math.random() * buddyNames.length)], look: t === 2 ? shopperLook[2] : shopperLook[4], table: t, chatT: 0, done: false };
        say(partner.name + ' is sitting opposite you \u{1F642} Yum! Eating your ' + mallTray.name.toLowerCase() + '...', 150);
      }
    }

    // press the action: go in a shop, ride the escalator, take a trolley, buy, eat, or go out
    function mallAction() {
      if (phase !== 'mall' || mallBusy()) return;
      if (mallShop < 0) {
        const d = nearMallDoor();
        if (d >= 0) enterShop(d);
        else if (nearTrolleyBay()) trolleyAction();
        else if (nearMallEsc()) rideEscalator();
        else if (nearLift()) openLift('mall', { type: 'floor', val: mallFloor });
      } else if (inFoodCourt()) {
        const k = nearStall();
        const t = nearTable();
        if (k >= 0) orderFood(k);
        else if (t >= 0) sitDown(t);
        else if (mm.x < 70) leaveShop();
      } else if (inFacility()) {
        const k = nearFac();
        if (k >= 0) facilityAct(k);
        else if (mm.x < 70) leaveShop();
      } else {
        const k = nearShelf();
        if (k >= 0) mallBuy(k);
        else if (mm.x < 70) leaveShop();
      }
    }

    function mallPress(p) {
      mm.goto = null;
      mm.act = null;
      if (mallBusy()) return;
      if (mallShop < 0) {
        for (let s = 0; s < slotCount(); s++) {
          const sx = mallDoorX(s) - mallCamX;
          if (p.x > sx - 40 && p.x < sx + 40 && p.y > 240 && p.y < 416) {
            mm.goto = mallDoorX(s);
            return;
          }
        }
        const ex = mallEscX - mallCamX;
        if (!isMosque() && p.x > ex - 56 && p.x < ex + 56 && p.y > 200 && p.y < 440) {
          mm.goto = mallEscX;
          return;
        }
        const lx = liftX - mallCamX;
        if (!isMosque() && p.x > lx - 48 && p.x < lx + 48 && p.y > 200 && p.y < 440) {
          mm.goto = liftX;
          return;
        }
        const bx = trolleyBayX - mallCamX;
        if (!isMosque() && mallFloor === 0 && p.x > bx - 44 && p.x < bx + 44 && p.y >= 416 && p.y < 475) {
          mm.goto = trolleyBayX;
          mm.act = { kind: 'trolley' };
          return;
        }
      } else if (inFoodCourt()) {
        if (p.x < 70 && p.y > 170 && p.y < 420) {
          mm.goto = 20;
          return;
        }
        if (eidParty) {
          for (let i = 0; i < partyKids.length; i++) {
            if (Math.abs(p.x - partyKids[i][0]) < 26 && p.y > partyKids[i][1] - 58 && p.y < partyKids[i][1] + 10) {
              mm.goto = partyKids[i][0];
              mm.act = { kind: 'kid', i };
              return;
            }
          }
        }
        for (let k = 0; k < 4; k++) {
          if (Math.abs(p.x - stallX[k]) < 40 && p.y > 190 && p.y < 340) {
            mm.goto = stallX[k];
            mm.act = { kind: 'stall', i: k };
            return;
          }
        }
        for (let t = 0; t < 3; t++) {
          if (Math.abs(p.x - tableX[t]) < 48 && p.y > 395 && p.y < 500) {
            mm.goto = tableX[t];
            mm.act = { kind: 'table', i: t };
            return;
          }
        }
      } else if (inFacility()) {
        if (p.x < 70 && p.y > 170 && p.y < 420) {
          mm.goto = 20;
          return;
        }
        const spots = facSpots[mallShopsData[mallShop].facility];
        for (let k = 0; k < spots.length; k++) {
          if (Math.abs(p.x - spots[k].x) < 44 && p.y > (spots[k].y0 || 140) && p.y < (spots[k].y1 || 470)) {
            mm.goto = spots[k].x;
            mm.act = { kind: 'fac', i: k };
            return;
          }
        }
      } else {
        if (p.x < 70 && p.y > 170 && p.y < 420) {
          mm.goto = 20;
          return;
        }
        for (let k = 0; k < 3; k++) {
          if (Math.abs(p.x - mallShelfX[k]) < 44 && p.y > 300 && p.y < 440) {
            mm.goto = mallShelfX[k];
            return;
          }
        }
      }
      hold = p;
    }

    function wander(sh, step, minX, maxX) {
      sh.t += step;
      if (sh.v === 0) return;
      if (sh.pause > 0) {
        sh.pause -= step;
        return;
      }
      sh.x += sh.dir * sh.v * step;
      if (sh.x < minX || sh.x > maxX) {
        sh.dir = -sh.dir;
        sh.x = Math.max(minX, Math.min(maxX, sh.x));
      }
      if (Math.random() < 0.002 * step) sh.pause = 60 + Math.random() * 120;
    }

    function updateMall(step) {
      mallTime += step;
      facFx = Math.max(0, facFx - step);
      updateToilet(step);
      updateAdhan(step);
      for (let i = 0; i < 4; i++) kidSay[i] = Math.max(0, kidSay[i] - step);
      if (buddy && buddy.bye) {
        updateBuddyBye(step);
        return;
      }
      if (salah) {
        updateSalah(step);
        return;
      }
      if (toi.stage === 4) return;
      if (mallEat) {
        // sitting at the table, eating
        mallEat.t += step;
        if (Math.floor(mallEat.t / 26) !== Math.floor((mallEat.t - step) / 26) && mallEat.t < 130) blip(280 + Math.random() * 120, 200, 0.07, 0.07);
        if (mallEat.t >= 140 && chatWait(step)) {
          const price = mallEat.tray.price;
          mallEat = null;
          mallTray = null;
          mm.x = tableX[nearTable() >= 0 ? nearTable() : 1] - 60;
          mm.y = 500;
          if (eidParty && !eidPartyDone) {
            eidPartyDone = true;
            addScore(15 + price);
            say('Eid breakfast with everyone! \u{1F973} +' + (15 + price), 220);
            [523, 659, 784, 1047].forEach((f, j) => blip(f, f, 0.25, 0.1, j * 0.12));
          } else {
            addScore(5 + price);
            say('Yummy! \u{1F60B} +' + (5 + price), 150);
          }
          [523, 659, 784].forEach((f, j) => blip(f, f, 0.15, 0.09, j * 0.1));
        }
        mallShopFolk.forEach((s) => wander(s, step, 60, 360));
        return;
      }
      if (mallRide) {
        mallRide.t += step;
        const inLift = mallRide.kind === 'lift';
        if (inLift && !mallRide.moved && mallRide.t >= 45) {
          mallRide.moved = true;
          mallFloor = mallRide.to;
          blip(1200, 1200, 0.25, 0.1); // ding!
        }
        if (mallRide.t >= (inLift ? 76 : 90)) {
          if (!inLift) mallFloor += mallRide.dir;
          mallRide = null;
          mm.x = inLift ? liftX : mallEscX;
          mm.y = 505;
          say(mallFloor === 0 ? 'Ground floor' : mallFloor === 1 ? 'Floor 1: shops and the food court!' : 'Floor ' + mallFloor + ': more shops!', 120);
        }
        return;
      }
      let dx = 0;
      let dy = 0;
      if (mm.goto !== null) {
        if (Math.abs(mm.goto - mm.x) < 6) {
          mm.goto = null;
          const a = mm.act;
          mm.act = null;
          if (a && a.kind === 'trolley') trolleyAction();
          else if (a && a.kind === 'stall') orderFood(a.i);
          else if (a && a.kind === 'table') sitDown(a.i);
          else if (a && a.kind === 'fac') facilityAct(a.i);
          else if (a && a.kind === 'kid') giveKidGift(a.i);
          else mallAction();
        } else dx = mm.goto > mm.x ? 1 : -1;
      }
      if (hold) {
        mm.goto = null;
        mm.act = null;
        const px = hold.x + (mallShop < 0 ? mallCamX : 0);
        if (Math.abs(px - mm.x) > 5) dx = px > mm.x ? 1 : -1;
        if (Math.abs(hold.y - mm.y) > 6) dy = hold.y > mm.y ? 1 : -1;
      }
      if (keys.left) dx -= 1;
      if (keys.right) dx += 1;
      if (keys.up) dy -= 1;
      if (keys.down) dy += 1;
      mm.moving = dx !== 0 || dy !== 0;
      if (mm.moving) {
        if (dx !== 0) mm.dir = dx > 0 ? 1 : -1;
        const maxX = mallShop < 0 ? worldW() - 30 : 380;
        mm.x = Math.max(mallShop < 0 ? 30 : 22, Math.min(maxX, mm.x + Math.sign(dx) * 2.8 * step));
        mm.y = Math.max(452, Math.min(548, mm.y + Math.sign(dy) * 1.8 * step));
        mm.stepT += step;
      }
      updateBuddy(step);
      if (mallShop < 0) {
        if (adhan.t < 0) mallShoppers.forEach((s) => wander(s, step, 60, mallWorldW - 60));
        const want = Math.max(0, Math.min(worldW() - W, mm.x - 200));
        mallCamX += (want - mallCamX) * (1 - Math.pow(1 - 0.12, step));
      } else {
        if (!inFacility()) mallShopFolk.forEach((s) => wander(s, step, 60, 360));
        if (mm.x <= 24) leaveShop();
      }
    }

    // ---------- your home: wake up, make breakfast, get your things and go down in the lift ----------
    const apt = { food: false, cooking: 0, cooked: false, eating: null, eaten: false, items: [false, false, false, false], woke: false, showered: false, brushed: false, shower: 0, menu: [], fade: 0 };
    // the calendar: every new day is the next day of the week, and Friday is the day of the Friday prayer
    let gameDate = new Date();
    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const isFriday = () => gameDate.getDay() === 5;
    let fridayDone = false; // you did the Friday prayer today
    let towed = false;
    function saveDay() {
      try {
        localStorage.setItem('carDodgeDay', JSON.stringify({ y: gameDate.getFullYear(), m: gameDate.getMonth(), d: gameDate.getDate(), fd: fridayDone }));
      } catch (e) {}
    }
    function loadDay() {
      try {
        const sd = JSON.parse(localStorage.getItem('carDodgeDay') || 'null');
        if (sd && sd.y > 2000 && sd.m >= 0 && sd.m < 12 && sd.d >= 1 && sd.d <= 31) {
          gameDate = new Date(sd.y, sd.m, sd.d);
          fridayDone = !!sd.fd;
        }
      } catch (e) {}
    }
    let calOpen = false;
    let calLeave = false; // the calendar opened when you go out
    let aptRoom = 'kitchen'; // your flat: the bedroom, the bathroom (downstairs) and the kitchen
    const bedX = 85;
    const stairsX = 352;
    const bathX = { shower: 75, sink: 190, door: 352 };
    // what is in the fridge: [emoji, name, needs cooking]
    const fridgeFoods = [
      ['\u{1F95A}', 'Eggs', true], ['\u{1F95E}', 'Pancakes', true], ['\u{1F9C7}', 'Waffles', true], ['\u{1F35E}', 'Toast', true],
      ['\u{1F341}', 'Maple syrup', false], ['\u{1F36F}', 'Honey', false], ['\u{1F9C8}', 'Butter', false], ['\u{1F95B}', 'Milk', false],
      ['\u{1F9C3}', 'Juice', false], ['\u{1F353}', 'Strawberries', false], ['\u{1F34C}', 'Banana', false], ['\u{1F963}', 'Cereal', false],
    ];
    let fridgeOpen = false;
    let fridgePick = [];
    const fridgeCell = (i) => ({ x: 30 + (i % 3) * 112, y: 112 + Math.floor(i / 3) * 70, w: 104, h: 62 });
    const hm = { x: 200, y: 505, dir: 1, stepT: 0, moving: false, goto: null, act: null };
    const aptX = { fridge: 50, stove: 132, table: 222, shelf: 305, door: 368 };
    const aptItems = [['\u{1F511}', 'car keys'], ['\u{1F45B}', 'wallet'], ['\u{1F4F1}', 'phone'], ['\u{1F392}', 'bag']];
    const aptItemX = [276, 298, 320, 342];
    // the car park under your building: your car is where you left it last time
    function setupHomeLot() {
      lotKind = 'home';
      startFree = 1;
      levelBays = {};
      lotLevel = carKindNow === 'home' ? carLevel : 1;
      bays = levelBays[lotLevel] = makeLevel(lotLevel);
      if (carKindNow === 'home') {
        bays[carBay].occupied = false;
        const c = bayCentre(carBay);
        car.x = c.x;
        car.y = c.y;
      }
      levelFade = 0;
      levelFadeTo = 0;
    }

    function enterApartment(first) {
      phase = 'apartment';
      leg = 'out';
      dest = homeDest;
      shopped = false;
      mallActive = false;
      mallBag = [];
      mallTrolley = false;
      bootDone = false;
      apt.food = false;
      apt.cooking = 0;
      apt.cooked = false;
      apt.eating = null;
      apt.eaten = false;
      apt.skipped = false;
      apt.items = [false, false, false, false];
      aptRoom = 'bed';
      apt.calSeen = false;
      calOpen = false;
      prayMode = isFriday() ? 'friday' : 'normal';
      apt.woke = false;
      apt.showered = false;
      apt.brushed = false;
      apt.shower = 0;
      apt.menu = [];
      apt.fade = 0;
      fridgeOpen = false;
      fridgePick = [];
      hm.x = bedX;
      hm.y = 505;
      hm.dir = 1;
      hm.goto = null;
      hm.act = null;
      hold = null;
      departing = false;
      setupHomeLot();
      say((first ? 'Good morning! ' : 'A new day! ') + 'It is ' + dayNames[gameDate.getDay()] + (isFriday() ? ' \u{1F54C}' : '') + ' \u2600\uFE0F Tap to wake up', 260);
    }

    function goRoom(r) {
      aptRoom = r;
      apt.fade = 50;
      hm.goto = null;
      hm.act = null;
      hold = null;
      hm.y = 505;
      if (r === 'bath') {
        hm.x = 330;
        hm.dir = -1;
        say('Down the stairs ⬇️ to the bathroom. Time for a shower! \u{1F6BF}', 200);
        [600, 500, 400].forEach((f, j) => blip(f, f, 0.1, 0.07, j * 0.12));
      } else if (r === 'kitchen') {
        hm.x = 40;
        hm.dir = 1;
        say(carKindNow !== 'home' ? 'Your car is at ' + carPlaceName + ' (level ' + carLevel + '). Take the metro to get it!' : 'Open the fridge and choose your breakfast \u{1F373}', 240);
        blip(500, 700, 0.2, 0.07);
      }
    }

    function aptAction(a) {
      if (phase !== 'apartment' || apt.eating || apt.cooking > 0 || apt.shower > 0 || fridgeOpen || calOpen || apt.fade > 25) return;
      if (aptRoom === 'bed') {
        if (a === 'bed') {
          if (!apt.woke) {
            apt.woke = true;
            hm.x = 178;
            hm.dir = 1;
            say('Good morning! ☀️ Go down the stairs to the shower.', 220);
            [392, 523, 659].forEach((f, j) => blip(f, f, 0.2, 0.08, j * 0.12));
          } else say('Your bed is made. Time for the shower! \u{1F6BF}', 110);
        } else if (a === 'stairs') {
          if (!apt.woke) say('Wake up first! Tap your bed \u{1F6CF}️', 100);
          else goRoom('bath');
        }
        return;
      }
      if (aptRoom === 'bath') {
        if (a === 'shower') {
          if (apt.showered) say('You are already clean ✨', 90);
          else {
            apt.shower = 230;
            hm.goto = null;
            hm.x = bathX.shower;
            say('Shower time! \u{1F6BF}', 130);
          }
        } else if (a === 'sink') {
          if (!apt.brushed) {
            apt.brushed = true;
            addScore(1);
            say('Brush brush! \u{1FAA5} Clean teeth +1', 120);
            blip(900, 1100, 0.15, 0.06);
          } else say('Your teeth are clean \u{1F601}', 90);
        } else if (a === 'door') {
          if (!apt.showered) say('Have your shower first! \u{1F6BF}', 110);
          else goRoom('kitchen');
        }
        return;
      }
      if (a === 'fridge') {
        if (apt.food) say('You chose your breakfast: ' + apt.menu.map((m) => m[0]).join(' '), 110);
        else openFridge();
      } else if (a === 'stove') {
        if (!apt.food) say('Choose your breakfast from the fridge first!', 110);
        else if (apt.cooked) say('Breakfast is ready on the table!', 90);
        else {
          apt.cooking = 110;
          say('Cooking ' + apt.menu.filter((m) => m[2]).map((m) => m[1].toLowerCase()).join(' and ') + '... \u{1F373}', 100);
        }
      } else if (a === 'table') {
        if (!apt.cooked) say(apt.food ? 'Cook the breakfast first!' : 'Start by choosing food from the fridge.', 100);
        else if (apt.eaten) say('You have had your breakfast.', 90);
        else {
          apt.eating = { t: 0 };
          hm.x = aptX.table - 28;
          hm.y = 500;
          say('Yum yum! Eating breakfast...', 120);
        }
      } else if (a === 'door') {
        if (!apt.items[0]) say('You need your car keys \u{1F511}! They are on the shelf by the door.', 150);
        else if (!apt.eaten && !apt.skipped) {
          apt.skipped = true;
          say('Breakfast first? Tap the table. Or tap the door again to go without it.', 170);
        } else if (!apt.calSeen) openCalendar(true);
        else leaveApartment();
      } else if (typeof a === 'number') {
        if (apt.items[a]) say('You already have your ' + aptItems[a][1] + '.', 80);
        else {
          apt.items[a] = true;
          addScore(1);
          say('Got your ' + aptItems[a][1] + ' ' + aptItems[a][0] + ' +1', 100);
          blip(700, 1000, 0.12, 0.1);
        }
      }
    }

    // ---- the open fridge: choose up to 3 things for breakfast
    function openFridge() {
      fridgeOpen = true;
      fridgePick = [];
      hold = null;
      blip(700, 500, 0.15, 0.08);
      say('The fridge is open! Choose up to 3 things.', 160);
    }
    function confirmFridge() {
      fridgeOpen = false;
      apt.food = true;
      apt.menu = fridgePick.map((i) => fridgeFoods[i]);
      addScore(1);
      blip(500, 800, 0.15, 0.1);
      if (apt.menu.some((m) => m[2])) say('Nice choice! ' + apt.menu.map((m) => m[0]).join(' ') + ' Now cook it on the stove \u{1F373}', 200);
      else {
        apt.cooked = true;
        say('Nice choice! ' + apt.menu.map((m) => m[0]).join(' ') + ' No cooking needed: take it to the table.', 200);
      }
    }
    function fridgePress(p) {
      if (p.x > 130 && p.x < 270 && p.y > 508 && p.y < 548) {
        fridgeOpen = false;
        return;
      }
      if (p.x > 90 && p.x < 310 && p.y > 440 && p.y < 490 && fridgePick.length) {
        confirmFridge();
        return;
      }
      for (let i = 0; i < fridgeFoods.length; i++) {
        const c = fridgeCell(i);
        if (p.x > c.x && p.x < c.x + c.w && p.y > c.y && p.y < c.y + c.h) {
          const at = fridgePick.indexOf(i);
          if (at >= 0) fridgePick.splice(at, 1);
          else if (fridgePick.length >= 3) say('Only 3 things! Tap one to put it back.', 100);
          else fridgePick.push(i);
          blip(800, 800, 0.05, 0.06);
          return;
        }
      }
    }
    function drawFridgePanel() {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.62)';
      ctx.fillRect(0, 0, W, H);
      roundedRect(16, 40, 368, 520, 18);
      ctx.fillStyle = '#eef6fb';
      ctx.fill();
      ctx.strokeStyle = '#7fb2d9';
      ctx.lineWidth = 4;
      ctx.stroke();
      ctx.fillStyle = '#7fb2d9';
      roundedRect(16, 40, 368, 56, 18);
      ctx.fill();
      ctx.fillRect(16, 74, 368, 22);
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 18px sans-serif';
      ctx.fillText('\u{1F9CA} THE FRIDGE: CHOOSE BREAKFAST', 200, 66);
      ctx.font = '12px sans-serif';
      ctx.fillText('Pick up to 3 things (' + fridgePick.length + '/3)', 200, 87);
      fridgeFoods.forEach((f, i) => {
        const c = fridgeCell(i);
        const on = fridgePick.indexOf(i) >= 0;
        roundedRect(c.x, c.y, c.w, c.h, 12);
        ctx.fillStyle = on ? '#d9f7e3' : '#ffffff';
        ctx.fill();
        ctx.strokeStyle = on ? '#2fbf71' : '#b9c7d3';
        ctx.lineWidth = on ? 4 : 2;
        ctx.stroke();
        ctx.font = '28px sans-serif';
        ctx.fillStyle = '#000000';
        ctx.textAlign = 'center';
        ctx.fillText(f[0], c.x + c.w / 2, c.y + 34);
        fitText(f[1], c.w - 8, 12);
        ctx.fillStyle = '#2b2230';
        ctx.fillText(f[1], c.x + c.w / 2, c.y + 54);
        if (f[2]) {
          ctx.font = '11px sans-serif';
          ctx.fillText('\u{1F525}', c.x + c.w - 12, c.y + 16);
        }
        if (on) {
          ctx.font = 'bold 14px sans-serif';
          ctx.fillStyle = '#2fbf71';
          ctx.fillText('✅', c.x + 12, c.y + 16);
        }
      });
      ctx.fillStyle = '#6b727b';
