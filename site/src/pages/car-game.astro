<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Car Game</title>
  </head>
  <body>
    <h1>🏎️ Car Game</h1>
    <p>Drag your finger (or mouse) left and right to steer! Grab the gold coins.</p>
    <canvas id="game" width="400" height="600"></canvas>
    <p id="score">Score: 0</p>
    <p id="level">Level: 1</p>

    <div class="boost-row">
      <button id="boostBtn">🚀 BOOST</button>
      <div class="boost-bar">
        <div id="boostFill" class="boost-fill"></div>
      </div>
    </div>

    <style>
      body {
        font-family: sans-serif;
        text-align: center;
        background: #f6fdff;
      }
      canvas {
        background: #555555;
        border: 4px solid #333;
        border-radius: 8px;
        touch-action: none;
      }
      #score {
        font-size: 24px;
        font-weight: bold;
      }
      #level {
        font-size: 16px;
        color: #4a6572;
        margin-top: -8px;
      }
      .boost-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 12px;
      }
      #boostBtn {
        font-size: 16px;
        font-weight: bold;
        padding: 10px 18px;
        border: 3px solid #8c1a1a;
        border-radius: 999px;
        background: #ff6b4a;
        color: white;
        cursor: pointer;
        touch-action: none;
        user-select: none;
      }
      #boostBtn:active {
        background: #e63946;
      }
      .boost-bar {
        width: 110px;
        height: 14px;
        background: #ddd;
        border: 2px solid #333;
        border-radius: 999px;
        overflow: hidden;
      }
      .boost-fill {
        height: 100%;
        width: 100%;
        background: #ffd400;
        transition: width 80ms linear;
      }
    </style>

    <script>
      const canvas = document.getElementById('game');
      const ctx = canvas.getContext('2d');
      const scoreEl = document.getElementById('score');
      const levelEl = document.getElementById('level');
      const boostBtn = document.getElementById('boostBtn');
      const boostFill = document.getElementById('boostFill');
      const pointsPerLevel = 5;

      const roadLeft = 60;
      const roadRight = canvas.width - 60;

      const car = { x: canvas.width / 2, y: canvas.height - 100, w: 36, h: 60 };
      const carColor = '#d62828'; // red
      const carOutline = '#8c1a1a';

      let targetX = car.x;
      let keys = { left: false, right: false };
      const moveSpeed = 15; // how fast arrow keys move the car
      const followSpeed = 0.5; // how smoothly the car chases the pointer

      let traffic = []; // the other cars coming down the road
      let coins = []; // gold coins you can collect for bonus points
      let laneLines = [];
      let score = 0;
      let level = 1;
      let levelFlash = 0; // frames left to show the "Level up!" banner
      let gameOver = false;

      // Boost: hold the button (or Shift) to speed everything up for a
      // moment. Draining/refilling an energy bar keeps it a choice, not a
      // free always-on speed.
      let boosting = false;
      let boostEnergy = 100;
      const boostDrain = 1.3;
      const boostRegen = 0.5;
      const boostMultiplier = 1.6;

      let coinSpawnIn = 90;

      // A police car waits behind you. Coast too long without boosting and
      // it starts closing in; boost to pull away and lose it.
      let police = null;
      let slowTimer = 0;
      let busted = false;
      const slowThreshold = 300; // ~5s of not boosting before it appears
      const policeApproach = 3; // how fast it closes the gap while you coast
      const policeRetreat = 4; // how fast it falls back while you boost

      // Crash spin-out: a short animation before "Game Over" shows, instead
      // of the car just freezing in place.
      let crashing = false;
      let crashTimer = 0;
      let crashAngle = 0;
      let crashSpin = 1;
      let crashVX = 0;
      let crashVY = 0;
      let frameCount = 0;

      function startCrash() {
        if (crashing || gameOver) return;
        crashing = true;
        crashTimer = 36;
        crashAngle = 0;
        crashSpin = Math.random() < 0.5 ? -1 : 1;
        crashVX = crashSpin * 4;
        crashVY = -2;
      }

      function levelFor(s) {
        return Math.floor(s / pointsPerLevel) + 1;
      }

      function spawnTraffic() {
        const w = 36;
        const h = 56;
        const x = roadLeft + 20 + Math.random() * (roadRight - roadLeft - 40 - w) + w / 2;
        const colors = ['#6a4c93', '#ffb703', '#2a9d8f', '#f4a261'];
        const color = colors[Math.floor(Math.random() * colors.length)];
        traffic.push({ x, y: -60, w, h, color, passed: false });
      }

      function spawnCoin() {
        const x = roadLeft + 24 + Math.random() * (roadRight - roadLeft - 48);
        coins.push({ x, y: -30, r: 12 });
      }

      function baseSpeed() {
        // Starts slow at level 1, a clear step up with each level.
        return Math.min(19, 5.5 + (level - 1) * 2.1);
      }

      function worldSpeed() {
        return boosting && boostEnergy > 0 ? baseSpeed() * boostMultiplier : baseSpeed();
      }

      function spawnGap() {
        // The road gets busier each level — new cars arrive sooner.
        return Math.max(85, 195 - (level - 1) * 19);
      }

      function spawnLaneLines() {
        laneLines = [];
        for (let i = 0; i < 8; i++) {
          laneLines.push({ y: i * 80 });
        }
      }

      function resetGame() {
        car.x = canvas.width / 2;
        targetX = car.x;
        traffic = [];
        coins = [];
        score = 0;
        level = 1;
        levelFlash = 0;
        gameOver = false;
        boosting = false;
        boostEnergy = 100;
        coinSpawnIn = 90;
        police = null;
        slowTimer = 0;
        busted = false;
        crashing = false;
        crashTimer = 0;
        crashAngle = 0;
        spawnTraffic();
        spawnLaneLines();
        levelEl.textContent = 'Level: 1';
      }

      function pointerToX(clientX) {
        const rect = canvas.getBoundingClientRect();
        return ((clientX - rect.left) / rect.width) * canvas.width;
      }

      canvas.addEventListener('mousedown', (e) => {
        if (gameOver) resetGame();
        targetX = pointerToX(e.clientX);
      });
      canvas.addEventListener('mousemove', (e) => {
        targetX = pointerToX(e.clientX);
      });
      canvas.addEventListener(
        'touchstart',
        (e) => {
          if (gameOver) resetGame();
          targetX = pointerToX(e.touches[0].clientX);
        },
        { passive: true }
      );
      canvas.addEventListener(
        'touchmove',
        (e) => {
          targetX = pointerToX(e.touches[0].clientX);
        },
        { passive: true }
      );

      function startBoost(e) {
        e.preventDefault();
        boosting = true;
      }
      function stopBoost() {
        boosting = false;
      }
      boostBtn.addEventListener('mousedown', startBoost);
      boostBtn.addEventListener('touchstart', startBoost, { passive: false });
      boostBtn.addEventListener('mouseup', stopBoost);
      boostBtn.addEventListener('mouseleave', stopBoost);
      boostBtn.addEventListener('touchend', stopBoost);
      boostBtn.addEventListener('touchcancel', stopBoost);

      window.addEventListener('keydown', (e) => {
        if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
        if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
        if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = true;
        if (e.code === 'Space' && gameOver) resetGame();
      });
      window.addEventListener('keyup', (e) => {
        if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
        if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
        if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') boosting = false;
      });

      function update() {
        frameCount++;

        if (crashing) {
          crashTimer--;
          crashAngle += 0.35 * crashSpin;
          car.x += crashVX;
          car.y += crashVY;
          crashVX *= 0.92;
          crashVY *= 0.92;
          if (crashTimer <= 0) {
            crashing = false;
            gameOver = true;
          }
          return; // freeze traffic, coins and the police car while spinning out
        }

        if (gameOver) {
          boosting = false;
          return;
        }

        if (keys.left) targetX -= moveSpeed;
        if (keys.right) targetX += moveSpeed;
        targetX = Math.max(roadLeft + car.w / 2, Math.min(roadRight - car.w / 2, targetX));

        car.x += (targetX - car.x) * followSpeed;

        if (boosting && boostEnergy > 0) {
          boostEnergy = Math.max(0, boostEnergy - boostDrain);
        } else {
          boosting = false;
          boostEnergy = Math.min(100, boostEnergy + boostRegen);
        }
        boostFill.style.width = boostEnergy + '%';

        const speed = worldSpeed();

        laneLines.forEach((line) => {
          line.y += speed;
          if (line.y > canvas.height) line.y -= 8 * 80;
        });

        traffic.forEach((other) => {
          other.y += speed;

          if (
            Math.abs(car.x - other.x) < (car.w + other.w) / 2 - 6 &&
            Math.abs(car.y - other.y) < (car.h + other.h) / 2 - 6
          ) {
            startCrash();
          }

          if (!other.passed && other.y > car.y + car.h) {
            other.passed = true;
            score++;

            const newLevel = levelFor(score);
            if (newLevel > level) {
              level = newLevel;
              levelEl.textContent = 'Level: ' + level;
              levelFlash = 90; // ~1.5s at 60fps
            }
          }
        });

        traffic = traffic.filter((other) => other.y < canvas.height + 80);

        if (traffic.length === 0 || traffic[traffic.length - 1].y > spawnGap()) {
          spawnTraffic();
        }

        coins.forEach((coin) => {
          coin.y += speed;

          const dx = car.x - coin.x;
          const dy = car.y - coin.y;
          if (Math.sqrt(dx * dx + dy * dy) < coin.r + Math.min(car.w, car.h) / 2) {
            coin.collected = true;
            score += 3;
          }
        });
        coins = coins.filter((coin) => !coin.collected && coin.y < canvas.height + 40);

        coinSpawnIn--;
        if (coinSpawnIn <= 0) {
          spawnCoin();
          coinSpawnIn = 110 + Math.random() * 90;
        }

        // The police car: coasting too long (not boosting) summons it from
        // behind; boosting sends it falling back out of the chase.
        if (boosting) {
          slowTimer = 0;
        } else {
          slowTimer++;
        }

        if (!police && slowTimer >= slowThreshold) {
          police = { x: car.x, y: canvas.height + 90 };
        }

        if (police) {
          police.y += boosting ? policeRetreat : -policeApproach;
          police.x += (car.x - police.x) * 0.06;

          if (police.y - car.y < 14) {
            busted = true;
            startCrash();
          } else if (police.y > canvas.height + 140) {
            police = null;
            slowTimer = 0;
          }
        }

        if (levelFlash > 0) levelFlash--;

        scoreEl.textContent = 'Score: ' + score;
      }

      function drawCar(x, y, w, h, color, outline) {
        const r = 8;
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.moveTo(x - w / 2 + r, y - h / 2);
        ctx.arcTo(x + w / 2, y - h / 2, x + w / 2, y - h / 2 + r, r);
        ctx.lineTo(x + w / 2, y + h / 2 - r);
        ctx.arcTo(x + w / 2, y + h / 2, x + w / 2 - r, y + h / 2, r);
        ctx.lineTo(x - w / 2 + r, y + h / 2);
        ctx.arcTo(x - w / 2, y + h / 2, x - w / 2, y + h / 2 - r, r);
        ctx.lineTo(x - w / 2, y - h / 2 + r);
        ctx.arcTo(x - w / 2, y - h / 2, x - w / 2 + r, y - h / 2, r);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = outline;
        ctx.lineWidth = 2;
        ctx.stroke();

        // A little windshield so cars read as cars, not just boxes.
        ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
        ctx.fillRect(x - w / 2 + 6, y - h / 2 + 10, w - 12, h / 3);
      }

      function drawPoliceCar(x, y, w, h) {
        drawCar(x, y, w, h, '#f2ecdf', '#222');

        // Black door stripe.
        ctx.fillStyle = '#222';
        ctx.fillRect(x - w / 2, y - 6, w, 10);

        // Flashing red/blue light bar on the roof.
        const litRed = Math.floor(frameCount / 8) % 2 === 0;
        ctx.fillStyle = litRed ? '#ff3b30' : '#2b45f0';
        ctx.fillRect(x - 10, y - h / 2 - 8, 20, 7);
      }

      function drawCoin(x, y, r) {
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = '#ffd400';
        ctx.fill();
        ctx.strokeStyle = '#b8860b';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(x, y, r - 4, 0, Math.PI * 2);
        ctx.strokeStyle = '#fff3b0';
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // The sea either side of the bridge.
        ctx.fillStyle = '#1f6f9c';
        ctx.fillRect(0, 0, roadLeft, canvas.height);
        ctx.fillRect(roadRight, 0, canvas.width - roadRight, canvas.height);

        // Gentle wave caps drifting with the road, reusing the lane-line
        // positions so nothing extra needs to be tracked.
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.lineWidth = 2;
        laneLines.forEach((line) => {
          [22, 70].forEach((xOffset) => {
            ctx.beginPath();
            ctx.arc(xOffset, line.y + 30, 10, Math.PI * 0.15, Math.PI * 0.85);
            ctx.stroke();
            ctx.beginPath();
            ctx.arc(canvas.width - xOffset, line.y + 60, 10, Math.PI * 0.15, Math.PI * 0.85);
            ctx.stroke();
          });
        });

        // The bridge deck.
        ctx.fillStyle = '#555555';
        ctx.fillRect(roadLeft, 0, roadRight - roadLeft, canvas.height);

        // Scrolling centre line.
        ctx.strokeStyle = '#f2ecdf';
        ctx.lineWidth = 4;
        ctx.setLineDash([24, 24]);
        laneLines.forEach((line) => {
          ctx.beginPath();
          ctx.moveTo(canvas.width / 2, line.y);
          ctx.lineTo(canvas.width / 2, line.y + 24);
          ctx.stroke();
        });
        ctx.setLineDash([]);

        // Bridge guardrails: a concrete curb with posts along each edge.
        ctx.fillStyle = '#c9c2b2';
        ctx.fillRect(roadLeft - 10, 0, 10, canvas.height);
        ctx.fillRect(roadRight, 0, 10, canvas.height);
        ctx.fillStyle = '#8c8577';
        laneLines.forEach((line) => {
          ctx.fillRect(roadLeft - 10, line.y, 10, 14);
          ctx.fillRect(roadRight, line.y, 10, 14);
        });

        coins.forEach((coin) => drawCoin(coin.x, coin.y, coin.r));

        traffic.forEach((other) => drawCar(other.x, other.y, other.w, other.h, other.color, '#333'));

        if (police) {
          drawPoliceCar(police.x, police.y, car.w, car.h);
        }

        if (crashing) {
          ctx.save();
          ctx.translate(car.x, car.y);
          ctx.rotate(crashAngle);
          drawCar(0, 0, car.w, car.h, carColor, carOutline);
          ctx.restore();
        } else {
          drawCar(car.x, car.y, car.w, car.h, carColor, carOutline);
        }

        if (boosting && boostEnergy > 0) {
          ctx.fillStyle = 'rgba(255, 180, 0, 0.9)';
          ctx.font = 'bold 20px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('BOOST!', canvas.width / 2, 30);
        } else if (police && !crashing && !gameOver) {
          ctx.fillStyle = 'rgba(255, 59, 48, 0.9)';
          ctx.font = 'bold 18px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('🚨 Boost to lose the police!', canvas.width / 2, 30);
        } else if (!police && slowTimer > slowThreshold - 90 && !crashing && !gameOver) {
          const blink = Math.floor(frameCount / 10) % 2 === 0;
          if (blink) {
            ctx.fillStyle = 'rgba(255, 150, 0, 0.9)';
            ctx.font = 'bold 16px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('Speed up...', canvas.width / 2, 30);
          }
        }

        if (levelFlash > 0) {
          const alpha = Math.min(1, levelFlash / 20);
          ctx.fillStyle = `rgba(255, 196, 0, ${alpha})`;
          ctx.font = 'bold 40px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Level ' + level + '!', canvas.width / 2, 80);
        }

        if (gameOver) {
          ctx.fillStyle = 'rgba(0,0,0,0.5)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = 'white';
          ctx.font = '28px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(busted ? 'Busted!' : 'Game Over!', canvas.width / 2, canvas.height / 2 - 20);
          ctx.font = '18px sans-serif';
          ctx.fillText('Click or tap to try again', canvas.width / 2, canvas.height / 2 + 20);
        }
      }

      function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
      }

      resetGame();
      loop();
    </script>
  </body>
</html>
