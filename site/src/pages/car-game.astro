ctx.fillStyle = line.colour;\n        ctx.fillRect(80, y, 240, 6);\n        roundedRect(110, y + 20, 180, 30, 8);\n        ctx.fillStyle = line.colour;\n        ctx.fill();\n        ctx.strokeStyle = '#ffffff';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n        ctx.fillStyle = '#ffffff';\n        ctx.font = 'bold 15px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText((isTram ? '\\u{1F68B} ' : '\\u{1F687} ') + line.name, 200, y + 40);\n        if (isTram && big) {\n          // the tram waiting at the stop\n          roundedRect(176, y + 56, 48, 94, 10);\n          ctx.fillStyle = '#ffa83d';\n          ctx.fill();\n          ctx.strokeStyle = '#7a4208';\n          ctx.lineWidth = 2;\n          ctx.stroke();\n          ctx.fillStyle = '#ffffff';\n          ctx.fillRect(198, y + 62, 4, 82);\n          ctx.fillStyle = '#2f4358';\n          for (let i = 0; i \u003c 4; i++) ctx.fillRect(182, y + 66 + i * 20, 10, 14);\n          ctx.fillStyle = '#3ddc84';\n          ctx.fillRect(173, y + 80, 4, 14);\n          ctx.fillRect(223, y + 80, 4, 14);\n        }\n      };\n      drawStop(walkLen - 130, from, from === metroLines.tram, false);\n      // the plaza at the end of the walk, with a tunnel to every line\n      ctx.fillStyle = '#d7dbe0';\n      ctx.fillRect(0, 50, W, 190);\n      ctx.fillStyle = '#b8bec6';\n      ctx.fillRect(0, 232, W, 8);\n      walkTunnels().forEach((t) => {\n        const isMall = t.key === 'mall';\n        const line = isMall ? { colour: '#7d4a92', name: 'Mall' } : metroLines[t.key];\n        const suggested = t.key === walkTarget;\n        const x = t.cx - t.w / 2;\n        // the arch: dark inside, in the line's colour round the edge\n        roundedRect(x, 96, t.w, 120, t.w / 2);\n        ctx.fillStyle = line.colour;\n        ctx.fill();\n        roundedRect(x + 6, 102, t.w - 12, 114, (t.w - 12) / 2);\n        if (isMall) {\n          // bright shop doors with a glow\n          const glow = ctx.createLinearGradient(0, 1