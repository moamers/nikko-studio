pause \u003c= 0, p.t, false) }));\n      things.push({\n        y: mallPerson.y,\n        draw: () => drawShopperFigure(mallPerson.x, mallPerson.y, { look: ['#f2c9a0', '#d71920', '#26344a'], bag: mallBag.length > 0, kid: false }, 0.95 + (mallPerson.y - 440) / 330, mallPerson.dir, mallPerson.moving, mallPerson.stepT, false),\n      });\n      things.sort((a, b) => a.y - b.y).forEach((t) => t.draw());\n      // \"tap to buy\" hint\n      const nk = mallNearShelf();\n      if (nk >= 0 && !mallDone[base + nk]) {\n        const pr = mallProducts[base + nk];\n        ctx.fillStyle = 'rgba(10, 18, 28, 0.85)';\n        roundedRect(mallShelfX[nk] - 62, 330, 124, 24, 12);\n        ctx.fill();\n        ctx.fillStyle = '#ffffff';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('Tap to buy ' + pr.emoji + ' \\u{1F4B0}' + pr.price, mallShelfX[nk], 346);\n      }\n    }\n\n    function drawMall() {\n      ctx.clearRect(0, 0, W, H);\n      if (mallShop >= 0) drawMallShop();\n      else drawMallStreet();\n      drawMallHud();\n    }\n    mallBtn.addEventListener('click', () => {\n      unlockAudio();\n      leaveMall();\n    });\n\n    function setMap(on) {\n      if (on && (walkMode || mallMode)) return;\n      mapOpen = on;\n      mapBtn.innerHTML = on ? '&#10006;&#65039; Close map' : '&#128506;&#65039; Map';\n      if (on) {\n        stopSpeech();\n        updateHum(false, 0);\n      }\n    }\n    mapBtn.addEventListener('click', () => {\n      unlockAudio();\n      setMap(!mapOpen);\n    });\n\n    // The trophy goes to the highest level you reach.\n    function noteLevelRecord() {\n      if (level \u003c= bestLevel) return;\n      bestLevel = level;\n      if (easy) bestLevelEasy = level;\n      else bestLevelNormal = level;\n      trophyEl.textContent = '\\u{1F3C6} Best level: ' + bestLevel;\n      try {\n        localStorage.setItem(easy ? 'trainBestLevelEasy' : 'trainBestLevel', String(bestLevel));\n      } catch (e) {}\n    }\n\n    function levelFor(s) {\n      return Math.floor(s / pointsPerLevel) + 1;\n    }\n\n    // Starts gentle at level 1 and steps up each level.\n    function worldSpeed() {\n      return Math.min(11.5, 3.3 + (Math.min(level, calmLevel) - 1) * 0.9) * (easy ? 0.7 : 1) * (currentLine === 'tram' ? 0.75 : 1); // trams are a little slower\n    }\n\n    function spawnGap() {\n      return Math.max(145, 280 - (level - 1) * 13) * (easy ? 1.3 : 1);\n    }\n\n    // A cow or a sheep wanders across the tracks from one side.\n    function spawnAnimal() {\n      const dir = Math.random() \u003c 0.5 ? 1 : -1;\n      const cow = Math.random() \u003c 0.5;\n      const vx = dir * Math.min(4.2, 2.5 + level * 0.12) * (easy ? 0.7 : 1);\n      obstacles.push({\n        kind: 'animal',\n        animal: cow ? 'cow' : 'sheep',\n        lane: dir > 0 ? 0 : 2,\n        x: dir > 0 ? -30 : W + 30,\n        y: -40,\n        vx,\n        dir,\n        phase: 0,\n        hw: cow ? 21 : 17,\n        hh: cow ? 12 : 11,\n        speedMul: 1,\n        passed: false,\n      });\n      lastSpawnY = -40;\n      if (cow) tone('sawtooth', 140, 95, 0.55, 0.07, 0.3);\n      else tone('square', 330, 270, 0.4, 0.04, 0.3);\n    }\n\n    function spawnRow() {\n      if (level >= 2 && Math.random() \u003c (easy ? 0.07 : 0.14)) {\n        spawnAnimal();\n        return;\n      }\n      const lanes = [0, 1, 2].sort(() => Math.random() - 0.5);\n      const blocked = !easy && level >= 4 && Math.random() \u003c 0.3 ? 2 : 1; // never all three\n      for (let i = 0; i \u003c blocked; i++) {\n        const l = lanes[i];\n        const roll = Math.random();\n        const x = laneX[l];\n        if (level >= 2 && blocked === 1 && roll \u003c 0.3) {\n          obstacles.push({ kind: 'train', lane: l, x, y: -90, hw: 15, hh: 48, speedMul: easy ? 1.15 : 1.35, passed: false });\n        } else if (roll \u003c 0.65) {\n          obstacles.push({ kind: 'rock', lane: l, x, y: -40, hw: 17, hh: 15, seed: Math.random() * 10, speedMul: 1, passed: false });\n        } else {\n          obstacles.push({ kind: 'barrier', lane: l, x, y: -40, hw: 28, hh: 8, speedMul: 1, passed: false });\n        }\n      }\n      lastSpawnY = -40;\n    }\n\n    function spawnCoin() {\n      const l = Math.floor(Math.random() * 3);\n      if (obstacles.some((o) => o.lane === l && o.y \u003c 120)) return false;\n      coins.push({ x: laneX[l], y: -30, r: 12 });\n      return true;\n    }\n\n    // A glowing shield bubble to collect. It protects the whole train from\n    // one bump (or runs out after about 12 seconds).\n    function spawnShield() {\n      if (shieldTime > 0 || coins.some((c) => c.kind === 'shield')) return true;\n      const l = Math.floor(Math.random() * 3);\n      if (obstacles.some((o) => o.lane === l && o.y \u003c 120)) return false;\n      coins.push({ x: laneX[l], y: -30, r: 15, kind: 'shield' });\n      return true;\n    }\n\n    function resetGame() {\n      lane = 1;\n      cars.forEach((c) => (c.x = laneX[1]));\n      obstacles = [];\n      coins = [];\n      puffs = [];\n      rings = [];\n      score = 0;\n      level = 1;\n      levelFlash = 0;\n      coinSpawnIn = 90;\n      shieldTime = 0;\n      shieldSpawnIn = 1100;\n      boostTime = 0;\n      boostCool = 0;\n      updateBoostBtn(true);\n      crashing = false;\n      crashTimer = 0;\n      crashT = 0;\n      gameOver = false;\n      started = true;\n      scoreEl.textContent = 'Score: 0';\n      levelEl.textContent = 'Level 1';\n      const ev0 = eventInfo();\n      whistledSlot = eventReach(ev0) >= engineY ? ev0.n : -1;\n      nextAnnouncedK = -1;\n      arrivingAnnouncedK = -1;\n      levelAtStart = bestLevel;\n      recordThisRun = false;\n      recordFlash = 0;\n      newMedals = [];\n      chances = maxChances;\n      hurtTime = 0;\n      calmStarted = false;\n      calmTick = 0;\n      calmFlash = 0;\n      quietT = 0;\n      quietCool = 0;\n      mallMode = false;\n      mallLost = false;\n      mallBtn.disabled = tru