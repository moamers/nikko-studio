      const cur = pt === -2 ? salah.seg : pt < 0 ? -1 : salahPose(pt, sq).i;
      if (cur !== salah.seg) {
        salah.seg = cur;
        const sg = sq[Math.max(0, cur)];
        if (cur >= 0 && sg.text) say(sg.text, 110);
        if (cur > 0) blip(260, 240, 0.18, 0.05);
      }
      if (salah.t >= total) {
        salah = null;
        if (mode === 'friday') {
          facAward(2, 25, 'Jumu\'ah Mubarak! The Friday prayer is finished \u{1F932}');
          fridayDone = true;
          saveDay();
        }
        else if (mode === 'eid') facAward(3, 40, 'Eid Mubarak! The Eid prayer is finished \u{1F319}');
        else facAward(0, 15, 'The prayer is finished \u{1F932}');
        if (mode === 'eid' && !eidParty) {
          eidParty = true;
          eidPartyDone = false;
        }
        if (mode === 'eid' && !mallDone[mallShop][4]) {
          facState.eidi = true;
          say('The imam has an Eidi for you \u{1F9E7} Tap him!', 240);
        }
        if (adhan.window > 0 && adhan.t < 0) {
          adhan.window = 0;
          addScore(10);
          say('You prayed on time! \u{1F31F} +10', 200);
        }
      }
    }
    // a person praying, seen from the side, facing the niche on the right
    function drawWorshipper(ax, ay, J, look, scale, imam, turn) {
      const [skin, shirt, pants] = look;
      const body = imam ? '#f6f3ea' : shirt;
      const leg = imam ? '#f6f3ea' : pants;
      const s = scale;
      const pt = (p) => [ax + p[0] * s, ay + p[1] * s];
      const seg = (p, q, w, col) => {
        const a = pt(p);
        const b = pt(q);
        ctx.strokeStyle = col;
        ctx.lineWidth = w * s;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(a[0], a[1]);
        ctx.lineTo(b[0], b[1]);
        ctx.stroke();
      };
      ctx.fillStyle = 'rgba(0, 0, 0, 0.16)';
      ctx.beginPath();
      ctx.ellipse(ax, ay + 2, 40 * s, 6 * s, 0, 0, Math.PI * 2);
      ctx.fill();
      seg(J.hip, J.knee, imam ? 12 : 10, leg);
      seg(J.knee, J.ankle, imam ? 11 : 9, leg);
      seg(J.ankle, [J.ankle[0] + 9, J.ankle[1]], 5, skin);
      seg(J.hip, J.shoulder, imam ? 17 : 15, body);
      seg(J.shoulder, J.elbow, 6, body);
      seg(J.elbow, J.hand, 5, body);
      const h = pt(J.head);
      const hx = h[0] + turn * 3 * s;
      ctx.fillStyle = skin;
      ctx.beginPath();
      ctx.arc(hx, h[1], 9 * s, 0, Math.PI * 2);
      ctx.fill();
      const hd = pt(J.hand);
      ctx.beginPath();
      ctx.arc(hd[0], hd[1], 3.4 * s, 0, Math.PI * 2);
      ctx.fill();
      // an eye, hair or the white cap and the beard of the imam
      ctx.fillStyle = '#2a2a2a';
      ctx.beginPath();
      ctx.arc(hx + 4 * s, h[1] - 1 * s, 1.3 * s, 0, Math.PI * 2);
      ctx.fill();
      if (imam) {
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(hx, h[1] - 2 * s, 9.2 * s, Math.PI * 1.05, Math.PI * 1.95);
        ctx.fill();
        ctx.fillStyle = '#4a4a4a';
        ctx.beginPath();
        ctx.arc(hx + 3 * s, h[1] + 3 * s, 6.5 * s, 0.1, Math.PI * 0.9);
        ctx.fill();
      } else {
        ctx.fillStyle = '#2a2a2a';
        ctx.beginPath();
        ctx.arc(hx - 1 * s, h[1] - 2 * s, 9.2 * s, Math.PI * 0.95, Math.PI * 1.75);
        ctx.fill();
      }
    }

