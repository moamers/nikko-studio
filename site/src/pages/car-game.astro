    }\n\n      if (boostTime > 0) {\n        boostTime = Math.max(0, boostTime - step);\n      } else {\n        boostCool = Math.max(0, boostCool - step);\n      }\n      updateBoostBtn();\n      shieldTime = Math.max(0, shieldTime - step);\n      shieldSpawnIn -= step;\n      if (shieldSpawnIn \u003c= 0) {\n        shieldSpawnIn = spawnShield() ? (1500 + Math.random() * 900) * (easy ? 0.6 : 1) : 10;\n      }\n\n      if (quietT > 0) {\n        quietT -= step;\n        if (quietT \u003c= 0) {\n          quietT = 0;\n          quietCool = quietRecharge;\n          tone('triangle', 660, 440, 0.25, 0.08);\n        }\n      } else if (quietCool > 0) {\n        quietCool = Math.max(0, quietCool - step);\n      }\n      if ((level >= calmLevel || quietT > 0) && !won && dwell \u003c= 0) {\n        // smooth sailing: a point every second and a half, so the journey still moves on\n        calmTick += step;\n        if (calmTick >= 90) {\n          calmTick = 0;\n          score++;\n          scoreEl.textContent = 'Score: ' + score;\n        }\n      }\n      checkLevelUp();\n      calmFlash = Math.max(0, calmFlash - step);\n      levelFlash = Math.max(0, levelFlash - step);\n      finalFlash = Math.max(0, finalFlash - step);\n      updateLineBtn();\n      updateQuietBtn();\n      recordFlash = Math.max(0, recordFlash - step);\n    }\n\n    // ---------- drawing ----------\n\n    // The city rolling past: rooftops and parks beside the tracks, and a street\n    // every now and then that the railway crosses over.\n    // sandy stone, white and glass: the colours of Dubai's rooftops\n    const roofColours = ['#e4cfa3', '#d9b98a', '#f1e6cf', '#a9c7da', '#cfa86b', '#f5f0e6', '#b9cbd6', '#e8dcc0', '#c9a37a'];\n    const cityColumns = [[0, 50], [110, 170], [230, 290], [350, 400]];\n    const cityHash = (a, b) => (Math.imul(a + 7919, 73856093) ^ Math.imul(b + 104729, 19349663)) >>> 0;\n\n    function drawRoof(x, y, w, h, hv) {\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';\n      ctx.fillRect(x + 4, y + 4, w, h); // shadow\n      ctx.fillStyle = roofColours[hv % roofColours.length];\n      ctx.fillRect(x, y, w, h);\n      ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';\n      ctx.lineWidth = 1.5;\n      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.28)';\n      ctx.fillRect(x + 2, y + 2, w - 4, 3); // sunny edge\n      const kind = (hv >>> 4) % 6;\n      if (kind === 0) {\n        // air-con boxes\n        ctx.fillStyle = '#7e868e';\n        ctx.fillRect(x + 6, y + 8, 12, 9);\n        ctx.fillRect(x + w - 18, y + h - 17, 12, 9);\n        ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';\n        ctx.fillRect(x + 8, y + 10, 8, 5);\n      } else if (kind === 1 && w >= 50) {\n        // helipad\n        ctx.beginPath();\n        ctx.arc(x + w / 2, y + h / 2, Math.min(w, h) * 0.32, 0, Math.PI * 2);\n        ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';\n        ctx.lineWidth = 2.5;\n        ctx.stroke();\n        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';\n        ctx.font = 'bold 14px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.fillText('H', x + w / 2, y + h / 2 + 5);\n      } else if (kind === 2) {\n        // skylight\n        ctx.fillStyle = 'rgba(190, 230, 255, 0.7)';\n        ctx.fillRect(x + w / 2 - 9, y + h / 2 - 7, 18, 14);\n        ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';\n        ctx.lineWidth = 1;\n        ctx.strokeRect(x + w / 2 - 9, y + h / 2 - 7, 18, 14);\n      } else if (kind === 3) {\n        // water tank\n        ctx.beginPath();\n        ctx.arc(x + w / 2, y + h / 2, 9, 0, Math.PI * 2);\n        ctx.fillStyle = '#8d6e50';\n        ctx.fill();\n        ctx.beginPath();\n        ctx.arc(x + w / 2 - 2, y + h / 2 - 2, 4, 0, Math.PI * 2);\n        ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';\n        ctx.fill();\n      }\n    }\n\n    function drawPalm(px, py) {\n      ctx.strokeStyle = '#2f8a46';\n      ctx.lineWidth = 3;\n      ctx.lineCap = 'round';\n      for (let i = 0; i \u003c 7; i++) {\n        const a = (i / 7) * Math.PI * 2 + 0.3;\n        ctx.beginPath();\n        ctx.moveTo(px, py);\n        ctx.quadraticCurveTo(px + Math.cos(a) * 7, py + Math.sin(a) * 7 - 1, px + Math.cos(a) * 12, py + Math.sin(a) * 12 + 2);\n        ctx.stroke();\n      }\n      ctx.lineCap = 'butt';\n      ctx.beginPath();\n      ctx.arc(px, py, 3, 0, Math.PI * 2);\n      ctx.fillStyle = '#8d6e50';\n      ctx.fill();\n    }\n\n    // Famous Dubai buildings seen from above, each with a long shadow.\n    function drawTower(x, y, w, h) {\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';\n      ctx.beginPath();\n      ctx.moveTo(x + 4, y + 4);\n      ctx.lineTo(x + w + 4, y + 4);\n      ctx.lineTo(x + w + 22, y + h + 24);\n      ctx.lineTo(x + 18, y + h + 24);\n      ctx.fill();\n      const g = ctx.createLinearGradient(x, y, x + w, y + h);\n      g.addColorStop(0, '#d6ecf8');\n      g.addColorStop(1, '#7fa9c4');\n      ctx.fillStyle = g;\n      ctx.fillRect(x + 3, y + 3, w - 6, h - 6);\n      ctx.strokeStyle = '#4f7b96';\n      ctx.lineWidth = 2;\n      ctx.strokeRect(x + 3, y + 3, w - 6, h - 6);\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';\n      ctx.fillRect(x + 8, y + 8, w - 16, 5);\n      ctx.fillStyle = '#4f7b96';\n      ctx.fillRect(x + w / 2 - 6, y + h / 2 - 6, 12, 12);\n      ctx.beginPath();\n      ctx.arc(x + w / 2, y + h / 2, 2.5, 0, Math.PI * 2);\n      ctx.fillStyle = '#ffffff';\n      ctx.fill();\n    }\n\n    // Burj Khalifa: three petals round a tall spire\n    function drawBurj(x, y, w, h) {\n      const cx = x + w / 2;\n      const cy = y + h / 2;\n      const r = Math.min(w, h) * 0.24;\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';\n      ctx.beginPath();\n      ctx.moveTo(cx - 6, cy);\n      ctx.lineTo(cx + 6, cy);\n      ctx.lineTo(cx + 40, cy + 72);\n      ctx.lineTo(cx + 26, cy + 76);\n      ctx.fill();\n      ctx.fillStyle = '#e9eef2';\n      ctx.fillRect(x, y, w, h);\n      ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';\n      ctx.lineWidth = 1.5;\n      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);\n      [90, 210, 330].forEach((deg) => {\n        const a = (deg * Math.PI) / 180;\n        ctx.beginPath();\n        ctx.arc(cx + Math.cos(a) * r * 1.05, cy - Math.sin(a) * r * 1.05, r, 0, Math.PI * 2);\n        ctx.fillStyle = '#b7c3cd';\n        ctx.fill();\n        ctx.strokeStyle = '#7d8c99';\n        ctx.lineWidth = 1.5;\n        ctx.stroke();\n      });\n      ctx.beginPath();\n      ctx.arc(cx, cy, r * 0.7, 0, Math.PI * 2);\n      ctx.fillStyle = '#8a99a6';\n      ctx.fill();\n      ctx.beginPath();\n      ctx.arc(cx, cy, 3, 0, Math.PI * 2);\n      ctx.fillStyle = '#ffffff';\n      ctx.fill();\n      ctx.font = 'bold 8px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillStyle = '#5a6874';\n      ctx.fillText('BURJ', cx, y + h - 4);\n    }\n\n    // A mosque: a gold dome, a green courtyard and four minarets\n    function drawMosque(x, y, w, h) {\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.18)';\n      ctx.fillRect(x + 4, y + 4, w, h);\n      ctx.fillStyle = '#f1e6cf';\n      ctx.fillRect(x, y, w, h);\n      ctx.strokeStyle = '#a8895a';\n      ctx.lineWidth = 1.5;\n      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);\n      ctx.fillStyle = '#4f9d6f';\n      ctx.fillRect(x + 6, y + 6, w - 12, h - 12);\n      const cx = x + w / 2;\n      const cy = y + h / 2;\n      ctx.beginPath();\n      ctx.arc(cx, cy, Math.min(w, h) * 0.28, 0, Math.PI * 2);\n      ctx.fillStyle = '#e8c75a';\n      ctx.fill();\n      ctx.strokeStyle = '#a8861c';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.arc(cx, cy, Math.min(w, h) * 0.12, 0, Math.PI * 2);\n      ctx.fillStyle = '#fff3b0';\n      ctx.fill();\n      [[x + 5, y + 5], [x + w - 5, y + 5], [x + 5, y + h - 5], [x + w - 5, y + h - 5]].forEach(([mx, my]) => {\n        ctx.beginPath();\n        ctx.arc(mx, my, 4, 0, Math.PI * 2);\n        ctx.fillStyle = '#ffffff';\n        ctx.fill();\n        ctx.strokeStyle = '#a8895a';\n        ctx.lineWidth = 1;\n        ctx.stroke();\n      });\n    }\n\n    // The Dubai Frame: two towers joined by a golden bridge at the top\n    function drawFrame(x, y, w, h) {\n      ctx.fillStyle = '#e9dfc4';\n      ctx.fillRect(x, y, w, h);\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';\n      ctx.fillRect(x + 10, y + 8, 10, h - 14);\n      ctx.fillRect(x + w - 18, y + 8, 10, h - 14);\n      ctx.fillRect(x + 10, y + 8, w - 18, 10);\n      ctx.fillStyle = '#d4a72c';\n      ctx.fillRect(x + 6, y + 4, 10, h - 12);\n      ctx.fillRect(x + w - 16, y + 4, 10, h - 12);\n      ctx.fillRect(x + 6, y + 4, w - 12, 10);\n      ctx.fillStyle = '#fff0b0';\n      ctx.fillRect(x + 8, y + 5, 3, h - 14);\n      ctx.fillRect(x + w - 14, y + 5, 3, h - 14);\n      ctx.fillStyle = '#7d9b6a';\n      ctx.fillRect(x + 20, y + 20, w - 40, h - 30);\n    }\n\n    function drawPark(x, y, w, h, hv) {\n      ctx.fillStyle = '#6fbf73';\n      ctx.fillRect(x, y, w, h);\n      ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';\n      ctx.lineWidth = 1.5;\n      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);\n      for (let i = 0; i \u003c 2; i++) {\n        const tx = x + 14 + ((hv >>> (i * 3)) % Math.max(10, w - 28));\n        const ty = y + 14 + ((hv >>> (i * 3 + 1)) % Math.max(10, h - 28));\n        drawPalm(tx, ty);\n      }\n    }\n\n    // The Dubai Tram runs along the ground, in the road, instead of up on a viaduct.\n    const onGround = () => currentLine === 'tram';\n    const onMono = () => currentLine === 'monorail';\n\n    // The Palm Monorail glides above the sea: a beach with palm trees and hotels\n    // beside the track, and waves in between.\n    function drawPalmIsland(x0, x1, c) {\n      const period = 96;\n      const idx = Math.floor(scrollTotal / period);\n      const base = scrollTotal % period;\n      const w = x1 - x0;\n      for (let r = -1; r \u003c H / period + 1; r++) {\n        const g = idx - r;\n        const hv = cityHash(g, c + 60);\n        const y = r * period + base;\n        const edge = c === 0 ? x1 : x0; // the shore\n        ctx.fillStyle = '#ecd9a6';\n        ctx.fillRect(x0, y, w, period + 1);\n        ctx.fillStyle = 'rgba(255, 255, 255, 0.7)'; // surf along the shore\n        ctx.fillRect(c === 0 ? edge - 5 : edge, y, 5, period + 1);\n        if ((hv >>> 3) % 5 === 0) {\n          drawRoof(x0 + 4, y + 14, w - 8, 66, hv >>> 2); // a hotel\n        } else {\n          drawPalm(x0 + 14 + (hv % (w - 28)), y + 20 + ((hv >>> 6) % 20));\n          if ((hv >>> 9) % 2) drawPalm(x0 + 12 + ((hv >>> 12) % (w - 24)), y + 62 + ((hv >>> 15) % 20));\n        }\n      }\n    }\n\n    function drawSeaWaves() {\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';\n      ctx.lineWidth = 2;\n      for (let i = 0; i \u003c 26; i++) {\n        const wy = ((i * 97 + scrollTotal * 0.9) % (H + 40)) - 20;\n        const wx = 55 + ((i * 131) % 290);\n        ctx.beginPath();\n        ctx.moveTo(wx, wy);\n        ctx.quadraticCurveTo(wx + 8, wy - 4, wx + 16, wy);\n        ctx.quadraticCurveTo(wx + 24, wy + 4, wx + 32, wy);\n        ctx.stroke();\n      }\n    }\n    const carBodies = ['#e8e8ea', '#2f3f58', '#c0392b', '#d9b44a', '#4d7a5a', '#7d7f86'];\n\n    function drawCarV(x, y, colour, up) {\n      ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';\n      ctx.fillRect(x - 8, y - 13, 18, 30);\n      ctx.fillStyle = colour;\n      roundedRect(x - 9, y - 15, 18, 30, 4);\n      ctx.fill();\n      ctx.fillStyle = 'rgba(30, 40, 55, 0.75)';\n      ctx.fillRect(x - 6, y + (up ? -8 : 1), 12, 8);\n      ctx.fillStyle = up ? '#fff6c0' : '#ff3b30';\n      ctx.fillRect(x - 7, y - 15, 3, 2);\n      ctx.fillRect(x + 4, y - 15, 3, 2);\n    }\n\n    // a road with cars running between two of the tram tracks\n    function drawRoadGap(x0, x1, c) {\n      const w = x1 - x0;\n      ctx.fillStyle = '#585e66';\n      ctx.fillRect(x0, 0, w, H);\n      ctx.fillStyle = 'rgba(255, 220, 90, 0.85)';\n      const db = scrollTotal % 36;\n      for (let y = -36 + db; y \u003c H; y += 36) ctx.fillRect(x0 + w / 2 - 1, y, 2, 18);\n      const per = 230;\n      const bb = scrollTotal * 0.4;\n      const cb = scrollTotal * 1.6;\n      for (let i = 0; i \u003c 4; i++) {\n        const hv = cityHash(i, c + 40);\n        const f = (((i * per + bb + (hv % 90)) % (per * 4)) + per * 4) % (per * 4) - per;\n        const o = (((i * per + cb + (hv % 70)) % (per * 4)) + per * 4) % (per * 4) - per;\n        drawCarV(x0 + w / 2 - 14, f, carBodies[hv % carBodies.length], true);\n        drawCarV(x0 + w / 2 + 14, o, carBodies[(hv >>> 4) % carBodies.length], false);\n      }\n    }\n\n    function drawCity() {\n      const period = 96;\n      const idx = Math.floor(scrollTotal / period);\n      const base = scrollTotal % period;\n      const ground = onGround();\n      if (onMono()) {\n        drawSeaWaves();\n        drawPalmIsland(0, 50, 0);\n        drawPalmIsland(350, 400, 3);\n        return;\n      }\n      cityColumns.forEach(([x0, x1], c) => {\n        if (ground && (c === 1 || c === 2)) return;\n        for (let r = -1; r \u003c H / period + 1; r++) {\n          const g = idx - r;\n          const hv = cityHash(g, c);\n          const gap = 6 + (hv % 9);\n          const h = 56 + ((hv >>> 8) % 26);\n          const y = r * period + base + (period - h) / 2 - gap / 2;\n          const inset = (hv >>> 12) % 4;\n          const x = x0 + 2 + inset;\n          const w = x1 - x0 - 4 - inset - ((hv >>> 14) % 3);\n          const lm = (hv >>> 9) % 40; // now and then a famous Dubai building\n          if ((hv >>> 3) % 7 === 0) drawPark(x - 1, y, w + 2, h, hv);\n          else if (lm \u003c 3 && w >= 40) drawTower(x, y, w, h);\n          else if (lm === 3 && w >= 44) drawBurj(x, y, w, h);\n          else if (lm === 4 && w >= 40) drawMosque(x, y, w, h);\n          else if (lm === 5 && w >= 40) drawFrame(x, y, w, h);\n          else drawRoof(x, y, w, h, hv >>> 2);\n        }\n      });\n      if (ground) return; // the tram's streets are drawn over its tracks, after them\n      // streets crossing under the railway\n      const ev = eventInfo();\n      const spacing = 620;\n      const sIdx = Math.floor(scrollTotal / spacing);\n      const sBase = scrollTotal % spacing;\n      for (let k = -1; k \u003c H / spacing + 1; k++) {\n        const sy = k * spacing + sBase + 120;\n        if (sy > ev.top - 40 && sy \u003c ev.top + ev.len + 40) continue; // not over a station, tunnel or river\n        const g = sIdx - k;\n        ctx.fillStyle = '#585e66';\n        ctx.fillRect(0, sy - 20, W, 40);\n        ctx.fillStyle = '#c9ccd1';\n        ctx.fillRect(0, sy - 23, W, 3);\n        ctx.fillRect(0, sy + 20, W, 3);\n        ctx.fillStyle = 'rgba(255, 220, 90, 0.85)';\n        for (let dx = -((scrollTotal * 0) % 28); dx \u003c W; dx += 28) ctx.fillRect(dx, sy - 1, 14, 2);\n        drawStreetExtras(sy, g);\n      }\n    }\n\n    // Streets that cross the tram tracks at level crossings.\n    function drawGroundStreets() {\n      const ev = eventInfo();\n      const spacing = 620;\n      const sIdx = Math.floor(scrollTotal / spacing);\n      const sBase = scrollTotal % spacing;\n      for (let k = -1; k \u003c H / spacing + 1; k++) {\n        const sy = k * spacing + sBase + 120;\n        if (sy > ev.top - 40 && sy \u003c ev.top + ev.len + 40 && ev.kind === 'station') continue;\n        const g = sIdx - k;\n        ctx.fillStyle = '#585e66';\n        ctx.fillRect(0, sy - 20, W, 40);\n        ctx.fillStyle = '#c9ccd1';\n        ctx.fillRect(0, sy - 23, W, 3);\n        ctx.fillRect(0, sy + 20, W, 3);\n        ctx.fillStyle = 'rgba(255, 220, 90, 0.85)';\n        for (let dx = 0; dx \u003c W; dx += 28) ctx.fillRect(dx, sy - 1, 14, 2);\n        // level crossings: yellow and black stripes where the tram goes over the road\n        laneX.forEach((x) => {\n          ctx.fillStyle = '#3a3f46';\n          ctx.fillRect(x - 28, sy - 20, 56, 40);\n          ctx.fillStyle = '#f2c230';\n          for (let i = 0; i \u003c 8; i++) ctx.fillRect(x - 28 + i * 8, sy - 20, 4, 40);\n          ctx.fillStyle = '#8d969e';\n          ctx.fillRect(x - 15, sy - 20, 3, 40);\n          ctx.fillRect(x + 12, sy - 20, 3, 40);\n        });\n        drawStreetExtras(sy, g);\n      }\n    }\n\n    // ---------- traffic lights and the cars that obey them ----------\n    const streetSpacing = 620;\n    const lightCycle = 600; // frames: green, then yellow, then red\n    const stopEastX = () => (onGround() ? 40 : 122); // where eastbound cars wait (in the gap between tracks)\n    const stopWestX = () => (onGround() ? 360 : 278); // where westbound cars wait\n    let streetCars = {};\n\n    function lightState(g) {\n      const p = (frame + g * 173) % lightCycle;\n      return p \u003c 260 ? 'green' : p \u003c 320 ? 'yellow' : 'red';\n    }\n\n    function newStreetCars(g) {\n      const h = (i) => cityHash(g, i + 20);\n      const mk = (x, dir, i) => ({\n        x,\n        dir,\n        v: 0.9 + ((h(i) % 8) / 8) * 1.1,\n        colour: roofColours[h(i + 5) % roofColours.length],\n        stopped: false,\n      });\n      return [mk(-30 + (h(0) % 90), 1, 0), mk(180 + (h(1) % 110), 1, 1), mk(W - 20 - (h(2) % 120), -1, 2), mk(W + 70, -1, 3)];\n    }\n\n    function updateStreets(step) {\n      const sIdx = Math.floor(scrollTotal / streetSpacing);\n      const keep = {};\n      for (let k = -1; k \u003c H / streetSpacing + 1; k++) {\n        const g = sIdx - k;\n        keep[g] = streetCars[g] || newStreetCars(g);\n        const cars = keep[g];\n        const state = lightState(g);\n        cars.forEach((c, i) => {\n          const stopX = c.dir > 0 ? stopEastX() : stopWestX();\n          let nx = c.x + c.dir * c.v * step;\n          // wait at a red or yellow light (a car already past the line carries on)\n          if (state !== 'green') {\n            if (c.dir > 0 && c.x \u003c= stopX - 14 && nx > stopX - 14) nx = stopX - 14;\n            if (c.dir \u003c 0 && c.x >= stopX + 14 && nx \u003c stopX + 14) nx = stopX + 14;\n          }\n          // keep a gap to