ng lights\n      ctx.fillStyle = '#fffbe9';\n      for (let x = 50; x \u003c W; x += 110) ctx.fillRect(x, 0, 60, 8);\n      ctx.fillStyle = 'rgba(255, 250, 220, 0.18)';\n      for (let x = 50; x \u003c W; x += 110) {\n        ctx.beginPath();\n        ctx.moveTo(x, 8);\n        ctx.lineTo(x + 60, 8);\n        ctx.lineTo(x + 90, 330);\n        ctx.lineTo(x - 30, 330);\n        ctx.fill();\n      }\n      // the shop's sign\n      ctx.fillStyle = sh.colour;\n      roundedRect(110, 78, 180, 34, 8);\n      ctx.fill();\n      ctx.fillStyle = '#ffffff';\n      ctx.font = 'bold 18px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(sh.emoji + ' ' + sh.name, 200, 102);\n      // shelves along the wall, full of things\n      [150, 210, 270].forEach((sy, r) => {\n        ctx.fillStyle = '#8a6c4a';\n        ctx.fillRect(70, sy + 22, 330, 6);\n        ctx.fillStyle = 'rgba(0, 0, 0, 0.12)';\n        ctx.fillRect(70, sy + 28, 330, 4);\n        ctx.font = '22px sans-serif';\n        ctx.fillStyle = '#000000';\n        for (let k = 0; k \u003c 9; k++) ctx.fillText(sh.items[(k + r) % 3][0], 82 + k * 36, sy + 20);\n      });\n      // the exit door on the left\n      ctx.fillStyle = '#5a5046';\n      ctx.fillRect(0, 170, 62, 240);\n      const exit = ctx.createLinearGradient(0, 180, 62, 180);\n      exit.addColorStop(0, '#fff6e0');\n      exit.addColorStop(1, '#d9f0ff');\n      ctx.fillStyle = exit;\n      ctx.fillRect(0, 178, 54, 232);\n      ctx.fillStyle = '#2a9d5f';\n      roundedRect(4, 146, 48, 22, 5);\n      ctx.fill();\n      ctx.fillStyle = '#ffffff';\n      ctx.font = 'bold 13px sans-serif';\n      ctx.fillText('EXIT', 28, 162);\n      // the counter, the till and the shopkeeper\n      ctx.fillStyle = '#6b4a2e';\n      ctx.fillRect(296, 318, 104, 70);\n      ctx.fillStyle = '#8f6a45';\n      ctx.fillRect(296, 318, 104, 8);\n      ctx.fillStyle = '#3a3f46';\n      ctx.fillRect(330, 296, 30, 22);\n      ctx.fillStyle = '#9be7a0';\n      ctx.fillRect(334, 300, 