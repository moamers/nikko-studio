allNearShelf() {\n      for (let k = 0; k \u003c 3; k++) if (Math.abs(mallPerson.x - mallShelfX[k]) \u003c 40) return k;\n      return -1;\n    }\n\n    // press the action: go into the shop at this door, or buy what is in front of you\n    function mallAction() {\n      if (!mallMode) return;\n      if (mallShop \u003c 0) {\n        const d = mallNearDoor();\n        if (d >= 0) mallEnterShop(d);\n      } else {\n        const k = mallNearShelf();\n        if (k >= 0) mallBuy(mallProducts.findIndex((p) => p.shop === mallShop) + k);\n        else if (mallPerson.x \u003c 70) mallLeaveShop();\n      }\n    }\n\n    // a tap or click on the picture\n    function mallPress(p) {\n      mallGoto = null;\n      if (mallShop \u003c 0) {\n        for (let i = 0; i \u003c mallShopsData.length; i++) {\n          const sx = mallDoorX(i) - mallCamX;\n          if (p.x > sx - 34 && p.x \u003c sx + 34 && p.y > 250 && p.y \u003c 420) {\n            if (Math.abs(mallPerson.x - mallDoorX(i)) \u003c 46) mallEnterShop(i);\n            else mallGoto = mallDoorX(i);\n            return;\n          }\n        }\n      } else {\n        if (p.x \u003c 70 && p.y > 170 && p.y \u003c 420) {\n          if (mallPerson.x \u003c 110) mallLeaveShop();\n          else mallGoto = 20;\n          return;\n        }\n        for (let k = 0; k \u003c 3; k++) {\n          if (Math.abs(p.x - mallShelfX[k]) \u003c 44 && p.y > 300 && p.y \u003c 440) {\n            if (Math.abs(mallPerson.x - mallShelfX[k]) \u003c 40) mallBuy(mallProducts.findIndex((q) => q.shop === mallShop) + k);\n            else mallGoto = mallShelfX[k];\n            return;\n          }\n        }\n      }\n      walkPointer = p;\n    }\n\n    function walkShopper(sh, step, minX, maxX) {\n      sh.t += step;\n      if (sh.v === 0) return;\n      if (sh.pause > 0) {\n        sh.pause -= step;\n        return;\n      }\n      sh.x += sh.dir * sh.v * step;\n      if (sh.x \u003c minX || sh.x > maxX) {\n        sh.dir = -sh.dir;\n        sh.x = Math.max(minX, Math.min(maxX, sh.x));\n      }\n      if (Math.random() \u003c 0.002 * step) sh.pause = 60 + Math.random() * 120; // stops to look in a window\n    }\n\n    function updateMall(step) {\n      mallMsgT = Math.max(0, mallMsgT - step);\n      mallFlash = Math.max(0, mallFlash - step);\n      mallTime2 += step;\n      // walking about: press and hold towards your finger, or the arrow keys\n      let dx = 0;\n      let dy = 0;\n      if (mallGoto !== null) {\n        if (Math.abs(mallGoto - mallPerson.x) \u003c 6) {\n          // arrived where you tapped: go in, or buy\n          mallGoto = null;\n          mallAction();\n        } else {\n          dx = mallGoto > mallPerson.x ? 1 : -1;\n        }\n      }\n      if (walkPointer) {\n        mallGoto = null;\n        const px = walkPointer.x + (mallShop \u003c 0 ? mallCamX : 0);\n        const d = Math.hypot(px - mallPerson.x, walkPointer.y - mallPerson.y);\n        if (d > 5) {\n          dx = (px - mallPerson.x) / d;\n          dy = (walkPointer.y - mallPerson.y) / d;\n        }\n      }\n      if (walkKeys.left) dx -= 1;\n      if (walkKeys.right) dx += 1;\n      if (walkKeys.up) dy -= 1;\n      if (walkKeys.down) dy += 1;\n      const len = Math.hypot(dx, dy);\n      mallPerson.moving = len > 0.01;\n      if (mallPerson.moving) {\n        dx /= Math.max(1, len);\n        dy /= Math.max(1, len);\n        if (Math.abs(dx) > 0.2) mallPerson.dir = dx > 0 ? 1 : -1;\n        const maxX = mallShop \u003c 0 ? mallWorldW - 40 : 380;\n        mallPerson.x = Math.max(mallShop \u003c 0 ? 40 : 24, Math.min(maxX, mallPerson.x + dx * 3.1 * step));\n        mallPerson.y = Math.max(452, Math.min(548, mallPerson.y + dy * 2 * step));\n        mallPerson.stepT += step;\n      }\n      if (mallShop \u003c 0) {\n        mallShoppers.forEach((sh) => walkShopper(sh, step, 90, mallWorldW - 90));\n        const want = Math.max(0, Math.min(mallWorldW - W, mallPerson.x - 200));\n        mallCamX += (want - mallCamX) * (1 - 