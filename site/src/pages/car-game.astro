    function aptKey() {
      if (aptRoom === 'bed' && !apt.woke) {
        aptAction('bed');
        return;
      }
      const n = nearApt();
      if (!n) return;
      if (n === 'shelf') {
        const k = apt.items.findIndex((x) => !x);
        if (k >= 0) aptAction(k);
        else say('You have everything.', 80);
      } else aptAction(n);
    }

    function leaveApartment() {
      hm.goto = null;
      openLift('home', { type: 'flat', val: 0 });
    }

    function aptPress(p) {
      hm.goto = null;
      hm.act = null;
      if (apt.eating || apt.cooking > 0 || apt.shower > 0) return;
      if (aptRoom === 'bed') {
        if (!apt.woke) {
          aptAction('bed');
          return;
        }
        if (p.x > 52 && p.x < 148 && p.y > 86 && p.y < 196) {
          openCalendar(false);
          return;
        }
        if (p.x < 170 && p.y > 300 && p.y < 440) {
          hm.goto = bedX + 60;
          hm.act = 'bed';
        } else if (p.x > 320 && p.y > 160) {
          hm.goto = stairsX;
          hm.act = 'stairs';
        } else hold = p;
        return;
      }
      if (aptRoom === 'bath') {
        if (p.x < 135 && p.y > 150 && p.y < 440) {
          hm.goto = bathX.shower;
          hm.act = 'shower';
        } else if (p.x >= 140 && p.x < 250 && p.y > 140 && p.y < 440) {
          hm.goto = bathX.sink;
          hm.act = 'sink';
        } else if (p.x > 320 && p.y > 160 && p.y < 440) {
          hm.goto = bathX.door;
          hm.act = 'door';
        } else hold = p;
        return;
      }
      if (p.x > 284 && p.x < 352 && p.y > 82 && p.y < 156) {
        openCalendar(false);
        return;
      }
      for (let k = 0; k < 4; k++) {
        if (Math.abs(p.x - aptItemX[k]) < 13 && Math.abs(p.y - 248) < 22) {
          hm.goto = aptX.shelf;
          hm.act = k;
          return;
        }
      }
      if (p.x < 90 && p.y > 150 && p.y < 440) {
        hm.goto = aptX.fridge;
        hm.act = 'fridge';
      } else if (p.x >= 90 && p.x < 172 && p.y > 300 && p.y < 440) {
        hm.goto = aptX.stove;
        hm.act = 'stove';
      } else if (p.x >= 172 && p.x < 262 && p.y > 360 && p.y < 500) {
        hm.goto = aptX.table;
        hm.act = 'table';
      } else if (p.x > 346 && p.y > 160 && p.y < 440) {
        hm.goto = aptX.door;
        hm.act = 'door';
      } else {
        hold = p;
      }
    }

    function nearApt() {
      if (aptRoom === 'bed') {
        if (Math.abs(hm.x - bedX) < 70) return 'bed';
        if (Math.abs(hm.x - stairsX) < 34) return 'stairs';
        return null;
      }
      if (aptRoom === 'bath') {
        if (Math.abs(hm.x - bathX.shower) < 40) return 'shower';
        if (Math.abs(hm.x - bathX.sink) < 40) return 'sink';
        if (Math.abs(hm.x - bathX.door) < 30) return 'door';
        return null;
      }
      if (Math.abs(hm.x - aptX.fridge) < 36) return 'fridge';
      if (Math.abs(hm.x - aptX.stove) < 36) return 'stove';
      if (Math.abs(hm.x - aptX.table) < 40) return 'table';
      if (Math.abs(hm.x - aptX.shelf) < 40) return 'shelf';
      if (Math.abs(hm.x - aptX.door) < 30) return 'door';
      return null;
    }

    function updateApartment(step) {
      if (apt.fade > 0) apt.fade = Math.max(0, apt.fade - step);
      if (apt.shower > 0) {
        apt.shower -= step;
        if (Math.floor(apt.shower / 14) !== Math.floor((apt.shower + step) / 14)) blip(1500 + Math.random() * 400, 1800, 0.08, 0.025);
        if (apt.shower <= 0) {
          apt.shower = 0;
          apt.showered = true;
          hm.x = 150;
          addScore(3);
          say('Fresh and clean! \u{1F6BF}✨ +3', 150);
          [523, 659, 784].forEach((f, j) => blip(f, f, 0.15, 0.09, j * 0.1));
        }
        return;
      }
      if (apt.cooking > 0) {
        apt.cooking -= step;
        if (Math.floor(apt.cooking / 20) !== Math.floor((apt.cooking + step) / 20)) blip(200 + Math.random() * 80, 120, 0.1, 0.05);
        if (apt.cooking <= 0) {
          apt.cooking = 0;
          apt.cooked = true;
          addScore(2);
          say('Breakfast is ready! ' + apt.menu.map((m) => m[0]).join('') + ' Take it to the table. +2', 160);
          [660, 880].forEach((f, j) => blip(f, f, 0.15, 0.1, j * 0.1));
        }
        return;
      }
      if (apt.eating) {
        apt.eating.t += step;
        if (Math.floor(apt.eating.t / 26) !== Math.floor((apt.eating.t - step) / 26) && apt.eating.t < 130) blip(280 + Math.random() * 120, 200, 0.07, 0.07);
        if (apt.eating.t >= 140) {
          apt.eating = null;
          apt.eaten = true;
          hm.x = aptX.table - 60;
          const pts = 10 + apt.menu.length;
          addScore(pts);
          say('Yummy breakfast! \u{1F60B} +' + pts, 150);
          [523, 659, 784].forEach((f, j) => blip(f, f, 0.15, 0.09, j * 0.1));
        }
        return;
      }
      if (aptRoom === 'bed' && !apt.woke) return;
      let dx = 0;
      if (hm.goto !== null) {
        if (Math.abs(hm.goto - hm.x) < 6) {
          hm.goto = null;
          const a = hm.act;
          hm.act = null;
          if (a !== null) aptAction(a);
        } else dx = hm.goto > hm.x ? 1 : -1;
      }
      if (hold) {
        hm.goto = null;
        hm.act = null;
        if (Math.abs(hold.x - hm.x) > 5) dx = hold.x > hm.x ? 1 : -1;
      }
      if (keys.left) dx -= 1;
      if (keys.right) dx += 1;
      hm.moving = dx !== 0;
      if (hm.moving) {
        hm.dir = dx > 0 ? 1 : -1;
        hm.x = Math.max(28, Math.min(W - 24, hm.x + Math.sign(dx) * 2.8 * step));
        hm.stepT += step;
      }
    }

