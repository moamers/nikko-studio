      if (Math.abs(dx) > 300) buddy.x = tx;
      buddy.moving = Math.abs(dx) > 5;
      if (buddy.moving) {
        buddy.x += Math.sign(dx) * Math.min(Math.abs(dx), 2.6 * step);
        buddy.dir = dx > 0 ? 1 : -1;
