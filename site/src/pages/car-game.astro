      ctx.fillStyle = '#ff3b30';\n          ctx.fillRect(c.x - c.dir * 11 - 1, cy - 5, 2, 3);\n          ctx.fillRect(c.x - c.dir * 11 - 1, cy + 1, 2, 3);\n        }\n      });\n      // the traffic lights, one on each side of the street\n      drawSignal(stopEastX() + 2, sy + 26, state);\n      drawSignal(stopWestX() - 2, sy - 56, state);\n    }\n\n    function drawScenery() {\n      const land = getComputedStyle(document.documentElement).getPropertyValue('--land').trim() || '#6fbf73';\n      const bed = getComputedStyle(document.documentElement).getPropertyValue('--bed').trim() || '#b8a88a';\n      ctx.fillStyle = onMono() ? (getComputedStyle(document.documentElement).getPropertyValue('--water').trim() || '#4aa3d8') : land;\n      ctx.fillRect(0, 0, W, H);\n\n      drawCity();\n      const dim = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--city-dim')) || 0;\n      if (dim > 0) {\n        ctx.fillStyle = 'rgba(6, 12, 26, ' + dim + ')';\n        ctx.fillRect(0, 0, W, H);\n      }\n\n      drawBridgeWater();\n\n      const ground = onGround();\n      if (ground) {\n        drawRoadGap(110, 170, 1);\n        drawRoadGap(230, 290, 2);\n      }\n      if (onMono()) {\n        // a concrete guideway on pillars, with its shadow on the sea\n        laneX.forEach((x) => {\n          ctx.fillStyle = 'rgba(0, 40, 80, 0.25)';\n          ctx.fillRect(x - 17, 0, 40, H);\n          ctx.fillStyle = '#dfe3e8';\n          ctx.fillRect(x - 20, 0, 40, H);\n          ctx.fillStyle = '#b3bac2';\n          ctx.fillRect(x - 20, 0, 3, H);\n          ctx.fillRect(x + 17, 0, 3, H);\n          ctx.fillStyle = '#8f96a0';\n          ctx.fillRect(x - 3, 0, 6, H);\n          ctx.fillStyle = '#c4cad1';\n          const jb = scrollTotal % 90;\n          for (let y = -90 + jb; y \u003c H + 90; y += 90) ctx.fillRect(x - 20, y, 40, 3);\n        });\n        drawStationGround();\n        return;\n      }\n      laneX.forEach((x) => {\n        // gravel bed (the tram's bed i