    // ---------- the lifts: take them to any floor of the mall or any level of the car park ----------
    // Malls have 4 floors (G, 1, 2, 3) and a car park of 10 levels. Your building has your
    // flat and a car park of 12 levels. Pick a floor on the lift buttons.
    let liftOpen = false;
    let liftKind = 'mall';
    let liftHere = { type: 'floor', val: 0 };
    let liftButtons = [];
    let liftRide = null;
    let departing = false;
    let mallActive = false;
    const carParkTop = (kind) => (kind === 'home' ? 12 : kind === 'mosque' ? (dest.indoor ? 5 : 1) : 10);
    const lvlName = (kind, l) => (l === carParkTop(kind) ? 'Level ' + l + ' (outdoor)' : 'Level ' + l);
    const floorLabel = ['G', '1', '2', '3'];

    function openLift(kind, here) {
      liftKind = kind;
      liftHere = here;
      liftOpen = true;
      hold = null;
      const b = [];
      if (kind === 'mall') {
        for (let i = 0; i < 4; i++) b.push({ label: floorLabel[3 - i], type: 'floor', val: 3 - i, x: 20 + (i + 0.5) * 90, y: 168, r: 26 });
        const top = carParkTop(kind);
        for (let l = 1; l <= top; l++) {
          const i = l - 1;
          b.push({ label: 'P' + l, type: 'level', val: l, x: 20 + ((i % 5) + 0.5) * 72, y: 278 + Math.floor(i / 5) * 66, r: 24, roof: l === top });
        }
      } else if (kind === 'mosque') {
        b.push({ label: '\u{1F54C} The mosque', type: 'mosque', val: 0, x: 200, y: 166, r: 26, big: true });
        const top = carParkTop(kind);
        for (let l = 1; l <= top; l++) {
          const i = l - 1;
          b.push({ label: 'P' + l, type: 'level', val: l, x: 20 + ((i % 6) + 0.5) * 60, y: 292 + Math.floor(i / 6) * 62, r: 22 });
        }
      } else {
        b.push({ label: '\u{1F3E0} My flat', type: 'flat', val: 0, x: 200, y: 166, r: 26, big: true });
        const top = carParkTop(kind);
        for (let l = 1; l <= top; l++) {
          const i = l - 1;
          b.push({ label: 'P' + l, type: 'level', val: l, x: 20 + ((i % 6) + 0.5) * 60, y: 292 + Math.floor(i / 6) * 62, r: 22, roof: l === top });
        }
      }
      if (kind === 'home') b.push({ label: '\u{1F687} Home metro station', type: 'metro', val: 0, x: 200, y: 398, r: 20, big: true, h2: 36 });
      else if (stationOfMall(dest.name)) b.push({ label: '\u{1F687} ' + lineInfo[mallLine(dest.name)].name + ' station', type: 'metro', val: 0, x: 200, y: 396, r: 20, big: true, h2: 36 });
      b.forEach((x) => {
        x.here = x.type === liftHere.type && x.val === liftHere.val;
        x.car = x.type === 'level' && x.val === carLevel && carKindNow === kind && carPlaceName === (kind === 'home' ? 'Home' : dest.name);
      });
      liftButtons = b;
      blip(700, 700, 0.08, 0.08);
    }
    let carKindNow = 'home'; // which car park your car is in

    function closeLift() {
      liftOpen = false;
    }

    function liftPress(p) {
      if (p.x > 110 && p.x < 290 && p.y > 478 && p.y < 522) {
        closeLift();
        return;
      }
      for (const b of liftButtons) {
        const hw = b.big ? 150 : b.r;
        const hh = b.big ? (b.h2 ? b.h2 / 2 : 30) : b.r;
        if (Math.abs(p.x - b.x) < hw && Math.abs(p.y - b.y) < hh) {
          if (b.here) return;
          startLiftRide(b);
          return;
        }
      }
    }

    function labelOfSel(s) {
      return s.type === 'floor' ? floorLabel[s.val] : s.type === 'flat' ? 'Flat' : s.type === 'mosque' ? 'Mosque' : s.type === 'metro' ? 'Metro' : 'P' + s.val;
    }

    function startLiftRide(b) {
      if (phase === 'mall' && b.type !== 'floor' && typeof toi !== 'undefined' && toi.stage > 0) {
        say('You need the toilet first! \u{1F6BB} Find the restrooms by the lift.', 200);
        blip(220, 160, 0.2, 0.08);
        return;
      }
      if (phase === 'mall' && buddy && !buddy.bye && b.type !== 'floor') {
        closeLift();
        buddyBye(() => startLiftRide(b));
        return;
      }
      closeLift();
      if (b.type === 'mosque') {
        enterMosque();
        return;
      }
      if (b.type === 'metro') {
        enterStation(liftKind === 'home' ? homeStation : stationOfMall(dest.name));
        return;
      }
      // moving between floors of the mall: the lift doors in the mall itself
      if (b.type === 'floor' && phase === 'mall') {
        mallRide = { t: 0, dir: b.val > mallFloor ? 1 : -1, kind: 'lift', moved: false, to: b.val };
        mm.x = liftX;
        mm.goto = null;
        say('Going to ' + (b.val === 0 ? 'the ground floor' : 'floor ' + b.val) + ' in the lift!', 110);
        blip(900, 900, 0.2, 0.08);
        return;
      }
      liftRide = { t: 0, to: { type: b.type, val: b.val }, from: liftHere, kind: liftKind };
      blip(600, 900, 0.5, 0.08);
    }

    function updateLiftRide(step) {
      liftRide.t += step;
      if (liftRide.t >= 80) {
        const r = liftRide;
        liftRide = null;
        arriveVia(r.to, r.kind, r.from);
      }
    }

    function arriveVia(to, kind, from) {
      const fromMall = phase === 'mall';
      blip(1200, 1200, 0.25, 0.1); // ding
      if (to.type === 'floor') {
        enterMallAt(to.val);
      } else if (to.type === 'flat') {
        finishHome();
      } else {
        // a level of the car park: you step out of the lift, next to the lift doors
        if (fromMall) mallShop = -1;
        if (!(kind === 'home' && from && from.type === 'flat')) shopped = true;
        phase = 'walk';
        lotKind = kind === 'home' ? 'home' : kind === 'mosque' ? 'mosque' : 'mall';
        if (kind === 'home' && from && from.type === 'flat') departing = true;
        lotLevel = to.val;
        bays = levelBays[lotLevel] || (levelBays[lotLevel] = makeLevel(lotLevel));
        me.x = 200;
        me.y = 205;
        me.hurt = 0;
        leftCar = true;
        hold = null;
        lotCars = [
          { x: 40, y: 307, dir: 1, v: 1.1, colour: '#2a9d8f' },
          { x: 330, y: 500, dir: -1, v: 1.0, colour: '#e76f51' },
        ];
        if (carIsHere()) {
          const c = bayCentre(carBay);
          car.x = c.x;
          car.y = c.y;
          say('Your car is here! Walk to it. \u{1F697}', 180);
        } else {
          say('Level ' + lotLevel + ': your car is not here. It is on level ' + carLevel + '.', 220);
        }
      }
    }
    // the lift buttons panel
    function drawLiftPanel() {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.62)';
      ctx.fillRect(0, 0, W, H);
      const metal = ctx.createLinearGradient(20, 0, 380, 0);
      metal.addColorStop(0, '#aeb4bb');
      metal.addColorStop(0.5, '#eef1f4');
      metal.addColorStop(1, '#aeb4bb');
      ctx.fillStyle = metal;
      roundedRect(20, 56, 360, 480, 18);
      ctx.fill();
      ctx.strokeStyle = '#6f757c';
      ctx.lineWidth = 3;
      ctx.stroke();
      // the little display
      ctx.fillStyle = '#101418';
      roundedRect(44, 70, 312, 40, 8);
      ctx.fill();
      ctx.fillStyle = '#6dff9c';
      ctx.font = 'bold 20px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('\u{1F6D7} LIFT • you are on ' + labelOfSel(liftHere), 200, 98);
      ctx.fillStyle = '#3a3f46';
      ctx.font = 'bold 13px sans-serif';
      ctx.textAlign = 'left';
      if (liftKind === 'mall') {
        ctx.fillText('MALL FLOORS', 40, 130);
        ctx.fillText('CAR PARK', 40, 236);
      } else if (liftKind === 'mosque') {
        ctx.fillText('THE MOSQUE', 40, 130);
        ctx.fillText('CAR PARK (5 INDOOR LEVELS)', 40, 262);
      } else {
        ctx.fillText('YOUR FLAT', 40, 130);
        ctx.fillText('CAR PARK UNDER YOUR BUILDING', 40, 246);
      }
      liftButtons.forEach((b) => {
        if (b.big) {
          roundedRect(b.x - 150, b.y - (b.h2 ? b.h2 / 2 : 28), 300, b.h2 || 56, 14);
        } else {
          ctx.beginPath();
          ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
        }
        ctx.fillStyle = b.here ? '#9aa0a8' : b.roof ? '#fff3c4' : '#fafbfc';
        ctx.fill();
        ctx.strokeStyle = b.car ? '#1fbf6a' : '#555b62';
        ctx.lineWidth = b.car ? 5 : 3;
        ctx.stroke();
        ctx.fillStyle = b.here ? '#e8eaed' : '#22272d';
        ctx.font = (b.big ? 'bold 20px' : 'bold 16px') + ' sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(b.label, b.x, b.y + 6);
        if (b.roof) ctx.fillText('☀️', b.x + b.r - 4, b.y - b.r + 6);
        if (b.car) {
          ctx.font = '14px sans-serif';
          ctx.fillText('\u{1F697}', b.x, b.y - b.r - 3);
        }
      });
      // where is your car?
      ctx.fillStyle = '#1b7f4b';
      roundedRect(40, 420, 320, 44, 12);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('\u{1F697} Your car is on ' + lvlName(carKindNow === 'home' ? 'home' : liftKind, carLevel) + (carKindNow === 'home' && liftKind !== 'home' ? ' at home' : ''), 200, 440);
      ctx.font = '11px sans-serif';
      ctx.fillText('The green ring shows the level of your car.', 200, 456);
      ctx.fillStyle = '#e63946';
      roundedRect(110, 478, 180, 44, 22);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 16px sans-serif';
      ctx.fillText('Close ✖', 200, 506);
    }

    // inside the lift while it moves
    function drawLiftRide() {
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, '#2a2f36');
      g.addColorStop(1, '#14171b');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);
      const metal = ctx.createLinearGradient(0, 0, W, 0);
      metal.addColorStop(0, '#9aa1a9');
      metal.addColorStop(0.5, '#e9ecef');
      metal.addColorStop(1, '#9aa1a9');
      ctx.fillStyle = metal;
      ctx.fillRect(40, 120, 320, 400);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
      ctx.fillRect(60, 140, 14, 360);
      ctx.fillStyle = '#101418';
      roundedRect(120, 70, 160, 50, 10);
      ctx.fill();
      const t = liftRide.t;
      const dir = liftRide.to.type === 'level' && liftRide.from.type !== 'level' ? -1 : liftRide.to.type !== 'level' && liftRide.from.type === 'level' ? 1 : liftRide.to.val > liftRide.from.val ? 1 : -1;
      ctx.fillStyle = '#6dff9c';
      ctx.font = 'bold 30px monospace';
      ctx.textAlign = 'center';
      ctx.fillText((dir > 0 ? '⬆ ' : '⬇ ') + (t < 60 ? '...' : labelOfSel(liftRide.to)), 200, 106);
      // the doors, sliding open at the end
      const open = t < 62 ? 0 : Math.min(1, (t - 62) / 16);
      ctx.fillStyle = '#c4cad1';
      ctx.fillRect(100, 180, 100 - open * 90, 320);
      ctx.fillRect(200 + open * 90, 180, 100 - open * 90, 320);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
      ctx.fillRect(198, 180, 4, 320);
      // you inside, and the feeling of moving
      ctx.fillStyle = 'rgba(255, 255, 255, 0.18)';
      for (let k = 0; k < 6; k++) ctx.fillRect(0, ((k * 110 + t * 7 * dir * -1) % 640 + 640) % 640 - 20, 40, 4);
      ctx.font = 'bold 18px sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.fillText(t < 62 ? 'Going ' + (dir > 0 ? 'up' : 'down') + '...' : 'DING! \u{1F514}', 200, 560);
    }

const TRAIN_DOC = "\u003c!doctype html>\u003chtml lang=\"en\">\u003chead>\u003cmeta charset=\"utf-8\">\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\u003c/head>\u003cbody>\u003ctitle>Metro ride\u003c/title>\n\u003cstyle>\n  :root {\n    --bg: #fff8ec;\n    --card: #ffffff;\n    --ink: #1a2a33;\n    --ink-soft: #4a6572;\n    --land: #e6d5ab;\n    --city-dim: 0;\n    --bed: #b8a88a;\n    --water: #4aa3d8;\n    --accent: #c8741a;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root:not([data-theme=\"light\"]) {\n      --bg: #0f1b22;\n      --card: #16262f;\n      --ink: #eaf4f8;\n      --ink-soft: #9fb6c0;\n      --land: #4a4332;\n      --city-dim: 0.38;\n      --bed: #7d7360;\n      --water: #2a6a99;\n      --accent: #ff8a6a;\n      color-scheme: dark;\n    }\n  }\n  :root[data-theme=\"dark\"] {\n    --bg: #0f1b22;\n    --card: #16262f;\n    --ink: #eaf4f8;\n    --ink-soft: #9fb6c0;\n    --land: #4a4332;\n    --city-dim: 0.38;\n    --bed: #7d7360;\n    --water: #2a6a99;\n    --accent: #ff8a6a;\n    color-scheme: dark;\n  }\n\n  body {\n    background: var(--bg);\n    color: var(--ink);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    display: flex;\n    justify-content: center;\n    padding-inline: 16px;\n  }\n\n  .wrap {\n    width: 100%;\n    max-width: 440px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 12px;\n    padding-block: 24px;\n  }\n\n  h1 {\n    font-size: clamp(22px, 6vw, 30px);\n    margin: 0;\n    text-align: center;\n  }\n\n  .skyline {\n    width: 100%;\n    max-width: 400px;\n    height: auto;\n    color: var(--ink-soft);\n    margin-block: -4px;\n  }\n\n  .sub {\n    color: var(--ink-soft);\n    margin: 0;\n    text-align: center;\n    font-size: 14px;\n  }\n\n  .stage {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 2 / 3;\n    max-height: 70vh;\n    background: var(--card);\n    border-radius: 20px;\n    padding: 10px;\n    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);\n  }\n\n  canvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n    border-radius: 14px;\n    background: var(--land);\n    touch-action: none;\n  }\n\n  .score {\n    font-size: 20px;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .level {\n    font-size: 14px;\n    font-weight: 600;\n    color: var(--accent);\n  }\n\n  .controls {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 10px;\n  }\n\n  .controls button {\n    font: inherit;\n    font-size: 15px;\n    font-weight: 600;\n    color: var(--ink);\n    background: var(--card);\n    border: 2px solid var(--ink-soft);\n    border-radius: 999px;\n    padding: 8px 16px;\n    cursor: pointer;\n  }\n\n  .controls button:disabled {\n    opacity: 0.55;\n    cursor: default;\n  }\n\n  /* the change-line button grows big and bright whenever you can change line */\n  #lineBtn:not(:disabled) {\n    border-color: #00a04a;\n    color: #00a04a;\n    font-weight: 700;\n  }\n\n  /* inside the mall: a big purple button to go back outside */\n  #mallBtn:not(:disabled) {\n    order: -2;\n    flex: 1 1 100%;\n    font-size: 24px;\n    font-weight: 800;\n    padding: 18px 20px;\n    border-color: #5b2c6f;\n    background: #8e44ad;\n    color: #ffffff;\n    box-shadow: 0 4px 14px rgba(142, 68, 173, 0.45);\n  }\n\n  #mallBtn.late:not(:disabled) {\n    border-color: #8f0f22;\n    background: #e21836;\n    box-shadow: 0 4px 14px rgba(226, 24, 54, 0.55);\n    animation: lineBtnPulse 0.5s ease-in-out infinite;\n  }\n\n  #mallBtn:disabled {\n    display: none;\n  }\n\n  #lineBtn.big:not(:disabled) {\n    order: -1;\n    flex: 1 1 100%;\n    font-size: 24px;\n    font-weight: 800;\n    padding: 18px 20px;\n    border-color: #00793a;\n    background: #00a04a;\n    color: #ffffff;\n    box-shadow: 0 4px 14px rgba(0, 160, 74, 0.45);\n    animation: lineBtnPulse 1.1s ease-in-out infinite;\n  }\n\n  @keyframes lineBtnPulse {\n    0%, 100% { transform: scale(1); }\n    50% { transform: scale(1.04); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #lineBtn.big:not(:disabled) { animation: none; }\n  }\n\n  #quietBtn:not(:disabled) {\n    border-color: #2a9d8f;\n    color: #2a9d8f;\n  }\n\n  #quietBtn[aria-pressed=\"true\"] {\n    background: #2a9d8f;\n    border-color: #2a9d8f;\n    color: #ffffff;\n  }\n\n  #boostBtn:not(:disabled) {\n    border-color: var(--accent);\n    color: var(--accent);\n  }\n\n  .controls button[aria-pressed=\"true\"] {\n    background: var(--accent);\n    border-color: var(--accent);\n    color: var(--bg);\n  }\n\n  .controls button:active {\n    transform: scale(0.96);\n  }\n\n  .best {\n    font-size: 13px;\n    color: var(--ink-soft);\n  }\n  /* when the train is a ride inside the car game: just the game and its buttons */\n  body.ride h1,\n  body.ride .sub,\n  body.ride .skyline,\n  body.ride #medals,\n  body.ride .best,\n  body.ride #lineBtn,\n  body.ride #mallBtn {\n    display: none;\n  }\n\u003c/style>\n\n\u003cdiv class=\"wrap\">\n  \u003ch1>&#128644; Dubai Train Dodge\u003c/h1>\n  \u003csvg class=\"skyline\" viewBox=\"0 0 400 76\" role=\"img\" aria-label=\"The Dubai skyline: Burj Khalifa, Burj Al Arab and the Dubai Frame\">\n    \u003cg fill=\"currentColor\" opacity=\"0.55\">\n      \u003crect x=\"8\" y=\"46\" width=\"14\" height=\"30\"/>\u003crect x=\"24\" y=\"36\" width=\"12\" height=\"40\"/>\n      \u003cpolygon points=\"54,76 56,48 60,40 63,26 65,10 66,2 67,10 69,26 72,40 76,48 78,76\"/>\n      \u003crect x=\"86\" y=\"40\" width=\"16\" height=\"36\"/>\u003crect x=\"104\" y=\"52\" width=\"12\" height=\"24\"/>\n      \u003crect x=\"168\" y=\"44\" width=\"12\" height=\"32\"/>\u003crect x=\"182\" y=\"30\" width=\"10\" height=\"46\"/>\n      \u003crect x=\"296\" y=\"42\" width=\"14\" height=\"34\"/>\u003crect x=\"312\" y=\"30\" width=\"10\" height=\"46\"/>\n      \u003crect x=\"324\" y=\"50\" width=\"14\" height=\"26\"/>\u003crect x=\"342\" y=\"38\" width=\"12\" height=\"38\"/>\u003crect x=\"358\" y=\"46\" width=\"14\" height=\"30\"/>\n    \u003c/g>\n    \u003cg fill=\"currentColor\" opacity=\"0.8\">\n      \u003cpolygon points=\"196,76 198,50 201,42 203,28 205,14 206,4 207,0 208,4 209,14 211,28 213,42 216,50 218,76\"/>\n      \u003cpath d=\"M236 76 Q236 36 252 12 L255 8 Q276 36 276 76 Z\"/>\u003crect x=\"254\" y=\"0\" width=\"2\" height=\"12\"/>\n    \u003c/g>\n    \u003cg fill=\"#d4a72c\">\n      \u003crect x=\"122\" y=\"22\" width=\"9\" height=\"54\"/>\u003crect x=\"144\" y=\"22\" width=\"9\" height=\"54\"/>\u003crect x=\"122\" y=\"22\" width=\"31\" height=\"10\"/>\n    \u003c/g>\n    \u003cpath d=\"M0 74 H400\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\"0.5\"/>\n  \u003c/svg>\n  \u003cp class=\"sub\">Tap the left, middle or right side to switch tracks. You have two chances ❤️❤️ before the train derails. Dodge the rocks, barriers, oncoming trains and wandering cows, grab the gold and shields, and press Boost to zoom! Stop at the stations: passengers get off at their stop and new ones hop on. At Union, BurJuman, Business Bay or Creek get off the train and walk through the city to the tunnels at the end: there is one to every line (Red, Green, Blue, Tram and Monorail), so you pick where to go. At any station you can press \"Get off & walk\" if you like. At Dubai Marina the walk goes down the road to the Dubai Tram, and at the end of the tram, Palm Jumeirah, hop on the Palm Monorail to Atlantis. Reach level 20 to finish the journey. From level 9 to level 20 there are no obstacles at all!\u003c/p>\n  \u003cp class=\"score\" id=\"score\">Score: 0\u003c/p>\n  \u003cp class=\"level\" id=\"level\">Level 1\u003c/p>\n  \u003cp class=\"best\" id=\"best\">Best: 0\u003c/p>\n  \u003cp class=\"best\" id=\"trophy\">&#127942; Best level: 0\u003c/p>\n  \u003cp class=\"best\" id=\"medals\">&#127894;&#65039; Medals: none yet\u003c/p>\n  \u003cdiv class=\"stage\">\n    \u003ccanvas id=\"game\" width=\"400\" height=\"600\" aria-label=\"Train dodge game\">\u003c/canvas>\n  \u003c/div>\n  \u003cdiv class=\"controls\">\n    \u003cbutton type=\"button\" id=\"easyBtn\">&#128034; Easy\u003c/button>\n    \u003cbutton type=\"button\" id=\"normalBtn\">&#127918; Normal\u003c/button>\n    \u003cbutton type=\"button\" id=\"whistleBtn\">&#128226; Horn\u003c/button>\n    \u003cbutton type=\"button\" id=\"boostBtn\">&#128640; Boost\u003c/button>\n    \u003cbutton type=\"button\" id=\"lineBtn\" disabled>&#128257; Change line\u003c/button>\n    \u003cbutton type=\"button\" id=\"mallBtn\" disabled>&#128682; Leave the mall\u003c/button>\n    \u003cbutton type=\"button\" id=\"quietBtn\" disabled>&#128330;&#65039; Calm minute\u003c/button>\n    \u003cbutton type=\"button\" id=\"mapBtn\">&#128506;&#65039; Map\u003c/button>\n    \u003cbutton type=\"button\" id=\"nightBtn\">&#127769; Night\u003c/button>\n    \u003cbutton type=\"button\" id=\"soundBtn\">&#128266; Sound on\u003c/button>\n  \u003c/div>\n\u003c/div>\n\n\u003cscript>\n  (function () {\n    // The train can be a metro ride that the car game starts: it says which stations to stop at.\n    const rideCfg = window.__ride || null;\n    if (rideCfg) document.body.classList.add('ride');\n    function postRide(ok) {\n      try {\n        parent.postMessage({ type: 'rideDone', won: ok, score: score, station: rideCfg.endName }, '*');\n      } catch (e) {}\n    }\n    // which way the train is going, when it is a ride\n    function drawRideLabel() {\n      if (!rideCfg || gameOver) return;\n      const text = (rideCfg.reverse ? '⬅ Back to ' : '➡ To ') + rideCfg.endName;\n      ctx.fillStyle = 'rgba(10, 18, 28, 0.62)';\n      roundedRect(W / 2 - 110, 8, 220, 24, 12);\n      ctx.fill();\n      ctx.fillStyle = '#ffffff';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(text.length > 30 ? text.slice(0, 30) : text, W / 2, 25);\n    }\n    function postSize() {\n      try {\n        parent.postMessage({ type: 'rideSize', h: document.documentElement.scrollHeight }, '*');\n      } catch (e) {}\n    }\n    const canvas = document.getElementById('game');\n    const ctx = canvas.getContext('2d');\n    const scoreEl = document.getElementById('score');\n    const levelEl = document.getElementById('level');\n    const bestEl = document.getElementById('best');\n    const trophyEl = document.getElementById('trophy');\n    const medalsEl = document.getElementById('medals');\n\n    const W = canvas.width;\n    const H = canvas.height;\n    const pointsPerLevel = 5;\n\n    const laneX = [80, 200, 320];\n\n    // The train's spot on screen never changes by itself: only its sideways\n    // position follows the track you pick. The wreck animation is drawn as an\n    // offset on top, so a restart always puts everything back.\n    const engineY = H - 190;\n    const carSpacing = 52;\n    const cars = [\n      { x: laneX[1], hw: 15, hh: 25, kind: 'engine' },\n      { x: laneX[1], hw: 14, hh: 22, kind: 'car' },\n      { x: laneX[1], hw: 14, hh: 22, kind: 'car' },\n    ];\n    const carY = (i) => engineY + i * carSpacing;\n\n    let lane = 1;\n    let obstacles = [];\n    let coins = [];\n    let puffs = []; // chimney smoke\n    let rings = []; // dust rings when something happens\n    let score = 0;\n    let level = 1;\n    let levelFlash = 0;\n    let best = 0; // best score for the mode you are playing\n    let bestNormal = 0;\n    let bestEasy = 0;\n    // the trophy: the highest level you have ever reached (one per mode)\n    let bestLevel = 0;\n    let bestLevelNormal = 0;\n    let bestLevelEasy = 0;\n    // Medals: one for finishing each line (reaching its last station), and a\n    // gold Metro Master medal once you have finished both.\n    let medals = { red: 0, green: 0, blue: 0, tram: 0, monorail: 0 }; // how many times you have finished each line\n    let newMedals = []; // the medals won on this journey\n    let levelAtStart = 0; // the record when this journey began\n    let recordThisRun = false;\n    let recordFlash = 0;\n    let easy = false; // easy mode: a calmer, slower game\n    let started = false;\n    let gameOver = false;\n    let coinSpawnIn = 90;\n    let boostTime = 0; // frames of boost left\n    let boostCool = 0; // frames until the boost is ready again\n    const boostDuration = 120; // 2 seconds\n    let boostCooldown = 420; // 7 seconds (shorter in easy mode)\n    const boostSpeed = 1.6;\n    let shieldTime = 0; // frames of shield left\n    let shieldSpawnIn = 1100;\n    let shieldDuration = 720; // about 12 seconds (longer in easy mode)\n    let lastSpawnY = 0;\n    let scrollTotal = 0;\n    let smokeIn = 0;\n    let frame = 0;\n    let shownMph = 0; // the speedometer needle eases toward the real speed\n    const mphPerUnit = 20; // game speed -> miles per hour\n    const mphMax = 400;\n\n    // Storm: from level 5 it rains, and now and then lightning strikes.\n    const stormLevel = Infinity; // no rain or lightning in Dubai!\n    let rainAmt = 0; // 0 = dry, 1 = full storm (fades in and out)\n    let lightningIn = 200;\n    let flash = 0;\n    let flashAgain = 0; // frames until the second flicker of a strike\n    let bolt = null;\n    let rainSoundIn = 0;\n    const drops = [];\n    for (let i = 0; i \u003c 110; i++) {\n      drops.push({ x: Math.random() * (W + 40), y: Math.random() * H, len: 10 + Math.random() * 14, v: 15 + Math.random() * 9 });\n    }\n    let lastTime = null;\n\n    // Wreck animation: the carriages swing out sideways and the train tips,\n    // staying fully on screen.\n    let crashing = false;\n    let crashTimer = 0;\n    const crashDuration = 60;\n    let crashDir = 1;\n    let crashT = 0;\n\n    try {\n      bestNormal = Number(localStorage.getItem('trainDodgeBest') || 0);\n      bestEasy = Number(localStorage.getItem('trainDodgeBestEasy') || 0);\n      bestLevelNormal = Number(localStorage.getItem('trainBestLevel') || 0);\n      bestLevelEasy = Number(localStorage.getItem('trainBestLevelEasy') || 0);\n      const savedMedals = JSON.parse(localStorage.getItem('trainMedals') || '{}');\n      medals.red = Number(savedMedals.red) || 0;\n      medals.green = Number(savedMedals.green) || 0;\n      medals.blue = Number(savedMedals.blue) || 0;\n      medals.tram = Number(savedMedals.tram) || 0;\n      medals.monorail = Number(savedMedals.monorail) || 0;\n      easy = localStorage.getItem('trainEasy') === '1';\n    } catch (e) {}\n    best = easy ? bestEasy : bestNormal;\n    bestEl.textContent = 'Best: ' + best;\n\n    // ---------- sound (made with Web Audio, no files needed) ----------\n    let audio = null;\n    let noiseBuf = null;\n    let soundOn = true;\n    let chuffIn = 0;\n    let chuffFlip = false;\n    let whistledSlot = -1;\n    let doorSide = 'right'; // which side the doors open on\n    let doorK = 0; // which station the open doors belong to\n    // passengers: the ones waiting on the platform hop on while the train stands\n    let passengers = 0; // how many you have carried so far\n    let boarding = []; // passengers walking to the train right now\n    let onboard = []; // the passengers on the train, each with the station they are going to\n    let alighting = []; // passengers getting off right now\n    let delivered = 0; // passengers who reached their stop\n    let offHere = 0; // how many are getting off at this station\n    let onHere = 0; // how many are getting on at this station\n    let floaters = []; // little \"+1\" signs\n    let boardedSlot = -1; // which station's platform has been emptied...\n    let boardedPlatformX = -1; // ...and which of its two platforms\n    const passengerColours = ['#2b7bd6', '#e8a33d', '#8e44ad', '#2a9d8f'];\n    // Metro lines: you can change between the Red and Green lines at an interchange station.\n    // The journey ends at the last station of the line when you reach level 20.\n    const finalLevel = 20;\n    let terminusK = -1; // the station number of the last station, once it is scheduled\n    let won = false;\n    let finalFlash = 0;\n    let currentLine = 'red';\n    let lineBaseK = 0; // from this station number on, the current line's list starts at lineStart\n    let lineStart = 0;\n    let ridden = []; // the stations (positions on the current line) you have stopped at\n    let changedHere = false; // you have already changed line at this stop\n    // Two chances: the first two bumps do not derail the train, the third does.\n    const maxChances = 2;\n    let chances = maxChances;\n    let hurtTime = 0; // after a bump the train cannot be hit again for a moment\n    let mapOpen = false; // the metro line map; the game waits while it is open\n    let lastStoppedK = -1; // the last station the train has stopped at\n    let dwell = 0; // frames left standing at a station (doors open)\n    let departT = 0; // frames of pulling away after a station\n    let doorsClosingSaid = false;\n    let curSpeed = 0; // how fast the train is really going right now\n    const dwellFrames = 300; // at least 5 seconds at each station\n    let dwellTotal = dwellFrames; // how long this stop lasts (longer when many passengers swap)\n    const brakeDist = 650; // how far before the station the train starts slowing down\n    let nextAnnouncedK = -1; // the next station we have already announced\n    let arrivingAnnouncedK = -1; // the station we have already said we are arriving at\n    const whistleBtn = document.getElementById('whistleBtn');\n    const soundBtn = document.getElementById('soundBtn');\n    const mapBtn = document.getElementById('mapBtn');\n    const lineBtn = document.getElementById('lineBtn');\n    const quietBtn = document.getElementById('quietBtn');\n\n    function getAudio() {\n      if (audio) return audio;\n      try {\n        const AC = window.AudioContext || window.webkitAudioContext;\n        if (!AC) return null;\n        audio = new AC();\n        noiseBuf = audio.createBuffer(1, audio.sampleRate * 0.5, audio.sampleRate);\n        const d = noiseBuf.getChannelData(0);\n        for (let i = 0; i \u003c d.length; i++) d[i] = Math.random() * 2 - 1;\n      } catch (e) {\n        audio = null;\n      }\n      return audio;\n    }\n\n    function unlockAudio() {\n      try {\n        const a = getAudio();\n        if (a && a.state === 'suspended') a.resume();\n      } catch (e) {}\n    }\n\n    function noiseBurst(freq, dur, vol, type) {\n      try {\n        const a = getAudio();\n        if (!a || !soundOn) return;\n        const src = a.createBufferSource();\n        src.buffer = noiseBuf;\n        const f = a.createBiquadFilter();\n        f.type = type || 'bandpass';\n        f.frequency.value = freq;\n        const g = a.createGain();\n        const t = a.currentTime;\n        g.gain.setValueAtTime(vol, t);\n        g.gain.exponentialRampToValueAtTime(0.001, t + dur);\n        src.connect(f);\n        f.connect(g);\n        g.connect(a.destination);\n        src.start(t);\n        src.stop(t + dur + 0.02);\n      } catch (e) {}\n    }\n\n    function tone(type, f0, f1, dur, vol, delay, lowpass) {\n      try {\n        const a = getAudio();\n        if (!a || !soundOn) return;\n        const o = a.createOscillator();\n        const g = a.createGain();\n        const t = a.currentTime + (delay || 0);\n        o.type = type;\n        o.frequency.setValueAtTime(f0, t);\n        o.frequency.linearRampToValueAtTime(f1, t + dur);\n        g.gain.setValueAtTime(0.0001, t);\n        g.gain.exponentialRampToValueAtTime(vol, t + 0.04);\n        g.gain.setValueAtTime(vol, t + dur * 0.7);\n        g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n        if (lowpass) {\n          const f = a.createBiquadFilter();\n          f.type = 'lowpass';\n          f.frequency.value = lowpass;\n          o.connect(f);\n          f.connect(g);\n        } else {\n          o.connect(g);\n        }\n        g.connect(a.destination);\n        o.start(t);\n        o.stop(t + dur + 0.05);\n      } catch (e) {}\n    }\n\n    // Bullet-train sounds: a smooth electric hum and rushing wind that rise\n    // with speed, quick clack-clacks over the rail joints, and a bright horn.\n    let hum = null;\n    let humIn = 0;\n    function ensureHum() {\n      try {\n        const a = getAudio();\n        if (!a || hum) return;\n        const o = a.createOscillator();\n        o.type = 'sawtooth';\n        const f = a.createBiquadFilter();\n        f.type = 'lowpass';\n        f.frequency.value = 300;\n        const g = a.createGain();\n        g.gain.value = 0;\n        o.connect(f);\n        f.connect(g);\n        g.connect(a.destination);\n        o.start();\n        const n = a.createBufferSource();\n        n.buffer = noiseBuf;\n        n.loop = true;\n        const nf = a.createBiquadFilter();\n        nf.type = 'bandpass';\n        nf.frequency.value = 800;\n        nf.Q.value = 0.6;\n        const ng = a.createGain();\n        ng.gain.value = 0;\n        n.connect(nf);\n        nf.connect(ng);\n        ng.connect(a.destination);\n        n.start();\n        hum = { o, f, g, nf, ng };\n      } catch (e) {\n        hum = null;\n      }\n    }\n\n    let rainSnd = null;\n    function updateRainSound() {\n      try {\n        if (rainAmt \u003c 0.02 || !soundOn) {\n          if (rainSnd) rainSnd.g.gain.setTargetAtTime(0, audio.currentTime, 0.2);\n          return;\n        }\n        const a = getAudio();\n        if (!a) return;\n        if (!rainSnd) {\n          const n = a.createBufferSource();\n          n.buffer = noiseBuf;\n          n.loop = true;\n          const f = a.createBiquadFilter();\n          f.type = 'highpass';\n          f.frequency.value = 2500;\n          const g = a.createGain();\n          g.gain.value = 0;\n          n.connect(f);\n          f.connect(g);\n          g.connect(a.destination);\n          n.start();\n          rainSnd = { g };\n        }\n        rainSnd.g.gain.setTargetAtTime(0.035 * rainAmt, a.currentTime, 0.2);\n      } catch (e) {}\n    }\n\n    function strikeLightning() {\n      flash = 1;\n      flashAgain = 7;\n      // a jagged bolt from the sky down to the ground\n      const pts = [];\n      let x = 40 + Math.random() * (W - 80);\n      let y = 0;\n      const bottom = 180 + Math.random() * 260;\n      while (y \u003c bottom) {\n        pts.push([x, y]);\n        x += (Math.random() - 0.5) * 50;\n        y += 22 + Math.random() * 26;\n      }\n      bolt = pts;\n      // thunder arrives a moment later\n      setTimeout(() => {\n        noiseBurst(140, 1.3, 0.4, 'lowpass');\n        noiseBurst(70, 1.6, 0.35, 'lowpass');\n      }, 250 + Math.random() * 600);\n    }\n\n    function updateHum(on, speed) {\n      try {\n        if (!on || !soundOn) {\n          if (hum) {\n            const t0 = audio.currentTime;\n            hum.g.gain.setTargetAtTime(0, t0, 0.08);\n            hum.ng.gain.setTargetAtTime(0, t0, 0.08);\n          }\n          return;\n        }\n        ensureHum();\n        if (!hum) return;\n        const t = audio.currentTime;\n        hum.o.frequency.setTargetAtTime(60 + speed * 12, t, 0.15);\n        hum.f.frequency.setTargetAtTime(240 + speed * 45, t, 0.15);\n        hum.g.gain.setTargetAtTime(0.03, t, 0.15);\n        hum.nf.frequency.setTargetAtTime(500 + speed * 110, t, 0.15);\n        hum.ng.gain.setTargetAtTime(0.012 + speed * 0.004, t, 0.15);\n      } catch (e) {}\n    }\n\n    function playClack() {\n      chuffFlip = !chuffFlip;\n      noiseBurst(chuffFlip ? 2600 : 2100, 0.04, 0.1);\n      noiseBurst(260, 0.06, 0.09, 'lowpass');\n    }\n\n    // Honk at an oncoming train that is heading for you and it politely slides\n    // over to another track (never onto yours).\n    function moveOncomingTrain(o) {\n      if (o.slideTo !== undefined) return;\n      const ahead = engineY - (o.y + o.hh);\n      if (ahead \u003c -20 || ahead > 380) return;\n      const mine = laneX[lane];\n      if (Math.abs(o.x - mine) > 50 && Math.abs(o.x - cars[0].x) > 50) return; // not coming for us\n      const options = [0, 1, 2].filter((l) => laneX[l] !== mine && Math.abs(laneX[l] - o.x) > 10);\n      if (!options.length) return;\n      const clear = (l) => !obstacles.some((q) => q !== o && Math.abs(q.x - laneX[l]) \u003c 40 && Math.abs(q.y - o.y) \u003c 140);\n      const pick = options.find(clear) || options[0];\n      o.slideTo = laneX[pick];\n      o.lane = pick;\n      o.scared = true;\n      rings.push({ x: o.x, y: o.y + o.hh, age: 18 });\n    }\n\n    // Honk! Any animal ahead of the train (and close) gets a fright and runs\n    // away sideways, fast.\n    function scareAnimals() {\n      obstacles.forEach((o) => {\n        if (o.kind === 'train') {\n          moveOncomingTrain(o);\n          return;\n        }\n        if (o.kind !== 'animal' || o.scared) return;\n        const ahead = engineY - o.y; // how far in front of the engine\n        if (ahead \u003c -40 || ahead > 280) return;\n        o.scared = true;\n        o.dir = o.x \u003c cars[0].x ? -1 : o.x > cars[0].x ? 1 : Math.random() \u003c 0.5 ? -1 : 1;\n        o.vx = o.dir * 6.5;\n        rings.push({ x: o.x, y: o.y, age: 18 });\n      });\n    }\n\n    // A bright two-note electric horn: pwaaa!\n    function playWhistle(short) {\n      scareAnimals();\n      const d = short ? 0.3 : 0.8;\n      tone('sawtooth', 520, 500, d, 0.05, 0, 1700);\n      tone('sawtooth', 660, 630, d, 0.04, 0, 1700);\n      if (!short) {\n        tone('sawtooth', 520, 470, 0.35, 0.05, d + 0.15, 1700);\n        tone('sawtooth', 660, 600, 0.35, 0.04, d + 0.15, 1700);\n      }\n    }\n\n    // whoosh when a train rushes past the other way\n    function playPassBy() {\n      noiseBurst(1800, 0.5, 0.22);\n      tone('sawtooth', 700, 260, 0.45, 0.04, 0, 900);\n    }\n\n    function playDing() {\n      tone('sine', 1100, 1500, 0.18, 0.12);\n    }\n\n    function playCrash() {\n      noiseBurst(300, 0.6, 0.4, 'lowpass');\n      tone('sawtooth', 220, 50, 0.5, 0.12);\n    }\n\n    // Metro-style announcements: a two-note chime, then a calm voice.\n    let speakTimer = null;\n    function stopSpeech() {\n      try {\n        clearTimeout(speakTimer);\n        if ('speechSynthesis' in window) window.speechSynthesis.cancel();\n      } catch (e) {}\n    }\n\n    // The voices come from the device, and can arrive a moment after the page loads.\n    let voicesCache = [];\n    function loadVoices() {\n      try {\n        if ('speechSynthesis' in window && window.speechSynthesis.getVoices) voicesCache = window.speechSynthesis.getVoices() || [];\n      } catch (e) {}\n    }\n    loadVoices();\n    try {\n      if ('speechSynthesis' in window) window.speechSynthesis.onvoiceschanged = loadVoices;\n    } catch (e) {}\n\n    // A calm, formal woman's voice if the device has one.\n    function pickVoice(lang) {\n      const mine = voicesCache.filter((v) => new RegExp('^' + lang, 'i').test(v.lang));\n      if (lang === 'en') {\n        const gb = mine.filter((v) => /^en[-_]GB/i.test(v.lang));\n        const woman = /female|serena|kate|fiona|hazel|sonia|libby|tessa|moira|karen|samantha|susan/i;\n        return gb.find((v) => woman.test(v.name)) || mine.find((v) => woman.test(v.name)) || gb[0] || mine[0] || null;\n      }\n      return mine.find((v) => /female|laila|leila|zeina|salma|hoda|noura|amira|mariam|maryam|google/i.test(v.name)) || mine[0] || null;\n    }\n\n    // parts: [{ text, lang: 'ar' | 'en' }], spoken one after the other, slowly\n    function speakParts(parts, queue) {\n      try {\n        if (!soundOn || !('speechSynthesis' in window)) return;\n        const synth = window.speechSynthesis;\n        loadVoices();\n        if (!queue) synth.cancel(); // a new message replaces the old one, unless it should wait its turn\n        parts.forEach((p) => {\n          const voice = pickVoice(p.lang);\n          if (p.lang === 'ar' && !voice) return; // no Arabic voice on this device: the panel still shows it\n          const u = new SpeechSynthesisUtterance(p.text);\n          if (voice) {\n            u.voice = voice;\n            u.lang = voice.lang;\n          } else {\n            u.lang = 'en-GB';\n          }\n          u.rate = p.lang === 'ar' ? 0.75 : 0.7; // unhurried, like the real announcements\n          u.pitch = 1;\n          u.volume = 0.9;\n          synth.speak(u);\n        });\n      } catch (e) {}\n    }\n\n    // A two-note chime, then the same message in Arabic and in English.\n    function announce(arabic, english, queue) {\n      const parts = [{ text: arabic, lang: 'ar' }, { text: english, lang: 'en' }];\n      if (queue) {\n        // doors message: no chime, it just follows what is already being said\n        setTimeout(() => speakParts(parts, true), 300);\n        return;\n      }\n      tone('sine', 784, 784, 0.35, 0.09);\n      tone('sine', 659, 659, 0.45, 0.09, 0.3);\n      clearTimeout(speakTimer);\n      speakTimer = setTimeout(() => speakParts(parts), 900);\n    }\n\n    function setSound(on) {\n      soundOn = on;\n      if (!on) stopSpeech();\n      soundBtn.innerHTML = on ? '&#128266; Sound on' : '&#128263; Sound off';\n    }\n\n    whistleBtn.addEventListener('click', () => {\n      unlockAudio();\n      playWhistle();\n    });\n    soundBtn.addEventListener('click', () => {\n      unlockAudio();\n      setSound(!soundOn);\n    });\n\n    // ---------- night mode ----------\n    let night = false;\n    const nightBtn = document.getElementById('nightBtn');\n    try {\n      night = localStorage.getItem('trainNight') === '1';\n    } catch (e) {}\n    function setNight(on) {\n      night = on;\n      nightBtn.innerHTML = on ? '&#9728;&#65039; Day' : '&#127769; Night';\n      try {\n        localStorage.setItem('trainNight', on ? '1' : '0');\n      } catch (e) {}\n    }\n    setNight(night);\n    nightBtn.addEventListener('click', () => setNight(!night));\n\n    // ---------- boost ----------\n    const boostBtn = document.getElementById('boostBtn');\n    let boostLabel = '';\n    function updateBoostBtn(force) {\n      const running = started && !gameOver && !crashing;\n      let label = '\\u{1F680} Boost';\n      if (boostTime > 0) label = '\\u{1F525} Zoom!';\n      else if (boostCool > 0) label = '\\u{1F680} ' + Math.ceil(boostCool / 60) + 's';\n      const off = !running || boostTime > 0 || boostCool > 0;\n      if (force || label !== boostLabel || boostBtn.disabled !== off) {\n        boostLabel = label;\n        boostBtn.textContent = label;\n        boostBtn.disabled = off;\n      }\n    }\n\n    function useBoost() {\n      unlockAudio();\n      if (!started || gameOver || crashing || walkMode || mallMode || boostTime > 0 || boostCool > 0) return;\n      boostTime = boostDuration;\n      boostCool = boostCooldown;\n      noiseBurst(1200, 0.6, 0.25);\n      tone('sawtooth', 120, 420, 0.6, 0.07);\n      playWhistle(true);\n      updateBoostBtn();\n    }\n    boostBtn.addEventListener('click', useBoost);\n    updateBoostBtn(true);\n\n    // ---------- easy mode / normal mode ----------\n    const easyBtn = document.getElementById('easyBtn');\n    const normalBtn = document.getElementById('normalBtn');\n    function applyMode() {\n      easyBtn.setAttribute('aria-pressed', easy ? 'true' : 'false');\n      normalBtn.setAttribute('aria-pressed', easy ? 'false' : 'true');\n      shieldDuration = easy ? 1080 : 720;\n      boostCooldown = easy ? 300 : 420;\n      best = easy ? bestEasy : bestNormal;\n      bestEl.textContent = 'Best: ' + best;\n      bestLevel = easy ? bestLevelEasy : bestLevelNormal;\n      trophyEl.textContent = '\\u{1F3C6} Best level: ' + bestLevel;\n    }\n    function setMode(wantEasy) {\n      if (easy === wantEasy) return;\n      easy = wantEasy;\n      try {\n        localStorage.setItem('trainEasy', easy ? '1' : '0');\n      } catch (e) {}\n      applyMode();\n      if (started) {\n        // switching in the middle of a game: go back to the start screen\n        resetGame();\n        started = false;\n        obstacles = [];\n        coins = [];\n        updateBoostBtn(true);\n      }\n    }\n    easyBtn.addEventListener('click', () => setMode(true));\n    normalBtn.addEventListener('click', () => setMode(false));\n    applyMode();\n\n    // ---------- the metro line map ----------\n    // Levels 9 to 20 are a calm run to the end of the line: no obstacles at all.\n    const calmLevel = 9;\n    // The Calm minute button: no obstacles at all for one minute. It has to\n    // recharge for a minute before you can use it again.\n    const quietLength = 3600;\n    const quietRecharge = 3600;\n    let quietT = 0; // frames of calm left\n    let quietCool = 0; // frames until the button works again\n    function quietLabel() {\n      const secs = (f) => Math.ceil(f / 60);\n      const mmss = (f) => Math.floor(secs(f) / 60) + ':' + String(secs(f) % 60).padStart(2, '0');\n      if (quietT > 0) return '\\u{1F54A}\\uFE0F Calm ' + mmss(quietT);\n      if (quietCool > 0) return '\\u{1F54A}\\uFE0F Recharging ' + mmss(quietCool);\n      return '\\u{1F54A}\\uFE0F Calm minute';\n    }\n    function updateQuietBtn() {\n      const usable = started && !gameOver && !walkMode && !mallMode && quietT \u003c= 0 && quietCool \u003c= 0 && level \u003c calmLevel;\n      const label = quietLabel();\n      if (quietBtn.textContent !== label) quietBtn.textContent = label;\n      if (quietBtn.disabled === usable) quietBtn.disabled = !usable;\n      quietBtn.setAttribute('aria-pressed', String(quietT > 0));\n    }\n    function startQuiet() {\n      unlockAudio();\n      if (!started || gameOver || walkMode || mallMode || quietT > 0 || quietCool > 0 || level >= calmLevel) return;\n      quietT = quietLength;\n      calmFlash = 170;\n      // everything on the track pops away\n      obstacles.forEach((o) => {\n        if (!o.dead) {\n          o.dead = true;\n          rings.push({ x: o.x, y: o.y, age: 18 });\n        }\n      });\n      [523, 659, 784].forEach((f, i) => tone('triangle', f, f, 0.2, 0.08, i * 0.1));\n      updateQuietBtn();\n    }\n    quietBtn.addEventListener('click', startQuiet);\n    let calmTick = 0;\n    let calmFlash = 0;\n    let calmStarted = false;\n\n    function checkLevelUp() {\n      const newLevel = levelFor(score);\n      if (newLevel \u003c= level) return;\n      level = newLevel;\n      levelEl.textContent = 'Level ' + level;\n      levelFlash = 90;\n      playWhistle(true);\n      // beating your old record level wins the trophy\n      if (level > levelAtStart && level >= 2) {\n        if (!recordThisRun && levelAtStart >= 2) {\n          recordFlash = 150;\n          [523, 659, 784, 1047, 1319].forEach((f, i) => tone('triangle', f, f, 0.25, 0.09, i * 0.09));\n        }\n        recordThisRun = true;\n      }\n      noteLevelRecord();\n      if (level >= calmLevel && calmFlash \u003c= 0 && !calmStarted) {\n        // the track clears: everything still on it pops away\n        calmStarted = true;\n        calmFlash = 170;\n        obstacles.forEach((o) => {\n          if (!o.dead) {\n            o.dead = true;\n            rings.push({ x: o.x, y: o.y, age: 18 });\n          }\n        });\n      }\n      if (level >= finalLevel && terminusK \u003c 0) scheduleTerminus();\n    }\n\n    // Level 10: the next (or the one after, if the next is too close) station\n    // becomes the last one of the line.\n    function scheduleTerminus() {\n      const k = nextStationK();\n      const dist = stationPassAt(k) - scrollTotal;\n      terminusK = dist > 2000 ? k : k + 1;\n      // the monorail always runs its whole way, to Atlantis\n      if (currentLine === 'monorail') terminusK = Math.max(terminusK, lineBaseK + metroLines.monorail.names.length);\n      finalFlash = 200;\n      if (terminusK === k) {\n        nextAnnouncedK = -1; // announce it again, now as the final station\n        arrivingAnnouncedK = -1;\n      }\n      [523, 659, 784].forEach((f, i) => tone('triangle', f, f, 0.2, 0.08, i * 0.1));\n    }\n\n    function saveMedals() {\n      try {\n        localStorage.setItem('trainMedals', JSON.stringify(medals));\n      } catch (e) {}\n    }\n\n    function updateMedalsEl() {\n      const m = (icon, name, n) => icon + ' ' + name + (n > 0 ? ' \\u2713' + (n > 1 ? ' \\u00D7' + n : '') : ' \\u2014');\n      const master = medals.red > 0 && medals.green > 0 && medals.blue > 0 && medals.tram > 0 ? 1 : 0;\n      medalsEl.textContent = '\\u{1F396}\\uFE0F ' + m('\\u{1F534}', 'Red', medals.red) + '   ' + m('\\u{1F7E2}', 'Green', medals.green) + '   ' + m('\\u{1F535}', 'Blue', medals.blue) + '   ' + m('\\u{1F7E0}', 'Tram', medals.tram) + '   ' + m('\\u{1F7E3}', 'Monorail', medals.monorail) + '   ' + m('\\u2B50', 'Metro Master', master);\n    }\n    updateMedalsEl();\n\n    function finishJourney() {\n      won = true;\n      if (rideCfg) {\n        [523, 659, 784, 1047].forEach((f, i) => tone('triangle', f, f, 0.3, 0.1, i * 0.12));\n        announce('وصلنا إلى المحطة', 'You have arrived at ' + rideCfg.endName + '.', true);\n        setTimeout(() => postRide(true), 1500);\n        return;\n      }\n      // a medal for the line you finished (the first time), and Metro Master for both\n      const key = currentLine;\n      const firstTime = medals[key] === 0;\n      medals[key]++;\n      newMedals = [];\n      if (firstTime) newMedals.push(key);\n      if (firstTime && medals.red > 0 && medals.green > 0 && medals.blue > 0 && medals.tram > 0) newMedals.push('master');\n      saveMedals();\n      updateMedalsEl();\n      [523, 659, 784, 1047, 1319, 1568].forEach((f, i) => tone('triangle', f, f, 0.3, 0.1, i * 0.12));\n      announce('شكراً لسفركم معنا', 'Thank you for travelling with us.', true);\n      endGame();\n    }\n\n    function updateLineBtn() {\n      // at any station you can get off and walk (except at the very end of a line)\n      const inter = isInterchange(lastStoppedK);\n      const here = started && !gameOver && dwell > 0 && !changedHere && !walkMode && !mallMode && lastStoppedK >= 0 && (lastStoppedK !== terminusK || inter);\n      const tl = here && inter ? targetLineAt(lastStoppedK) : null;\n      const mall = here && isMallName(stationName(lastStoppedK));\n      const label = here ? (inter ? (tl === 'monorail' || currentLine === 'monorail' ? '\\u{1F501} To ' + metroLines[tl].name : mall ? '\\u{1F6CD}\\uFE0F Go to the mall or a line' : '\\u{1F6B6} Walk to the lines') : mall ? '\\u{1F6CD}\\uFE0F Go to the mall' : '\\u{1F6B6} Get off & walk') : '\\u{1F501} Change line';\n      if (lineBtn.textContent !== label) lineBtn.textContent = label;\n      if (lineBtn.disabled === here) lineBtn.disabled = !here;\n      lineBtn.classList.toggle('big', here && (inter || mall));\n    }\n\n    // Step off at an interchange and on to the other line: the stations after\n    // this one are the other line's.\n    function changeLine() {\n      if (rideCfg) return;\n      unlockAudio();\n      if (!started || gameOver || dwell \u003c= 0 || changedHere || lastStoppedK \u003c 0) return;\n      if (!isInterchange(lastStoppedK)) {\n        // any ordinary station: get off if you like and pick any line in the tunnels\n        if (lastStoppedK === terminusK) return;\n        changedHere = true;\n        startWalk(null);\n        return;\n      }\n      const target = targetLineAt(lastStoppedK);\n      if (target !== 'monorail' && currentLine !== 'monorail') {\n        // the other line is down the road in the city: get off and walk there\n        changedHere = true;\n        startWalk(target);\n        return;\n      }\n      performLineChange(target, 5);\n    }\n\n    function performLineChange(target, bonus) {\n      const name = stationName(lastStoppedK);\n      let j = metroLines[target].names.indexOf(name);\n      if (j \u003c 0) j = 0; // you walked to a tunnel for a line that does not stop here: join it at its first station\n      currentLine = target;\n      lineBaseK = lastStoppedK;\n      lineStart = j;\n      ridden = [j];\n      // a new line gets its own last station (the monorail goes all the way to Atlantis)\n      if (target === 'monorail') terminusK = lineBaseK + metroLines.monorail.names.length;\n      changedHere = true;\n      score += bonus; // a little bonus for changing line\n      scoreEl.textContent = 'Score: ' + score;\n      floaters.push({ x: cars[0].x, y: engineY - 30, age: 0, text: '+' + bonus });\n      nextAnnouncedK = -1; // say the next station again, on the new line\n      arrivingAnnouncedK = lastStoppedK;\n      tone('sine', 660, 990, 0.2, 0.09);\n      tone('sine', 990, 1320, 0.25, 0.09, 0.15);\n      const o = metroLines[target];\n      announce('التحويل إلى ' + o.nameAr, 'Changing to the ' + o.name + '.', true);\n      updateLineBtn();\n    }\n    lineBtn.addEventListener('click', changeLine);\n\n    // ---------- changing between the metro and the tram: a walk along the road ----------\n    // The tram stop is down the road from the metro station. You walk there,\n    // crossing roads where the cars drive and a railway crossing where a tram\n    // comes through, and the line changes when you arrive.\n    let walkMode = false;\n    let walkTarget = null; // the line we are walking to\n    let walkMall = null; // at a mall station: the mall you can walk into\n    let walkPointer = null; // where a finger or the mouse is pressing (canvas coordinates)\n    const walkKeys = { left: false, right: false, up: false, down: false };\n    const walkLen = 1700;\n    const walker = { x: 200, y: walkLen - 60, hurt: 0, fallT: 0, safeY: 0, stepT: 0, moving: false };\n    let walkCars = [];\n    let walkTime = 0;\n    let walkMsg = '';\n    let walkMsgT = 0;\n    let walkIntro = 0;\n    let walkTramX = -400;\n    let walkGate = 0; // 0 = the gates are up, 1 = down\n    let walkTramWarn = false;\n    const walkRoads = [\n      { y: 1420, h: 120, signal: true, speed: 2.4, gap: 190, phase: 0, next: [0, 0] },\n      { y: 1080, h: 120, signal: false, speed: 3.0, gap: 330, phase: 0, next: [0, 0] },\n      { y: 520, h: 120, signal: true, speed: 2.8, gap: 170, phase: 300, next: [0, 0] },\n    ];\n    const zebra = { x0: 140, x1: 260 };\n    const tramCross = { y0: 820, y1: 900 };\n    const walkCarColours = ['#e63946', '#1f6fd6', '#f4a261', '#2a9d8f', '#8e44ad', '#e9c46a', '#dfe6ec'];\n    const walkCamY = () => Math.max(0, Math.min(walkLen - H, walker.y - 400));\n    const canvasPos = (clientX, clientY) => {\n      const rect = canvas.getBoundingClientRect();\n      return { x: ((clientX - rect.left) / rect.width) * W, y: ((clientY - rect.top) / rect.height) * H };\n    };\n\n    // the traffic lights: cars stop while the light is yellow or red, and people can cross while it is red\n    function carsMustStop(road) {\n      if (!road.signal) return false;\n      const t = (walkTime + road.phase) % 900;\n      return t >= 420 && t \u003c 800;\n    }\n    function pedGreen(road) {\n      if (!road.signal) return false;\n      const t = (walkTime + road.phase) % 900;\n      return t >= 500 && t \u003c 780;\n    }\n\n    function addWalkCar(roadIdx, lane, x) {\n      const road = walkRoads[roadIdx];\n      const dir = lane === 0 ? -1 : 1;\n      if (walkCars.some((c) => c.road === roadIdx && c.lane === lane && Math.abs(c.x - x) \u003c 70)) return;\n      walkCars.push({\n        road: roadIdx,\n        lane,\n        x,\n        y: road.y + (lane === 0 ? 38 : 90),\n        dir,\n        w: 40,\n        h: 22,\n        speed: road.speed * (easy ? 0.75 : 1) * (0.85 + Math.random() * 0.3), // calmer traffic in Easy mode\n        moving: true,\n        colour: walkCarColours[Math.floor(Math.random() * walkCarColours.length)],\n      });\n    }\n\n    function startWalk(target) {\n      walkMode = true;\n      walkTarget = target;\n      walkMall = isMallName(stationName(lastStoppedK)) ? stationName(lastStoppedK) : null;\n      walker.x = 200;\n      walker.y = walkLen - 60;\n      walker.hurt = 0;\n      walker.fallT = 0;\n      walkPointer = null;\n      walkTime = 0;\n      walkMsg = '';\n      walkMsgT = 0;\n      walkIntro = 300;\n      walkTramX = -400;\n      walkGate = 0;\n      walkCars = [];\n      walkRoads.forEach((road, ri) => {\n        for (let lane = 0; lane \u003c 2; lane++) {\n          let x = Math.random() * road.gap;\n          while (x \u003c W + 40) {\n            addWalkCar(ri, lane, x);\n            x += road.gap * (0.7 + Math.random() * 0.8);\n          }\n          road.next[lane] = (road.gap / road.speed) * (0.6 + Math.random() * 0.8);\n        }\n      });\n      updateHum(false, 0);\n      if (walkMall) {\n        announce('يرجى السير إلى المول أو اختيار الخط', 'Please walk to ' + walkMall + ', or choose a line.');\n      } else if (target) {\n        const t = metroLines[target];\n        announce('يرجى السير إلى ' + t.nameAr, 'Please walk to the ' + t.name + '.');\n      } else {\n        announce('يرجى اختيار الخط الذي تريده', 'Please choose the line you want.');\n      }\n      updateLineBtn();\n    }\n\n    // At the end of the walk there is a tunnel to every line. The one you came\n    // to change to is in the middle, so walking straight on picks it.\n    const walkLineKeys = ['red', 'green', 'blue', 'tram', 'monorail'];\n    function walkTunnels() {\n      let order = walkLineKeys.slice();\n      if (walkTarget) {\n        const others = walkLineKeys.filter((k) => k !== walkTarget);\n        order = [others[0], others[1], walkTarget, others[2], others[3]];\n      }\n      if (walkMall) order.unshift('mall'); // at a mall station there is a door into the mall as well\n      const step = 360 / order.length;\n      return order.map((key, i) => ({ key, cx: 20 + step / 2 + i * step, w: step - 10 }));\n    }\n    const tunnelMouthY = 215; // you are in the tunnel once you reach this high\n\n    function finishWalk(skipped, chosen) {\n      walkMode = false;\n      walkPointer = null;\n      walkKeys.left = walkKeys.right = walkKeys.up = walkKeys.down = false;\n      if (chosen === 'mall') {\n        // into the mall for some shopping\n        startMall();\n        return;\n      }\n      const target = chosen || walkTarget || currentLine;\n      walkTarget = null;\n      walkMall = null;\n      if (target === currentLine) {\n        // back on the same line: nothing changes\n        updateLineBtn();\n        return;\n      }\n      performLineChange(target, skipped ? 5 : 10);\n    }\n\n    function walkHit(why) {\n      walker.hurt = 130;\n      walker.fallT = 90; // knocked over, then gets back up\n      score = Math.max(0, score - 3);\n      scoreEl.textContent = 'Score: ' + score;\n      walkMsg = why;\n      walkMsgT = 160;\n      walkPointer = null;\n      // back to the pavement just before whatever you walked into\n      const zones = walkRoads.map((r) => [r.y - 4, r.y + r.h + 4]).concat([[tramCross.y0, tramCross.y1]]);\n      let safe = walkLen - 60;\n      zones.forEach(([a, b]) => {\n        if (walker.y >= a - 2 && walker.y \u003c= b + 2) safe = b + 24;\n      });\n      walker.safeY = safe; // you are helped back to the pavement when you get up\n      noiseBurst(500, 0.3, 0.3);\n      tone('square', 380, 330, 0.3, 0.06);\n    }\n\n    function updateWalk(step) {\n      walkTime += step;\n      walkIntro = Math.max(0, walkIntro - step);\n      walkMsgT = Math.max(0, walkMsgT - step);\n      walker.hurt = Math.max(0, walker.hurt - step);\n      if (walker.fallT > 0) {\n        walker.fallT -= step;\n        if (walker.fallT \u003c= 0) {\n          walker.fallT = 0;\n          walker.y = walker.safeY;\n        }\n      }\n\n      // walking: press and hold to walk towards your finger, or use the arrow keys\n      let dx = 0;\n      let dy = 0;\n      if (walkPointer) {\n        const tx = walkPointer.x;\n        const ty = walkPointer.y + walkCamY();\n        const d = Math.hypot(tx - walker.x, ty - walker.y);\n        if (d > 5) {\n          dx = (tx - walker.x) / d;\n          dy = (ty - walker.y) / d;\n        }\n      }\n      if (walkKeys.left) dx -= 1;\n      if (walkKeys.right) dx += 1;\n      if (walkKeys.up) dy -= 1;\n      if (walkKeys.down) dy += 1;\n      if (walker.fallT > 0) {\n        dx = 0;\n        dy = 0;\n      }\n      const len = Math.hypot(dx, dy);\n      walker.moving = len > 0.01;\n      if (walker.moving) {\n        dx /= Math.max(1, len);\n        dy /= Math.max(1, len);\n        let nx = walker.x + dx * 2.3 * step;\n        let ny = walker.y + dy * 2.3 * step;\n        // the railway gates are shut while a tram is coming: you cannot walk in\n        if (walkGate > 0.5) {\n          if (walker.y > tramCross.y1 + 6 && ny \u003c= tramCross.y1 + 6) ny = tramCross.y1 + 6;\n          if (walker.y \u003c tramCross.y0 - 6 && ny >= tramCross.y0 - 6) ny = tramCross.y0 - 6;\n        }\n        walker.x = Math.max(28, Math.min(W - 28, nx));\n        walker.y = Math.max(40, Math.min(walkLen - 16, ny));\n        walker.stepT += step;\n        if (walker.stepT > 15) {\n          walker.stepT = 0;\n          noiseBurst(1600, 0.03, 0.04);\n        }\n      }\n\n      // the tram timetable: warning lights and bell, gates down, tram passes, gates up\n      const t = (walkTime + 200) % 600;\n      walkTramWarn = t >= 140 && t \u003c 440;\n      if (t >= 140 && t \u003c 300) walkGate = Math.min(1, (t - 140) / 50);\n      else if (t >= 300 && t \u003c 420) walkGate = 1;\n      else if (t >= 420 && t \u003c 470) walkGate = Math.max(0, 1 - (t - 420) / 45);\n      else walkGate = 0;\n      const tramOn = t >= 300 && t \u003c 420;\n      walkTramX = tramOn ? -260 + ((t - 300) / 120) * 740 : -400;\n      if (walkTramWarn && (t - 140) % 22 \u003c step) tone('sine', 1650, 1650, 0.12, 0.05);\n      if (tramOn && walker.hurt \u003c= 0 && Math.abs(walker.x - walkTramX) \u003c 125 && walker.y > tramCross.y0 + 14 && walker.y \u003c tramCross.y1 - 14) {\n        walkHit('A tram! Wait for the gates to open');\n      }\n\n      // the cars\n      walkRoads.forEach((road, ri) => {\n        for (let lane = 0; lane \u003c 2; lane++) {\n          road.next[lane] -= step;\n          if (road.next[lane] \u003c= 0) {\n            addWalkCar(ri, lane, lane === 0 ? W + 30 : -30);\n            road.next[lane] = (road.gap / road.speed) * (0.7 + Math.random() * 0.9);\n          }\n        }\n      });\n      walkCars.forEach((c) => {\n        const road = walkRoads[c.road];\n        let move = c.speed * c.dir * step;\n        // wait at a red light\n        if (carsMustStop(road)) {\n          if (c.dir > 0 && c.x + c.w / 2 \u003c= zebra.x0 - 14 && c.x + c.w / 2 + move > zebra.x0 - 14) move = zebra.x0 - 14 - (c.x + c.w / 2);\n          if (c.dir \u003c 0 && c.x - c.w / 2 >= zebra.x1 + 14 && c.x - c.w / 2 + move \u003c zebra.x1 + 14) move = zebra.x1 + 14 - (c.x - c.w / 2);\n        }\n        // keep a gap to the car in front\n        walkCars.forEach((o) => {\n          if (o === c || o.road !== c.road || o.lane !== c.lane) return;\n          const ahead = (o.x - c.x) * c.dir;\n          if (ahead > 0 && ahead - Math.abs(move) \u003c c.w + 12) move = c.dir * Math.max(0, ahead - (c.w + 12));\n        });\n        // slow down for a person on the crossing\n        if (walker.y > road.y - 22 && walker.y \u003c road.y + road.h + 22 && walker.x > zebra.x0 - 12 && walker.x \u003c zebra.x1 + 12) {\n          const ahead = (walker.x - c.x) * c.dir;\n          if (ahead > 0 && ahead \u003c 130) move *= Math.max(0, (ahead - 34) / 96);\n        }\n        c.x += move;\n        c.moving = Math.abs(move) > 0.25 * step;\n        // bumped into the walker?\n        if (c.moving && walker.hurt \u003c= 0 && Math.abs(walker.x - c.x) \u003c c.w / 2 + 5 && Math.abs(walker.y - c.y) \u003c c.h / 2 + 6) {\n          walkHit('Ouch! Watch out for the cars');\n        }\n      });\n      walkCars = walkCars.filter((c) => c.x > -80 && c.x \u003c W + 80);\n\n      // arrived at the stop\n      if (walker.fallT \u003c= 0 && walker.y \u003c tunnelMouthY) {\n        const tun = walkTunnels().find((t) => Math.abs(walker.x - t.cx) \u003c t.w / 2 + 1);\n        if (tun) finishWalk(false, tun.key);\n      }\n    }\n\n    function drawWalk() {\n      const camY = walkCamY();\n      const cs = getComputedStyle(document.documentElement);\n      ctx.clearRect(0, 0, W, H);\n      ctx.fillStyle = cs.getPropertyValue('--land').trim() || '#a9b0b7';\n      ctx.fillRect(0, 0, W, H);\n      ctx.save();\n      ctx.translate(0, -camY);\n      // buildings along both sides\n      const first = Math.floor(camY / 96) - 1;\n      for (let i = first; i \u003c first + H / 96 + 3; i++) {\n        const hv = cityHash(i, 40);\n        drawRoof(2, i * 96 + 6, 36, 76 - (hv % 18), hv >>> 2);\n        const hw = cityHash(i, 41);\n        drawRoof(W - 38, i * 96 + 6, 36, 76 - (hw % 18), hw >>> 2);\n      }\n      // pavement decorations: palms, benches and arrows\n      for (let y = 140; y \u003c walkLen - 40; y += 64) {\n        const inRoad = walkRoads.some((r) => y > r.y - 30 && y \u003c r.y + r.h + 30) || (y > tramCross.y0 - 40 && y \u003c tramCross.y1 + 40);\n        if (inRoad || y \u003c 270) continue;\n        const hv = cityHash(Math.floor(y / 64), 55);\n        drawPalm(hv % 2 ? 64 : 336, y);\n        if (hv % 5 === 0) {\n          ctx.fillStyle = '#8d6e50';\n          ctx.fillRect(hv % 2 ? 84 : 296, y - 5, 20, 8);\n        }\n      }\n      ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';\n      ctx.font = 'bold 20px sans-serif';\n      ctx.textAlign = 'center';\n      for (let y = 300; y \u003c walkLen - 100; y += 150) {\n        if (walkRoads.some((r) => y > r.y - 40 && y \u003c r.y + r.h + 40) || (y > tramCross.y0 - 50 && y \u003c tramCross.y1 + 50)) continue;\n        ctx.fillText('▲', 200, y);\n      }\n      // roads, zebra crossings, traffic lights\n      walkRoads.forEach((road) => {\n        ctx.fillStyle = '#585e66';\n        ctx.fillRect(0, road.y, W, road.h);\n        ctx.fillStyle = '#c9ccd1';\n        ctx.fillRect(0, road.y - 3, W, 3);\n        ctx.fillRect(0, road.y + road.h, W, 3);\n        ctx.fillStyle = 'rgba(255, 220, 90, 0.85)';\n        for (let x = 0; x \u003c W; x += 28) ctx.fillRect(x, road.y + road.h / 2 - 1, 14, 2);\n        ctx.fillStyle = 'rgba(255, 255, 255, 0.92)';\n        for (let x = zebra.x0; x \u003c zebra.x1; x += 16) ctx.fillRect(x, road.y + 5, 9, road.h - 10);\n        if (road.signal) {\n          ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';\n          ctx.fillRect(zebra.x0 - 16, road.y + road.h / 2, 3, road.h / 2); // stop line, one way\n          ctx.fillRect(zebra.x1 + 13, road.y, 3, road.h / 2); // stop line, the other way\n          const green = pedGreen(road);\n          [zebra.x0 - 22, zebra.x1 + 22].forEach((px) => {\n            roundedRect(px - 10, road.y - 24, 20, 20, 5);\n            ctx.fillStyle = green ? '#27a844' : '#d4352a';\n            ctx.fill();\n            ctx.fillStyle = '#ffffff';\n            ctx.font = '12px sans-serif';\n            ctx.textAlign = 'center';\n            ctx.fillText(green ? '\\u{1F6B6}' : '✋', px, road.y - 10);\n          });\n        }\n      });\n      // the railway crossing\n      ctx.fillStyle = '#b8a88a';\n      ctx.fillRect(0, tramCross.y0 + 6, W, tramCross.y1 - tramCross.y0 - 12);\n      ctx.fillStyle = '#7a5a3a';\n      for (let x = 0; x \u003c W; x += 14) ctx.fillRect(x, tramCross.y0 + 14, 8, tramCross.y1 - tramCross.y0 - 28);\n      ctx.fillStyle = '#8d969e';\n      ctx.fillRect(0, 843, W, 4);\n      ctx.fillRect(0, 873, W, 4);\n      const flash = walkTramWarn && Math.floor(walkTime / 12) % 2 === 0;\n      [[44, tramCross.y0 - 16], [W - 44, tramCross.y1 + 16]].forEach(([px, py]) => {\n        ctx.fillStyle = '#3a3f46';\n        ctx.fillRect(px - 2, py - 8, 4, 22);\n        ctx.beginPath();\n        ctx.arc(px - 7, py - 10, 5, 0, Math.PI * 2);\n        ctx.arc(px + 7, py - 10, 5, 0, Math.PI * 2);\n        ctx.fillStyle = '#5a1d1d';\n        ctx.fill();\n        if (walkTramWarn) {\n          ctx.beginPath();\n          ctx.arc(flash ? px - 7 : px + 7, py - 10, 5, 0, Math.PI * 2);\n          ctx.fillStyle = '#ff3b30';\n          ctx.fil