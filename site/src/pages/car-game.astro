      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('SERVICES \u27A1  \u{1F6BF} \u{1F54C} \u{1F6BB} ℹ️', 971, 118);
