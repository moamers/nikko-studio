    // the lift lobby at the end of the mall
    function drawLift() {
      const x0 = 700;
      const upper = mallFloor > 0;
      const ride = mallRide && mallRide.kind === 'lift' ? mallRide : null;
      // the wall of the lobby
      ctx.fillStyle = '#e6e0d4';
      ctx.fillRect(x0, 130, 100, 270);
      ctx.fillStyle = '#bdb5a8';
      ctx.fillRect(x0 - 2, 130, 4, 270);
      ctx.fillStyle = '#2b2230';
      roundedRect(x0 + 12, 142, 76, 24, 8);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('\u{1F6D7} LIFT', x0 + 50, 159);
      // the floor number above the doors
      ctx.fillStyle = '#111111';
      roundedRect(x0 + 34, 178, 32, 24, 4);
      ctx.fill();
      ctx.fillStyle = '#ff6b4a';
      ctx.font = 'bold 15px sans-serif';
      ctx.fillText(floorLabel[mallFloor] + (ride ? (ride.dir > 0 ? ' ⬆' : ' ⬇') : ''), x0 + 50, 196);
      // the shaft with glass sides and the lift doors
      ctx.fillStyle = '#5b5f66';
      ctx.fillRect(x0 + 18, 208, 64, 192);
      const inside = ctx.createLinearGradient(0, 212, 0, 400);
      inside.addColorStop(0, '#fff8dc');
      inside.addColorStop(1, '#ffeeb8');
      ctx.fillStyle = inside;
      ctx.fillRect(x0 + 22, 212, 56, 188);
      ctx.strokeStyle = '#b8a67a';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(x0 + 22, 330);
      ctx.lineTo(x0 + 78, 330);
      ctx.stroke();
      // you, inside the lift
      if (ride && ride.t < 45) {
        const o = ride.t < 22 ? Math.min(1, ride.t / 14) : 1;
        if (o > 0.1) drawShopper(x0 + 50, 392, ['#f2c9a0', '#d71920', '#26344a'], 0.8, 1, false, 0, mallBag.length > 0 && !mallTrolley);
      }
      // the doors slide open and shut
      let open = 0;
      if (ride) {
        const t = ride.t;
        if (t < 16) open = t / 16;
        else if (t < 24) open = 1;
        else if (t < 38) open = 1 - (t - 24) / 14;
        else if (t < 52) open = 0;
        else if (t < 66) open = (t - 52) / 14;
        else open = 1;
      } else if (nearLift()) {
        open = 0.15;
      }
      const dw = 28 * (1 - open);
      const metal = ctx.createLinearGradient(x0 + 22, 0, x0 + 78, 0);
      metal.addColorStop(0, '#aeb4bb');
      metal.addColorStop(0.5, '#eef1f4');
      metal.addColorStop(1, '#aeb4bb');
      ctx.fillStyle = metal;
      ctx.fillRect(x0 + 22, 212, dw, 188);
      ctx.fillRect(x0 + 78 - dw, 212, dw, 188);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.18)';
      ctx.fillRect(x0 + 49, 212, 2, 188);
      // the call button
      ctx.fillStyle = '#3a3f46';
      roundedRect(x0 + 86, 300, 10, 22, 3);
      ctx.fill();
      ctx.fillStyle = ride ? '#ffd23f' : '#ff6b4a';
      ctx.beginPath();
      ctx.arc(x0 + 91, 307, 3, 0, Math.PI * 2);
      ctx.arc(x0 + 91, 316, 3, 0, Math.PI * 2);
      ctx.fill();
    }

