    function leaveMall() {
      if (phase !== 'mall' || mallRide) return;
      if (toi.stage > 0) {
        say('You need the toilet first! \u{1F6BB} Find the restrooms by the lift.', 200);
        blip(220, 160, 0.2, 0.08);
        return;
      }
      if (buddy && !buddy.bye) {
        buddyBye(() => leaveMall());
        return;
      }
      if (isMosque()) {
        leaveMosque();
        return;
