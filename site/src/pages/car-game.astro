    // a shopping trolley seen from the side: a wire basket on wheels with your bags in it
    function drawTrolley(x, y, scale, dir, bags) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale * dir, scale);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.16)';
      ctx.beginPath();
      ctx.ellipse(8, 0, 22, 4, 0, 0, Math.PI * 2);
      ctx.fill();
      // the bags
      const cols = ['#c77dff', '#ff9f1c', '#2ec4b6', '#ef476f'];
      for (let i = 0; i < Math.min(8, bags); i++) {
        ctx.fillStyle = cols[i % 4];
        roundedRect(-8 + (i % 4) * 9, -40 - Math.floor(i / 4) * 9, 11, 12, 2);
        ctx.fill();
      }
      // the basket
      ctx.fillStyle = 'rgba(210, 215, 222, 0.5)';
      ctx.beginPath();
      ctx.moveTo(-12, -32);
      ctx.lineTo(32, -32);
      ctx.lineTo(26, -12);
      ctx.lineTo(-6, -12);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#8c939b';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      for (let k = 0; k < 5; k++) {
        ctx.moveTo(-8 + k * 9, -32);
        ctx.lineTo(-4 + k * 8, -12);
      }
      ctx.moveTo(-9, -22);
      ctx.lineTo(29, -22);
      ctx.stroke();
      // the handle and the wheels
      ctx.strokeStyle = '#4a4f57';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(-12, -32);
      ctx.lineTo(-18, -44);
      ctx.moveTo(-6, -12);
      ctx.lineTo(-4, -4);
      ctx.moveTo(26, -12);
      ctx.lineTo(24, -4);
      ctx.stroke();
      ctx.fillStyle = '#2b2f35';
      ctx.beginPath();
      ctx.arc(-4, -2, 3.5, 0, Math.PI * 2);
      ctx.arc(24, -2, 3.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

