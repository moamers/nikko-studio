أهلاً بكم في ' + stationNameAr(lastStoppedK), 'Welcome to ' + stationName(lastStoppedK) + '. You have one minute to shop!', true);\n    }\n\n    // Back outside: pick a line in the tunnels and carry on.\n    function leaveMall() {\n      if (!mallMode) return;\n      mallMode = false;\n      mallShop = -1;\n      mallBtn.disabled = true;\n      mallBtn.classList.remove('late');\n      mallBtn.textContent = '\\u{1F6AA} Leave the mall';\n      walkMode = true;\n      walkTarget = null;\n      walkMall = null;\n      walkPointer = null;\n      walkIntro = 0;\n      walker.x = 200;\n      walker.y = 340;\n      walker.fallT = 0;\n      walker.hurt = 0;\n      walkMsg = 'Back outside! Pick a tunnel to your line.';\n      walkMsgT = 220;\n      [784, 659, 523].forEach((f, i) => tone('triangle', f, f, 0.2, 0.08, i * 0.09));\n      updateLineBtn();\n      updateQuietBtn();\n    }\n\n    // Too slow: you lose the game and a Green Line medal.\n    function mallLose() {\n      mallMode = false;\n      mallShop = -1;\n      mallBtn.disabled = true;\n      mallBtn.classList.remove('late');\n      mallBtn.textContent = '\\u{1F6AA} Leave the mall';\n      mallLost = true;\n      mallLostMedal = medals.green > 0;\n      medals.green = Math.max(0, medals.green - 1);\n      saveMedals();\n      updateMedalsEl();\n      finalFlash = 0;\n      endGame();\n    }\n\n    function mallEnterShop(i) {\n      mallShop = i;\n      mallGoto = null;\n      mallPerson.x = 70;\n      mallPerson.y = 500;\n      mallPerson.dir = 1;\n      walkPointer = null;\n      mallShopFolk = [\n        { x: 190, y: 470, dir: 1, v: 0.35, look: shopperLook[(i + 2) % 8], bag: false, kid: false, t: 0, pause: 0 },\n        { x: 330, y: 520, dir: -1, v: 0.3, look: shopperLook[(i + 5) % 8], bag: true, kid: i % 2 === 0, t: 7, pause: 0 },\n      ];\n      mallMsg = 'Welcome to ' + mallShopsData[i].name + '! Tap what you want to buy.';\n      mallMsgT = 200;\n      tone('sine', 988, 988, 0.15, 0.08);\n      tone('sine', 