      } else if (mallFloor === 0 && nearTrolleyBay() && !mallRide) {
        ctx.fillStyle = 'rgba(10, 18, 28, 0.82)';
        roundedRect(trolleyBayX - 80, 300, 160, 26, 13);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(mallTrolley ? '\u{1F6D2} Tap to put the trolley back' : '\u{1F6D2} Tap to take a trolley', trolleyBayX, 318);
      } else if (nearLift() && !mallRide) {
        ctx.fillStyle = 'rgba(10, 18, 28, 0.82)';
        roundedRect(liftX - 70, 262, 140, 26, 13);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('\u{1F6D7} Tap the lift to choose a floor', liftX, 280);
      } else if (nearMallEsc() && !mallRide) {
        ctx.fillStyle = 'rgba(10, 18, 28, 0.82)';
        roundedRect(mallEscX - 70, 262, 140, 26, 13);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(mallFloor < 3 ? '\u2B06 Tap to ride up' : '\u2B07 Tap to ride down', mallEscX, 280);
      }
      ctx.restore();
      if (mallRide && mallRide.kind !== 'lift' && mallRide.t > 72) {
        ctx.fillStyle = 'rgba(255, 255, 255, ' + (mallRide.t - 72) / 18 + ')';
        ctx.fillRect(0, 0, W, H);
      }
    }

    // inside a shop: shelves, a counter, the shopkeeper and the things for sale
