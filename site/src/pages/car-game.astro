        say(fk ? 'Welcome to the ' + mallShopsData[mallShop].name + '! ' + (fk === 'wudu' ? 'Tap your stool to wash for prayer.' : fk === 'prayer' ? 'Shoes off, then your mat.' : fk === 'wc' ? 'Tap things to use them.' : 'Ask the helper anything.') : 'Welcome to ' + mallShopsData[mallShop].name + '! Tap what you want to buy.', 200);
