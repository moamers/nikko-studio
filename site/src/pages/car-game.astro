 'Marina Walk', 'JBR 1', 'The Walk', 'JBR 2', 'Marina Mall', 'The Beach Mall', 'Mina Seyahi', 'Media City', 'Internet City', 'Knowledge Village', 'Al Sufouh', 'Sobha Realty', 'Marina Yacht Club', 'Dubai Harbour'],\n        ar: ['دبي مارينا', 'أبراج المارينا', 'مارينا ووك', 'جي بي آر 1', 'ذا ووك', 'جي بي آر 2', 'مارينا مول', 'ذا بيتش مول', 'ميناء السيهة', 'مدينة دبي للإعلام', 'مدينة دبي للإنترنت', 'القرية المعرفية', 'السفوح', 'صبّا العقارية', 'نادي مارينا لليخوت', 'ميناء دبي'],\n      },\n      monorail: {\n        name: 'Palm Monorail',\n        nameAr: 'مونوريل النخلة',\n        colour: '#8e44ad',\n        dark: '#5b2c6f',\n        end: { name: 'Atlantis The Palm', ar: 'أتلانتس النخلة' },\n        names: ['Palm Jumeirah', 'Palm Jumeirah Station'],\n        ar: ['نخلة جميرا', 'محطة نخلة جميرا'],\n      },\n      blue: {\n        name: 'Blue Line',\n        nameAr: 'الخط الأزرق',\n        colour: '#0a6ed1',\n        dark: '#064a8f',\n        end: { name: 'Academic City', ar: 'المدينة الأكاديمية' },\n        names: ['Mirdif', 'Dubai Festival City Mall', 'Al Warqa', 'Dubai Hills Mall', 'International City', 'Silicon Oasis', 'Ras Al Khor', 'Creek', 'Dubai Creek Harbour', 'Business Bay', 'Al Safa', 'Al Quoz'],\n        ar: ['مردف', 'دبي فستيفال سيتي مول', 'الورقاء', 'دبي هيلز مول', 'المدينة العالمية', 'واحة السيليكون', 'رأس الخور', 'كريك', 'ميناء خور دبي', 'الخليج التجاري', 'الصفا', 'القوز'],\n      },\n    };\n    const lineOf = () => metroLines[currentLine];\n    // the shopping malls: they get a big mall building beside the station\n    const isMallName = (name) => /Mall|City Centre|Ghurair|Centrepoint/.test(name);\n    const lineWith = (name) => Object.keys(metroLines).find((key) => key !== currentLine && metroLines[key].names.includes(name)) || null;\n    // which station of the current line is station number k\n    const lineIndexAt = (k) => {\n      const len = lineOf().names.length;\n      return (((k - lineBaseK + lineStart) % len) + len) % len;\n    };\n    const stationName = (k) => (k === terminusK ? lineOf().end.name : lineOf().names[lineIndexAt(k)]);\n    const stationNameAr = (k) => (k === terminusK ? lineOf().end.ar : lineOf().ar[lineIndexAt(k)]);\n    const targetLineAt = (k) => lineWith(stationName(k));\n    // the Dubai Tram's last stop, Palm Jumeirah, is where the monorail carries on to Atlantis\nconst isInterchange = (k) => (k !== terminusK || currentLine === 'tram') && targetLineAt(k) !== null;\n    const eventKinds = ['station', 'tunnel', 'bridge'];\n    const eventLengths = { station: 300, tunnel: 440, bridge: 200 };\n    // Station number k is passed when the train has travelled this far. The\n    // stations come round every three slots (station, tunnel, bridge).\n    const stationSpan = slotLength * 3;\n    // The train stops with its middle carriage opposite the middle of the platforms.\n    function stationPassAt(k) {\n      return k * stationSpan + engineY + 200;\n    }\n    function nextStationK() {\n      const first = stationPassAt(0);\n      const ahead = Math.max(0, Math.ceil((scrollTotal - first - 1e-6) / stationSpan));\n      return Math.max(ahead, lastStoppedK + 1);\n    }\n\n    function eventInfo() {\n      const n = Math.floor(scrollTotal / slotLength);\n      const kind = eventKinds[n % 3];\n      const len = eventLengths[kind];\n      const top = (scrollTotal % slotLength) - len; // top edge on screen\n      return { n, kind, len, top, name: stationName(Math.floor(n / 3)), nameAr: stationNameAr(Math.floor(n / 3)) };\n    }\n    // the moment the engine reaches the thing (sign, tunnel mouth or river)\n    function eventReach(ev) {\n      return ev.kind === 'station' ? ev.top + 20 : ev.top + ev.len;\n    }\n    const stationInfo = () => {\n      const ev = eventInfo();\n      return { n: ev.n, top: ev.kind === 'station' ? ev.top : 9999, name: ev.name, nameAr: ev.nameAr };\n    };\n    const stationLength = eventLengths.station;\n\n    function drawStationGround() {\n      const st = stationInfo();\n      if (st.top > H || st.top + stationLength \u003c 0) return;\n      [140, 260].forEach((cx) => {\n        // platform\n        ctx.fillStyle = '#c9ccd1';\n        ctx.fillRect(cx - 27, st.top, 54, stationLength);\n        ctx.fillStyle = '#ffd23f';\n        ctx.fillRect(cx - 27, st.top, 3, stationLength);\n        ctx.fillRect(cx + 24, st.top, 3, stationLength);\n        // platform screen doors along both edges (the street-level tram has none)\n        ctx.fillStyle = 'rgba(120, 190, 230, 0.9)';\n        if (!onGround()) for (let y = st.top + 8; y \u003c st.top + stationLength - 14; y += 22) {\n          ctx.fillRect(cx - 27, y, 3, 16);\n          ctx.fillRect(cx + 24, y, 3, 16);\n        }\n        // waiting passengers\n        const colours = passengerColours;\n        const emptied = st.n === boardedSlot && cx === boardedPlatformX; // they have all gone on board\n        for (let i = 0; i \u003c (emptied ? 0 : 5); i++) {\n          const px = cx - 16 + ((i * 11) % 32);\n          const py = st.top + 40 + i * 48 + (cx === 260 ? 18 : 0);\n          ctx.beginPath();\n          ctx.arc(px, py, 5, 0, Math.PI * 2);\n          ctx.fillStyle = colours[(i + (cx === 260 ? 2 : 0)) % 4];\n          ctx.fill();\n          ctx.beginPath();\n          ctx.arc(px, py - 7, 3.5, 0, Math.PI * 2);\n          ctx.fillStyle = '#f2c9a0';\n          ctx.fill();\n        }\n        if (onGround() || onMono()) {\n          // a simple shelter in the line's colour\n          const tx = cx - 20;\n          const ty = st.top + 70;\n          const th = stationLength - 140;\n          ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';\n          ctx.fillRect(tx + 4, ty + 4, 40, th);\n          ctx.fillStyle = lineOf().colour;\n          roundedRect(tx, ty, 40, th, 6);\n          ctx.fill();\n          ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';\n          ctx.fillRect(tx + 6, ty + 6, 28, 4);\n          ctx.fillRect(tx + 6, ty + th - 10, 28, 4);\n          ctx.fillStyle = 'rgba(140, 200, 235, 0.45)';\n          ctx.fillRect(tx + 14, ty + 16, 12, th - 32);\n          return;\n        }\n        // the silver \"shell\" roof that Dubai Metro stations are famous for\n        const rx = cx - 25;\n        const ry = st.top + 28;\n        const rw = 50;\n        const rh = stationLength - 56;\n        const shell = ctx.createLinearGradient(rx, 0, rx + rw, 0);\n        shell.addColorStop(0, 'rgba(150, 160, 172, 0.82)');\n        shell.addColorStop(0.35, 'rgba(245, 248, 252, 0.85)');\n        shell.addColorStop(0.65, 'rgba(230, 236, 244, 0.8)');\n        shell.addColorStop(1, 'rgba(140, 150, 165, 0.82)');\n        roundedRect(rx, ry, rw, rh, 24);\n        ctx.fillStyle = shell;\n        ctx.fill();\n        ctx.strokeStyle = 'rgba(80, 90, 105, 0.8)';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n        // glass strip down the middle and ribs across\n        roundedRect(cx - 9, ry + 14, 18, rh - 28, 9);\n        ctx.fillStyle = 'rgba(140, 200, 235, 0.45)';\n        ctx.fill();\n        ctx.strokeStyle = 'rgba(90, 100, 115, 0.4)';\n        ctx.lineWidth = 1;\n        for (let y = ry + 30; y \u003c ry + rh - 24; y += 20) {\n          ctx.beginPath();\n          ctx.moveTo(rx + 6, y);\n          ctx.quadraticCurveTo(cx, y - 5, rx + rw - 6, y);\n          ctx.stroke();\n        }\n      });\n    }\n\n    function drawStationSign() {\n      const st = stationInfo();\n      const y = st.top + 20;\n      if (y \u003c -40 || y > H + 20) return;\n      ctx.fillStyle = '#4a4f55';\n      ctx.fillRect(0, y, W, 6);\n      ctx.fillRect(6, y, 6, 20);\n      ctx.fillRect(W - 12, y, 6, 20);\n      roundedRect(W / 2 - 105, y - 6, 210, 48, 8);\n      ctx.fillStyle = lineOf().colour;\n      ctx.fill();\n      ctx.strokeStyle = 'white';\n      ctx.lineWidth = 3;\n      ctx.stroke();\n      ctx.fillStyle = 'white';\n      ctx.textAlign = 'center';\n      const label = (isMallName(st.name) ? '\\u{1F6CD}\\uFE0F ' : '\\u{1F687} ') + st.name;\n      let size = 18;\n      ctx.font