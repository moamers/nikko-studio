    // ---- the calendar
    function openCalendar(leaving) {
      calOpen = true;
      calLeave = leaving;
      hold = null;
      blip(700, 700, 0.08, 0.08);
    }
    function calendarPress(p) {
      if (calLeave) {
        if (p.x > 40 && p.x < 190 && p.y > 498 && p.y < 542) {
          calOpen = false;
          apt.calSeen = true;
          leaveApartment();
        } else if (p.x > 210 && p.x < 360 && p.y > 498 && p.y < 542) calOpen = false;
      } else if (p.x > 130 && p.x < 270 && p.y > 498 && p.y < 542) calOpen = false;
    }
    function wrapLines(text, maxChars) {
      const out = [];
      let line = '';
      text.split(' ').forEach((w) => {
        if ((line + ' ' + w).trim().length > maxChars) {
          out.push(line);
          line = w;
        } else line = (line + ' ' + w).trim();
      });
      if (line) out.push(line);
      return out;
    }
    function drawCalendarPanel() {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.62)';
      ctx.fillRect(0, 0, W, H);
      roundedRect(20, 40, 360, 520, 18);
      ctx.fillStyle = '#fffdf6';
      ctx.fill();
      ctx.strokeStyle = '#d62828';
      ctx.lineWidth = 4;
      ctx.stroke();
      ctx.fillStyle = '#d62828';
      roundedRect(20, 40, 360, 62, 18);
      ctx.fill();
      ctx.fillRect(20, 80, 360, 22);
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 20px sans-serif';
      ctx.fillText('\u{1F4C5} ' + monthNames[gameDate.getMonth()].toUpperCase() + ' ' + gameDate.getFullYear(), 200, 70);
      ctx.font = '13px sans-serif';
      ctx.fillText(calLeave ? 'Before you go out: what day is it?' : 'Your calendar', 200, 93);
      ctx.fillStyle = '#2b2230';
      ctx.font = 'bold 17px sans-serif';
      ctx.fillText('Today is ' + dayNames[gameDate.getDay()] + ', ' + gameDate.getDate() + ' ' + monthNames[gameDate.getMonth()] + (isFriday() ? ' \u{1F54C}' : ''), 200, 130);
      // the days
      const y0 = gameDate.getFullYear();
      const m0 = gameDate.getMonth();
      const first = new Date(y0, m0, 1).getDay();
      const count = new Date(y0, m0 + 1, 0).getDate();
      const gx = 29;
      const gy = 168;
      ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach((n, i) => {
        ctx.fillStyle = i === 5 ? '#1f9d55' : '#6b727b';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText(n, gx + i * 46 + 23, gy - 8);
      });
      for (let d = 1; d <= count; d++) {
        const idx = first + d - 1;
        const cx = gx + (idx % 7) * 46;
        const cy = gy + Math.floor(idx / 7) * 42;
        const fri = idx % 7 === 5;
        const today = d === gameDate.getDate();
        roundedRect(cx + 2, cy, 42, 38, 8);
        ctx.fillStyle = today ? '#ffd23f' : fri ? '#d9f7e3' : '#f3f0e6';
        ctx.fill();
        if (today) {
          ctx.strokeStyle = '#d62828';
          ctx.lineWidth = 3;
          ctx.stroke();
        } else if (fri) {
          ctx.strokeStyle = '#1f9d55';
          ctx.lineWidth = 2;
          ctx.stroke();
        }
        ctx.fillStyle = '#2b2230';
        ctx.font = 'bold 15px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(String(d), cx + 23, cy + 22);
        if (fri) {
          ctx.font = '11px sans-serif';
          ctx.fillText('\u{1F54C}', cx + 23, cy + 35);
        }
      }
      // what it means
      const toFri = (5 - gameDate.getDay() + 7) % 7;
      const nf = new Date(gameDate.getFullYear(), gameDate.getMonth(), gameDate.getDate() + toFri);
      const note = isFriday() ? 'Today is Friday! It is the day of the Friday prayer (Jumu\'ah). Do your wudu and pray in the prayer room at the mall.' : 'The next Friday prayer is on Friday ' + nf.getDate() + ' ' + monthNames[nf.getMonth()] + ', in ' + toFri + (toFri === 1 ? ' day.' : ' days.');
      roundedRect(34, 420, 332, 62, 12);
      ctx.fillStyle = isFriday() ? '#d9f7e3' : '#eef3f8';
      ctx.fill();
      ctx.strokeStyle = isFriday() ? '#1f9d55' : '#b9c7d3';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = '#2b2230';
      ctx.font = 'bold 13px sans-serif';
      wrapLines(note, 42).forEach((ln, i) => ctx.fillText(ln, 200, 442 + i * 17));
      // the buttons
      const btn = (x, w, col, label) => {
        roundedRect(x, 498, w, 44, 22);
        ctx.fillStyle = col;
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 15px sans-serif';
        ctx.fillText(label, x + w / 2, 526);
      };
      if (calLeave) {
        btn(40, 150, '#2fbf71', 'Go out \u{1F6AA}');
        btn(210, 150, '#e08a1e', 'Stay home');
