    // ---------- the beach: walk on the sand, collect shells and paddle in the sea ----------
    const bch = { x: 200, y: 555, stepT: 0, moving: false };
    let shells = [];
    let shellCount = 0;
    let paddled = false;
    let splashT = 0;
    let swimmers = [];
    let umbrellas = [];
    let sunbathers = [];
    let beachTime = 0;

    function enterBeach() {
      phase = 'beach';
      bch.x = 200;
      bch.y = 555;
      hold = null;
      mallBag = [];
      mallTrolley = false;
      shellCount = 0;
      paddled = false;
      splashT = 0;
      beachCoins = 15;
      saltTried = [];
      poolSwum = false;
      poolLaps = 0;
      poolEnd = 0;
      bchDir = 1;
      strollers = [[20, 205, 330, 0.6, 1, 2], [380, 20, 335, 0.5, -1, 4], [30, 380, 540, 0.7, 1, 1], [360, 40, 560, 0.55, -1, 5]].map(([a, b, y, v, dir, lk], i) => ({ x: a, min: Math.min(a, b), max: Math.max(a, b), y, v, dir, look: shopperLook[lk], t: i * 13 }));
      saltEat = null;
      saltOpen = false;
      shells = [];
      for (let i = 0; i < 8; i++) {
        let sx;
        let sy;
        do {
          sx = 30 + Math.random() * 340;
          sy = 225 + Math.random() * 300;
        } while ((sx < 330 && sy < 335) || (sx < 160 && sy > 385 && sy < 505) || (sx > 200 && sx < 400 && sy > 325 && sy < 505));
        shells.push({ x: sx, y: sy, kind: i < 6 ? 'shell' : 'star', got: false });
      }
      swimmers = [];
      for (let i = 0; i < 6; i++) swimmers.push({ x: 40 + i * 60, y: 50 + (i % 3) * 30, dir: i % 2 ? 1 : -1, v: 0.3 + (i % 3) * 0.15, t: i * 11 });
      umbrellas = [{ x: 352, y: 240, c: '#ffb703' }, { x: 150, y: 372, c: '#e63946' }, { x: 300, y: 548, c: '#4361ee' }, { x: 215, y: 545, c: '#ff9f1c' }];
      sunbathers = [{ x: 150, y: 394, c: '#f4a261' }, { x: 352, y: 262, c: '#8d5a3b' }];
      kite = { x: 60 + Math.random() * 280, y: 470 + Math.random() * 90, on: false, t: 0, loop: 0, cool: 0, air: 0, kx: 200, ky: 120, col: kiteColours[Math.floor(Math.random() * kiteColours.length)] };
      kiteTime = 0;
      say('Evening at ' + dest.name + '! SALT \u{1F47D} KARAK \u2615 a pool \u{1F3CA} and a kite', 280);
      blip(988, 988, 0.15, 0.1);
      blip(1318, 1318, 0.2, 0.1, 0.14);
    }

    function leaveBeach() {
      if (phase !== 'beach') return;
      kite.on = false;
      phase = 'walk';
      shopped = true;
      me.x = 200;
      me.y = 200;
      me.hurt = 0;
      leftCar = true;
      hold = null;
      say('Walk back to your car and get in!', 200);
    }

    // ---------- flying a kite on the beach ----------
    // Pick up the kite from the sand. It flies above you in the wind: run to
    // make it climb, and press TUG to make it loop the loop for points.
    let kite = { x: 300, y: 500, on: false, t: 0, loop: 0, cool: 0, air: 0, kx: 200, ky: 120, col: ['#ff3b30', '#ffd23f'] };
    const kiteBtn = document.getElementById('kiteBtn');
    const kiteColours = [['#ff3b30', '#ffd23f'], ['#4361ee', '#4cc9f0'], ['#f72585', '#ffbe0b'], ['#2ec4b6', '#ff9f1c']];

    function updateKiteBtn() {
      const show = phase === 'beach' && kite.on;
      if (kiteBtn.hidden === show) kiteBtn.hidden = !show;
    }

    function tugKite() {
      if (phase !== 'beach' || !kite.on || kite.loop > 0 || kite.cool > 0) return;
      kite.loop = 48;
      kite.cool = 80;
      addScore(3);
      say('Whoosh! A loop-the-loop! \u{1FA81} +3', 100);
      blip(300, 900, 0.3, 0.1);
    }
    kiteBtn.addEventListener('click', () => {
      ensureAudio();
      tugKite();
    });

    function updateKite(step) {
      kite.t += step;
      kite.cool = Math.max(0, kite.cool - step);
      if (!kite.on) {
        if (Math.hypot(bch.x - kite.x, bch.y - kite.y) < 24) {
          kite.on = true;
          kite.air = 0;
          kite.kx = bch.x;
          kite.ky = bch.y - 120;
          say('You have a kite! \u{1FA81} Run to make it climb, and press TUG for loops.', 240);
          blip(500, 900, 0.2, 0.1);
        }
        return;
      }
      // the wind carries it from side to side; running makes it climb higher
      const lift = bch.moving ? 50 : 0;
      const tx = bch.x + Math.sin(kite.t / 38) * 60;
      const ty = Math.max(36, bch.y - 170 - lift) + Math.sin(kite.t / 52) * 18;
      kite.kx += (tx - kite.kx) * (1 - Math.pow(0.94, step));
      kite.ky += (ty - kite.ky) * (1 - Math.pow(0.94, step));
      if (kite.loop > 0) kite.loop = Math.max(0, kite.loop - step);
      // points for every few seconds in the air
      kite.air += step;
      if (kite.air > 240) {
        kite.air = 0;
        if (kiteTime < 12) {
          kiteTime++;
          addScore(1);
          say('The kite is flying high! +1', 70);
        }
      }
    }
    let kiteTime = 0;

    function drawKite() {
      if (!kite.on) {
        // the kite lying on the sand, waiting for you
        ctx.save();
        ctx.translate(kite.x, kite.y);
        ctx.rotate(0.5);
        const glow = 0.4 + 0.3 * Math.sin(frameCount / 8);
        ctx.fillStyle = 'rgba(255, 255, 255, ' + glow + ')';
        ctx.beginPath();
        ctx.arc(0, 0, 26, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
        drawKiteShape(kite.x, kite.y, 0.5, 0.8, 0);
        return;
      }
      // the string
      const sx = bch.x;
      const sy = bch.y - 12;
      ctx.strokeStyle = 'rgba(40, 40, 40, 0.75)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(sx, sy);
      ctx.quadraticCurveTo((sx + kite.kx) / 2 + Math.sin(kite.t / 20) * 12, (sy + kite.ky) / 2 + 30, kite.kx, kite.ky + 20);
      ctx.stroke();
      const spin = kite.loop > 0 ? (1 - kite.loop / 48) * Math.PI * 4 : 0;
      const sway = Math.sin(kite.t / 30) * 0.25;
      drawKiteShape(kite.kx, kite.ky - (kite.loop > 0 ? Math.sin((1 - kite.loop / 48) * Math.PI) * 40 : 0), sway + spin, 1, kite.t);
    }

    function drawKiteShape(x, y, angle, scale, t) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);
      ctx.scale(scale, scale);
      // the long wiggly tail
      ctx.strokeStyle = kite.col[0];
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(0, 26);
      for (let k = 1; k <= 6; k++) ctx.lineTo(Math.sin(t / 8 + k) * 8, 26 + k * 12);
      ctx.stroke();
      ctx.fillStyle = kite.col[1];
      for (let k = 1; k <= 5; k++) {
        ctx.beginPath();
        ctx.arc(Math.sin(t / 8 + k) * 8, 26 + k * 12, 4, 0, Math.PI * 2);
        ctx.fill();
      }
      // the diamond
      ctx.beginPath();
      ctx.moveTo(0, -24);
      ctx.lineTo(16, 0);
      ctx.lineTo(0, 26);
      ctx.lineTo(-16, 0);
      ctx.closePath();
      ctx.fillStyle = kite.col[0];
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(0, -24);
      ctx.lineTo(16, 0);
      ctx.lineTo(0, 0);
      ctx.lineTo(-16, 0);
      ctx.closePath();
      ctx.fillStyle = kite.col[1];
      ctx.fill();
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(0, -24);
      ctx.lineTo(0, 26);
      ctx.moveTo(-16, 0);
      ctx.lineTo(16, 0);
      ctx.stroke();
      ctx.restore();
    }

    function updateBeach(step) {
      beachTime += step;
      splashT = Math.max(0, splashT - step);
      if (saltEat) {
        bch.moving = false;
        updateSaltEat(step);
        return;
      }
      const d = inputDir(bch.x, bch.y);
      bch.moving = d.moving;
      const slow = inPool(bch.x, bch.y) ? 0.6 : 1;
      if (d.moving) {
        bch.x = Math.max(16, Math.min(W - 16, bch.x + d.dx * 2.4 * slow * step));
        bch.y = Math.max(100, Math.min(H - 12, bch.y + d.dy * 2.4 * slow * step));
        bch.stepT += step;
        if (Math.abs(d.dx) > 0.2) bchDir = d.dx > 0 ? 1 : -1;
      }
      strollers.forEach((st) => {
        st.t += step;
        st.x += st.dir * st.v * step;
        if (st.x < st.min || st.x > st.max) {
          st.dir = -st.dir;
          st.x = Math.max(st.min, Math.min(st.max, st.x));
        }
      });
      if (inPool(bch.x, bch.y)) {
        if (!poolSwum) {
          poolSwum = true;
          addScore(4);
          say('Splash! You are swimming in the pool \u{1F3CA} +4', 150);
          noiseBlip();
        }
        if (d.moving && Math.floor(beachTime / 14) !== Math.floor((beachTime - step) / 14)) splashT = 30;
        const left = bch.x < poolBox.x + 24;
        const right = bch.x > poolBox.x + poolBox.w - 24;
        if ((left && poolEnd === 1) || (right && poolEnd === -1)) {
          poolLaps++;
          addScore(2);
          say('Lap ' + poolLaps + '! \u{1F3CA} +2', 100);
          blip(880, 1320, 0.15, 0.08);
        }
        if (left) poolEnd = -1;
        else if (right) poolEnd = 1;
      } else poolEnd = 0;
      swimmers.forEach((s) => {
        s.t += step;
        s.x += s.dir * s.v * step;
        if (s.x < 24 || s.x > W - 24) s.dir = -s.dir;
      });
      shells.forEach((sh) => {
        if (!sh.got && Math.hypot(bch.x - sh.x, bch.y - sh.y) < 20) {
          sh.got = true;
          shellCount++;
          const pts = sh.kind === 'star' ? 3 : 2;
          addScore(pts);
          say((sh.kind === 'star' ? 'A starfish! ⭐ +' : 'A shell! \u{1F41A} +') + pts, 90);
          blip(900, 1500, 0.12, 0.1);
          if (shells.every((q) => q.got)) {
            addScore(10);
            say('\u{1F389} You found everything on the beach! +10', 200);
            [523, 659, 784, 1047].forEach((f, j) => blip(f, f, 0.18, 0.1, 0.2 + j * 0.08));
          }
        }
      });
      updateKite(step);
      if (bch.y < 190) {
        if (d.moving && Math.floor(beachTime / 14) !== Math.floor((beachTime - step) / 14)) splashT = 30;
        if (!paddled) {
          paddled = true;
          addScore(3);
          say('Splash! You are paddling in the sea! \u{1F30A} +3', 140);
          noiseBlip();
        }
      }
    }
    function noiseBlip() {
      blip(300, 500, 0.15, 0.08);
      blip(450, 250, 0.2, 0.06, 0.1);
    }

