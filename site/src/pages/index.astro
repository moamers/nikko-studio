---
/**
 * The homepage.
 *
 * FOUNDATIONS ONLY. The ten content sections (hero, marquee, attention,
 * language, founder, services, sampler, joyride, pitch) are built separately
 * and dropped into the `<main>` below, in the order listed in
 * `design-handoff/homepage/README.md` § "Screens / Views".
 *
 * Two things to know before you add a section:
 *
 *   1. `<OpeningSequence />` owns `id="top"`. Do not put `id="top"` on the
 *      hero — the source did, and two elements sharing an id is invalid HTML.
 *      Use `id="hero"` if the hero needs a target.
 *
 *   2. Content comes from `src/lib/content`, never from `astro:content` and
 *      never as a string literal in this file. [P7]
 */
import Base from '../layouts/Base.astro';
import OpeningSequence from '../components/OpeningSequence.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
---

<Base>
  <OpeningSequence />

  <SiteHeader nav={settings.nav} cta={settings.cta} logo={settings.logo} />

  <main id="main">
    <p class="nk-placeholder">Sections build here</p>
  </main>
</Base>

<style>
  @layer layout {
    .nk-placeholder {
      max-width: var(--nk-content-max);
      margin: 0 auto;
      padding: var(--nk-section-pad);
      padding-bottom: clamp(80px, 10vw, 150px);
      font-family: var(--nk-font-mono);
      font-size: var(--nk-size-mono-lg);
      letter-spacing: var(--nk-tracking-mono-wide);
      text-transform: uppercase;
      color: var(--nk-ink-muted);
    }
  }
</style>
