---
/**
 * /lab/patterns — an internal prototype, not a route anyone is meant to find.
 *
 * WHAT THIS PAGE IS FOR. Two pattern studies exist as a standalone pitch; the
 * question that pitch cannot answer is whether either one survives contact
 * with a real section, at real contrast, behind real copy. So this page puts
 * the field into three places on the actual site and uses the actual words
 * from `src/content/homepage/*.yaml` — not lorem, and not a mock-up of the
 * copy. If the heading is hard to read here, it will be hard to read there.
 *
 * NEVER INDEXED. `noindex` is passed to `Base` explicitly rather than relying
 * on `PUBLIC_ALLOW_INDEXING` being unset, because production sets that flag
 * and a prototype competing with the homepage in search is exactly the
 * mistake that flag exists to prevent. The page also carries no navigation
 * to it: reaching it means typing the URL.
 *
 * NOT SHIPPED. Nothing on this page is wired into the real homepage. The
 * component and the renderer are real and reviewed; where — and whether —
 * they land is the founder's call, and until that call this route is the
 * whole footprint.
 */
import Base from '../../layouts/Base.astro';
import PatternField from '../../components/PatternField.astro';
import Pill from '../../components/Pill.astro';
import {
  getAttention,
  getFounder,
  getHero,
  getJoyride,
  getLanguage,
  getMarquee,
  getPitch,
  getSampler,
  getServices,
} from '../../lib/content/homepage';

const hero = await getHero();
const language = await getLanguage();
const pitch = await getPitch();
const attention = await getAttention();
const services = await getServices();
const sampler = await getSampler();
const founder = await getFounder();
const joyride = await getJoyride();

/**
 * Two headings on the homepage are templates with `{1}`-style slots so the
 * emphasised words can be styled separately. This prototype only needs the
 * sentence, so it fills the slots flat rather than reproducing the markup the
 * real sections build. [P7 — the copy still comes from the content files.]
 */
function fill(template: string, parts: readonly string[]): string {
  return parts.reduce((out, part, i) => out.replace(`{${i + 1}}`, part), template).trim();
}

const attentionHeading = fill(
  attention.heading.template,
  attention.heading.words.map((word) => word.label),
);
const joyrideHeading = fill(
  joyride.heading.template,
  joyride.heading.emphasis.map((item) => item.text),
);
const firstService = services.items[0];
const secondService = services.items[1];
const marquee = await getMarquee();

/** The three contexts, in the order the homepage would meet them. */
const CONTEXTS = [
  {
    id: 'hero',
    index: '01',
    title: 'Hero backdrop',
    variant: 'Quarters · mono · strength 0.10',
    note:
      'The quietest setting there is. The field is behind the H1 doing nothing you would ' +
      'consciously notice — which is the job. Turn it off with the toggle and the section ' +
      'goes flat; that difference is the whole argument for it.',
  },
  {
    id: 'language',
    index: '02',
    title: 'Language panel',
    variant: 'Najmeh · accent · arch · strength 1',
    note:
      'The one place the reference is the point rather than the texture. It sits in the ' +
      'arch beside the Arabic setting, on the turquoise ground the section already has.',
  },
  {
    id: 'pitch',
    index: '03',
    title: 'Footer field',
    variant: 'Najmeh · accent · ink · split · strength 0.55',
    note:
      'Full bleed behind the copy was the first attempt and it failed: at any strength ' +
      'where the stars still read as stars, the body text and the smallprint underneath ' +
      'them do not. So the field is beside the words rather than under them, bleeding off ' +
      'the right edge. That is the honest answer for a section that has to carry a form — ' +
      'a pattern can hold a heading, and it cannot hold 14px of legal type.',
  },
  {
    id: 'services',
    index: '04',
    title: 'Services band',
    variant: 'Truchet · mono · strength 0.16',
    note:
      'Concentric quarter arcs on a Truchet flip. This is LINE rather than mass, which is ' +
      'why it survives under a paragraph where the quarter discs would not — there is far ' +
      'less ink on the page for the same amount of pattern. Tiles flip on their own as you ' +
      'scroll, and every line through a flipped tile re-routes with it.',
  },
  {
    id: 'attention',
    index: '05',
    title: 'Attention backdrop',
    variant: 'Wave · mono · strength 0.14',
    note:
      'The quietest of the three textures, and the only one whose shape IS the motion: ' +
      'every stroke is turned by the same flow field that animates the others. Drag across ' +
      'it — strokes near the pointer turn to run around it, so you leave a wake rather ' +
      'than a highlight. On a section about attention and noise, that is the argument.',
  },
  {
    id: 'joyride',
    index: '06',
    title: 'Joyride band',
    variant: 'Ribbon · accent · ink · strength 0.38',
    note:
      'A triangular lattice with ribbons cut out of it by the flow field, so the chevron ' +
      'bands actually snake rather than sitting still. The wireframe stays visible ' +
      'underneath wherever the ribbon does not reach, which is what the reference does too. ' +
      'This is the other half of the footer finding: a subject pattern CAN sit under display ' +
      'type at 52px in Archivo Black. It is 16px body copy it cannot carry.',
  },
  {
    id: 'founder',
    index: '07',
    title: 'Founder plate',
    variant: 'Blocks · accent · ink · strength 1',
    note:
      'The op-art one, and the most expensive: three clipped faces with stripes each, so it ' +
      'is capped at 90 cubes however big the box gets. Each face rules its stripes in a ' +
      'different direction — that change of angle is what the eye reads as a change of ' +
      'plane. The cluster rises and falls on the field like a skyline.',
  },
  {
    id: 'sampler',
    index: '08',
    title: 'Sampler card',
    variant: 'Nested · trio · strength 0.45',
    note:
      'Concentric polygons with the fill phase travelling outward, so each cell pulses ' +
      'instead of sitting there as a bullseye. Set to `trio` here, which is the only ' +
      'placement on this page where all three accents run at once — a sampler is the one ' +
      'section where that is the point rather than a distraction.',
  },
  {
    id: 'lid',
    index: '09',
    title: 'Section lid',
    variant: 'Arc butterfly · accent · strength 1',
    note:
      'The banded cousin of the Truchet arcs: MASS where that one is line. It cannot go ' +
      'behind anything, which is exactly why it is here — a section lid is the one slot on ' +
      'the page that carries no copy at all, so a pattern strong enough to be looked at has ' +
      'nothing to negotiate with. Full strength, no apology. The ticker underneath sits on ' +
      'clean ground.',
  },
  {
    id: 'objects',
    index: '10',
    title: 'Service card objects',
    variant: 'Iso sphere + iso cross · accent · strength 1',
    note:
      'These two are OBJECTS, not fields. They do not tile and they do not fill a section — ' +
      'each is one thing, centred, that wants a plate the way a photograph does. Which makes ' +
      'the two service cards the obvious home: the section has exactly two items and each one ' +
      'has a slot an image would otherwise occupy. Both turn slowly on their own axis and ' +
      'dissolve to bare wireframe where the flow field passes through them.',
  },
] as const;
---

<Base
  title="Pattern prototype"
  description="Internal prototype: the generative pattern field in three homepage contexts."
  noindex
>
  <div class="lab" data-lab>
    <header class="lab__mast">
      <p class="lab__eyebrow">Nikko Studio · internal prototype · not a live route</p>
      <h1 class="lab__title">The pattern, doing a job</h1>
      <p class="lab__stand">
        Ten variants across ten places on the homepage, with the real copy. Three are
        textures meant to sit behind type, five are subjects strong enough to be the thing
        you are looking at, and two are objects that do not tile at all. Scroll — every field is stirred by scroll velocity, so
        they surge as the page moves and settle when it stops. Drag across any of them; tap
        to send a wave through.
      </p>

      <ol class="lab__index">
        {
          CONTEXTS.map((context) => (
            <li class="lab__index-item">
              <a class="lab__index-link" href={`#${context.id}`}>
                <span class="lab__index-num">{context.index}</span>
                <span class="lab__index-name">{context.title}</span>
                <span class="lab__index-spec">{context.variant}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </header>

    {/* ── 01 · Hero backdrop ─────────────────────────────────────────── */}
    <section class="lab__case" id="hero">
      <p class="lab__caseline"><b>01</b> Hero backdrop · {CONTEXTS[0].variant}</p>

      <div class="demo demo--hero">
        <PatternField variant="quarters" palette="mono" tone="paper" density={34} amount={0.38} strength={0.1} />

        <div class="demo__content">
          <ul class="demo__ticket">
            {
              hero.ticket.map((item) => (
                <li class:list={['demo__chip', item.highlight && 'demo__chip--on']}>{item.label}</li>
              ))
            }
          </ul>
          <h2 class="demo__h1">{hero.heading}</h2>
          <p class="demo__lead">{hero.lead}</p>
          <Pill href={hero.cta.href} size="xl">{hero.cta.label}</Pill>
        </div>
      </div>

      <p class="lab__note">{CONTEXTS[0].note}</p>
    </section>

    {/* ── 02 · Language panel ────────────────────────────────────────── */}
    <section class="lab__case" id="language">
      <p class="lab__caseline"><b>02</b> Language panel · {CONTEXTS[1].variant}</p>

      <div class="demo demo--lang">
        <div class="demo__lang-copy">
          <h2 class="demo__h2">{language.heading}</h2>
          <p class="demo__editorial">{language.editorial}</p>
          <p class="demo__arabic" dir="rtl" lang="ar">{language.arabic}</p>
        </div>

        <div class="demo__arch">
          <PatternField variant="najmeh" palette="accent" tone="ink" density={64} amount={0.28} />
        </div>
      </div>

      <p class="lab__note">{CONTEXTS[1].note}</p>
    </section>

    {/* ── 03 · Footer field ──────────────────────────────────────────── */}
    <section class="lab__case" id="pitch">
      <p class="lab__caseline"><b>03</b> Footer field · {CONTEXTS[2].variant}</p>

      <div class="demo demo--pitch">
        <div class="demo__content demo__content--pitch">
          <h2 class="demo__h2 demo__h2--paper">{pitch.heading}</h2>
          <p class="demo__body">{pitch.body[0]}</p>

          <form class="demo__form" novalidate>
            {
              pitch.newsletter.fields.map((field) => (
                <p class="demo__field">
                  <label class="demo__label" for={`lab-${field.name}`}>
                    {field.label}
                  </label>
                  <input
                    class="demo__input"
                    id={`lab-${field.name}`}
                    name={field.name}
                    type={field.type}
                    placeholder={field.placeholder}
                    autocomplete="off"
                  />
                </p>
              ))
            }
            <Pill type="button" size="lg" tone="paper">{pitch.newsletter.submit}</Pill>
          </form>
          <p class="demo__smallprint">
            Prototype only — this form is not wired to anything and submits nowhere.
          </p>
        </div>

        <div class="demo__bleed">
          <PatternField variant="najmeh" palette="accent" tone="ink" density={78} amount={0.24} strength={0.55} />
        </div>
      </div>

      <p class="lab__note">{CONTEXTS[2].note}</p>
    </section>

    {/* ── 04 · Services band ─────────────────────────────────────────── */}
    <section class="lab__case" id="services">
      <p class="lab__caseline"><b>04</b> Services band · {CONTEXTS[3].variant}</p>

      <div class="demo demo--services">
        <PatternField variant="truchet" palette="mono" tone="paper" density={64} amount={0.5} strength={0.16} />

        <div class="demo__content demo__content--services">
          <p class="demo__kicker">{services.kicker}</p>
          <h2 class="demo__h1">{services.heading}</h2>
          {
            firstService && (
              <div class="demo__card">
                <p class="demo__kicker">{firstService.n} · {firstService.stamp}</p>
                <h3 class="demo__card-title">{firstService.title}</h3>
                <p class="demo__lead">{firstService.lead}</p>
              </div>
            )
          }
        </div>
      </div>

      <p class="lab__note">{CONTEXTS[3].note}</p>
    </section>

    {/* ── 05 · Attention backdrop ────────────────────────────────────── */}
    <section class="lab__case" id="attention">
      <p class="lab__caseline"><b>05</b> Attention backdrop · {CONTEXTS[4].variant}</p>

      <div class="demo demo--attention">
        <PatternField variant="wave" palette="mono" tone="paper" density={20} amount={0.5} strength={0.14} />

        <div class="demo__content">
          <h2 class="demo__h1 demo__h1--wrap">{attentionHeading}</h2>
          <p class="demo__lead">{attention.lead}</p>
          <p class="demo__counter">
            <span class="demo__counter-n">{attention.counter.value}</span>
            <span class="demo__counter-label">{attention.counterLabel}</span>
          </p>
        </div>
      </div>

      <p class="lab__note">{CONTEXTS[4].note}</p>
    </section>

    {/* ── 06 · Joyride band ──────────────────────────────────────────── */}
    <section class="lab__case" id="joyride">
      <p class="lab__caseline"><b>06</b> Joyride band · {CONTEXTS[5].variant}</p>

      <div class="demo demo--joyride">
        <PatternField variant="ribbon" palette="accent" tone="ink" density={48} amount={0.52} strength={0.38} />

        <div class="demo__content demo__content--joyride">
          <h2 class="demo__h2 demo__h2--paper">{joyrideHeading}</h2>
          <p class="demo__joyride-lead">{joyride.lead}</p>
        </div>
      </div>

      <p class="lab__note">{CONTEXTS[5].note}</p>
    </section>

    {/* ── 07 · Founder plate ─────────────────────────────────────────── */}
    <section class="lab__case" id="founder">
      <p class="lab__caseline"><b>07</b> Founder plate · {CONTEXTS[6].variant}</p>

      <div class="demo demo--founder">
        <div class="demo__content demo__content--founder">
          <p class="demo__kicker">{founder.eyebrow}</p>
          <h2 class="demo__h2 demo__h2--ink">{founder.heading}</h2>
          <p class="demo__lead">{founder.body[0]}</p>
        </div>

        <div class="demo__plate">
          <PatternField variant="blocks" palette="accent" tone="ink" density={34} amount={0.5} />
        </div>
      </div>

      <p class="lab__note">{CONTEXTS[6].note}</p>
    </section>

    {/* ── 08 · Sampler card ──────────────────────────────────────────── */}
    <section class="lab__case" id="sampler">
      <p class="lab__caseline"><b>08</b> Sampler card · {CONTEXTS[7].variant}</p>

      <div class="demo demo--sampler">
        <PatternField variant="nested" palette="trio" tone="paper" density={80} amount={0.5} strength={0.45} />

        <div class="demo__content demo__content--sampler">
          <h2 class="demo__h2 demo__h2--ink">{sampler.heading}</h2>
          <ul class="demo__frags">
            {
              sampler.fragments.slice(0, 3).map((fragment) => (
                <li class="demo__frag">
                  <span class="demo__kicker">{fragment.tag}</span>
                  <span class="demo__frag-text">{fragment.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p class="lab__note">{CONTEXTS[7].note}</p>
    </section>

    {/* ── 09 · Section lid ───────────────────────────────────────────── */}
    <section class="lab__case" id="lid">
      <p class="lab__caseline"><b>09</b> Section lid · {CONTEXTS[8].variant}</p>

      <div class="demo demo--lid">
        <PatternField variant="arcbfly" palette="accent" tone="ink" density={104} amount={0.55} />
      </div>

      <p class="demo__ticker">{marquee.text.trim()}</p>

      <p class="lab__note">{CONTEXTS[8].note}</p>
    </section>

    {/* ── 10 · Service card objects ──────────────────────────────────── */}
    <section class="lab__case" id="objects">
      <p class="lab__caseline"><b>10</b> Service card objects · {CONTEXTS[9].variant}</p>

      <div class="demo demo--objects">
        {
          [
            { item: firstService, variant: 'isosphere' as const },
            { item: secondService, variant: 'isocross' as const },
          ].map((entry) =>
            entry.item ? (
              <article class="demo__svc">
                <div class="demo__object">
                  <PatternField variant={entry.variant} palette="accent" tone="ink" amount={0.5} />
                </div>
                <div class="demo__svc-copy">
                  <p class="demo__kicker">{entry.item.n} · {entry.item.stamp}</p>
                  <h3 class="demo__card-title">{entry.item.title}</h3>
                  <p class="demo__lead">{entry.item.lead}</p>
                </div>
              </article>
            ) : null,
          )
        }
      </div>

      <p class="lab__note">{CONTEXTS[9].note}</p>
    </section>

    {/* ── The comparison rail ────────────────────────────────────────── */}
    <div class="rail" data-lab-rail>
      <p class="rail__label">Compare</p>
      <div class="rail__group" role="group" aria-label="Pattern visibility">
        <button type="button" class="rail__btn" data-lab-on="true" aria-pressed="true">Pattern on</button>
        <button type="button" class="rail__btn" data-lab-on="false" aria-pressed="false">Off</button>
      </div>
      <div class="rail__group" role="group" aria-label="Palette">
        <button type="button" class="rail__btn" data-lab-palette="" aria-pressed="true">As set</button>
        <button type="button" class="rail__btn" data-lab-palette="trio" aria-pressed="false">Trio</button>
        <button type="button" class="rail__btn" data-lab-palette="mono" aria-pressed="false">Mono</button>
      </div>
    </div>
  </div>
</Base>

<script>
  import { initPatternFields, destroyPatternFields } from '../../scripts/pattern';

  /**
   * The prototype's comparison rail.
   *
   * Options are read once when a field mounts, so changing one means writing
   * the new `data-*`, tearing the fields down and mounting them again. That
   * is a prototype affordance and deliberately not an API on the renderer:
   * the real site sets a field's options in the template and never changes
   * them, and giving `pattern.ts` a live setter for one internal page would
   * be interface nobody else asks for. [P14]
   */
  const rail = document.querySelector<HTMLElement>('[data-lab-rail]');
  const stage = document.querySelector<HTMLElement>('[data-lab]');

  if (rail && stage) {
    const canvases = Array.from(stage.querySelectorAll<HTMLCanvasElement>('canvas[data-pattern]'));
    // Whatever each field was authored with, so "As set" can put it back.
    const authored = canvases.map((canvas) => canvas.dataset.patternPalette ?? 'accent');

    let visible = true;
    let palette = '';

    const press = (group: string, value: string): void => {
      rail.querySelectorAll<HTMLButtonElement>(`[data-lab-${group}]`).forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset[`lab${group[0]?.toUpperCase()}${group.slice(1)}`] === value));
      });
    };

    const apply = (): void => {
      destroyPatternFields(stage);
      canvases.forEach((canvas, index) => {
        canvas.dataset.patternPalette = palette || authored[index] || 'accent';
        const wrapper = canvas.closest<HTMLElement>('.nk-pattern');
        if (wrapper) wrapper.hidden = !visible;
      });
      if (visible) initPatternFields(stage);
    };

    rail.querySelectorAll<HTMLButtonElement>('[data-lab-on]').forEach((button) => {
      button.addEventListener('click', () => {
        visible = button.dataset.labOn === 'true';
        press('on', button.dataset.labOn ?? 'true');
        apply();
      });
    });

    rail.querySelectorAll<HTMLButtonElement>('[data-lab-palette]').forEach((button) => {
      button.addEventListener('click', () => {
        palette = button.dataset.labPalette ?? '';
        press('palette', palette);
        apply();
      });
    });
  }
</script>

<style>
  /* Prototype-only styling. It lives here rather than in `src/styles` on
     purpose: nothing below is site furniture, and none of it should outlive
     the decision this page exists to support. Tokens only, no hex. [P11] */
  @layer components {
    .lab {
      max-width: var(--nk-content-max);
      margin: 0 auto;
      padding: clamp(28px, 5vw, 64px) var(--nk-gutter) clamp(120px, 18vh, 200px);
      display: flex;
      flex-direction: column;
      gap: clamp(48px, 7vw, 88px);
    }

    .lab__eyebrow,
    .lab__caseline,
    .lab__index-num,
    .lab__index-spec,
    .rail__label,
    .rail__btn,
    .demo__chip,
    .demo__label,
    .demo__smallprint {
      font-family: var(--nk-font-mono);
      letter-spacing: var(--nk-tracking-mono);
      text-transform: uppercase;
    }

    .lab__eyebrow {
      margin: 0 0 16px;
      font-size: var(--nk-size-mono);
      color: var(--nk-coral);
    }

    .lab__title {
      margin: 0 0 16px;
      font-family: var(--nk-font-display);
      font-size: var(--nk-size-h1);
      line-height: var(--nk-leading-h1);
      letter-spacing: var(--nk-tracking-h1);
      text-transform: uppercase;
      text-wrap: balance;
    }

    .lab__stand {
      margin: 0;
      max-width: var(--nk-measure-prose);
      font-size: var(--nk-size-lead);
      color: var(--nk-ink-muted);
    }

    .lab__index {
      list-style: none;
      margin: 28px 0 0;
      padding: 0;
      display: grid;
      gap: 0;
      border-top: var(--nk-rule-hair);
    }

    .lab__index-link {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 4px 16px;
      align-items: baseline;
      padding: 14px 0;
      min-height: var(--nk-tap-min);
      border-bottom: var(--nk-rule-hair);
      color: var(--nk-ink);
    }

    .lab__index-link:hover { color: var(--nk-coral); }

    .lab__index-num { font-size: var(--nk-size-mono); color: var(--nk-ink-muted); }

    .lab__index-name {
      font-family: var(--nk-font-body);
      font-size: var(--nk-size-body);
      text-transform: none;
      letter-spacing: 0;
    }

    .lab__index-spec {
      grid-column: 2;
      font-size: var(--nk-size-mono-sm);
      letter-spacing: var(--nk-tracking-mono-wide);
      color: var(--nk-ink-muted);
    }

    .lab__case { display: flex; flex-direction: column; gap: var(--nk-gap-stack); }

    .lab__caseline {
      margin: 0;
      padding-top: 12px;
      border-top: var(--nk-rule);
      font-size: var(--nk-size-mono);
      color: var(--nk-ink-muted);
    }

    .lab__caseline b { color: var(--nk-ink); }

    .lab__note {
      margin: 0;
      max-width: var(--nk-measure-prose);
      font-size: var(--nk-size-note);
      color: var(--nk-ink-muted);
    }

    /* ── The demos ──────────────────────────────────────────────────── */
    .demo { position: relative; overflow: hidden; }

    .demo__content { position: relative; z-index: 1; }

    .demo--hero {
      background: var(--nk-paper);
      padding: clamp(36px, 6vw, 72px) clamp(24px, 4vw, 56px);
      box-shadow: var(--nk-shadow-ticket);
    }

    .demo__ticket {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 24px;
      padding: 0;
    }

    .demo__chip {
      padding: 7px 14px;
      border: var(--nk-rule);
      border-radius: var(--nk-radius-oval);
      font-size: var(--nk-size-mono-sm);
    }

    .demo__chip--on { background: var(--nk-accent); color: var(--nk-on-accent); }

    .demo__h1 {
      margin: 0 0 20px;
      max-width: var(--nk-measure-heading);
      font-family: var(--nk-font-display);
      font-size: var(--nk-size-h1);
      line-height: var(--nk-leading-h1);
      letter-spacing: var(--nk-tracking-h1);
      text-transform: uppercase;
      text-wrap: balance;
    }

    .demo__lead {
      margin: 0 0 28px;
      max-width: var(--nk-measure-prose);
